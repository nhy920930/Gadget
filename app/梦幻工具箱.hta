    body.dark th.a2 { background-color: #816bf6; border-left-color: #816bf6; border-right-color: #787af6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF816BF6', endColorstr='#FF787AF6'); }
    body.dark th.a3 { background-color: #787af6; border-left-color: #787af6; border-right-color: #6e8af5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF787AF6', endColorstr='#FF6E8AF5'); }
    body.dark th.a4 { background-color: #6e8af5; border-left-color: #6e8af5; border-right-color: #6599f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6E8AF5', endColorstr='#FF6599F5'); }
    body.dark th.a5 { background-color: #6599f5; border-left-color: #6599f5; border-right-color: #5ba8f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6599F5', endColorstr='#FF5BA8F5'); }
    body.dark th.g1 { background-color: #8b5cf6; border-left-color: #8b5cf6; border-right-color: #8664f6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF8664F6'); }
    body.dark th.g2 { background-color: #8664f6; border-left-color: #8664f6; border-right-color: #7f6ff6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8664F6', endColorstr='#FF7F6FF6'); }
    body.dark th.g3 { background-color: #7f6ff6; border-left-color: #7f6ff6; border-right-color: #787af6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7F6FF6', endColorstr='#FF787AF6'); }
    body.dark th.g4 { background-color: #787af6; border-left-color: #787af6; border-right-color: #6991f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF787AF6', endColorstr='#FF6991F5'); }
    body.dark th.g5 { background-color: #6991f5; border-left-color: #6991f5; border-right-color: #5ba8f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6991F5', endColorstr='#FF5BA8F5'); }
    body.dark th.h1 { background-color: #8b5cf6; border-left-color: #8b5cf6; border-right-color: #8664f6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF8664F6'); }
    body.dark th.h2 { background-color: #8664f6; border-left-color: #8664f6; border-right-color: #806df6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8664F6', endColorstr='#FF806DF6'); }
    body.dark th.h3 { background-color: #806df6; border-left-color: #806df6; border-right-color: #7b75f6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF806DF6', endColorstr='#FF7B75F6'); }
    body.dark th.h4 { background-color: #7b75f6; border-left-color: #7b75f6; border-right-color: #767ef6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B75F6', endColorstr='#FF767EF6'); }
    body.dark th.h5 { background-color: #767ef6; border-left-color: #767ef6; border-right-color: #7086f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF767EF6', endColorstr='#FF7086F5'); }
    body.dark th.h6 { background-color: #7086f5; border-left-color: #7086f5; border-right-color: #6b8ff5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7086F5', endColorstr='#FF6B8FF5'); }
    body.dark th.h7 { background-color: #6b8ff5; border-left-color: #6b8ff5; border-right-color: #6697f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6B8FF5', endColorstr='#FF6697F5'); }
    body.dark th.h8 { background-color: #6697f5; border-left-color: #6697f5; border-right-color: #60a0f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6697F5', endColorstr='#FF60A0F5'); }
    body.dark th.h9 { background-color: #60a0f5; border-left-color: #60a0f5; border-right-color: #5ba8f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF60A0F5', endColorstr='#FF5BA8F5'); }
    body.dark td { border-color: #3c424a; color: #b6bcc2; }
    body.dark tr.alt { background-color: #2c3038; }
    body.dark .pet-block-title { color: #aeb4bc; }
    body.dark .pet-note { color: #7c828a; }
    body.dark .pet-cost-total { color: #aeb4bc; }
    body.dark .pet-cost-total b { color: #f0a050; }
    body.dark .pet-empty { color: #7c828a; }
    body.dark .input-bar .pet-char-btn { background-color: #292d33; color: #d2d6da; border-color: #4a5058 #0e1013 #0e1013 #4a5058; }
    body.dark .input-bar .pet-char-btn-on { color: #ffffff; background-color: #7b43f5; border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5'); }
    body.dark td.pet-char-cell { color: #8b5cf6; background-color: #37324d; }
    body.dark td.pet-subtotal { background-color: #453a1e; }
    body.dark td.pet-grand { color: #ffffff; background-color: #787af6; }
    body.dark td.pet-hist-day { color: #b6bcc2; }
    body.dark td.pet-hist-today { color: #8b5cf6; }
    body.dark td.pet-hist-has { color: #ffffff; background-color: #8b5cf6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5'); }
    body.dark #petHistOverlay, body.dark #petCostOverlay, body.dark #updOverlay { filter: progid:DXImageTransform.Microsoft.Alpha(opacity=55); }
    body.dark #petCostDialog label { color: #aeb4bc; }
    body.dark #petCostDialog input {
        background-color: #292d33; color: #d2d6da;
        border-color: #0e1013 #4a5058 #4a5058 #0e1013;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C8292D33', endColorstr='#B022252B');
    }
    body.dark .pet-cost-note { color: #7c828a; }
    body.dark .history-header { color: #aeb4bc; }
    body.dark .history-table td.hist-time { color: #7c828a; }
    body.dark .history-table td.hist-info { color: #a6adb4; }
    body.dark .history-table tr.row-current { background-color: #453a1e; }
    body.dark .history-table td.current-tag { color: #f0a050; }
    body.dark .history-table td.hist-tag { color: #7c828a; }
    body.dark #remindStatus { color: #7c828a; }
    body.dark #remindStatus b { color: #4ecca3; }
    body.dark .xiu-table td.xiu-item { color: #aeb4bc; }
    body.dark th.x1 { background-color: #8b5cf6; border-left-color: #8b5cf6; border-right-color: #7382f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF7382F5'); }
    body.dark th.x2 { background-color: #7382f5; border-left-color: #7382f5; border-right-color: #5ba8f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7382F5', endColorstr='#FF5BA8F5'); }
    body.dark #resultArea {
        background-color: #262a30;
        border-color: #0e1013 #3c424a #3c424a #0e1013;
    }
    body.dark #resultArea table { background-color: transparent; }
    body.dark .btn-clear-hist {
        background-color: #7b43f5; color: #ffffff;
        border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    body.dark .btn-clear-hist:active {
        border-color: #6a3de0 #4a90e8 #4a90e8 #6a3de0;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7042E0', endColorstr='#FF4690E8');
    }
    body.dark .history-header select {
        background-color: #292d33;
        border-color: #0e1013 #3c424a #3c424a #0e1013;
    }
    /* 主题切换：钉在视口右上角（quirks 下 fixed 失效，改 absolute + PinTopButtons 脚本钉位；
       right 值为脚本执行前的兜底定位）；nowrap 防文字串行换行 */
    .theme-toggle { position: absolute; top: 8px; right: 16px; z-index: 999; white-space: nowrap; }
    .theme-toggle-chk { position: absolute; left: -9999px; }
    .theme-toggle-track {
        display: inline-block; width: 48px; height: 24px; position: relative; vertical-align: middle; cursor: pointer;
        background-color: #c8ccd2;
        border: 2px solid; border-color: #a0a6ae #eceef2 #eceef2 #a0a6ae;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#D8D4D8DE', endColorstr='#C0B4BAC4');
    }
    .theme-toggle-knob {
        display: block; width: 20px; height: 20px; position: absolute; top: 0; left: 0;
        background-color: #f2f4f6;
        border: 2px solid; border-color: #ffffff #98a0a8 #98a0a8 #ffffff;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#EAFFFFFF', endColorstr='#D8E2E6EC');
    }
    .theme-toggle-txt { font-size: 12px; color: #3d444d; margin-left: 6px; vertical-align: middle; font-weight: bold; }
    body.dark .theme-toggle-track {
        background-color: #7b43f5;
        border-color: #6a3de0 #5ba8f5 #5ba8f5 #6a3de0;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    body.dark .theme-toggle-track .theme-toggle-knob { left: 24px; }
    body.dark .theme-toggle-knob {
        background-color: #2e3238;
        border-color: #6a7078 #16181c #16181c #6a7078;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C82E3238', endColorstr='#B026292E');
    }
    body.dark .theme-toggle-txt { color: #aeb4bc; }
    /* 答题 OCR：建议答案卡片、识别原文与命中行高亮 */
    #ocrSection { margin-top: 6px; }
    .ocr-bar { margin-top: 8px; }
    .input-bar .ocr-bar button { margin-left: 0; margin-right: 8px; }
    .ocr-ans-table td.ocr-ans-cell { text-align: left; }
    .ocr-ans-main { font-size: 14px; color: #3d444d; }
    .ocr-ans-main b { font-size: 18px; color: #c0392b; }
    .ocr-ans-q { margin-top: 4px; font-size: 13px; color: #3d444d; }
    .ocr-ans-alt { margin-top: 4px; font-size: 12px; color: #70787f; }
    .ocr-ans-meta { margin-top: 4px; font-size: 12px; color: #70787f; }
    /* 识别原文限高约 7 行、其余内部滚动：quirks 模式下 max-height 不生效，改用固定 height（脚本再按行数内联调小） */
    .ocr-text-head { margin-top: 8px; font-size: 12px; color: #70787f; }
    .ocr-text { height: 154px; overflow-y: auto; margin-top: 2px; padding: 6px 8px; background-color: #f4f5f7; border: 1px solid #c2c8d0; font-size: 13px; color: #3d444d; line-height: 1.7; }
    .ocr-text-line { white-space: normal; }
    .ocr-line-hit { background-color: #ffd76e; font-weight: bold; }
    /* 本地题库搜索：回车即搜，结果区限高滚动，点某条直接复制答案 */
    .input-bar #txtOcrSearch { width: 380px; }
    #ocrSearchResult { display: none; margin-top: 8px; height: 190px; overflow-y: auto; padding: 6px 8px; background-color: #f4f5f7; border: 1px solid #c2c8d0; font-size: 13px; color: #3d444d; line-height: 1.6; }
    .ocr-sr-line { padding: 2px 0; border-bottom: 1px dashed #d8dce2; cursor: pointer; }
    .ocr-sr-line b { color: #c0392b; }
    /* 题目用蓝色（与红色答案区分），命中的关键词再叠黄底：一条关键词命中多题时一眼能分辨 */
    .ocr-sr-line .ocr-sr-q { color: #1565c0; font-weight: bold; }
    .ocr-sr-line .ocr-hl { background-color: #ffe08a; color: #7a4a00; font-weight: bold; }
    .ocr-sr-line .ocr-sr-kind { color: #70787f; font-size: 12px; }
    body.dark .ocr-sr-line .ocr-sr-q { color: #7cc4ff; }
    body.dark .ocr-sr-line .ocr-hl { background-color: #6b5216; color: #ffe08a; }
    body.dark .ocr-sr-line .ocr-sr-kind { color: #7c828a; }
    .ocr-error { color: #c0392b; font-size: 13px; }
    /* 捉鬼坐标监控的状态文字：绿=已进范围，红=还在范围外 */
    .ghost-mon-in { color: #1c7a42; font-size: 13px; }
    .ghost-mon-out { color: #c0392b; font-size: 13px; font-weight: bold; }
    body.dark .ghost-mon-in { color: #4fc27a; }
    body.dark .ghost-mon-out { color: #f0a050; }
    /* 捉鬼面板：参数行 / 操作行（计算 | 监控组，竖线分隔）/ 状态行三段式；
       两个主按钮定宽，文案在“▶ 坐标实时监控 / ■ 停止监控”之间切换时不会顶动布局 */
    .ghost-params { margin-top: 8px; }
    .ghost-params label { width: auto; margin: 0 8px 0 0; vertical-align: middle; }
    .ghost-params label.ghost-lbl-gap { margin-left: 20px; }
    .ghost-params label.ghost-lbl-tight { margin-left: 10px; margin-right: 6px; }
    .ghost-params select { width: 170px; }
    .ghost-params input { width: 84px; }
    .ghost-params .tip { margin-left: 6px; }
    .ghost-actions { margin-top: 10px; }
    .input-bar .ghost-actions button { margin-left: 0; margin-right: 8px; }
    .input-bar .ghost-actions .pet-secondary-btn { height: 34px; }
    .input-bar #btnGhostCalc, .input-bar #btnGhostMon { width: 136px; padding: 0; }
    .input-bar #btnGhostMon { height: 34px; }
    /* 多开锁窗口：标题较长（角色名[ID] · 尺寸），单独占一行加宽，不挤操作行 */
    #selGameWin { width: 320px; vertical-align: middle; }
    .input-bar .ghost-win-row .pet-secondary-btn { margin-left: 6px; height: 28px; }
    .ghost-actions-sep { display: inline-block; width: 1px; height: 22px; margin: 0 10px 0 4px; background-color: #b6bcc4; vertical-align: middle; }
    body.dark .ghost-actions-sep { background-color: #4a5058; }
    .ghost-status { margin-top: 8px; }
    .ghost-status .tip { margin-left: 0; }
    .ghost-note-title { margin-top: 8px; font-weight: bold; font-size: 13px; color: #3d444d; }
    body.dark .ghost-note-title { color: #aeb4bc; }
    body.dark .ocr-ans-main { color: #aeb4bc; }
    body.dark .ocr-ans-main b { color: #f0a050; }
    body.dark .ocr-ans-q { color: #aeb4bc; }
    body.dark .ocr-ans-alt, body.dark .ocr-ans-meta { color: #7c828a; }
    body.dark .ocr-text, body.dark #ocrSearchResult { background-color: #292d33; border-color: #4a5058; color: #d2d6da; }
    body.dark .ocr-line-hit { background-color: #6b5210; }
    body.dark .ocr-text-head { color: #7c828a; }
    body.dark .ocr-sr-line { border-bottom-color: #3c424a; }
    body.dark .ocr-sr-line b { color: #f0a050; }
    body.dark .ocr-error { color: #f0a050; }
    /* 神器任务攻略 */
    #sqLinks { margin-top: 8px; }
    .sq-group {
        display: block; margin: 8px 0 2px 0; padding: 2px 10px; cursor: default;
        color: #ffffff; font-weight: bold; font-size: 13px;
        background-color: #4895ef;
        border: 2px solid; border-color: #7b43f5 #16181c #16181c #7b43f5;
    }
    body.dark .sq-group { background-color: #5ba8f5; }
    .sq-toggle {
        display: inline-block; margin-left: 10px; padding: 2px 12px; cursor: pointer;
        color: #ffffff; font-weight: bold; font-size: 12px;
        background-color: #4895ef;
        border: 2px solid; border-color: #7b43f5 #16181c #16181c #7b43f5;
    }
    body.dark .sq-toggle { background-color: #5ba8f5; }
    .sq-link {
        display: inline-block; margin: 3px 6px 3px 0; padding: 4px 12px; cursor: pointer;
        color: #ffffff; font-weight: bold; font-size: 13px;
        background-color: #7b43f5;
        border: 2px solid; border-color: #7b43f5 #4895ef #4895ef #7b43f5;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF4895EF');
    }
    body.dark .sq-link {
        background-color: #8b5cf6;
        border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    #sqOverlay {
        position: absolute; left: 0; top: 0; z-index: 900; display: none;
        background-color: #000000;
        filter: progid:DXImageTransform.Microsoft.Alpha(opacity=40);
    }
    body.dark #sqOverlay { filter: progid:DXImageTransform.Microsoft.Alpha(opacity=55); }
    #sqDialog {
        position: absolute; z-index: 901; display: none; padding: 10px;
        background-color: #e8eaee;
        border: 2px solid; border-color: #f8fafc #a2a8b2 #a2a8b2 #f8fafc;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#F2FFFFFF', endColorstr='#D8D8DCE4');
    }
    body.dark #sqDialog {
        background-color: #2b2f35;
        border-color: #4a5058 #0e1013 #0e1013 #4a5058;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C8333740', endColorstr='#B0252930');
    }
    .sq-dialog-head { margin-bottom: 8px; cursor: move; }
    #sqDialogTitle { font-weight: bold; font-size: 14px; color: #3d444d; margin-right: 8px; vertical-align: middle; }
    body.dark #sqDialogTitle { color: #aeb4bc; }
    .sq-dialog-btn {
        height: 28px; padding: 0 14px; margin-left: 8px; cursor: pointer; vertical-align: middle;
        font-size: 13px; font-weight: bold; color: #ffffff;
        background-color: #7b43f5;
        border: 2px solid; border-color: #7b43f5 #4895ef #4895ef #7b43f5;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF4895EF');
    }
    body.dark .sq-dialog-btn {
        background-color: #8b5cf6;
        border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    #sqFrame {
        background-color: #ffffff;
        border: 2px solid; border-color: #9aa2ac #ffffff #ffffff #9aa2ac;
    }
    /* 弹窗右下角拖拽手柄：鼠标拖动可自由调整弹窗大小 */
    .sq-resize-handle {
        position: absolute; right: 3px; bottom: 3px; width: 18px; height: 18px;
        cursor: se-resize; z-index: 940; overflow: hidden;
    }
    .sq-resize-handle span {
        position: absolute; right: 0; display: block; height: 3px;
        background-color: #7b43f5;
    }
    .sq-resize-handle .sq-rh-1 { bottom: 0; width: 16px; }
    .sq-resize-handle .sq-rh-2 { bottom: 6px; width: 10px; }
    .sq-resize-handle .sq-rh-3 { bottom: 12px; width: 4px; }
    body.dark .sq-resize-handle span { background-color: #8b5cf6; }
    /* 拖拽调整大小期间的透明遮罩：盖住 iframe，防止其吞掉鼠标移动事件 */
    #sqDragMask {
        position: absolute; left: 0; top: 0; width: 100%; height: 100%;
        z-index: 950; display: none; cursor: se-resize;
        background-color: #ffffff;
        filter: progid:DXImageTransform.Microsoft.Alpha(opacity=1);
    }
</style>
<script language="VBScript">
    ' ===================== 公共数值、单位与结构化数据 =====================
    Const GOLD_UNIT = 1000
    Const COIN_PER_WAN = 10000
    Const PET_CHAR_COUNT = 5
    Const PET_TASK_COUNT = 13
    Const XIU_FRUIT_EXP = 150
    Const XIU_HUNDRED_RING_EXP = 760
    Const XIU_PILL_EXP = 0.5
    Function Pad2(n)
        Pad2 = Right("0" & n, 2)
    End Function
    Function MakeRecord(keys, values)
        Dim record, i
        Set record = CreateObject("Scripting.Dictionary")
        For i = 0 To UBound(keys)
            record.Add keys(i), values(i)
        Next
        Set MakeRecord = record
    End Function
    Function TryNumber(value, ByRef number)
        TryNumber = False
        If IsNull(value) Or IsEmpty(value) Then Exit Function
        If Not IsNumeric(value) Then Exit Function
        On Error Resume Next
        Err.Clear
        number = CDbl(value)
        If Err.Number = 0 Then TryNumber = True
        Err.Clear
        On Error GoTo 0
    End Function
    Function ReadInputNumber(id, defaultValue, rule, maximum, message, ByRef number)
        Dim text, valid
        ReadInputNumber = False
        text = Trim(document.getElementById(id).value)
        If text = "" Then
            If Not IsNull(defaultValue) Then
                number = defaultValue
                ReadInputNumber = True
                Exit Function
            End If
        End If
        valid = TryNumber(text, number)
        If valid Then
            If rule = "positive" Then valid = (number > 0)
            If rule = "nonnegative" Or rule = "integer" Then valid = (number >= 0)
            If rule = "integer" Then valid = valid And (number = Fix(number))
            If maximum >= 0 Then valid = valid And (number <= maximum)
        End If
        If valid Then
            ReadInputNumber = True
        Else
            MsgBox message, vbExclamation, "输入错误"
            document.getElementById(id).focus
        End If
    End Function
    Function CoinToRmb(coin, gold)
        CoinToRmb = coin / GOLD_UNIT * gold
    End Function
    Function RmbToCoin(rmb, gold)
        RmbToCoin = rmb / gold * GOLD_UNIT
    End Function
    Function FmtAmount(value)
        If value = Fix(value) Then FmtAmount = FormatNumber(value, 0) Else FmtAmount = FormatNumber(value, 1)
    End Function
    ' 公共折叠：同步内容显示与提示文字，展开前的数据刷新由业务入口负责。
    Sub SetSectionVisible(sectionId, hintId, visible)
        If visible Then
            document.getElementById(sectionId).style.display = "block"
            document.getElementById(hintId).innerText = "▲ 收起"
        Else
            document.getElementById(sectionId).style.display = "none"
            document.getElementById(hintId).innerText = "▼ 展开"
        End If
    End Sub
    Sub ToggleSection(sectionId, hintId)
        SetSectionVisible sectionId, hintId, document.getElementById(sectionId).style.display = "none"
    End Sub
    ' ===================== 金价比例 =====================
    Sub CheckEnterGold
        If window.event.keyCode = 13 Then CalcGold
    End Sub
    Function GetGoldRatio()
        Dim value
        GetGoldRatio = 0
        If ReadInputNumber("txtGold", Null, "positive", -1, "请先在金价比例中输入大于0的有效数字！", value) Then GetGoldRatio = value
    End Function
    Sub CalcGold
        Dim dblGold, dblCoin, dblRmb
        dblGold = GetGoldRatio()
        If dblGold = 0 Then Exit Sub
        If Not ReadInputNumber("txtCoin", -1, "nonnegative", -1, "梦幻币必须为非负数字（不填默认不换算）！", dblCoin) Then Exit Sub
        If Not ReadInputNumber("txtRmb", -1, "nonnegative", -1, "人民币必须为非负数字（不填默认不换算）！", dblRmb) Then Exit Sub
        RenderGoldResult dblGold, dblCoin, dblRmb
    End Sub
    Sub RenderGoldResult(dblGold, dblCoin, dblRmb)
        Dim dblPerYuan, strHtml, strCls
        ' 换算基准：金价比例 g 元 / 1000万梦幻币（1千万 = 1000万），万↔千万因子为 1000
        dblPerYuan = RmbToCoin(1, dblGold)
        strHtml = "<table class=""xiu-table""><tr><th class=""x1"" width=""30%"">项目</th><th class=""x2"">结果</th></tr>"
        strHtml = strHtml & "<tr><td class=""xiu-item"">金价比例</td><td class=""xiu-val"">" & FormatNumber(dblGold, 2) & " 元 / 1000万梦幻币</td></tr>"
        strHtml = strHtml & "<tr class=""alt""><td class=""xiu-item"">基准换算</td><td class=""xiu-val"">1 元 = " & FormatNumber(dblPerYuan, 2) & " 万梦幻币，1 万梦幻币 = " & FormatNumber(CoinToRmb(1, dblGold), 4) & " 元</td></tr>"
        If dblCoin >= 0 Then
            strHtml = strHtml & "<tr><td class=""xiu-item"">梦幻币 → 人民币</td><td class=""xiu-val"">" & FormatNumber(dblCoin, 2) & " 万梦幻币 ≈ <b>" & FormatNumber(CoinToRmb(dblCoin, dblGold), 2) & "</b> 元</td></tr>"
        End If
        If dblRmb >= 0 Then
            If dblCoin >= 0 Then strCls = " class=""alt""" Else strCls = ""
            strHtml = strHtml & "<tr" & strCls & "><td class=""xiu-item"">人民币 → 梦幻币</td><td class=""xiu-val"">" & FormatNumber(dblRmb, 2) & " 元 ≈ <b>" & FormatNumber(RmbToCoin(dblRmb, dblGold), 2) & "</b> 万梦幻币</td></tr>"
        End If
        strHtml = strHtml & "</table>"
        document.getElementById("goldResult").innerHTML = strHtml
    End Sub
    ' ===================== 宝石成本 =====================
    ' 宝石成本多选合计：gemCosts(i) 为 i 级单个成本；gemPicked 记录选中等级；各等级个数填在 gemQty{等级} 输入框中（空=1个）
    ' gemResultOn：结果区展开状态（默认折叠，生成表格或点击切换时展开）
    ' gemKind：0=宝石（1~15级）1=精魄灵石（同样 2 个 N 级合 1 个 N+1 级，最高 10 级），下拉切换后表格行数、表头与提示文案一起变
    Dim gemSelectOn, gemResultOn, gemPicked, gemCosts(15), gemKind
    Set gemPicked = CreateObject("Scripting.Dictionary")
    gemSelectOn = False
    gemResultOn = False
    gemKind = 0
    Function GemKindName()
        If gemKind = 1 Then GemKindName = "精魄灵石" Else GemKindName = "宝石"
    End Function
    Function GemMaxLevel()
        If gemKind = 1 Then GemMaxLevel = 10 Else GemMaxLevel = 15
    End Function
    ' 规则说明跟着类型走，顺带写明各自算到几级
    Sub UpdateGemRuleTip
        If gemKind = 1 Then
            document.getElementById("gemRuleTip").innerText = "合成规则：2个N级精魄灵石 = 1个(N+1)级精魄灵石，合成到N级另收N万梦幻币（最高10级）"
        Else
            document.getElementById("gemRuleTip").innerText = "合成规则：2个N级宝石 = 1个(N+1)级宝石（最高15级）"
        End If
    End Sub
    ' 切换计算对象：两种物品等级上限不同（15 / 10 级），旧表格的行数和文案都不再对应，
    ' 因此先退出选择模式、丢掉已选金额，再按新类型重算；单价还没填或填错就清空，等用户重新输入
    Sub OnGemKindChange
        Dim objSel, dblPrice, strVal, bOk
        Set objSel = document.getElementById("selGemKind")
        If objSel.value = "1" Then gemKind = 1 Else gemKind = 0
        UpdateGemRuleTip
        If gemSelectOn Then ToggleGemSelect
        strVal = Trim(document.getElementById("txtPrice").value)
        bOk = False
        dblPrice = 0
        If strVal <> "" Then
            If TryNumber(strVal, dblPrice) Then
                If dblPrice > 0 Then bOk = True
            End If
        End If
        If bOk Then
            Calculate
        Else
            document.getElementById("resultArea").innerHTML = ""
            document.getElementById("gemSumResult").innerHTML = ""
            SetGemResultVisible False
        End If
    End Sub
    Sub CheckEnter
        If window.event.keyCode = 13 Then Calculate
    End Sub
    Function CalculateGemCost(level, price)
        Dim required, cumulative, fee, feeSum
        required = 2 ^ (level - 1)
        cumulative = 2 ^ level - 1
        ' 精魄灵石合成另收固定费，宝石为 0，口径统一成“万”
        fee = 0 : feeSum = 0
        If gemKind = 1 Then
            fee = GemMergeFee(level)
            feeSum = GemMergeFeeSum(level)
        End If
        Set CalculateGemCost = MakeRecord(Array("required", "cumulative", "fee", "cost", "total"), Array(required, cumulative, fee, required * price + fee, cumulative * price + feeSum))
    End Function
    ' 精魄灵石每合成一次另收固定费：合成到 N 级收 N 万梦幻币（2→1 收 2 万 … 10→9 收 10 万）。
    ' 得到 1 个 N 级要 2 个 N-1 级再加一次合成，所以合成费逐级翻倍累加：fee(N) = fee(N-1) * 2 + N 万，fee(1) = 0
    Function GemMergeFee(level)
        Dim k, fee
        fee = 0
        For k = 2 To level
            fee = fee * 2 + k
        Next
        GemMergeFee = fee
    End Function
    ' 1~N 级各留一个时累积的合成费（每级各自从 1 级合上去）：2 级 2 万、3 级 9 万、10 级 2994 万
    Function GemMergeFeeSum(level)
        Dim k, total
        total = 0
        For k = 2 To level
            total = total + GemMergeFee(k)
        Next
        GemMergeFeeSum = total
    End Function
    Sub Calculate
        Dim dblPrice, level, maxLv, rows(15)
        If Not ReadInputNumber("txtPrice", Null, "positive", -1, "请输入大于0的有效数字！", dblPrice) Then Exit Sub
        maxLv = GemMaxLevel()
        For level = 1 To maxLv
            Set rows(level) = CalculateGemCost(level, dblPrice)
        Next
        RenderGemCosts rows, maxLv
    End Sub
    Sub RenderGemCosts(rows, maxLv)
        Dim i, row, strKind, strTh, strFeeCell, lngNeed, lngCum, dblFee, dblCost, dblCumCost, strHtml, strCls
        strKind = GemKindName()
        ' 精魄灵石多一列合成消耗（万），成本列相应收窄；宝石没有这项开销，保持原五列
        If gemKind = 1 Then
            strTh = "<th class=""g1"" width=""9%"">等级</th><th class=""g2"" width=""15%"">需要1级" & strKind & "(个)</th><th class=""g3"" width=""15%"">累计1级" & strKind & "(个)</th><th class=""g4"" width=""14%"">合成消耗(万)</th><th class=""g5"" width=""23%"">单个成本(万)</th><th class=""g6"" width=""24%"">累计成本(万)</th>"
        Else
            strTh = "<th class=""g1"" width=""10%"">等级</th><th class=""g2"" width=""15%"">需要1级" & strKind & "(个)</th><th class=""g3"" width=""15%"">累计1级" & strKind & "(个)</th><th class=""g4"" width=""30%"">单个成本(万)</th><th class=""g5"" width=""30%"">累计成本(万)</th>"
        End If
        strHtml = "<table><tr>" & strTh & "</tr>"
        For i = 1 To maxLv
            Set row = rows(i)
            lngNeed = row("required")
            lngCum = row("cumulative")
            dblFee = row("fee")
            dblCost = row("cost")
            dblCumCost = row("total")
            gemCosts(i) = dblCost
            If i Mod 2 = 0 Then strCls = " class=""alt""" Else strCls = ""
            ' 合成费按整数万显示：它本身就是整万，带两位小数反而像估算值
            If gemKind = 1 Then strFeeCell = "<td>" & FormatNumber(dblFee, 0) & "</td>" Else strFeeCell = ""
            strHtml = strHtml & "<tr" & strCls & "><td class=""lv"">" & i & "级</td><td class=""num"">" & lngNeed & "</td><td class=""num"">" & lngCum & "</td>" & strFeeCell & "<td class=""cost"" onclick=""ToggleGemPick " & i & """>" & FormatNumber(dblCost, 2) & "</td><td>" & FormatNumber(dblCumCost, 2) & "</td></tr>"
        Next
        document.getElementById("resultArea").innerHTML = strHtml & "</table>"
        ' 表格重新生成后重置多选与合计结果，并自动展开结果区
        gemPicked.RemoveAll
        document.getElementById("gemSumResult").innerHTML = ""
        SetGemResultVisible True
    End Sub
    ' 设置宝石结果区显示状态（同步切换提示文本与状态变量）
    Sub SetGemResultVisible(bOn)
        gemResultOn = bOn
        SetSectionVisible "resultArea", "gemResultToggleHint", bOn
    End Sub
    ' 结果区默认折叠，点击标题行展开/收起（与神器攻略一致）
    Sub ToggleGemResult
        If Not gemResultOn Then
            If document.getElementById("resultArea").innerHTML = "" Then
                MsgBox "请先输入1级" & GemKindName() & "单价并点击“确认换算”生成表格！", vbExclamation, "提示"
                Exit Sub
            End If
            SetGemResultVisible True
        Else
            SetGemResultVisible False
        End If
    End Sub
    ' 进入/退出宝石成本多选模式
    Sub ToggleGemSelect
        If Not gemSelectOn Then
            If document.getElementById("resultArea").innerHTML = "" Then
                MsgBox "请先输入1级" & GemKindName() & "单价并点击“确认换算”生成表格！", vbExclamation, "提示"
                Exit Sub
            End If
            gemSelectOn = True
            SetGemResultVisible True
            document.getElementById("btnGemSelect").innerText = "退出选择"
            document.getElementById("resultArea").className = "pick"
            document.getElementById("gemSumResult").innerHTML = "选择模式：点击表格中“单个成本(万)”列的金额选中该等级，在出现的输入框中填写" & GemKindName() & "个数（不填默认1个），选好后点击“计算”按钮合计。"
        Else
            gemSelectOn = False
            document.getElementById("btnGemSelect").innerText = "选择"
            document.getElementById("resultArea").className = ""
            document.getElementById("gemSumResult").innerHTML = ""
        End If
    End Sub
    ' 点击“单个成本”单元格切换选中状态（仅选择模式下生效）；选中后单元格内出现个数输入框
    Sub ToggleGemPick(idx)
        Dim objSrc, objTd, objInputs
        If Not gemSelectOn Then Exit Sub
        If idx < 1 Or idx > 15 Then Exit Sub
        Set objSrc = window.event.srcElement
        ' 点击个数输入框内部时不改变选中状态
        If UCase(objSrc.tagName) = "INPUT" Then Exit Sub
        Set objTd = objSrc
        If gemPicked.Exists(idx) Then
            gemPicked.Remove idx
            objTd.className = "cost"
            objTd.innerHTML = FormatNumber(gemCosts(idx), 2)
        Else
            gemPicked(idx) = True
            objTd.className = "cost picked"
            objTd.innerHTML = FormatNumber(gemCosts(idx), 2) & " <input type=""text"" class=""gem-qty"" id=""gemQty" & idx & """ value="""" placeholder=""1"" title=""该等级" & GemKindName() & "个数，不填默认1个"" />"
            Set objInputs = objTd.getElementsByTagName("INPUT")
            If objInputs.length > 0 Then objInputs(0).focus
        End If
    End Sub
    ' 合计已选成本（个数取自各等级输入框，不填默认1）
    Sub CalcGemSum
        Dim k, dblSum, dblQty, objInp, strVal, strDetail
        If gemPicked.Count = 0 Then
            MsgBox "尚未选择任何" & GemKindName() & "成本！请先点击“选择”按钮进入选择模式，再点击表格中的金额多选。", vbExclamation, "提示"
            Exit Sub
        End If
        dblSum = 0
        strDetail = ""
        For Each k In gemPicked.Keys
            Set objInp = document.getElementById("gemQty" & k)
            strVal = ""
            If Not objInp Is Nothing Then strVal = Trim(objInp.value)
            If strVal = "" Then
                dblQty = 1
            Else
                dblQty = 0
                If TryNumber(strVal, dblQty) Then
                    If dblQty < 1 Or dblQty <> Fix(dblQty) Then dblQty = 0
                End If
                If dblQty = 0 Then
                    MsgBox "“" & k & "级”" & GemKindName() & "的个数须为大于等于1的整数（不填默认1）！", vbExclamation, "输入错误"
                    If Not objInp Is Nothing Then objInp.focus
                    Exit Sub
                End If
            End If
            dblSum = dblSum + gemCosts(k) * dblQty
            If strDetail <> "" Then strDetail = strDetail & "、"
            strDetail = strDetail & k & "级×" & dblQty
        Next
        document.getElementById("gemSumResult").innerHTML = "已选 <b>" & gemPicked.Count & "</b> 项（" & strDetail & "），合计（" & GemKindName() & "）：<b>" & FormatNumber(dblSum, 2) & "</b> 万梦幻币"
    End Sub
    ' ===================== 捉鬼省眼：按假坐标推真坐标大致方位 =====================
    ' 规律来自玩家经验总结（约 70% 准确），真坐标始终落在假坐标 ±50 内；坐标按小地图 X 向右、Y 向上增大。
    ' 判定优先级：地图特例 → 角落锁死（都 <50 / 都 >150）→ 贴边（X<50 / Y<50）→ 对角（X<Y 左上 / X>Y 右下）
    ' 地图 w/h 是游戏坐标上限（X 0~w、Y 0~h），底图按此比例缩放到面板宽度；尺寸与底图取自 175LG 捉鬼范围可视化
    Dim gGhostIds, gGhostNames, gGhostWs, gGhostHs
    Dim gGhostLastMap, gGhostLastX, gGhostLastY, gGhostLastHalf
    ' 最近一次“计算坐标区域”得到的搜索范围，坐标监控按它判断角色是否已进入范围
    Dim gGhostRx1, gGhostRx2, gGhostRy1, gGhostRy2, gGhostDirHalf, gGhostFakeX, gGhostFakeY, gGhostRangeOn
    gGhostIds = Split("jy,al,cs,zz,bx,xl,ne,pt,wz,jnyw,dtjw,hgs,d3,h1,qls,bj,tg,byd,wzs,nw", ",")
    gGhostNames = Split("建邺城,傲来国,长寿村,朱紫国,宝象国,西梁女国,女儿村,普陀山,五庄观,江南野外,大唐境外,花果山,地狱迷宫三层,海底迷宫一层,麒麟山,北俱芦洲,天宫,波月洞,碗子山,女娲神迹", ",")
    gGhostWs = Split("287,223,160,192,159,163,127,95,99,159,639,159,119,63,190,227,251,95,95,191", ",")
    gGhostHs = Split("143,150,209,119,119,123,143,71,74,119,118,119,89,47,142,169,167,143,190,142", ",")
    gGhostLastMap = ""
    gGhostRangeOn = False
    gGhostRx1 = 0 : gGhostRx2 = 0 : gGhostRy1 = 0 : gGhostRy2 = 0
    gGhostDirHalf = "" : gGhostFakeX = -1 : gGhostFakeY = -1
    Sub FillGhostMaps
        Dim objSel, objOpt, i
        Set objSel = document.getElementById("selGhostMap")
        objSel.innerHTML = ""
        For i = 0 To UBound(gGhostIds)
            Set objOpt = document.createElement("OPTION")
            objSel.options.Add objOpt
            objOpt.text = gGhostNames(i)
            objOpt.value = gGhostIds(i)
        Next
        If objSel.options.length > 0 Then objSel.selectedIndex = 0
    End Sub
    Function GhostMapIndex(strId)
        Dim i
        GhostMapIndex = 0
        For i = 0 To UBound(gGhostIds)
            If gGhostIds(i) = strId Then
                GhostMapIndex = i
                Exit Function
            End If
        Next
    End Function
    Function GhostPxX(gx, sc)
        GhostPxX = Int(gx * sc + 0.5)
    End Function
    Function GhostPxY(gy, mapH, sc)
        GhostPxY = Int((mapH - gy) * sc + 0.5)
    End Function
    ' 遮罩块：±50 窗口以外压暗（IE5 不支持 rgba，用纯色 + alpha 滤镜）
    Function GhostDimDiv(l, t, w, h)
        If w <= 0 Or h <= 0 Then
            GhostDimDiv = ""
        Else
            GhostDimDiv = "<div style=""position:absolute;left:" & l & "px;top:" & t & "px;width:" & w & "px;height:" & h & "px;background:#323232;filter:alpha(opacity=72);""></div>"
        End If
    End Function
    Sub GhostMapImgError
        On Error Resume Next
        document.getElementById("ghostMapImg").style.display = "none"
        document.getElementById("ghostMapNote").style.display = "block"
        On Error GoTo 0
    End Sub
    ' 地图可视化（参考 175LG）：整图压暗，只留假坐标 ±50 的窗口；窗口内按 half 画概率红块，橙点标假坐标
    Sub RenderGhostMap(strMap, dblX, dblY, strHalf)
        Dim objBox, objHint, idx, mapW, mapH, boxW, boxH, sc
        Dim gx1, gx2, gy1, gy2, wx1, wx2, wy1, wy2, cx, cy, dx, dy
        Dim qx1, qx2, qy1, qy2, strHtml, strRed
        Set objBox = document.getElementById("ghostMapBox")
        Set objHint = document.getElementById("ghostMapHint")
        gGhostLastMap = strMap
        gGhostLastX = dblX
        gGhostLastY = dblY
        gGhostLastHalf = strHalf
        idx = GhostMapIndex(strMap)
        mapW = CDbl(gGhostWs(idx))
        mapH = CDbl(gGhostHs(idx))
        ' 先显示容器再量宽，display:none 下 clientWidth 恒为 0
        objBox.style.display = "block"
        boxW = objBox.clientWidth
        If boxW < 60 Then
            objBox.style.display = "none"
            Exit Sub
        End If
        sc = boxW / mapW
        boxH = Int(mapH * sc + 0.5)
        If dblX > mapW Or dblY > mapH Then
            objHint.style.display = "block"
            objHint.innerHTML = "假坐标超出该场景范围（X 0~" & gGhostWs(idx) & "，Y 0~" & gGhostHs(idx) & "），图示已按边界显示。"
        Else
            objHint.style.display = "none"
        End If
        ' 坐标大幅超出地图时窗口宽高会算成负数（整图全暗、没有亮区），绘图前先把坐标钳到地图内
        dx = dblX : If dx < 0 Then dx = 0
        If dx > mapW Then dx = mapW
        dy = dblY : If dy < 0 Then dy = 0
        If dy > mapH Then dy = mapH
        gx1 = dx - 50 : If gx1 < 0 Then gx1 = 0
        gx2 = dx + 50 : If gx2 > mapW Then gx2 = mapW
        gy1 = dy - 50 : If gy1 < 0 Then gy1 = 0
        gy2 = dy + 50 : If gy2 > mapH Then gy2 = mapH
        wx1 = GhostPxX(gx1, sc)
        wx2 = GhostPxX(gx2, sc)
        wy1 = GhostPxY(gy2, mapH, sc)
        wy2 = GhostPxY(gy1, mapH, sc)
        strRed = ""
        If strHalf = "lu" Then
            qx1 = dx - 50 : qx2 = dx : qy1 = dy : qy2 = dy + 50
        ElseIf strHalf = "ru" Then
            qx1 = dx : qx2 = dx + 50 : qy1 = dy : qy2 = dy + 50
        ElseIf strHalf = "ld" Then
            qx1 = dx - 50 : qx2 = dx : qy1 = dy - 50 : qy2 = dy
        ElseIf strHalf = "rd" Then
            qx1 = dx : qx2 = dx + 50 : qy1 = dy - 50 : qy2 = dy
        Else
            qx1 = 0 : qx2 = 0 : qy1 = 0 : qy2 = 0
        End If
        If qx1 < 0 Then qx1 = 0
        If qy1 < 0 Then qy1 = 0
        If qx2 > mapW Then qx2 = mapW
        If qy2 > mapH Then qy2 = mapH
        If qx2 > qx1 And qy2 > qy1 Then
            strRed = "<div style=""position:absolute;left:" & GhostPxX(qx1, sc) & "px;top:" & GhostPxY(qy2, mapH, sc) & "px;width:" & (GhostPxX(qx2, sc) - GhostPxX(qx1, sc)) & "px;height:" & (GhostPxY(qy1, mapH, sc) - GhostPxY(qy2, mapH, sc)) & "px;background:#FF0000;filter:alpha(opacity=42);""></div>"
        End If
        cx = GhostPxX(dx, sc)
        cy = GhostPxY(dy, mapH, sc)
        strHtml = "<img id=""ghostMapImg"" src=""https://cdn.175lg.com/map/" & gGhostIds(idx) & ".png"" style=""display:block;width:" & boxW & "px;height:" & boxH & "px;"" onerror=""GhostMapImgError"">"
        strHtml = strHtml & GhostDimDiv(0, 0, boxW, wy1)
        strHtml = strHtml & GhostDimDiv(0, wy2, boxW, boxH - wy2)
        strHtml = strHtml & GhostDimDiv(0, wy1, wx1, wy2 - wy1)
        strHtml = strHtml & GhostDimDiv(wx2, wy1, boxW - wx2, wy2 - wy1)
        strHtml = strHtml & strRed
        strHtml = strHtml & "<div style=""position:absolute;left:" & wx1 & "px;top:" & wy1 & "px;width:" & (wx2 - wx1) & "px;height:" & (wy2 - wy1) & "px;border:2px solid #9aa0a6;""></div>"
        strHtml = strHtml & "<div style=""position:absolute;left:" & (cx - 4) & "px;top:" & (cy - 4) & "px;width:9px;height:9px;background:#FF5722;border:1px solid #ffffff;""></div>"
        strHtml = strHtml & "<div id=""ghostMapNote"" style=""position:absolute;left:0;top:6px;width:100%;text-align:center;color:#ffffff;font-size:12px;display:none;"">底图加载失败（需联网），按范围框找即可</div>"
        objBox.style.height = boxH & "px"
        objBox.innerHTML = strHtml
    End Sub
    ' 切换场景：坐标已填则按新地图重算，否则先收起图示
    Sub GhostMapRedraw
        If Trim(document.getElementById("txtGhostX").value) = "" Or Trim(document.getElementById("txtGhostY").value) = "" Then
            document.getElementById("ghostMapBox").style.display = "none"
            document.getElementById("ghostMapHint").style.display = "none"
            Exit Sub
        End If
        CalcGhost
    End Sub
    Sub CheckEnterGhost
        If window.event.keyCode = 13 Then CalcGhost
    End Sub
    Sub ToggleGhostSection
        ToggleSection "ghostSection", "ghostToggleHint"
        ' 折叠时容器宽为 0，展开后按上次参数重画地图
        If gGhostLastMap <> "" Then
            If document.getElementById("ghostSection").style.display <> "none" Then
                RenderGhostMap gGhostLastMap, gGhostLastX, gGhostLastY, gGhostLastHalf
            End If
        End If
        ' 展开时顺手刷新游戏窗口列表：多开时窗口经常开关，列表要跟得上
        If document.getElementById("ghostSection").style.display <> "none" Then GhostWinRefresh
    End Sub
    Sub ToggleGhostRule
        Dim el
        Set el = document.getElementById("ghostRuleSection")
        If el.innerHTML = "" Then el.innerHTML = GhostRuleHtml()
        ToggleSection "ghostRuleSection", "ghostRuleToggleHint"
    End Sub
    Function GhostRuleHtml()
        Dim h
        h = "<table><tr><th width=""45%"">假坐标情况</th><th>鬼大致位置</th></tr>"
        h = h & "<tr><td class=""lv"">X &lt; Y</td><td>左上角（约 70%）</td></tr>"
        h = h & "<tr class=""alt""><td class=""lv"">X &gt; Y</td><td>右下角（约 70%）</td></tr>"
        h = h & "<tr><td class=""lv"">X、Y 都 &lt; 50</td><td>左下角（真坐标也在 50 以下）</td></tr>"
        h = h & "<tr class=""alt""><td class=""lv"">X、Y 都 &gt; 150</td><td>右上角（真坐标也在 150 以上）</td></tr>"
        h = h & "<tr><td class=""lv"">X &lt; 50</td><td>左侧：X 只会更小，Y 上下都可能</td></tr>"
        h = h & "<tr class=""alt""><td class=""lv"">Y &lt; 50</td><td>下侧：纵向几乎不变，主要沿 X 左右找</td></tr>"
        h = h & "<tr><td class=""lv"">五庄观、普陀山</td><td>直接左下角，准确率很高</td></tr>"
        h = h & "<tr class=""alt""><td class=""lv"">长寿村、宝象国 且 X、Y 均在 50~150</td><td>房屋多绕路远，建议直接开眼</td></tr>"
        h = h & "<tr><td class=""lv"">通用范围</td><td>真坐标始终在假坐标 X、Y 各 ±50 以内</td></tr>"
        h = h & "<tr class=""alt""><td class=""lv"">地图读法</td><td>亮框=±50 范围；红块=概率最高的那一块；橙点=假坐标</td></tr>"
        GhostRuleHtml = h & "</table>"
    End Function
    Sub CalcGhost
        Dim strMap, dblX, dblY, x1, x2, y1, y2, strDir, strRate, strHalf, blnEye, strTips, strHtml
        strMap = document.getElementById("selGhostMap").value
        If Not ReadInputNumber("txtGhostX", Null, "nonnegative", -1, "请输入有效的假坐标 X（非负数字）！", dblX) Then Exit Sub
        If Not ReadInputNumber("txtGhostY", Null, "nonnegative", -1, "请输入有效的假坐标 Y（非负数字）！", dblY) Then Exit Sub
        x1 = dblX - 50 : x2 = dblX + 50 : y1 = dblY - 50 : y2 = dblY + 50
        If x1 < 0 Then x1 = 0
        If y1 < 0 Then y1 = 0
        strDir = "" : strRate = "" : strHalf = "" : blnEye = False : strTips = ""
        If strMap = "wz" Or strMap = "pt" Then
            strDir = "左下角" : strHalf = "ld" : strRate = "准确率很高"
            strTips = "★五庄观、普陀山的鬼基本都在假坐标左下角，不管假坐标在哪都先扫左下"
        ElseIf (strMap = "cs" Or strMap = "bx") And dblX > 50 And dblX < 150 And dblY > 50 And dblY < 150 Then
            blnEye = True
            strTips = "★长寿村/宝象国房屋多、绕路远，X、Y 又都在 50~150 之间，直接开眼往往更省时间"
            If dblX < dblY Then
                strDir = "左上角" : strHalf = "lu" : strRate = "约 70%"
            ElseIf dblX > dblY Then
                strDir = "右下角" : strHalf = "rd" : strRate = "约 70%"
            Else
                strDir = "左下角" : strHalf = "ld" : strRate = "X=Y 时优先左下"
            End If
        ElseIf dblX < 50 And dblY < 50 Then
            strDir = "左下角" : strHalf = "ld" : strRate = "经验规律"
            x1 = 0 : y1 = 0
            If x2 > 50 Then x2 = 50
            If y2 > 50 Then y2 = 50
            strTips = "★X、Y 都小于 50，真坐标只会出现在 50 以下，直接在左下角找"
        ElseIf dblX > 150 And dblY > 150 Then
            strDir = "右上角" : strHalf = "ru" : strRate = "经验规律"
            If x1 < 150 Then x1 = 150
            If y1 < 150 Then y1 = 150
            strTips = "★X、Y 都大于 150，真坐标只会出现在 150 以上，直接在右上角找"
        ElseIf dblX < 50 Then
            strDir = "左侧（优先左下）" : strHalf = "ld" : strRate = "经验规律"
            If x2 > dblX Then x2 = dblX
            strTips = "★X 小于 50：鬼只会出现在 X 更小的左侧，纵向上下都可能"
        ElseIf dblY < 50 Then
            strDir = "下侧（优先左下）" : strHalf = "ld" : strRate = "经验规律"
            strTips = "★Y 小于 50：纵向几乎不变，主要沿 X 轴左右找"
        ElseIf dblX < dblY Then
            strDir = "左上角" : strHalf = "lu" : strRate = "约 70%"
            strTips = "★X 小于 Y：鬼大概率在假坐标左上角<br>★若左上角是地图外或空地，改到左下角找"
        ElseIf dblX > dblY Then
            strDir = "右下角" : strHalf = "rd" : strRate = "约 70%"
            strTips = "★X 大于 Y：鬼大概率在假坐标右下角<br>★若右下角是地图外或空地，改到右上角或左下角找"
        Else
            strDir = "左下角" : strHalf = "ld" : strRate = "X=Y 时方向不明确"
            strTips = "★X 等于 Y 时规律不明确，先扫左下角，找不到再开眼"
        End If
        strHtml = "<table class=""xiu-table""><tr><th class=""x1"" width=""26%"">项目</th><th class=""x2"">结果</th></tr>"
        strHtml = strHtml & "<tr><td class=""xiu-item"">优先搜索</td><td class=""xiu-val""><b style=""font-size:15px;color:#7B43F5;"">" & strDir & "</b>（" & strRate & "）</td></tr>"
        strHtml = strHtml & "<tr class=""alt""><td class=""xiu-item"">搜索范围</td><td class=""xiu-val"">X " & Int(x1) & " ~ " & Int(x2) & " · Y " & Int(y1) & " ~ " & Int(y2) & "</td></tr>"
        strHtml = strHtml & "<tr><td class=""xiu-item"">搜索提示</td><td class=""xiu-val"">" & strTips & "</td></tr>"
        If blnEye Then
            strHtml = strHtml & "<tr class=""alt""><td class=""xiu-item"">是否开眼</td><td class=""xiu-val""><b style=""color:#c0392b;"">建议直接开眼</b>（绕路比找鬼慢）</td></tr>"
        Else
            strHtml = strHtml & "<tr class=""alt""><td class=""xiu-item"">是否开眼</td><td class=""xiu-val"">先按上面的方向找，找不到再开眼</td></tr>"
        End If
        strHtml = strHtml & "</table>"
        document.getElementById("ghostResult").innerHTML = strHtml
        ' 坐标监控按这次算出的范围比对；范围一变就得重启监控，否则提示会按旧范围报
        gGhostRx1 = Int(x1) : gGhostRx2 = Int(x2) : gGhostRy1 = Int(y1) : gGhostRy2 = Int(y2)
        gGhostDirHalf = strHalf : gGhostFakeX = Int(dblX) : gGhostFakeY = Int(dblY)
        gGhostRangeOn = True
        If gmOn Then GhostMonStopReason "搜索范围已更新，已停止监控，请重新点“坐标实时监控”"
        RenderGhostMap strMap, dblX, dblY, strHalf
    End Sub
    ' ===================== 捉鬼坐标实时监控（OCR 识别 + 游戏窗口浮层提示） =====================
    ' 桌面端专用：调 ocr\ghost_monitor.ps1 截取坐标区域 → Windows 内置 OCR → 与当前搜索范围比对，
    ' 还没进范围时在游戏窗口顶部贴一条方向提示（透明置顶、鼠标穿透、不抢游戏焦点）。
    ' 区域配置单独写 ocr\ghost_config.txt，避免覆盖答题识别用的 ocr_config.txt。
    Dim gmOn, gmStopping, gmOutFile, gmStopFile, gmPidFile, gmRegionFile
    Dim gmLastEof, gmMiss, gmStopWait, gmRegionWait
    Dim gmRx, gmRy, gmRw, gmRh
    ' 多开：按标题里的角色 ID 锁定一个客户端（列表与选点见 GhostWinRefresh / GhostWinPick）
    Dim gmPin, gmPinLabel, gvOutFile, gvTry, gvBusy, gvFilling
    ' 自动读任务栏用的一次性结果文件与轮询计数
    Dim gqOutFile, gqTry
    Const GM_POLL_MS = 700
    Const GM_INTERVAL_MS = 900
    gmOn = False
    gmStopping = False
    gmOutFile = ""
    gmStopFile = ""
    gmPidFile = ""
    gmRegionFile = ""
    gmLastEof = ""
    gmMiss = 0
    gmStopWait = 0
    gmRegionWait = 0
    gmRx = -1 : gmRy = -1 : gmRw = 0 : gmRh = 0
    gmPin = "" : gmPinLabel = "" : gvOutFile = "" : gvTry = 0 : gvBusy = False : gvFilling = False
    Function GhostMonCfgFile
        GhostMonCfgFile = OcrDataDir() & "\ghost_config.txt"
    End Function
    Function GhostMonPs1
        GhostMonPs1 = OcrRoot() & "\ocr\ghost_monitor.ps1"
    End Function
    Sub GhostMonLoadConfig
        Dim fso, f, strLine, arrPart, arrSeg, strPrevPin, strPrevLabel
        gmRx = -1 : gmRy = -1 : gmRw = 0 : gmRh = 0
        strPrevPin = gmPin : strPrevLabel = gmPinLabel
        gmPin = "" : gmPinLabel = ""
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        If fso.FileExists(GhostMonCfgFile()) Then
            Set f = fso.OpenTextFile(GhostMonCfgFile(), 1)
            Do Until f.AtEndOfStream
                strLine = f.ReadLine
                arrPart = Split(strLine, "=")
                If UBound(arrPart) = 1 Then
                    If arrPart(0) = "pin" Then gmPin = arrPart(1)
                    If arrPart(0) = "region" Then
                        arrSeg = Split(arrPart(1), ",")
                        If UBound(arrSeg) = 3 Then
                            gmRx = CLng(arrSeg(0))
                            gmRy = CLng(arrSeg(1))
                            gmRw = CLng(arrSeg(2))
                            gmRh = CLng(arrSeg(3))
                        End If
                    End If
                End If
            Loop
            f.Close
        End If
        ' 同一个号再读一次时保留显示名（列表刷新过才有），免得状态行从“神丶荼[13504321]”退回“角色 13504321”
        If gmPin = strPrevPin Then gmPinLabel = strPrevLabel
        Err.Clear
        On Error GoTo 0
    End Sub
    Sub GhostMonSaveConfig
        Dim fso, f
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        ' 配置进了 data 子目录，首次保存时目录可能还不存在
        OcrEnsureData
        Set f = fso.CreateTextFile(GhostMonCfgFile(), True)
        If Err.Number = 0 Then
            If ocrProcName <> "" Then f.WriteLine "proc=" & ocrProcName
            ' 锁定的窗口和区域一起存，下次开工具箱还是同一个号（游戏重开后找不到会提示“没找到”）
            If gmPin <> "" Then f.WriteLine "pin=" & gmPin
            f.WriteLine "region=" & gmRx & "," & gmRy & "," & gmRw & "," & gmRh
        End If
        Err.Clear
        If Not f Is Nothing Then f.Close
        On Error GoTo 0
    End Sub
    ' 多开：列出所有游戏窗口给下拉框选。锁定键用标题里的角色 ID（… - 神丶荼[13504321]），
    ' 不用窗口句柄——句柄在切标签时不变，区分不开同一个客户端里的两个号；客户端重开时又会变。
    Sub GhostWinRefresh
        Dim fso, objShell, strPs1, strTmp, strCmd
        ' 连着点“刷新窗口”时不重叠启进程：两轮共用一个结果文件会互相删文件
        If gvBusy Then Exit Sub
        Set fso = CreateObject("Scripting.FileSystemObject")
        strPs1 = GhostMonPs1()
        If Not fso.FileExists(strPs1) Then Exit Sub
        Set objShell = CreateObject("WScript.Shell")
        strTmp = objShell.ExpandEnvironmentStrings("%TEMP%")
        gvOutFile = fso.BuildPath(strTmp, "gadget_ghost_windows.txt")
        On Error Resume Next
        If fso.FileExists(gvOutFile) Then fso.DeleteFile gvOutFile, True
        On Error GoTo 0
        strCmd = PsCmdFile(strPs1, False)
        strCmd = strCmd & " -ListWindows -OutFile " & ocrQuote & gvOutFile & ocrQuote
        objShell.Run strCmd, 0, False
        gvTry = 0
        gvBusy = True
        window.setTimeout "GhostWinPoll", 500
    End Sub
    ' 脚本最多 0.5s 体面起完 PowerShell，再叠一次枚举耗时，这里给 6s 余量
    Sub GhostWinPoll
        Dim fso, strText
        gvTry = gvTry + 1
        Set fso = CreateObject("Scripting.FileSystemObject")
        If fso.FileExists(gvOutFile) Then
            strText = OcrReadText(gvOutFile, "utf-8")
            If InStr(strText, "EOF") > 0 Then
                gvBusy = False
                GhostWinFill strText
                Exit Sub
            End If
        End If
        If gvTry >= 15 Then
            gvBusy = False
            GhostMonSetStatus "没取到游戏窗口列表，稍后再点一次“刷新窗口”（反复失败多半是安全软件拦了 PowerShell，见 README）", "tip"
            Exit Sub
        End If
        window.setTimeout "GhostWinPoll", 400
    End Sub
    ' WIN 行：ID \t 简称 \t 尺寸 \t 状态；ID 取不到（标题不带 [角色ID]）的窗口不列
    Sub GhostWinFill(strRaw)
        Dim objSel, objOpt, arrLines, strLine, arrPart, strKey, strTxt, blnFound
        Set objSel = document.getElementById("selGameWin")
        If objSel Is Nothing Then Exit Sub
        ' 重建选项时 IE 可能连带触发 onchange，置位挡住 GhostWinPick，否则会把半成品选项当成选定
        gvFilling = True
        Do While objSel.options.length > 0
            objSel.remove 0
        Loop
        Set objOpt = document.createElement("OPTION")
        objOpt.text = "自动（面积最大的游戏窗口）"
        objOpt.value = ""
        objSel.options.Add objOpt
        blnFound = (gmPin = "")
        arrLines = Split(Replace(strRaw, vbCr, ""), vbLf)
        For Each strLine In arrLines
            arrPart = Split(strLine, vbTab)
            If UBound(arrPart) >= 4 Then
                If arrPart(0) = "WIN" Then
                    strKey = arrPart(1)
                    If strKey <> "" Then
                        strTxt = arrPart(2) & " · " & arrPart(3)
                        If arrPart(4) = "min" Then strTxt = strTxt & "（已最小化）"
                        Set objOpt = document.createElement("OPTION")
                        objOpt.text = strTxt
                        objOpt.value = strKey
                        objSel.options.Add objOpt
                        If strKey = gmPin Then
                            gmPinLabel = arrPart(2)
                            objSel.selectedIndex = objSel.options.length - 1
                            blnFound = True
                        End If
                    End If
                End If
            End If
        Next
        ' 锁定的号没开（已关闭 / 未登录）：这一项照样留着，否则看不出现在锁的是谁
        If Not blnFound Then
            Set objOpt = document.createElement("OPTION")
            objOpt.text = GhostPinText() & "（未在运行）"
            objOpt.value = gmPin
            objSel.options.Add objOpt
            objSel.selectedIndex = objSel.options.length - 1
        End If
        gvFilling = False
    End Sub
    ' 选中即锁定：写进 ghost_config.txt；正在监控时按新窗口重启（旧范围属于旧的号）
    Sub GhostWinPick
        Dim objSel, strVal, strTxt, n
        If gvFilling Then Exit Sub
        Set objSel = document.getElementById("selGameWin")
        If objSel Is Nothing Then Exit Sub
        If objSel.selectedIndex < 0 Then Exit Sub
        strVal = objSel.options(objSel.selectedIndex).value
        strTxt = objSel.options(objSel.selectedIndex).text
        gmPin = strVal
        n = InStr(strTxt, " · ")
        If n > 0 Then
            gmPinLabel = Left(strTxt, n - 1)
        Else
            gmPinLabel = strTxt
        End If
        If gmPin = "" Then gmPinLabel = ""
        GhostMonSaveConfig
        If gmOn Then
            GhostMonStopReason "已锁定窗口：" & GhostPinText() & "，按新窗口重新识别…"
            GhostMonStart
        Else
            GhostMonRefreshStatus
        End If
    End Sub
    Function GhostPinText
        If gmPinLabel <> "" Then
            GhostPinText = gmPinLabel
        ElseIf gmPin <> "" Then
            GhostPinText = "角色 " & gmPin
        Else
            GhostPinText = "自动"
        End If
    End Function
    ' 方向 key → 文案（与 ghost_texts.txt 保持一致，脚本画在游戏窗口上的也是这几句）
    Function GhostDirText(strKey)
        Select Case strKey
            Case "dir_left" : GhostDirText = "往左走"
            Case "dir_right" : GhostDirText = "往右走"
            Case "dir_up" : GhostDirText = "往上走"
            Case "dir_down" : GhostDirText = "往下走"
            Case "dir_lu" : GhostDirText = "往左上走"
            Case "dir_ru" : GhostDirText = "往右上走"
            Case "dir_ld" : GhostDirText = "往左下走"
            Case "dir_rd" : GhostDirText = "往右下走"
            Case Else : GhostDirText = ""
        End Select
    End Function
    Function GhostQuadText(strHalf)
        Select Case strHalf
            Case "lu" : GhostQuadText = "左上角"
            Case "ru" : GhostQuadText = "右上角"
            Case "ld" : GhostQuadText = "左下角"
            Case "rd" : GhostQuadText = "右下角"
            Case Else : GhostQuadText = ""
        End Select
    End Function
    Sub GhostMonSetStatus(strText, strCls)
        Dim el
        On Error Resume Next
        Set el = document.getElementById("ghostMonStatus")
        If el Is Nothing Then Exit Sub
        el.innerText = strText
        el.className = strCls
        On Error GoTo 0
    End Sub
    Sub GhostMonRefreshBtn
        Dim btn
        On Error Resume Next
        Set btn = document.getElementById("btnGhostMon")
        If btn Is Nothing Then Exit Sub
        If gmOn Then
            btn.innerText = "■ 停止监控"
            btn.className = "pet-hist-delete"
        Else
            btn.innerText = "▶ 坐标实时监控"
            btn.className = ""
        End If
        btn.disabled = False
        On Error GoTo 0
    End Sub
    ' 未运行时的状态行：默认自动取左上角，只有手动微调过才显示自定义尺寸
    Sub GhostMonRefreshStatus
        Dim strInfo
        If gmOn Then Exit Sub
        If gmPin <> "" Then
            strInfo = "未开启 · 已锁定窗口：" & GhostPinText()
            If gmRw > 0 And gmRh > 0 Then strInfo = strInfo & " · 自定义区域 " & gmRw & "×" & gmRh
        ElseIf gmRw > 0 And gmRh > 0 Then
            strInfo = "未开启 · 自定义区域 " & gmRw & "×" & gmRh & "（可点“微调坐标区域”恢复自动）"
        Else
            strInfo = "未开启 · 自动读取窗口左上角坐标"
        End If
        GhostMonSetStatus strInfo, "tip"
    End Sub
    Sub GhostMonToggle
        If gmStopping Then Exit Sub
        If gmOn Then
            GhostMonStop
        Else
            GhostQuestThenStart
        End If
    End Sub
    ' 点“坐标实时监控”时先让脚本读一次游戏右侧任务栏：读到捉鬼任务就自动选场景、回填假坐标并算范围，
    ' 读不到再退回旧逻辑（已有范围就直接监控，没范围才提示手动填），不影响原来的用法。
    Sub GhostQuestThenStart
        Dim fso, objShell, strPs1, strTmp, strCmd
        If gmOn Or gmStopping Then Exit Sub
        Set fso = CreateObject("Scripting.FileSystemObject")
        strPs1 = GhostMonPs1()
        If Not fso.FileExists(strPs1) Then
            GhostMonStart
            Exit Sub
        End If
        Set objShell = CreateObject("WScript.Shell")
        GhostMonLoadConfig
        strTmp = objShell.ExpandEnvironmentStrings("%TEMP%")
        gqOutFile = fso.BuildPath(strTmp, "gadget_ghost_quest.txt")
        ' 先删旧结果，否则可能把上一次读到的任务当成这一次的
        On Error Resume Next
        If fso.FileExists(gqOutFile) Then fso.DeleteFile gqOutFile, True
        On Error GoTo 0
        strCmd = PsCmdFile(strPs1, False)
        strCmd = strCmd & " -ReadQuest -QuestTimeout 2500"
        strCmd = strCmd & " -OutFile " & ocrQuote & gqOutFile & ocrQuote
        If fso.FileExists(OcrRoot() & "\ocr\ghost_texts.txt") Then strCmd = strCmd & " -TextFile " & ocrQuote & OcrRoot() & "\ocr\ghost_texts.txt" & ocrQuote
        If fso.FileExists(GhostMonCfgFile()) Then strCmd = strCmd & " -ConfigFile " & ocrQuote & GhostMonCfgFile() & ocrQuote
        If gmPin <> "" Then strCmd = strCmd & " -PinId " & ocrQuote & gmPin & ocrQuote
        objShell.Run strCmd, 0, False
        gqTry = 0
        GhostMonSetStatus "正在读取游戏右侧任务栏（捉鬼 / 鬼王）…", "tip"
        window.setTimeout "GhostQuestPoll", 500
    End Sub
    ' 每 400ms 看一次结果文件；脚本自己最多读 2.5 秒，再叠上一次 OCR 耗时，这里给 6.1 秒余量
    Sub GhostQuestPoll
        Dim fso, strText
        gqTry = gqTry + 1
        Set fso = CreateObject("Scripting.FileSystemObject")
        If fso.FileExists(gqOutFile) Then
            strText = OcrReadText(gqOutFile, "utf-8")
            If InStr(strText, "EOF") > 0 Then
                GhostQuestApply strText
                Exit Sub
            End If
        End If
        If gqTry >= 15 Then
            GhostQuestFallback
            Exit Sub
        End If
        window.setTimeout "GhostQuestPoll", 400
    End Sub
    ' 解析任务结果：quest=1 就回填场景与假坐标，调 CalcGhost 算搜索范围，然后照常启动监控。
    ' 捉鬼和鬼王同时挂在任务栏里时脚本返回 status=choose，这里先弹框让用户确认按哪个走。
    Sub GhostQuestApply(strRaw)
        Dim d, arrLines, strLine, arrPart, strStatus, strQuest, strTask, strScene, strFx, strFy, lx, ly
        Set d = CreateObject("Scripting.Dictionary")
        arrLines = Split(Replace(strRaw, vbCr, ""), vbLf)
        For Each strLine In arrLines
            arrPart = Split(strLine, vbTab)
            If UBound(arrPart) >= 2 Then
                If arrPart(0) = "META" Then d(arrPart(1)) = arrPart(2)
            End If
        Next
        strStatus = ""
        If d.Exists("status") Then strStatus = d("status")
        If strStatus = "choose" Then
            GhostQuestAsk d
            Exit Sub
        End If
        strQuest = "0"
        If d.Exists("quest") Then strQuest = d("quest")
        strTask = "ghost"
        If d.Exists("task") Then strTask = d("task")
        strScene = ""
        If d.Exists("scene") Then strScene = d("scene")
        strFx = "-1"
        If d.Exists("fakex") Then strFx = d("fakex")
        strFy = "-1"
        If d.Exists("fakey") Then strFy = d("fakey")
        If strQuest <> "1" Or strScene = "" Or Not IsNumeric(strFx) Or Not IsNumeric(strFy) Then
            GhostQuestFallback
            Exit Sub
        End If
        lx = CLng(strFx)
        ly = CLng(strFy)
        If lx < 0 Or ly < 0 Then
            GhostQuestFallback
            Exit Sub
        End If
        GhostQuestFill strScene, lx, ly, GhostTaskName(strTask)
    End Sub
    ' 两个任务都在：把两边的场景和坐标都摆出来，用“是 / 否”点一个，“取消”先不管
    Sub GhostQuestAsk(d)
        Dim strO1, strO2, a1, a2, strMsg, nRet
        strO1 = "" : strO2 = ""
        If d.Exists("opt1") Then strO1 = d("opt1")
        If d.Exists("opt2") Then strO2 = d("opt2")
        If strO1 = "" Or strO2 = "" Then
            GhostQuestFallback
            Exit Sub
        End If
        a1 = Split(strO1, "|")
        a2 = Split(strO2, "|")
        If UBound(a1) < 3 Or UBound(a2) < 3 Then
            GhostQuestFallback
            Exit Sub
        End If
        If Not IsNumeric(a1(2)) Or Not IsNumeric(a1(3)) Or Not IsNumeric(a2(2)) Or Not IsNumeric(a2(3)) Then
            GhostQuestFallback
            Exit Sub
        End If
        strMsg = "右侧任务栏里同时有捉鬼和鬼王两个任务，请确认这次按哪个找：" & vbCrLf & vbCrLf & _
            "【是】按" & GhostTaskName(a1(0)) & "任务：" & GhostMapName(a1(1)) & " " & a1(2) & "," & a1(3) & vbCrLf & _
            "【否】按" & GhostTaskName(a2(0)) & "任务：" & GhostMapName(a2(1)) & " " & a2(2) & "," & a2(3) & vbCrLf & vbCrLf & _
            "【取消】先不启动监控，自己填坐标。"
        nRet = MsgBox(strMsg, vbYesNoCancel + vbQuestion, "选择要追踪的任务")
        If nRet = vbYes Then
            GhostQuestFill a1(1), CLng(a1(2)), CLng(a1(3)), GhostTaskName(a1(0))
        ElseIf nRet = vbNo Then
            GhostQuestFill a2(1), CLng(a2(2)), CLng(a2(3)), GhostTaskName(a2(0))
        Else
            GhostMonRefreshStatus
        End If
    End Sub
    ' 脚本只回传 kind 代号（ghost / king），中文名叫法在这里定
    Function GhostTaskName(strKind)
        If strKind = "king" Then
            GhostTaskName = "鬼王"
        Else
            GhostTaskName = "捉鬼"
        End If
    End Function
    Function GhostMapName(strId)
        GhostMapName = gGhostNames(GhostMapIndex(strId))
    End Function
    ' 回填场景与假坐标 → 算范围 → 启动监控（自动读任务与手动选择共用这一段）
    Sub GhostQuestFill(strScene, lx, ly, strLabel)
        Dim idx
        idx = GhostMapIndex(strScene)
        document.getElementById("selGhostMap").selectedIndex = idx
        document.getElementById("txtGhostX").value = lx
        document.getElementById("txtGhostY").value = ly
        CalcGhost
        GhostMonSetStatus "已按" & strLabel & "任务填入 " & gGhostNames(idx) & " " & lx & "," & ly, "ghost-mon-in"
        GhostMonStart
    End Sub
    ' 读不到任务时的退路：有范围就照常监控（不打扰），没范围才提示手动填
    Sub GhostQuestFallback
        If gGhostRangeOn Then
            GhostMonStart
            Exit Sub
        End If
        GhostMonRefreshStatus
        MsgBox "没读到捉鬼或鬼王任务（右侧任务栏里没有这类任务，或任务彩字太模糊）。" & vbCrLf & vbCrLf & _
            "请先在游戏里接到捉鬼 / 鬼王任务，或手动填假坐标后点“计算坐标区域”，再点“坐标实时监控”。" & vbCrLf & vbCrLf & _
            "如果一直是这个提示，也可能是安全软件拦了后台脚本，详见 README 的“被安全软件拦住怎么办”。", vbExclamation, "需要搜索范围"
    End Sub
    Sub GhostMonStart
        Dim fso, objShell, strPs1, strTmp, strCmd
        If gmOn Or gmStopping Then Exit Sub
        If Not gGhostRangeOn Then
            MsgBox "请先填假坐标并点“计算坐标区域”，监控用那次算出的搜索范围判断角色是否进圈。", vbExclamation, "还没有搜索范围"
            Exit Sub
        End If
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set objShell = CreateObject("WScript.Shell")
        strPs1 = GhostMonPs1()
        If Not fso.FileExists(strPs1) Then
            MsgBox "找不到监控脚本：" & vbCrLf & strPs1 & vbCrLf & vbCrLf & "请确认工具箱目录下的 ocr 文件夹里存在 ghost_monitor.ps1 与 ghost_texts.txt。", vbExclamation, "缺少文件"
            Exit Sub
        End If
        GhostMonLoadConfig
        strTmp = objShell.ExpandEnvironmentStrings("%TEMP%")
        gmOutFile = fso.BuildPath(strTmp, "gadget_ghost_monitor.txt")
        gmStopFile = fso.BuildPath(strTmp, "gadget_ghost_stop.txt")
        gmPidFile = fso.BuildPath(strTmp, "gadget_ghost_pid.txt")
        ' 幂等收尾：上一轮异常退出时 PID 文件还在，先按老 PID 终止再重新起
        GhostMonKill
        On Error Resume Next
        If fso.FileExists(gmOutFile) Then fso.DeleteFile gmOutFile, True
        On Error GoTo 0
        strCmd = PsCmdFile(strPs1, False)
        strCmd = strCmd & " -X1 " & gGhostRx1 & " -X2 " & gGhostRx2 & " -Y1 " & gGhostRy1 & " -Y2 " & gGhostRy2
        strCmd = strCmd & " -FakeX " & gGhostFakeX & " -FakeY " & gGhostFakeY & " -Half " & gGhostDirHalf
        strCmd = strCmd & " -Interval " & GM_INTERVAL_MS
        strCmd = strCmd & " -OutFile " & ocrQuote & gmOutFile & ocrQuote
        strCmd = strCmd & " -StopFile " & ocrQuote & gmStopFile & ocrQuote & " -PidFile " & ocrQuote & gmPidFile & ocrQuote
        If fso.FileExists(OcrRoot() & "\ocr\ghost_texts.txt") Then strCmd = strCmd & " -TextFile " & ocrQuote & OcrRoot() & "\ocr\ghost_texts.txt" & ocrQuote
        If fso.FileExists(GhostMonCfgFile()) Then strCmd = strCmd & " -ConfigFile " & ocrQuote & GhostMonCfgFile() & ocrQuote
        If gmRw > 0 Then strCmd = strCmd & " -RelX " & gmRx & " -RelY " & gmRy & " -RelW " & gmRw & " -RelH " & gmRh
        If gmPin <> "" Then strCmd = strCmd & " -PinId " & ocrQuote & gmPin & ocrQuote
        objShell.Run strCmd, 0, False
        gmOn = True
        gmLastEof = ""
        gmMiss = 0
        GhostMonRefreshBtn
        If gmRw > 0 Then
            GhostMonSetStatus "正在启动…切到游戏窗口后自动读取自定义区域", "tip"
        Else
            GhostMonSetStatus "正在启动…切到游戏窗口后自动读取左上角坐标", "tip"
        End If
        window.setTimeout "GhostMonPoll", 900
    End Sub
    ' 每 700ms 读一次结果文件；EOF 时间戳变了说明脚本又跑完一轮
    Sub GhostMonPoll
        Dim fso, strText, strEof
        If Not gmOn Then Exit Sub
        Set fso = CreateObject("Scripting.FileSystemObject")
        strText = ""
        strEof = ""
        If fso.FileExists(gmOutFile) Then
            strText = OcrReadText(gmOutFile, "utf-8")
            strEof = OcrEofTicks(strText)
        End If
        If strEof <> "" And strEof <> gmLastEof Then
            gmLastEof = strEof
            gmMiss = 0
            GhostMonApply strText
        Else
            gmMiss = gmMiss + 1
        End If
        If gmMiss = 14 Then GhostMonSetStatus "监控脚本无响应，稍候…", "tip"
        If gmMiss >= 45 Then
            gmOn = False
            GhostMonRefreshBtn
            GhostMonSetStatus "监控已中断（后台脚本无响应），请重新点“坐标实时监控”；反复出现多为安全软件拦截了 PowerShell（见 README）", "ghost-mon-out"
            Exit Sub
        End If
        window.setTimeout "GhostMonPoll", GM_POLL_MS
    End Sub
    ' 解析结果文件（META 键值行），把脚本算好的结论转成工具箱里的状态行
    Sub GhostMonApply(strRaw)
        Dim d, arrLines, strLine, arrPart, strCode, strCoord, strIn, strDir, strDist, strErr, strCap
        Dim strText, strCls
        Set d = CreateObject("Scripting.Dictionary")
        arrLines = Split(Replace(strRaw, vbCr, ""), vbLf)
        For Each strLine In arrLines
            arrPart = Split(strLine, vbTab)
            If UBound(arrPart) >= 2 Then
                If arrPart(0) = "META" Then d(arrPart(1)) = arrPart(2)
            End If
        Next
        strCode = ""
        If d.Exists("status") Then strCode = d("status")
        strCoord = ""
        If d.Exists("coord") Then strCoord = d("coord")
        strIn = "0"
        If d.Exists("inrange") Then strIn = d("inrange")
        strDir = ""
        If d.Exists("dir") Then strDir = d("dir")
        strDist = "0"
        If d.Exists("dist") Then strDist = d("dist")
        ' 脚本报的抓取方式：window = 读窗口自身画面（被遮挡也能读），screen = 兜底抓屏（需要窗口在前台）
        strCap = ""
        If d.Exists("cap") Then strCap = d("cap")
        If strCode = "ok" Then
            If strIn = "1" Then
                strText = "✓ 已在搜索范围 (" & strCoord & ")"
                If gGhostDirHalf <> "" Then strText = strText & "，找" & GhostQuadText(gGhostDirHalf)
                strCls = "ghost-mon-in"
            Else
                strText = "⚠ 超出范围 (" & strCoord & ") " & GhostDirText(strDir) & " 还差" & strDist & "格"
                strCls = "ghost-mon-out"
            End If
            If strCap = "window" Then strText = strText & " · 窗口被遮挡也能读"
        ElseIf strCode = "no_coord" Then
            strText = "没识别到坐标，稍候自动重试（一直失败可点“微调坐标区域”；也可能是安全软件拦了 PowerShell）"
            strCls = "tip"
        ElseIf strCode = "no_window" Then
            strText = "没找到游戏窗口（打开游戏后自动开始）"
            strCls = "tip"
        ElseIf strCode = "minimized" Then
            strText = "游戏窗口已最小化"
            strCls = "tip"
        ElseIf strCode = "not_foreground" Then
            strText = "切回游戏窗口后自动识别"
            strCls = "tip"
        ElseIf strCode = "pin_lost" Then
            strText = "没找到锁定的角色窗口（切到了别的标签页或已关闭），切回后自动继续；也可点“刷新窗口”重选"
            strCls = "tip"
        ElseIf strCode = "pin_hidden" Then
            strText = "锁定的窗口不在前台，切回该窗口后再读（取不到窗口画面、退回抓屏幕时才会这样提示）"
            strCls = "tip"
        Else
            strErr = ""
            If d.Exists("error") Then strErr = d("error")
            strText = "监控出错：" & strErr
            strCls = "ghost-mon-out"
        End If
        GhostMonSetStatus strText, strCls
    End Sub
    ' 停止：先落停止文件让脚本跑完当前一轮后自行退出，5s 内没退再按 PID 终止
    Sub GhostMonStop
        Dim fso, f
        If Not gmOn Then Exit Sub
        gmOn = False
        gmStopping = True
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        Set f = fso.CreateTextFile(gmStopFile, True)
        If Err.Number = 0 Then f.Close
        Err.Clear
        On Error GoTo 0
        GhostMonRefreshBtn
        GhostMonSetStatus "正在停止…", "tip"
        gmStopWait = 0
        window.setTimeout "GhostMonStopCheck", 500
    End Sub
    Sub GhostMonStopCheck
        gmStopWait = gmStopWait + 1
        If GhostMonAlive() And gmStopWait < 10 Then
            window.setTimeout "GhostMonStopCheck", 500
            Exit Sub
        End If
        GhostMonKill
        gmStopping = False
        GhostMonRefreshBtn
        GhostMonRefreshStatus
    End Sub
    ' 参数变了（比如重新算了方向）就停掉，免得按旧范围误报
    Sub GhostMonStopReason(strWhy)
        If Not gmOn Then Exit Sub
        gmOn = False
        gmStopping = False
        GhostMonStopHelper
        GhostMonRefreshBtn
        GhostMonSetStatus strWhy, "tip"
    End Sub
    Sub GhostMonStopHelper
        Dim fso, f
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        Set f = fso.CreateTextFile(gmStopFile, True)
        If Err.Number = 0 Then f.Close
        Err.Clear
        On Error GoTo 0
        ' 给脚本 400ms 自行退出，随后按 PID 兜底（不阻塞 UI：直接杀进程也可接受）
        GhostMonKill
    End Sub
    Function GhostMonAlive()
        Dim fso, strPid
        GhostMonAlive = False
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        If fso.FileExists(gmPidFile) Then
            strPid = Trim(fso.OpenTextFile(gmPidFile, 1).ReadAll)
            If IsNumeric(strPid) Then GhostMonAlive = OcrProcessAlive(CLng(strPid))
        End If
        Err.Clear
        On Error GoTo 0
    End Function
    ' 兜底终止：只在命令行确实指向本监控脚本时才结束进程（PID 可能已被系统复用）
    Sub GhostMonKill
        Dim fso, strPid, wmi, list, p
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        If fso.FileExists(gmPidFile) Then
            strPid = Trim(fso.OpenTextFile(gmPidFile, 1).ReadAll)
            If IsNumeric(strPid) Then
                Set wmi = GetObject("winmgmts:\\.\root\cimv2")
                If Err.Number = 0 Then
                    Set list = wmi.ExecQuery("SELECT ProcessId, CommandLine FROM Win32_Process WHERE ProcessId=" & CLng(strPid))
                    If Err.Number = 0 Then
                        For Each p In list
                            If InStr(LCase("" & p.CommandLine), "ghost_monitor.ps1") > 0 Then p.Terminate
                        Next
                    End If
                End If
            End If
        End If
        Err.Clear
        If fso.FileExists(gmPidFile) Then fso.DeleteFile gmPidFile, True
        If fso.FileExists(gmStopFile) Then fso.DeleteFile gmStopFile, True
        On Error GoTo 0
    End Sub
    ' 关工具箱时静默收尾，避免后台脚本继续截屏
    Sub GhostMonStopQuiet
        If Not gmOn And Not gmStopping Then Exit Sub
        gmOn = False
        gmStopping = False
        GhostMonStopHelper
    End Sub
    ' 恢复默认：删掉保存的区域，下次监控重新回到左上角自动识别
    Sub GhostMonResetAuto
        gmRx = -1 : gmRy = -1 : gmRw = 0 : gmRh = 0
        ' 只清区域，保留锁定的窗口（用户点“否”只是想恢复自动取左上角）
        GhostMonSaveConfig
        GhostMonSetStatus "已恢复自动识别（取游戏窗口左上角的 X/Y）", "ghost-mon-in"
    End Sub
    ' 微调区域：默认不需要；确认框里可改成恢复自动
    Sub GhostMonCalibrate
        Dim fso, objShell, strTmp, strPs1, strCmd, nRet
        If gmOn Or gmStopping Then
            MsgBox "请先停止监控，再调整坐标区域。", vbInformation, "监控运行中"
            Exit Sub
        End If
        nRet = MsgBox("坐标区域默认自动取游戏窗口左上角（X:196 Y:64 那一行），一般不用设置。" & vbCrLf & vbCrLf & _
            "点“是”：手动框选坐标区域（识别不准时再用）" & vbCrLf & _
            "点“否”：恢复自动识别（清除已保存的区域）" & vbCrLf & _
            "点“取消”：什么都不做", vbYesNoCancel + vbQuestion, "坐标区域")
        If nRet = vbCancel Then Exit Sub
        If nRet = vbNo Then
            GhostMonResetAuto
            Exit Sub
        End If
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set objShell = CreateObject("WScript.Shell")
        strPs1 = OcrRoot() & "\ocr\ocr_region.ps1"
        If Not fso.FileExists(strPs1) Then
            MsgBox "找不到框选脚本：" & vbCrLf & strPs1, vbExclamation, "缺少文件"
            Exit Sub
        End If
        If MsgBox("手动框选说明：" & vbCrLf & "1. 先把游戏窗口切到前台，能看到左上角的 X/Y 坐标" & vbCrLf & "2. 点“确定”后屏幕会变暗，按住鼠标左键只把“X:196 Y:64”那几个字框住" & vbCrLf & "3. 松开鼠标即完成；不想框选时按 Esc 取消" & vbCrLf & vbCrLf & "框选失败也不影响使用，默认就是自动识别。是否继续？", vbYesNo + vbQuestion, "手动框选坐标区域") <> vbYes Then Exit Sub
        strTmp = objShell.ExpandEnvironmentStrings("%TEMP%")
        gmRegionFile = fso.BuildPath(strTmp, "gadget_ghost_region.txt")
        On Error Resume Next
        If fso.FileExists(gmRegionFile) Then fso.DeleteFile gmRegionFile, True
        On Error GoTo 0
        strCmd = PsCmdFile(strPs1, True) & " -OutFile " & ocrQuote & gmRegionFile & ocrQuote
        If ocrProcName <> "" Then strCmd = strCmd & " -ProcName " & ocrQuote & ocrProcName & ocrQuote
        objShell.Run strCmd, 0, False
        GhostMonSetStatus "请在屏幕上拖框选择坐标区域（按 Esc 取消）…", "tip"
        gmRegionWait = 0
        window.setTimeout "GhostMonPollRegion", 300
    End Sub
    Sub GhostMonPollRegion
        Dim fso, strText, arrLines, strLine, arrPart
        Set fso = CreateObject("Scripting.FileSystemObject")
        gmRegionWait = gmRegionWait + 1
        If fso.FileExists(gmRegionFile) Then
            strText = OcrReadText(gmRegionFile, "utf-8")
            If Len(strText) > 0 Then
                arrLines = Split(Replace(strText, vbCr, ""), vbLf)
                For Each strLine In arrLines
                    arrPart = Split(strLine, vbTab)
                    If UBound(arrPart) = 4 Then
                        If arrPart(0) = "CANCEL" Then
                            GhostMonRefreshStatus
                            Exit Sub
                        End If
                        If arrPart(0) = "REL" Then
                            If CLng(arrPart(1)) < 0 Then
                                GhostMonSetStatus "未找到游戏窗口，无法换算相对区域，请打开游戏后重新框选", "ghost-mon-out"
                                Exit Sub
                            End If
                            gmRx = CLng(arrPart(1))
                            gmRy = CLng(arrPart(2))
                            gmRw = CLng(arrPart(3))
                            gmRh = CLng(arrPart(4))
                            GhostMonSaveConfig
                            GhostMonSetStatus "自定义区域已保存（" & gmRw & "×" & gmRh & "），点“坐标实时监控”开始", "tip"
                            Exit Sub
                        End If
                    End If
                Next
                GhostMonSetStatus "框选结果无效，请重试", "ghost-mon-out"
                Exit Sub
            End If
        End If
        If gmRegionWait > 500 Then
            GhostMonRefreshStatus
            Exit Sub
        End If
        window.setTimeout "GhostMonPollRegion", 300
    End Sub
    ' ===================== 定时提醒 =====================
    Dim remindTimerId, remindUiTimerId, remindLastFired, remindHour, remindMinute, remindSecond
    remindTimerId = 0
    remindUiTimerId = 0
    remindHour = -1
    Sub FillRemindMinutes
        FillTimeOptions "selRemindHour", -1, 23
        FillTimeOptions "selRemindMinute", 0, 59
        FillTimeOptions "selRemindSecond", 0, 59
    End Sub
    Sub FillTimeOptions(strId, first, last)
        Dim i, objSel, objOpt
        Set objSel = document.getElementById(strId)
        For i = first To last
            Set objOpt = document.createElement("OPTION")
            objSel.options.Add objOpt
            If i = -1 Then objOpt.text = "不设置" Else objOpt.text = Pad2(i)
            objOpt.value = CStr(i)
        Next
    End Sub
    Sub SetRemindControls(running)
        Dim id
        For Each id In Array("btnRemindStart", "btnRemindTest", "selRemindHour", "selRemindMinute", "selRemindSecond")
            document.getElementById(id).disabled = running
        Next
        document.getElementById("btnRemindStop").disabled = Not running
    End Sub
    Sub StartRemind
        remindHour = CInt(document.getElementById("selRemindHour").value)
        remindMinute = CInt(document.getElementById("selRemindMinute").value)
        remindSecond = CInt(document.getElementById("selRemindSecond").value)
        remindLastFired = ""
        SetRemindControls True
        StopRemindTimers
        remindTimerId = window.setInterval("CheckRemindTime", 1000, "VBScript")
        remindUiTimerId = window.setInterval("RefreshRemindStatus", 1000, "VBScript")
        CheckRemindTime
        RefreshRemindStatus
    End Sub
    Sub StopRemind
        StopRemindTimers
        SetRemindControls False
        document.getElementById("remindStatus").innerHTML = "已停止"
    End Sub
    Sub StopRemindTimers
        If remindTimerId <> 0 Then
            window.clearInterval remindTimerId
            remindTimerId = 0
        End If
        If remindUiTimerId <> 0 Then
            window.clearInterval remindUiTimerId
            remindUiTimerId = 0
        End If
    End Sub
    Function RemindTarget(dtNow, targetHour, targetMinute, targetSecond)
        Dim hourValue
        hourValue = targetHour
        If hourValue < 0 Then hourValue = Hour(dtNow)
        RemindTarget = DateSerial(Year(dtNow), Month(dtNow), Day(dtNow)) + TimeSerial(hourValue, targetMinute, targetSecond)
    End Function
    Function RemindFireKey(dtNow, targetHour, targetMinute, targetSecond, lastFired)
        Dim delta, key
        RemindFireKey = ""
        delta = DateDiff("s", RemindTarget(dtNow, targetHour, targetMinute, targetSecond), dtNow)
        If delta < 0 Or delta > 10 Then Exit Function
        key = CStr(Day(dtNow))
        If targetHour < 0 Then key = key & "-" & Hour(dtNow)
        If key <> lastFired Then RemindFireKey = key
    End Function
    Sub CheckRemindTime
        Dim key
        key = RemindFireKey(Now, remindHour, remindMinute, remindSecond, remindLastFired)
        If key <> "" Then
            remindLastFired = key
            ShowRemindNotify
        End If
    End Sub
    Sub RefreshRemindStatus
        Dim dtNow, dtNext, lngDiff, strMode
        dtNow = Now
        dtNext = RemindTarget(dtNow, remindHour, remindMinute, remindSecond)
        If remindHour >= 0 Then
            If dtNext <= dtNow Then dtNext = DateAdd("d", 1, dtNext)
            strMode = "每天 " & Pad2(remindHour) & ":" & Pad2(remindMinute) & ":" & Pad2(remindSecond)
        Else
            If dtNext <= dtNow Then dtNext = DateAdd("h", 1, dtNext)
            strMode = "每小时第 " & Pad2(remindMinute) & " 分 " & Pad2(remindSecond) & " 秒"
        End If
        lngDiff = DateDiff("s", dtNow, dtNext)
        document.getElementById("remindStatus").innerHTML = "<b>运行中</b>（" & strMode & "） 下次提醒 " & Pad2(Hour(dtNext)) & ":" & Pad2(Minute(dtNext)) & ":" & Pad2(Second(dtNext)) & "（还剩 " & (lngDiff \ 3600) & " 时 " & ((lngDiff Mod 3600) \ 60) & " 分 " & (lngDiff Mod 60) & " 秒）"
    End Sub
    Sub ShowRemindNotify
        Dim strMsg, strTitle, strPs1, strCmd, fso
        strMsg = document.getElementById("txtRemindMsg").value
        If strMsg = "" Then strMsg = "时间到啦！"
        ' 双引号会在命令行里截断参数，丢掉；单引号交给脚本当普通字符，不再转义
        strMsg = Replace(strMsg, """", "")
        strTitle = "定时提醒 " & Pad2(Hour(Now)) & ":" & Pad2(Minute(Now)) & ":" & Pad2(Second(Now))
        ' 气泡提示交给固定脚本 app\ocr\remind_notify.ps1。以前用 -Command 内联一长串 Add-Type，
        ' “隐藏窗口 + 绕过执行策略 + 内联脚本”是安全软件最敏感的组合；改成 -File 调用后命令行
        ' 形态稳定、可读，也方便在安全软件里只放行这一个脚本。
        strPs1 = OcrRoot() & "\ocr\remind_notify.ps1"
        Set fso = CreateObject("Scripting.FileSystemObject")
        If Not fso.FileExists(strPs1) Then
            ' 脚本丢了也别漏提醒：退回系统提示音
            CreateObject("WScript.Shell").Run "rundll32.exe user32.dll,MessageBeep", 0, False
            Exit Sub
        End If
        strCmd = PsCmdFile(strPs1, False)
        strCmd = strCmd & " -Title " & ocrQuote & strTitle & ocrQuote & " -Message " & ocrQuote & strMsg & ocrQuote
        CreateObject("WScript.Shell").Run strCmd, 0, False
    End Sub
    ' ===================== 修炼消耗 =====================
    Dim xiuTypes
    Set xiuTypes = MakeRecord(Array("attack", "magic", "hunt", "defend", "resist", "pet"), Array(Array("攻击修炼", 3, 4.5), Array("法术修炼", 3, 4.5), Array("猎术修炼", 3, 4.5), Array("防御修炼", 2, 3.5), Array("抗法修炼", 2, 3.5), Array("召唤兽修炼", 0, 0)))
    Sub CheckEnterXiu
        If window.event.keyCode = 13 Then CalcXiulian
    End Sub
    Function XiuExpForLv(lv)
        XiuExpForLv = (lv * lv + lv * 3 + 11) * 10
    End Function
    Sub CalcXiulian
        Dim strType, curLv, tgtLv, curExp, tgtExp, jiuPrice, jiuQuality, guoPrice, plan
        strType = document.getElementById("selXiuType").value
        If Not ReadInputNumber("txtXiuCurLv", Null, "integer", 25, "请输入当前修炼等级（0-25的整数）！", curLv) Then Exit Sub
        If Not ReadInputNumber("txtXiuCurExp", 0, "integer", 2147483647, "当前经验必须为非负整数（不填默认按0计算）！", curExp) Then Exit Sub
        If Not ReadInputNumber("txtXiuTgtLv", Null, "integer", 25, "请输入目标修炼等级（0-25的整数）！", tgtLv) Then Exit Sub
        If tgtLv < curLv Then
            MsgBox "目标修炼等级不能低于当前修炼等级！", vbExclamation, "输入错误"
            document.getElementById("txtXiuTgtLv").focus
            Exit Sub
        End If
        If Not ReadInputNumber("txtXiuTgtExp", 0, "integer", 2147483647, "目标经验必须为非负整数（不填默认按0计算）！", tgtExp) Then Exit Sub

        ' 九转金丹选填项（仅人物修炼）：每颗经验 = 品质×0.5，总品质 = 还需经验×2；填了品质时按颗数向上取整
        jiuPrice = 0
        jiuQuality = 0
        guoPrice = 0
        If strType = "pet" Then
            ' 召唤兽修炼：修炼果价格（万/颗，选填），每颗固定 150 点经验
            If Not ReadInputNumber("txtGuoPrice", 0, "positive", -1, "修炼果价格必须为大于0的数字（不填则不计算总成本）！", guoPrice) Then Exit Sub
        Else
            If Not ReadInputNumber("txtJiuPrice", 0, "positive", -1, "九转金丹每品质价格必须为大于0的数字（不填则不计算金丹）！", jiuPrice) Then Exit Sub
            If Not ReadInputNumber("txtJiuQuality", 0, "positive", -1, "九转金丹品质必须为大于0的数字（不填则不计算金丹）！", jiuQuality) Then Exit Sub
        End If

        If curLv < 25 And curExp >= XiuExpForLv(curLv + 1) Then
            MsgBox "当前经验已达到升" & (curLv + 1) & "级所需（" & XiuExpForLv(curLv + 1) & "点），请先调整当前等级！", vbExclamation, "输入错误"
            Exit Sub
        End If
        If tgtLv < 25 And tgtExp >= XiuExpForLv(tgtLv + 1) Then
            MsgBox "目标经验已达到升" & (tgtLv + 1) & "级所需（" & XiuExpForLv(tgtLv + 1) & "点），请调整目标等级！", vbExclamation, "输入错误"
            Exit Sub
        End If

        Set plan = CalculateXiuPlan(strType, curLv, tgtLv, curExp, tgtExp, jiuPrice, jiuQuality, guoPrice)
        If plan("needExp") < 0 Then
            MsgBox "当前修炼进度已达到目标！", vbInformation, "提示"
            Exit Sub
        End If
        RenderXiuResult strType, curLv, tgtLv, curExp, tgtExp, jiuPrice, jiuQuality, guoPrice, plan
    End Sub
    Function CalculateXiuPlan(kind, curLv, tgtLv, curExp, tgtExp, jiuPrice, jiuQuality, guoPrice)
        Dim needExp, level, times, info, jiuCount, jiuTotal, guoCount
        needExp = tgtExp - curExp
        For level = curLv + 1 To tgtLv
            needExp = needExp + XiuExpForLv(level)
        Next
        times = -Int(-needExp / 10)
        info = xiuTypes(kind)
        jiuCount = 0
        jiuTotal = needExp / XIU_PILL_EXP
        If jiuQuality > 0 Then
            jiuCount = -Int(-needExp / (jiuQuality * XIU_PILL_EXP))
            jiuTotal = jiuCount * jiuQuality
        End If
        guoCount = -Int(-needExp / XIU_FRUIT_EXP)
        Set CalculateXiuPlan = MakeRecord(Array("needExp", "times", "baiHuan", "guoCount", "guoCoin", "coinN", "coinF", "jiuCount", "jiuTotal", "jiuCoin"), Array(needExp, times, -Int(-needExp / XIU_HUNDRED_RING_EXP), guoCount, guoCount * guoPrice, times * info(1), times * info(2), jiuCount, jiuTotal, jiuTotal * jiuPrice / COIN_PER_WAN))
    End Function
    Sub RenderXiuResult(strType, curLv, tgtLv, curExp, tgtExp, jiuPrice, jiuQuality, guoPrice, plan)
        Dim info, strName, needExp, times, needContrib, contribHtml, xiuHtml
        Dim baiHuan, guoCount, guoCoin, guoStr, coinN, coinF, jiuTotalQ, jiuCount, jiuCoin, jiuHtml
        info = xiuTypes(strType)
        strName = info(0)
        needExp = plan("needExp")
        times = plan("times")

        needContrib = tgtLv * 150
        contribHtml = "≥ <b>" & needContrib & "</b> 点"
        xiuHtml = "<table class=""xiu-table""><tr><th class=""x1"" width=""30%"">项目</th><th class=""x2"">结果</th></tr>"
        xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">修炼类型</td><td class=""xiu-val"">" & strName & "</td></tr>"
        xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">修炼进度</td><td class=""xiu-val"">" & curLv & "级（" & curExp & "经验） → " & tgtLv & "级（" & tgtExp & "经验）</td></tr>"
        If times = 0 Then
            xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">还需修炼经验</td><td class=""xiu-val""><b>0</b> 点（已达到目标进度，无需修炼）</td></tr>"
            If strType <> "pet" Then
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">要求帮派总贡献</td><td class=""xiu-val"">" & contribHtml & "（目标等级 " & tgtLv & " × 150）</td></tr>"
            End If
        Else
            xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">还需修炼经验</td><td class=""xiu-val""><b>" & needExp & "</b> 点</td></tr>"
            If strType = "pet" Then
                ' 召唤兽修炼：每百环约 760 点经验、每颗修炼果固定 150 点经验，次数与个数均向上取整
                baiHuan = plan("baiHuan")
                guoCount = plan("guoCount")
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">召唤兽修炼百环</td><td class=""xiu-val""><b>" & baiHuan & "</b> 次（每百环约 760 点经验）</td></tr>"
                guoStr = "<b>" & guoCount & "</b> 个（每颗 150 点经验）"
                If guoPrice > 0 Then
                    guoCoin = plan("guoCoin")
                    guoStr = guoStr & "，<b>" & FmtAmount(guoCoin) & "</b> 万梦幻币"
                End If
                xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">修炼果</td><td class=""xiu-val"">" & guoStr & "</td></tr>"
            Else
                coinN = plan("coinN")
                coinF = plan("coinF")
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">修炼次数</td><td class=""xiu-val""><b>" & times & "</b> 次（每次提升 10 点经验）</td></tr>"
                xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">正常模式消耗</td><td class=""xiu-val""><b>" & FmtAmount(coinN) & "</b> 万梦幻币 + <b>" & times * 5 & "</b> 点资材</td></tr>"
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">免资材模式消耗</td><td class=""xiu-val""><b>" & FmtAmount(coinF) & "</b> 万梦幻币（不消耗资材）</td></tr>"
                ' 九转金丹方案（填了价格或品质时显示；经验 = 品质×0.5，总品质 = 还需经验×2）
                If jiuPrice > 0 Or jiuQuality > 0 Then
                    jiuTotalQ = plan("jiuTotal")
                    jiuCount = plan("jiuCount")
                    jiuCoin = plan("jiuCoin")
                    jiuHtml = "<tr><td class=""xiu-item"">九转金丹</td><td class=""xiu-val""><b>" & jiuTotalQ & "</b> 品质"
                    If jiuQuality > 0 Then jiuHtml = jiuHtml & "（<b>" & jiuCount & "</b> 颗 × " & jiuQuality & " 品）"
                    If jiuPrice > 0 Then jiuHtml = jiuHtml & "，<b>" & FmtAmount(jiuCoin) & "</b> 万梦幻币"
                    xiuHtml = xiuHtml & jiuHtml & "</td></tr>"
                End If
                xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">要求帮派总贡献</td><td class=""xiu-val"">" & contribHtml & "（目标等级 " & tgtLv & " × 150）</td></tr>"
            End If
        End If
        xiuHtml = xiuHtml & "</table>"
        document.getElementById("xiuResult").innerHTML = xiuHtml
    End Sub
    Sub OnXiuTypeChange
        Dim isPet
        isPet = (document.getElementById("selXiuType").value = "pet")
        If isPet Then
            document.getElementById("divXiuJiu").style.display = "none"
            document.getElementById("divXiuGuo").style.display = ""
        Else
            document.getElementById("divXiuJiu").style.display = ""
            document.getElementById("divXiuGuo").style.display = "none"
        End If
    End Sub
    ' ===================== 属性换算：输入、纯计算与展示 =====================
    Dim arrHistory, historyCount, lastDesc, lastResult
    ReDim arrHistory(0)
    historyCount = 0
    lastDesc = ""
    Set lastResult = Nothing
    Dim attrInputs, attrResults, raceCoeffs
    attrInputs = Array(Array("strength", "txtStr", "力"), Array("magic", "txtMag", "魔"), Array("constitution", "txtCon", "体"), Array("endurance", "txtEnd", "耐"), Array("agility", "txtAgi", "敏"))
    attrResults = Array(Array("damage", "tdADmg"), Array("magic", "tdAMag"), Array("defense", "tdADef"), Array("hp", "tdAHp"), Array("speed", "tdASpd"))
    Set raceCoeffs = MakeRecord(Array("human", "immortal", "demon"), Array(Array("人族", 0.67, 1.5, 5), Array("仙族", 0.57, 1.6, 4.5), Array("魔族", 0.77, 1.4, 6)))
    Sub CheckEnterAttr
        If window.event.keyCode = 13 Then CalcAttr
    End Sub
    Sub CalcAttr
        If document.getElementById("selCalcType").value = "weapon" Then
            CalcWeapon
        Else
            CalcEquip
        End If
    End Sub
    Sub SwitchCalcType
        If document.getElementById("selCalcType").value = "weapon" Then
            document.getElementById("rowWeaponRequired").style.display = ""
            document.getElementById("rowEquipRequired").style.display = "none"
            document.getElementById("btnCalcAttr").innerText = "计算武器属性"
        Else
            document.getElementById("rowWeaponRequired").style.display = "none"
            document.getElementById("rowEquipRequired").style.display = ""
            document.getElementById("btnCalcAttr").innerText = "计算装备属性"
        End If
        document.getElementById("divAttrTable").style.display = "none"
    End Sub
    Function ReadAttributes
        Dim attributes, field, value
        Set attributes = CreateObject("Scripting.Dictionary")
        For Each field In attrInputs
            value = 0
            If Not TryNumber(document.getElementById(field(1)).value, value) Then value = 0
            attributes.Add field(0), value
        Next
        Set ReadAttributes = attributes
    End Function
    Function CalculateAttributes(kind, race, attributes, base, hit)
        Dim coeffs, strength, magic, constitution, endurance, agility, damage, defense, spirit
        coeffs = raceCoeffs(race)
        strength = attributes("strength")
        magic = attributes("magic")
        constitution = attributes("constitution")
        endurance = attributes("endurance")
        agility = attributes("agility")
        damage = strength * coeffs(1)
        defense = endurance * coeffs(2)
        spirit = strength * 0.4 + magic * 0.7 + endurance * 0.2 + constitution * 0.3
        If kind = "weapon" Then
            damage = hit / 3 + (base + strength * coeffs(1))
            spirit = base / 4 + spirit
        Else
            defense = base + defense
        End If
        Set CalculateAttributes = MakeRecord(Array("damage", "magic", "defense", "hp", "speed"), Array(damage, spirit, defense, constitution * coeffs(3), constitution * 0.1 + endurance * 0.1 + strength * 0.1 + agility * 0.7))
    End Function
    Sub CalcWeapon
        CalculateAttrInput "weapon"
    End Sub
    Sub CalcEquip
        CalculateAttrInput "equip"
    End Sub
    Sub CalculateAttrInput(kind)
        Dim base, hit, race, attributes, result, field, coeffs, description
        hit = 0
        If kind = "weapon" Then
            If Not ReadInputNumber("txtWeaponDmg", Null, "number", -1, "请输入武器伤害！", base) Then Exit Sub
            If Not ReadInputNumber("txtWeaponHit", Null, "number", -1, "请输入武器命中！", hit) Then Exit Sub
        Else
            If Not ReadInputNumber("txtEquipDef", Null, "number", -1, "请输入装备防御！", base) Then Exit Sub
        End If
        race = document.getElementById("selRace").value
        coeffs = raceCoeffs(race)
        Set attributes = ReadAttributes
        Set result = CalculateAttributes(kind, race, attributes, base, hit)
        If kind = "weapon" Then
            description = "武器 " & coeffs(0) & " 伤害:" & base & " 命中:" & hit
        Else
            description = "装备 " & coeffs(0) & " 防御:" & base
        End If
        For Each field In attrInputs
            If attributes(field(0)) <> 0 Then description = description & " " & field(2) & ":" & attributes(field(0))
        Next
        SaveToHistory
        lastDesc = description
        Set lastResult = result
        document.getElementById("divAttrTable").style.display = ""
        For Each field In attrResults
            document.getElementById(field(1)).innerText = FormatNumber(result(field(0)), 2)
        Next
        RenderHistory
    End Sub
    Function AttrResultCells(result)
        Dim field, html
        html = ""
        For Each field In attrResults
            html = html & "<td class=""num"">" & FormatNumber(result(field(0)), 2) & "</td>"
        Next
        AttrResultCells = html
    End Function
    Sub SaveToHistory
        Dim idx
        If lastDesc = "" Then Exit Sub
        idx = historyCount
        historyCount = historyCount + 1
        ReDim Preserve arrHistory(historyCount - 1)
        arrHistory(idx) = Array(Pad2(Hour(Now)) & ":" & Pad2(Minute(Now)) & ":" & Pad2(Second(Now)), lastDesc, lastResult)
        lastDesc = ""
        Set lastResult = Nothing
        TrimHistory
    End Sub
    Sub TrimHistory
        Dim maxH, removeCount, i
        maxH = CInt(document.getElementById("selHistoryMax").value)
        If historyCount <= maxH Then Exit Sub
        removeCount = historyCount - maxH
        For i = 0 To historyCount - removeCount - 1
            arrHistory(i) = arrHistory(i + removeCount)
        Next
        historyCount = maxH
        ReDim Preserve arrHistory(historyCount - 1)
    End Sub
    Sub OnChangeHistoryLimit
        TrimHistory
        If lastDesc <> "" Or historyCount > 0 Then RenderHistory
    End Sub
    Sub RenderHistory
        Dim html, i, e
        html = "<table class=""history-table""><tr><th class=""h1"" width=""8%""></th><th class=""h2"" width=""9%"">时间</th><th class=""h3"" width=""28%"">输入参数</th><th class=""h4"">伤害</th><th class=""h5"">法伤</th><th class=""h6"">防御</th><th class=""h7"">气血</th><th class=""h8"">速度</th><th class=""h9"" width=""6%""></th></tr>"
        If lastDesc <> "" Then
            html = html & "<tr class=""row-current""><td class=""current-tag"">当前</td><td class=""hist-time"">" & Pad2(Hour(Now)) & ":" & Pad2(Minute(Now)) & ":" & Pad2(Second(Now)) & "</td><td class=""hist-info"">" & lastDesc & "</td>"
            html = html & AttrResultCells(lastResult)
            html = html & "<td></td></tr>"
        End If
        For i = historyCount - 1 To 0 Step -1
            e = arrHistory(i)
            html = html & "<tr><td class=""hist-tag"">历史</td><td class=""hist-time"">" & e(0) & "</td><td class=""hist-info"">" & e(1) & "</td>"
            html = html & AttrResultCells(e(2))
            html = html & "<td class=""hist-del""><button class=""hist-del-btn"" onclick=""DeleteHistory " & i & """>删</button></td></tr>"
        Next
        html = html & "</table>"
        document.getElementById("divHistoryTable").innerHTML = html
        document.getElementById("divHistory").style.display = ""
    End Sub
    Sub DeleteHistory(idx)
        Dim i
        If idx < 0 Or idx >= historyCount Then Exit Sub
        For i = idx To historyCount - 2
            arrHistory(i) = arrHistory(i + 1)
        Next
        historyCount = historyCount - 1
        If historyCount = 0 Then ReDim arrHistory(0) Else ReDim Preserve arrHistory(historyCount - 1)
        RenderHistory
    End Sub
    Sub ClearHistory
        ReDim arrHistory(0)
        historyCount = 0
        document.getElementById("divHistory").style.display = "none"
        document.getElementById("divHistoryTable").innerHTML = ""
    End Sub
    ' ===================== 宠环会话与明细 =====================
    ' 宠环任务区默认折叠，点击标题行展开/收起（规则同神器攻略）
    Sub TogglePetSection
        ToggleSection "petSection", "petToggleHint"
    End Sub
    Sub TogglePetTools
        ToggleSection "petToolsSection", "petToolsToggleHint"
        If document.getElementById("petToolsSection").style.display = "none" Then
            document.getElementById("btnPetTools").setAttribute "aria-expanded", "false"
        Else
            document.getElementById("btnPetTools").setAttribute "aria-expanded", "true"
        End If
    End Sub
    ' 只切换撤销入口的可见性，不修改计数和成本。
    Sub UpdatePetUndoButtons
        Dim button, display
        display = "none"
        If document.getElementById("chkPetUndo").checked Then display = "inline-block"
        For Each button In document.getElementById("petSection").getElementsByTagName("button")
            If InStr(" " & button.className & " ", " pet-undo-btn ") > 0 Then button.style.display = display
        Next
    End Sub
    ' 宠环跑环计数：+ 时弹录入框登记本次成本（万梦幻币，非必填按 0），- 撤销该任务最近一次记录（次数-1 并同步扣回其成本）
    ' “是否计算成本”选“否”时 + 不弹框，直接按 0 成本记账（仅计次数）；- 仍按撤销逻辑（无成本记录时仅减次数）
    ' 多号统计（1~5 号）：数据全部按号存两维——petCostHist(号,任务) 成本栈、petCounts(号,任务) 次数、petCostTotal(号) 累计成本、
    ' petDetailList(号) 录入顺序明细（格式 "任务序号:成本" 逗号分隔）；petCurChar 为当前号（0-4），DOM 只展示当前号视图，切号整体换装
    ' “是否计算成本”全局共享不分号；清零只清当前号；全部号合计为跨号只读汇总
    Dim petCostHist(4, 12), petCounts(4, 12), petCostTotal(4), petDetailList(4)
    Dim petCostIdx, petCostSavedScrollTop, petCurChar
    Dim pcI, petTaskNames
    petTaskNames = Array("找人", "乐器", "60级装备", "花", "1级家具", "80级装备", "三级药", "2级家具", "烹饪", "非指定变异召唤兽", "70级装备", "指定变异召唤兽", "上交非变异召唤兽")
    petCostIdx = -1
    petCurChar = 0
    ' 历史记录：每次 + / - / 清零后由 PetAutoSave 立刻把当天快照写回文件，所以不存在“未保存”状态，直接关窗也不会丢；
    ' petAutoSaveOk：上次自动保存是否成功（只在“由成功变失败”时弹一次提示，避免连点刷屏）；
    ' petHistData 文件加载的 日期→记录对象数组；petHistDateList 日期索引（日历点击传参用）；petHistYear/Month 当前显示月（-1 未初始化，展开时设为当月）；petIoSavedScrollTop 导入/导出弹窗打开前的滚动位置
    Dim petAutoSaveOk, petHistYear, petHistMonth, petHistSavedScrollTop, petIoSavedScrollTop
    Dim petHistDateList(), petHistData
    Dim petHistSelectedDate
    petHistSelectedDate = ""
    Set petHistData = CreateObject("Scripting.Dictionary")
    petAutoSaveOk = True
    petHistYear = -1
    petHistMonth = -1
    ReDim petHistDateList(-1)
    For pcI = 0 To PET_CHAR_COUNT - 1
        PetResetChar pcI
    Next
    Sub PetResetChar(character)
        Dim task
        petCostTotal(character) = 0
        petDetailList(character) = ""
        For task = 0 To PET_TASK_COUNT - 1
            petCostHist(character, task) = ""
            petCounts(character, task) = 0
        Next
    End Sub
    Sub RefreshPetSession
        Dim task, count
        For task = 0 To PET_TASK_COUNT - 1
            Set count = document.getElementById("petCnt" & task)
            If Not count Is Nothing Then count.innerText = CStr(petCounts(petCurChar, task))
        Next
        RefreshPetCostTotal
        RefreshPetDetail
    End Sub
    Sub PetAdd(idx)
        Dim objSel, lngIdx
        Set objSel = document.getElementById("selPetCostMode")
        If Not (objSel Is Nothing) Then
            If objSel.value = "0" Then
                lngIdx = CLng(idx)
                PetRecordCost lngIdx, 0
                Exit Sub
            End If
        End If
        OpenPetCostDlg idx
    End Sub
    Sub PetSub(idx)
        PetUndoOne idx
    End Sub
    ' 号名（1~5 号）
    Function PetCharName(c)
        PetCharName = (CLng(c) + 1) & "号"
    End Function
    ' 只修改当前号次数；登记或撤销完成全部状态更新后统一刷新视图。
    Sub PetChange(idx, delta)
        Dim lngN
        lngN = petCounts(petCurChar, idx) + CLng(delta)
        If lngN < 0 Then lngN = 0
        petCounts(petCurChar, idx) = lngN
    End Sub
    ' 切换当前号：页签高亮、次数换装、累计成本与明细重绘（成本弹窗开着时有遮罩挡住页签，无需防护）
    Sub PetSwitchChar(c)
        Dim i, objBtn
        c = CLng(c)
        If c < 0 Or c >= PET_CHAR_COUNT Then Exit Sub
        If c = petCurChar Then Exit Sub
        petCurChar = c
        For i = 0 To PET_CHAR_COUNT - 1
            Set objBtn = document.getElementById("petCharBtn" & i)
            If Not objBtn Is Nothing Then
                If i = c Then
                    objBtn.className = "pet-char-btn-on"
                Else
                    objBtn.className = "pet-char-btn"
                End If
            End If
        Next
        RefreshPetSession
    End Sub
    ' 撤销最近一次记录（当前号）：次数-1；该任务有成本记录时同步扣回（成本>0 先弹确认框告知金额）
    Sub PetUndoOne(idx)
        Dim lngN, dblCost
        idx = CLng(idx)
        lngN = petCounts(petCurChar, idx)
        If lngN <= 0 Then Exit Sub
        If petCostHist(petCurChar, idx) <> "" Then
            dblCost = PetCostPeek(idx)
            If dblCost > 0 Then
                If MsgBox("将撤销「" & PetCharName(petCurChar) & " · " & PetTaskName(idx) & "」最近一次记录：次数 -1，并从累计成本中扣回 " & PetFmtCost(dblCost) & " 万梦幻币。是否继续？", vbYesNo + vbQuestion, "撤销确认") <> vbYes Then Exit Sub
            End If
            petCostTotal(petCurChar) = petCostTotal(petCurChar) - PetCostPop(idx)
            If petCostTotal(petCurChar) < 0 Then petCostTotal(petCurChar) = 0
            PetDetailRemoveLast idx
        End If
        PetChange idx, -1
        RefreshPetSession
        PetAutoSave
    End Sub
    ' 读取当前号该任务最近一次录入的成本（不出栈）
    Function PetCostPeek(idx)
        Dim strS, lngP
        PetCostPeek = 0
        strS = petCostHist(petCurChar, idx)
        If strS = "" Then Exit Function
        lngP = InStrRev(strS, ",")
        If lngP = 0 Then
            PetCostPeek = CDbl(strS)
        Else
            PetCostPeek = CDbl(Mid(strS, lngP + 1))
        End If
    End Function
    ' 弹出并返回当前号该任务最近一次录入的成本（从历史中移除）
    Function PetCostPop(idx)
        Dim strS, lngP
        PetCostPop = PetCostPeek(idx)
        strS = petCostHist(petCurChar, idx)
        If strS = "" Then Exit Function
        lngP = InStrRev(strS, ",")
        If lngP = 0 Then
            petCostHist(petCurChar, idx) = ""
        Else
            petCostHist(petCurChar, idx) = Left(strS, lngP - 1)
        End If
    End Function
    ' 成本格式化：最多保留2位小数，去掉末尾无意义的 0 与小数点
    Function PetFmtCost(v)
        PetFmtCost = TrimNumberZeros(FormatNumber(v, 2))
    End Function
    ' 成本格式化（无千分位版，专用于历史文件与跨端交换文本）：最多保留2位小数，去掉末尾无意义的 0 与小数点；
    ' PetFmtCost（FormatNumber 默认带千分位）仅供界面显示，写文件/交换用本函数免得移动版 parseFloat 在逗号截断
    Function PetFmtCostPlain(v)
        PetFmtCostPlain = TrimNumberZeros(FormatNumber(v, 2, -1, 0, 0))
    End Function
    Function TrimNumberZeros(ByVal strS)
        If InStr(strS, ".") > 0 Then
            Do While Right(strS, 1) = "0"
                strS = Left(strS, Len(strS) - 1)
            Loop
            If Right(strS, 1) = "." Then strS = Left(strS, Len(strS) - 1)
        End If
        TrimNumberZeros = strS
    End Function
    ' 任务名称统一从配置读取，未知任务回退为序号。
    Function PetTaskName(idx)
        PetTaskName = "第" & (idx + 1) & "项"
        If idx >= 0 And idx < PET_TASK_COUNT Then PetTaskName = petTaskNames(idx)
    End Function
    ' 三类宠环弹窗共用遮罩、视口定位及滚动恢复；内容和焦点由各入口处理。
    Sub OpenPetDialog(prefix, ByRef savedScrollTop, alignTall)
        Dim dialog, overlay, viewHeight
        savedScrollTop = document.body.scrollTop
        document.body.style.overflow = "hidden"
        document.body.scrollTop = savedScrollTop
        Set dialog = document.getElementById(prefix & "Dialog")
        Set overlay = document.getElementById(prefix & "Overlay")
        dialog.style.display = "block"
        overlay.style.display = "block"
        overlay.style.pixelWidth = document.body.scrollWidth
        overlay.style.pixelHeight = document.body.scrollHeight
        viewHeight = document.body.clientHeight
        dialog.style.pixelLeft = Int((document.body.clientWidth - dialog.offsetWidth) / 2) + document.body.scrollLeft
        If alignTall And dialog.offsetHeight > viewHeight Then
            dialog.style.pixelTop = 8 + document.body.scrollTop
        Else
            dialog.style.pixelTop = Int((viewHeight - dialog.offsetHeight) / 2) + document.body.scrollTop
        End If
    End Sub
    Sub ClosePetDialog(prefix, savedScrollTop)
        document.getElementById(prefix & "Dialog").style.display = "none"
        document.getElementById(prefix & "Overlay").style.display = "none"
        document.body.style.overflow = ""
        document.body.scrollTop = savedScrollTop
    End Sub
    Sub OpenPetCostDlg(idx)
        Dim objInp
        petCostIdx = CLng(idx)
        document.getElementById("petCostTitle").innerText = "录入「" & PetCharName(petCurChar) & " · " & PetTaskName(petCostIdx) & "」本次成本"
        Set objInp = document.getElementById("petCostInput")
        objInp.value = ""
        OpenPetDialog "petCost", petCostSavedScrollTop, False
        objInp.focus
    End Sub
    Sub PetCostKeyDown
        If window.event.keyCode = 13 Then PetCostOk
    End Sub
    ' 确定：留空按 0 计入；非法输入保持弹窗待修正；成功则次数+1 并累计成本
    Sub PetCostOk
        Dim strVal, dblCost, message
        If petCostIdx < 0 Then Exit Sub
        strVal = Trim(document.getElementById("petCostInput").value)
        dblCost = 0
        If strVal <> "" Then
            If Not TryNumber(strVal, dblCost) Then
                MsgBox "成本必须为数字（单位：万梦幻币），不填按 0 计入！", vbExclamation, "输入错误"
                document.getElementById("petCostInput").focus
                Exit Sub
            End If
            If dblCost < 0 Then
                MsgBox "成本不能为负数（单位：万梦幻币），不填按 0 计入！", vbExclamation, "输入错误"
                document.getElementById("petCostInput").focus
                Exit Sub
            End If
            On Error Resume Next
            Err.Clear
            dblCost = Int(dblCost * 100 + 0.5) / 100
            message = Err.Description
            Err.Clear
            On Error GoTo 0
            If message <> "" Then
                MsgBox "成本超出可保存范围，请减小金额！", vbExclamation, "输入错误"
                Exit Sub
            End If
        End If
        PetRecordCost petCostIdx, dblCost
        ClosePetCostDlg
    End Sub
    ' 登记一笔成本（可为 0）并计数 +1（当前号）：成本入栈、明细追加、累计与表格同步刷新
    Sub PetRecordCost(ByVal idx, ByVal dblCost)
        idx = CLng(idx)
        dblCost = CDbl(dblCost)
        If petCostHist(petCurChar, idx) = "" Then
            petCostHist(petCurChar, idx) = CStr(dblCost)
        Else
            petCostHist(petCurChar, idx) = petCostHist(petCurChar, idx) & "," & CStr(dblCost)
        End If
        If petDetailList(petCurChar) = "" Then
            petDetailList(petCurChar) = idx & ":" & CStr(dblCost)
        Else
            petDetailList(petCurChar) = petDetailList(petCurChar) & "," & idx & ":" & CStr(dblCost)
        End If
        petCostTotal(petCurChar) = petCostTotal(petCurChar) + dblCost
        PetChange idx, 1
        RefreshPetSession
        PetAutoSave
    End Sub
    Sub PetCostCancel
        ClosePetCostDlg
    End Sub
    Sub ClosePetCostDlg
        ClosePetDialog "petCost", petCostSavedScrollTop
        petCostIdx = -1
    End Sub
    ' 刷新累计成本：当前号 + 全部号合计两个数字
    Sub RefreshPetCostTotal
        Dim n, dblAll
        dblAll = 0
        For n = 0 To PET_CHAR_COUNT - 1
            dblAll = dblAll + petCostTotal(n)
        Next
        document.getElementById("petTotalCost").innerText = PetFmtCost(petCostTotal(petCurChar))
        document.getElementById("petAllCost").innerText = PetFmtCost(dblAll)
    End Sub
    ' 展示/收起累计成本明细（展开时先刷新内容）
    Sub TogglePetDetail
        If document.getElementById("petDetailSection").style.display = "none" Then RefreshPetDetail
        ToggleSection "petDetailSection", "petDetailToggleHint"
    End Sub
    ' 积分奖励矩阵表与最终得分表默认折叠，点击标题行展开/收起（纯静态表，无内容刷新）
    Sub TogglePetReward
        ToggleSection "petRewardSection", "petRewardToggleHint"
    End Sub
    Sub TogglePetScore
        ToggleSection "petScoreSection", "petScoreToggleHint"
    End Sub
    ' 构建只读展示数据，供会话与历史共用汇总和逐笔明细表。
    Function PetViewRecord(record)
        Dim sums, item, details
        Set sums = CreateObject("Scripting.Dictionary")
        details = record("details")
        For Each item In details
            If Not sums.Exists(item(0)) Then sums.Add item(0), 0
            sums(item(0)) = sums(item(0)) + item(1)
        Next
        Set PetViewRecord = MakeRecord(Array("c", "counts", "details", "sums"), Array(record("c"), record("counts"), details, sums))
    End Function
    Function PetSessionViews
        Dim records, counts, character, task, record
        records = Array()
        For character = 0 To PET_CHAR_COUNT - 1
            ReDim counts(12)
            For task = 0 To PET_TASK_COUNT - 1
                counts(task) = petCounts(character, task)
            Next
            Set record = MakeRecord(Array("c", "counts", "details"), Array(character, counts, PetParseDetails(petDetailList(character))))
            AppendValue records, PetViewRecord(record)
        Next
        PetSessionViews = records
    End Function
    ' 从当前号全局明细中移除指定任务最近一笔（与该号成本栈弹出保持同步）
    Sub PetDetailRemoveLast(idx)
        Dim arrAll, arrItem, n, lngFound, strOut
        If petDetailList(petCurChar) = "" Then Exit Sub
        arrAll = Split(petDetailList(petCurChar), ",")
        lngFound = -1
        For n = UBound(arrAll) To 0 Step -1
            arrItem = Split(arrAll(n), ":")
            If CLng(arrItem(0)) = CLng(idx) Then
                lngFound = n
                Exit For
            End If
        Next
        If lngFound < 0 Then Exit Sub
        strOut = ""
        For n = 0 To UBound(arrAll)
            If n <> lngFound Then
                If strOut = "" Then
                    strOut = arrAll(n)
                Else
                    strOut = strOut & "," & arrAll(n)
                End If
            End If
        Next
        petDetailList(petCurChar) = strOut
    End Sub
    ' 重绘成本汇总与明细表：汇总按号分组（每号小节+小计，末行全部号合计）；明细只显示当前号（最新在上，序号为录入顺序）
    Sub RefreshPetDetail
        Dim objWrap
        Set objWrap = document.getElementById("petDetailSection")
        If objWrap Is Nothing Then Exit Sub
        objWrap.innerHTML = PetRenderTables(PetSessionViews, petCurChar)
    End Sub
    ' 清零当前号的次数与累计成本（有记录时确认；清完立刻把当天快照同步到历史文件；其他号不受影响）
    Sub PetCountReset
        Dim i, blnHasData
        blnHasData = False
        For i = 0 To PET_TASK_COUNT - 1
            If petCounts(petCurChar, i) > 0 Then blnHasData = True
        Next
        If blnHasData Or petCostTotal(petCurChar) > 0 Then
            If MsgBox("将清空 " & PetCharName(petCurChar) & " 的全部次数与累计成本（当前 " & PetFmtCost(petCostTotal(petCurChar)) & " 万梦幻币），其他号不受影响，今天已保存的记录会跟着同步。是否继续？", vbYesNo + vbQuestion, "清零确认") <> vbYes Then Exit Sub
        End If
        PetResetChar petCurChar
        RefreshPetSession
        PetAutoSave
    End Sub
    ' ===================== 宠环成本历史记录（文件按行存储：日期|号|次数CSV|明细CSV|累计成本，同一天多次保存覆盖当天） =====================
    ' 行格式即双端交换格式：与移动版“历史记录导入/导出”通用；total 一律无千分位（见 PetFmtCostPlain），跨端解析不被逗号截断
    ' 当天日期字符串（yyyy-mm-dd）
    Function PetTodayStr
        PetTodayStr = Year(Date) & "-" & Right("0" & Month(Date), 2) & "-" & Right("0" & Day(Date), 2)
    End Function
    ' 历史记录文件路径（工具箱目录下的 data 子目录，内容纯 ASCII）
    Function PetHistFile
        PetHistFile = OcrDataDir() & "\pet_cost_history.txt"
    End Function
    ' 读取历史文件全部行（文件不存在返回空数组，调用方过滤空行）
    Function PetReadHistLines
        Dim fso, f, strAll, message
        strAll = ""
        Set f = Nothing
        On Error Resume Next
        Err.Clear
        Set fso = CreateObject("Scripting.FileSystemObject")
        If fso.FileExists(PetHistFile) Then
            Set f = fso.OpenTextFile(PetHistFile, 1)
            ' 清空或删除最后一天后文件为零字节，直接 ReadAll 会触发错误 62（输入超出了文件尾）。
            If Err.Number = 0 Then
                If Not f.AtEndOfStream Then strAll = f.ReadAll
            End If
        End If
        message = Err.Description
        Err.Clear
        If Not f Is Nothing Then f.Close
        If message = "" Then message = Err.Description
        Err.Clear
        On Error GoTo 0
        If message <> "" Then Err.Raise 5, "PetReadHistLines", message
        If strAll = "" Then
            PetReadHistLines = Array()
        Else
            PetReadHistLines = Split(strAll, vbCrLf)
        End If
    End Function
    ' 存储结果显式区分成功、无数据、错误及并发变更；提示仅由事件入口负责。
    Function PetResult(status, data, raw, message)
        Set PetResult = MakeRecord(Array("status", "data", "raw", "error"), Array(status, data, raw, message))
    End Function
    ' 正则对象按 pattern 缓存：IE 里 New RegExp 是一次 COM 对象创建，宠环历史每行要校验十几次，
    ' 行数一多就是几万次创建（实测 1826 行单次解析 15 秒）。RegExp.Test 无状态，同一个对象可反复用。
    Dim textMatchCache
    Function TextMatches(text, pattern)
        Dim regex
        If IsEmpty(textMatchCache) Then Set textMatchCache = CreateObject("Scripting.Dictionary")
        If textMatchCache.Exists(pattern) Then
            Set regex = textMatchCache(pattern)
        Else
            Set regex = New RegExp
            regex.Pattern = pattern
            regex.IgnoreCase = True
            textMatchCache.Add pattern, regex
        End If
        TextMatches = regex.Test(CStr(text))
    End Function
    Function PetInteger(text, maximum)
        Dim number
        PetInteger = False
        If Not TextMatches(text, "^\d+$") Then Exit Function
        If Not TryNumber(text, number) Then Exit Function
        PetInteger = (number <= maximum)
    End Function
    Function PetNumber(text, ByRef number)
        PetNumber = False
        If Not TextMatches(Trim(text), "^[+-]?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$") Then Exit Function
        PetNumber = TryNumber(text, number)
    End Function
    Sub AppendValue(ByRef values, value)
        ReDim Preserve values(UBound(values) + 1)
        If IsObject(value) Then
            Set values(UBound(values)) = value
        Else
            values(UBound(values)) = value
        End If
    End Sub
    ' 交换行日期字段校验：先检查结构和范围，再验证日历日期，拒绝 DateSerial 自动归一化。
    Function PetValidDate(s)
        Dim yearValue, monthValue, dayValue, dt
        PetValidDate = False
        If Not TextMatches(s, "^\d{4}-\d{2}-\d{2}$") Then Exit Function
        yearValue = CInt(Left(s, 4))
        monthValue = CInt(Mid(s, 6, 2))
        dayValue = CInt(Right(s, 2))
        If yearValue < 100 Or monthValue < 1 Or monthValue > 12 Or dayValue < 1 Or dayValue > 31 Then Exit Function
        On Error Resume Next
        Err.Clear
        dt = DateSerial(yearValue, monthValue, dayValue)
        If Err.Number = 0 Then PetValidDate = (Year(dt) = yearValue And Month(dt) = monthValue And Day(dt) = dayValue)
        Err.Clear
        On Error GoTo 0
    End Function
    Function PetParseDetails(text)
        Dim items, fields, item, amount, details
        details = Array()
        If text <> "" Then
            items = Split(text, ",")
            For Each item In items
                fields = Split(item, ":")
                If UBound(fields) <> 1 Then Err.Raise 5, , "明细须为“任务序号:成本”格式。"
                If Not PetInteger(fields(0), PET_TASK_COUNT - 1) Then Err.Raise 5, , "明细任务序号须为 0~12。"
                If Not PetNumber(fields(1), amount) Then Err.Raise 5, , "明细成本须为完整数字。"
                AppendValue details, Array(CLng(fields(0)), amount)
            Next
        End If
        PetParseDetails = details
    End Function
    Function PetParseLine(line, normalizeTotal)
        Dim fields, counts, i, details, total
        fields = Split(line, "|")
        If UBound(fields) <> 4 Then Err.Raise 5, , "须有 5 个竖线分隔的字段。"
        If Not PetValidDate(fields(0)) Then Err.Raise 5, , "日期须为真实的 yyyy-mm-dd 日期。"
        If Not PetInteger(fields(1), PET_CHAR_COUNT - 1) Then Err.Raise 5, , "号字段须为 0~4。"
        counts = Split(fields(2), ",")
        If UBound(counts) <> PET_TASK_COUNT - 1 Then Err.Raise 5, , "次数字段须为 13 项。"
        For i = 0 To UBound(counts)
            If Not PetInteger(counts(i), 2147483647) Then Err.Raise 5, , "次数须为 0~2147483647 的整数。"
            counts(i) = CDbl(counts(i))
        Next
        details = PetParseDetails(fields(3))
        If Not PetNumber(Replace(fields(4), ",", ""), total) Then Err.Raise 5, , "累计成本须为完整数字。"
        If normalizeTotal Then line = fields(0) & "|" & fields(1) & "|" & fields(2) & "|" & fields(3) & "|" & PetFmtCostPlain(total)
        Set PetParseLine = MakeRecord(Array("date", "c", "counts", "detail", "details", "total", "line"), Array(fields(0), CLng(fields(1)), counts, fields(3), details, total, line))
    End Function
    Function PetParseHistText(text, normalizeTotal)
        Dim lines, line, history, records, record, count, message, result
        Set history = CreateObject("Scripting.Dictionary")
        lines = Split(Replace(Replace(text, vbCrLf, vbLf), vbCr, vbLf), vbLf)
        count = 0
        For Each line In lines
            line = Trim(line)
            If line <> "" Then
                count = count + 1
                On Error Resume Next
                Err.Clear
                Set record = PetParseLine(line, normalizeTotal)
                message = Err.Description
                Err.Clear
                On Error GoTo 0
                If message <> "" Then
                    Set PetParseHistText = PetResult("error", Nothing, text, "第 " & count & " 行：" & message)
                    Exit Function
                End If
                records = Array()
                If history.Exists(record("date")) Then records = history(record("date"))
                AppendValue records, record
                history(record("date")) = records
            End If
        Next
        Set result = PetResult("ok", history, text, "")
        If count = 0 Then result("status") = "empty"
        result.Add "count", count
        result.Add "days", history.Count
        Set PetParseHistText = result
    End Function
    ' 解析结果缓存（raw 文件全文 + data 日期→记录 + count）：宠环每次点击都要整读整写文件，
    ' 1827 行重新解析约 0.8 秒，而且反复解析会让 IE 脚本堆持续恶化（实测第 3 次已涨到 2.8 秒）；
    ' 文件内容没变就直接复用上次结果，任何写盘成功都同步更新缓存，外部改文件时靠 raw 比对自动失效。
    Dim petHistCacheRaw, petHistCacheData, petHistCacheCount
    Set petHistCacheData = Nothing
    petHistCacheRaw = ""
    petHistCacheCount = 0
    ' 用缓存内容拼一个与 PetParseHistText 同构的返回值（只造外壳，不重新解析）
    Function PetCachedResult(raw, data, count)
        Dim result
        Set result = PetResult("ok", data, raw, "")
        If count = 0 Then result("status") = "empty"
        result.Add "count", count
        result.Add "days", data.Count
        Set PetCachedResult = result
    End Function
    Function PetReadHistory
        Dim lines, message, raw, result
        On Error Resume Next
        Err.Clear
        lines = PetReadHistLines
        message = Err.Description
        Err.Clear
        On Error GoTo 0
        If message <> "" Then
            Set PetReadHistory = PetResult("error", Nothing, "", message)
            Exit Function
        End If
        raw = Join(lines, vbCrLf)
        ' 读文件本身只要几毫秒，慢的是逐行解析：内容没变就复用
        If Not (petHistCacheData Is Nothing) Then
            If raw = petHistCacheRaw Then
                Set PetReadHistory = PetCachedResult(raw, petHistCacheData, petHistCacheCount)
                Exit Function
            End If
        End If
        Set result = PetParseHistText(raw, False)
        If result("status") <> "error" Then
            petHistCacheRaw = raw
            Set petHistCacheData = result("data")
            petHistCacheCount = result("count")
        End If
        Set PetReadHistory = result
    End Function
    Function PetMergeHistory(history, incoming)
        Dim merged, day
        Set merged = CreateObject("Scripting.Dictionary")
        For Each day In history.Keys
            If Not incoming.Exists(day) Then merged.Add day, history(day)
        Next
        For Each day In incoming.Keys
            merged.Add day, incoming(day)
        Next
        Set PetMergeHistory = merged
    End Function
    Function PetHistoryText(history)
        Dim day, record, records, text
        text = ""
        For Each day In history.Keys
            records = history(day)
            For Each record In records
                text = text & record("line") & vbCrLf
            Next
        Next
        PetHistoryText = text
    End Function
    ' skipConfirm：True 表示“刚读过、紧接着写”的快照路径，跳过二次读盘比对（省一整遍全量解析）；
    ' 导入/删除等可能被外部程序插队的路径仍传 False，保留并发变更保护。
    ' 返回 status/data/raw/error；写成功时 data 就是落盘内容，调用方可直接拿去重画，不必再读一次。
    Function PetWriteHistory(history, expectedRaw, skipConfirm)
        Dim check, fso, stream, message, text, day
        If Not skipConfirm Then
            Set check = PetReadHistory
            If check("status") = "error" Then
                Set PetWriteHistory = check
                Exit Function
            End If
            If check("raw") <> expectedRaw Then
                Set PetWriteHistory = PetResult("changed", Nothing, expectedRaw, "确认期间历史记录发生变化，已取消操作，请重新查看。")
                Exit Function
            End If
        End If
        text = PetHistoryText(history)
        Set stream = Nothing
        On Error Resume Next
        Err.Clear
        Set fso = CreateObject("Scripting.FileSystemObject")
        ' 历史文件在 data 子目录，首次保存时目录可能还不存在
        OcrEnsureData
        Set stream = fso.CreateTextFile(PetHistFile, True)
        If Err.Number = 0 Then stream.Write text
        message = Err.Description
        Err.Clear
        If Not stream Is Nothing Then stream.Close
        If message = "" Then message = Err.Description
        Err.Clear
        On Error GoTo 0
        If message = "" Then
            Set PetWriteHistory = PetResult("ok", history, text, "")
            ' 刚写出的内容就是新的文件内容：缓存直接指向它，下一次读/展开历史都不必再逐行解析
            petHistCacheRaw = text
            Set petHistCacheData = history
            petHistCacheCount = 0
            For Each day In history.Keys
                petHistCacheCount = petHistCacheCount + (UBound(history(day)) + 1)
            Next
        Else
            Set PetWriteHistory = PetResult("error", Nothing, expectedRaw, message)
            ' 写盘失败：内存里的 history 可能已被改过（例如删除先改后存），与文件不再一致，
            ' 必须丢掉缓存，否则下一次读会拿着脏数据当文件内容
            Set petHistCacheData = Nothing
        End If
    End Function
    ' 组装当天全部有数据号的记录行（无数据返回空数组）
    Function PetBuildTodayLines
        Dim d, i, n, strCounts, blnHas, arrLines
        d = PetTodayStr
        ReDim arrLines(-1)
        For i = 0 To PET_CHAR_COUNT - 1
            blnHas = False
            strCounts = ""
            For n = 0 To PET_TASK_COUNT - 1
                If n > 0 Then strCounts = strCounts & ","
                strCounts = strCounts & CStr(petCounts(i, n))
                If petCounts(i, n) > 0 Or petCostHist(i, n) <> "" Then blnHas = True
            Next
            If blnHas Then
                ReDim Preserve arrLines(UBound(arrLines) + 1)
                arrLines(UBound(arrLines)) = d & "|" & i & "|" & strCounts & "|" & petDetailList(i) & "|" & PetFmtCostPlain(petCostTotal(i))
            End If
        Next
        PetBuildTodayLines = arrLines
    End Function
    ' 把当前会话状态写成“今天”的快照：先丢掉文件里今天的旧行，再写入当前各号（今天已无数据就只删）。
    ' 所以文件里今天的数字永远等于界面上的数字，关窗前不必再问“要不要保存”。
    ' 返回 status/data/raw/error（PetResult 结构）。
    Function PetSnapshotToday
        Dim incoming, loaded, merged, result, day
        Set incoming = PetParseHistText(Join(PetBuildTodayLines, vbCrLf), True)
        If incoming("status") = "error" Then
            Set PetSnapshotToday = incoming
            Exit Function
        End If
        Set loaded = PetReadHistory
        If loaded("status") = "error" Then
            Set PetSnapshotToday = loaded
            Exit Function
        End If
        ' 今天本来就没记录、现在也没有数据：文件不用动，省一次写盘
        If incoming("status") = "empty" And Not loaded("data").Exists(PetTodayStr) Then
            Set PetSnapshotToday = PetResult("empty", loaded("data"), loaded("raw"), "")
            Exit Function
        End If
        Set merged = CreateObject("Scripting.Dictionary")
        For Each day In loaded("data").Keys
            If day <> PetTodayStr Then merged.Add day, loaded("data")(day)
        Next
        If incoming("status") = "ok" Then
            For Each day In incoming("data").Keys
                merged.Add day, incoming("data")(day)
            Next
        End If
        Set result = PetWriteHistory(merged, loaded("raw"), True)
        Set PetSnapshotToday = result
    End Function
    ' 自动保存：每次 + / - / 清零落盘，失败只提示一次（由成功转失败那一瞬间），免得连点刷屏
    Sub PetAutoSave
        Dim result, objSec
        Set result = PetSnapshotToday
        If result("status") = "ok" Or result("status") = "empty" Then
            petAutoSaveOk = True
            ' 历史区展开着的时候日历要跟着变（今天是否高亮）；直接用刚写出的数据重画，不再重读文件
            Set objSec = document.getElementById("petHistSection")
            If Not objSec Is Nothing Then
                If objSec.style.display <> "none" Then Call PetHistShowData(result("data"))
            End If
        Else
            If petAutoSaveOk Then MsgBox "宠环记录自动保存失败，刚才的改动只在内存里：" & result("error") & vbCrLf & vbCrLf & "可以先关掉占用该文件的程序，再点「保存当天记录」重试（退出前请先存成功）。", vbExclamation, "自动保存失败"
            petAutoSaveOk = False
        End If
    End Sub
    ' “保存当天记录”按钮：手动再存一次（平时已由 PetAutoSave 自动保存，这里用于失败后重试与心里确认）
    Sub PetSaveHistory
        Dim result
        Set result = PetSnapshotToday
        If result("status") = "empty" Then
            MsgBox "当天暂无可保存的宠环成本记录。", vbInformation, "保存当天记录"
            Exit Sub
        End If
        If result("status") <> "ok" Then
            MsgBox "保存失败：" & result("error"), vbExclamation, "保存失败"
            Exit Sub
        End If
        petAutoSaveOk = True
        MsgBox "已保存 " & PetTodayStr & " 的宠环成本记录（可在“历史记录查询”中查看）。", vbInformation, "保存成功"
        If document.getElementById("petHistSection").style.display <> "none" Then Call PetHistShowData(result("data"))
    End Sub
    ' 加载历史文件到 petHistData（日期 → 该日记录对象数组），失败明确返回 False。
    Function PetLoadHist
        Dim result
        Set result = PetReadHistory
        PetLoadHist = False
        If result("status") = "error" Then
            MsgBox "读取历史记录失败：" & result("error"), vbExclamation, "历史记录"
            Exit Function
        End If
        Set petHistData = result("data")
        PetLoadHist = True
    End Function
    ' 日期数组升序（插入排序，量小）
    Sub PetSortDates(arr)
        Dim i, j, t
        For i = 1 To UBound(arr)
            t = arr(i)
            j = i - 1
            Do While j >= 0
                If arr(j) > t Then
                    arr(j + 1) = arr(j)
                    j = j - 1
                Else
                    Exit Do
                End If
            Loop
            arr(j + 1) = t
        Next
    End Sub
    ' 展开/收起历史记录查询（展开时重读文件渲染日历）
    Sub TogglePetHist
        If document.getElementById("petHistSection").style.display = "none" Then RefreshPetHist
        ToggleSection "petHistSection", "petHistToggleHint"
    End Sub
    ' 读文件后重画日历（常规入口：展开、翻月、删除、导入）
    Sub RefreshPetHist
        Dim objSec
        Set objSec = document.getElementById("petHistSection")
        If objSec Is Nothing Then Exit Sub
        If Not PetLoadHist Then
            objSec.innerText = "历史记录读取失败，请检查文件后重试。"
            Exit Sub
        End If
        RenderPetHistCal
    End Sub
    ' 用刚写出的快照数据直接重画日历：自动保存/手动保存后数据就在手上，不必再整读一次文件
    Sub PetHistShowData(history)
        Set petHistData = history
        RenderPetHistCal
    End Sub
    ' 渲染日历：周日起头；有记录日期紫底白字可点（传日期索引规避字符串引号问题）；今天紫字
    Sub RenderPetHistCal
        Dim objSec, n, strH, wd, days, d, cIdx, strDate, arrKeys, strToday
        Set objSec = document.getElementById("petHistSection")
        If objSec Is Nothing Then Exit Sub
        If petHistYear < 0 Then
            petHistYear = Year(Date)
            petHistMonth = Month(Date)
        End If
        arrKeys = petHistData.Keys
        PetSortDates arrKeys
        ReDim petHistDateList(UBound(arrKeys))
        For n = 0 To UBound(arrKeys)
            petHistDateList(n) = arrKeys(n)
        Next
        strToday = PetTodayStr
        strH = "<div style=""margin-top: 6px;""><button class=""pet-char-btn"" style=""width: 26px;"" onclick=""PetHistPrevMonth"">&lt;</button><b style=""margin: 0 10px; font-size: 14px;"">" & petHistYear & "年" & petHistMonth & "月</b><button class=""pet-char-btn"" style=""width: 26px;"" onclick=""PetHistNextMonth"">&gt;</button><span class=""tip"" style=""margin-left: 8px;"">高亮日期有记录，点击查看</span></div>"
        strH = strH & "<table class=""pet-hist-cal""><tr><th width=""14%"">日</th><th width=""14%"">一</th><th width=""14%"">二</th><th width=""14%"">三</th><th width=""15%"">四</th><th width=""14%"">五</th><th width=""15%"">六</th></tr>"
        wd = Weekday(DateSerial(petHistYear, petHistMonth, 1))
        days = Day(DateSerial(petHistYear, petHistMonth + 1, 0))
        d = 1 - (wd - 1)
        Do While d <= days
            strH = strH & "<tr>"
            For cIdx = 0 To 6
                If d >= 1 And d <= days Then
                    strDate = petHistYear & "-" & Right("0" & petHistMonth, 2) & "-" & Right("0" & d, 2)
                    If petHistData.Exists(strDate) Then
                        strH = strH & "<td class=""pet-hist-day pet-hist-has"" onclick=""PetShowHist " & PetDateIndex(strDate) & """>" & d & "</td>"
                    ElseIf strDate = strToday Then
                        strH = strH & "<td class=""pet-hist-day pet-hist-today"">" & d & "</td>"
                    Else
                        strH = strH & "<td class=""pet-hist-day"">" & d & "</td>"
                    End If
                Else
                    strH = strH & "<td class=""pet-hist-day""></td>"
                End If
                d = d + 1
            Next
            strH = strH & "</tr>"
        Loop
        strH = strH & "</table>"
        objSec.innerHTML = strH
    End Sub
    ' 日期在 petHistDateList 中的下标（-1 未找到）
    Function PetDateIndex(strDate)
        Dim n
        PetDateIndex = -1
        For n = 0 To UBound(petHistDateList)
            If petHistDateList(n) = strDate Then
                PetDateIndex = n
                Exit Function
            End If
        Next
    End Function
    Sub PetHistPrevMonth
        petHistMonth = petHistMonth - 1
        If petHistMonth = 0 Then
            petHistMonth = 12
            petHistYear = petHistYear - 1
        End If
        RefreshPetHist
    End Sub
    Sub PetHistNextMonth
        petHistMonth = petHistMonth + 1
        If petHistMonth = 13 Then
            petHistMonth = 1
            petHistYear = petHistYear + 1
        End If
        RefreshPetHist
    End Sub
    ' 点击日历日期：弹窗展示该日保存的成本汇总（按号分组）与逐笔明细（最新在上）
    Sub PetShowHist(idx)
        Dim strDate, records, views, record
        idx = CLng(idx)
        If idx < 0 Or idx > UBound(petHistDateList) Then Exit Sub
        strDate = petHistDateList(idx)
        ' 日历刚渲染过，petHistData 就是最新数据，不再重读文件
        If Not petHistData.Exists(strDate) Then Exit Sub
        records = petHistData(strDate)
        views = Array()
        For Each record In records
            AppendValue views, PetViewRecord(record)
        Next
        OpenPetHistDlg strDate, PetRenderTables(views, -1)
    End Sub
    Function PetRenderTables(records, detailCharacter)
        Dim n, m, record, arrCnt, arrDet, arrItem, strH, strCls, c, detailTitle
        Dim lngRows, lngCnt, dblSum, lngAllCnt, dblAllSum, blnAny, blnAnyDet, rn, taskSum, t
        strH = "<div class=""pet-block-title"""
        If detailCharacter = -1 Then strH = strH & " style=""margin-top: 0;"""
        strH = strH & ">【成本汇总】</div>"
        strH = strH & "<table><tr><th width=""55%"">任务内容</th><th width=""20%"">次数</th><th width=""25%"">合计成本（万）</th></tr>"
        lngAllCnt = 0
        dblAllSum = 0
        blnAny = False
        For n = 0 To UBound(records)
            Set record = records(n)
            c = record("c")
            arrCnt = record("counts")
            Set taskSum = record("sums")
            lngRows = 0
            lngCnt = 0
            dblSum = 0
            For t = 0 To PET_TASK_COUNT - 1
                If taskSum.Exists(t) Then
                    If lngRows = 0 Then
                        strH = strH & "<tr><td class=""pet-char-cell"" colspan=""3"">" & PetCharName(c) & "</td></tr>"
                        blnAny = True
                    End If
                    lngRows = lngRows + 1
                    lngCnt = lngCnt + arrCnt(t)
                    dblSum = dblSum + taskSum(t)
                    strCls = ""
                    If lngRows Mod 2 = 0 Then strCls = " class=""alt"""
                    strH = strH & "<tr" & strCls & "><td class=""lv"">" & PetTaskName(t) & "</td><td class=""num"">" & arrCnt(t) & "</td><td class=""num"">" & PetFmtCost(taskSum(t)) & "</td></tr>"
                End If
            Next
            If lngRows > 0 Then
                strH = strH & "<tr><td class=""pet-subtotal"">" & PetCharName(c) & " 小计</td><td class=""pet-subtotal""><b>" & lngCnt & "</b></td><td class=""pet-subtotal""><b>" & PetFmtCost(dblSum) & "</b></td></tr>"
                lngAllCnt = lngAllCnt + lngCnt
                dblAllSum = dblAllSum + dblSum
            End If
        Next
        If Not blnAny Then
            strH = strH & "<tr><td class=""pet-empty"" colspan=""3"">暂无成本记录</td></tr>"
        Else
            strH = strH & "<tr><td class=""pet-grand"">全部号合计</td><td class=""pet-grand""><b>" & lngAllCnt & "</b></td><td class=""pet-grand""><b>" & PetFmtCost(dblAllSum) & "</b></td></tr>"
        End If
        strH = strH & "</table>"
        detailTitle = "成本明细"
        If detailCharacter >= 0 Then detailTitle = detailTitle & " · " & PetCharName(detailCharacter) & "（最新在上）"
        strH = strH & "<div class=""pet-block-title"">【" & detailTitle & "】</div>"
        strH = strH & "<div class=""pet-detail-scroll""><table><tr><th width=""15%"">序号</th><th width=""55%"">任务内容</th><th width=""30%"">成本（万）</th></tr>"
        blnAnyDet = False
        For n = 0 To UBound(records)
            Set record = records(n)
            c = record("c")
            arrDet = record("details")
            If UBound(arrDet) >= 0 And (detailCharacter = -1 Or detailCharacter = c) Then
                If detailCharacter = -1 Then strH = strH & "<tr><td class=""pet-char-cell"" colspan=""3"">" & PetCharName(c) & "</td></tr>"
                blnAnyDet = True
                rn = 0
                For m = UBound(arrDet) To 0 Step -1
                    arrItem = arrDet(m)
                    rn = rn + 1
                    strCls = ""
                    If rn Mod 2 = 0 Then strCls = " class=""alt"""
                    strH = strH & "<tr" & strCls & "><td class=""num"">" & (m + 1) & "</td><td class=""lv"">" & PetTaskName(CLng(arrItem(0))) & "</td><td class=""num"">" & PetFmtCost(CDbl(arrItem(1))) & "</td></tr>"
                Next
            End If
        Next
        If Not blnAnyDet Then strH = strH & "<tr><td class=""pet-empty"" colspan=""3"">暂无成本记录</td></tr>"
        strH = strH & "</table></div>"
        PetRenderTables = strH
    End Function
    ' 打开历史弹窗：遮罩 + 视口居中 + 锁背景滚动（内容超高时顶部对齐）
    Sub OpenPetHistDlg(strDate, strHtml)
        petHistSelectedDate = strDate
        document.getElementById("petHistTitle").innerText = "📅 " & strDate & " 宠环成本记录"
        document.getElementById("petHistBody").innerHTML = strHtml
        OpenPetDialog "petHist", petHistSavedScrollTop, True
    End Sub
    Sub ClosePetHist
        petHistSelectedDate = ""
        ClosePetDialog "petHist", petHistSavedScrollTop
    End Sub
    ' 删除仅处理已保存快照，不改当前计数和成本；空日期仅由全部清空入口传入。
    Sub PetDeleteHistDay
        If petHistSelectedDate <> "" Then PetRemoveHistory petHistSelectedDate
    End Sub
    Sub PetClearHistory
        window.event.cancelBubble = True
        PetRemoveHistory ""
    End Sub
    Sub PetRemoveHistory(ByVal strDate)
        Dim loaded, history, result, hasRecords, strScope, strToken, strAnswer, strNote
        Set loaded = PetReadHistory
        If loaded("status") = "error" Then
            MsgBox "读取历史记录失败，未执行删除：" & loaded("error"), vbExclamation, "删除历史记录"
            Exit Sub
        End If
        Set history = loaded("data")
        hasRecords = (history.Count > 0)
        If strDate <> "" Then hasRecords = history.Exists(strDate)
        If Not hasRecords Then
            If strDate = "" Then
                MsgBox "暂无可清空的历史记录。", vbInformation, "清空历史记录"
            Else
                MsgBox strDate & " 已无历史记录。", vbInformation, "删除该日记录"
            End If
            If petHistSelectedDate <> "" Then ClosePetHist
            RefreshPetHist
            Exit Sub
        End If
        strNote = ""
        If strDate = "" Then
            strScope = "全部 " & history.Count & " 个日期、全部号的历史记录"
            strToken = "清空全部历史记录"
        Else
            strScope = strDate & " 的全部号历史记录"
            strToken = strDate
            strNote = vbCrLf & "其他日期记录保留。"
        End If
        If MsgBox("即将永久删除" & strScope & "。" & strNote & vbCrLf & vbCrLf & "此操作不可撤销，建议先取消并导出备份。" & vbCrLf & "当前计数和成本不受影响；再次保存当天记录会重新生成当天历史。" & vbCrLf & vbCrLf & "是否继续？", vbYesNo + vbExclamation + vbDefaultButton2, "删除历史记录 · 确认范围") <> vbYes Then Exit Sub
        If strDate = "" Then
            If MsgBox("再次确认：将清空所有日期的宠环历史记录，不只是当前月份或当前号！" & vbCrLf & "没有导出备份的记录将无法恢复。" & vbCrLf & vbCrLf & "确定继续清空吗？", vbYesNo + vbExclamation + vbDefaultButton2, "清空全部历史记录 · 二次确认") <> vbYes Then Exit Sub
        End If
        strAnswer = InputBox("最后确认：请输入“" & strToken & "”以删除" & strScope & "。" & vbCrLf & "输入不一致或取消均不会删除。", "删除历史记录 · 输入确认", "")
        If strAnswer = "" Then Exit Sub
        If strAnswer <> strToken Then
            MsgBox "输入不一致，已取消删除，历史记录未改动。", vbInformation, "已取消删除"
            Exit Sub
        End If
        ' 确认期间若其他窗口保存或导入了记录，拒绝用旧快照覆盖。
        If strDate = "" Then
            history.RemoveAll
        Else
            history.Remove strDate
        End If
        Set result = PetWriteHistory(history, loaded("raw"), False)
        If result("status") <> "ok" Then
            MsgBox "删除失败：" & result("error"), vbExclamation, "删除失败"
            Exit Sub
        End If
        If petHistSelectedDate <> "" Then ClosePetHist
        RefreshPetHist
        If strDate = "" Then
            MsgBox "已清空全部宠环历史记录。", vbInformation, "清空完成"
        Else
            MsgBox "已删除 " & strDate & " 的全部号历史记录，其他日期保留。", vbInformation, "删除完成"
        End If
    End Sub
    ' ===================== 历史记录跨端导入/导出（交换格式即文件行格式，与移动版通用） =====================
    ' 导出：全部已保存历史行填入文本框，全选待复制（到移动版“导入”粘贴）
    Sub PetHistExport
        Dim loaded, strAll, lngCnt
        window.event.cancelBubble = True
        Set loaded = PetReadHistory
        If loaded("status") = "error" Then
            MsgBox "读取历史记录失败：" & loaded("error"), vbExclamation, "导出历史记录"
            Exit Sub
        End If
        strAll = PetHistoryText(loaded("data"))
        lngCnt = loaded("count")
        If strAll = "" Then
            MsgBox "暂无已保存的历史记录（先点“保存当天记录”或从移动版导入）。", vbInformation, "导出历史记录"
            Exit Sub
        End If
        document.getElementById("petIoTitle").innerText = "导出历史记录（与移动版通用）"
        document.getElementById("petIoNote").innerText = "共 " & lngCnt & " 行。点“全选复制”复制全部文本，再到移动版“历史记录查询”的“导入”粘贴。"
        document.getElementById("petIoText").value = strAll
        document.getElementById("petIoOkBtn").style.display = "none"
        document.getElementById("petIoCopyBtn").style.display = ""
        OpenPetIoDlg
        document.getElementById("petIoText").select
    End Sub
    ' 导入：粘贴移动版导出的行文本，确认后与本机文件合并（同日期覆盖、其他保留）
    Sub PetHistImport
        window.event.cancelBubble = True
        document.getElementById("petIoTitle").innerText = "导入历史记录（与移动版通用）"
        document.getElementById("petIoNote").innerText = "粘贴移动版导出的记录文本后点“导入”。导入日期将覆盖本机同日期记录，其他日期保留；不影响当前计数。"
        document.getElementById("petIoText").value = ""
        document.getElementById("petIoOkBtn").style.display = ""
        document.getElementById("petIoCopyBtn").style.display = "none"
        OpenPetIoDlg
    End Sub
    ' 导入确认：逐行校验（5 段/日期/号 0-4/13 项整数次数/明细 t:c 且任务号 0-12/数字成本），
    ' 全过才合并写入：导入文本中的日期整日覆盖本地同日期行，本地其他日期保留；
    ' 计数器不受影响（导入的是已落盘快照，不是会话数据）；写入时 total 顺手规范化去千分位
    Sub PetIoOk
        Dim incoming, loaded, merged, result
        ' 统一换行为 vbLf 再分行（兼容 CRLF / LF / CR 及末尾多余换行）
        ' total 容忍千分位（HTA 旧版文件可能写过），写入时规范化
        Set incoming = PetParseHistText(document.getElementById("petIoText").value, True)
        If incoming("status") = "error" Then
            MsgBox "导入失败：" & incoming("error"), vbExclamation, "导入失败"
            Exit Sub
        End If
        If incoming("status") = "empty" Then
            MsgBox "请先粘贴历史记录文本！", vbExclamation, "导入历史记录"
            Exit Sub
        End If
        Set loaded = PetReadHistory
        If loaded("status") = "error" Then
            MsgBox "读取历史记录失败，未执行导入：" & loaded("error"), vbExclamation, "导入失败"
            Exit Sub
        End If
        ' 本地保留日期不在导入集合的行，再追加导入行（total 重写为无千分位）
        Set merged = PetMergeHistory(loaded("data"), incoming("data"))
        Set result = PetWriteHistory(merged, loaded("raw"), False)
        If result("status") <> "ok" Then
            MsgBox "导入失败：" & result("error"), vbExclamation, "导入失败"
            Exit Sub
        End If
        PetIoClose
        MsgBox "导入成功：共 " & incoming("count") & " 行（" & incoming("days") & " 天），导入日期已覆盖本机同日期记录，其他日期保留。", vbInformation, "导入历史记录"
        If document.getElementById("petHistSection").style.display <> "none" Then RefreshPetHist
    End Sub
    ' 全选并尝试复制文本框内容（剪贴板被安全设置拦截时退化为全选待手动 Ctrl+C）
    Sub PetIoCopyAll
        Dim objT
        Set objT = document.getElementById("petIoText")
        objT.focus
        objT.select
        On Error Resume Next
        window.clipboardData.setData "Text", objT.value
        If Err.Number = 0 Then
            MsgBox "已复制到剪贴板，到移动版“导入”粘贴即可。", vbInformation, "导出历史记录"
        Else
            Err.Clear
            MsgBox "已全选文本（剪贴板直接写入被拦截），请按 Ctrl+C 复制。", vbInformation, "导出历史记录"
        End If
        On Error GoTo 0
    End Sub
    ' 打开导入/导出弹窗：遮罩 + 视口居中 + 锁背景滚动（同历史查看弹窗）
    Sub OpenPetIoDlg
        OpenPetDialog "petIo", petIoSavedScrollTop, True
    End Sub
    Sub PetIoClose
        ClosePetDialog "petIo", petIoSavedScrollTop
    End Sub

        "yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yi|yin|yin|yin|yin|yin|yin|yin|yin|yin|yin|yin|yin|yin|yin|yin|yin|ying|ying|ying|ying|ying|ying|ying|ying|ying|" & _
        "ying|ying|ying|ying|ying|ying|ying|ying|ying|yo|yong|yong|yong|yong|yong|yong|yong|yong|yong|yong|yong|yong|yong|yong|yong|you|you|you|you|you|you|you|you|you|you|you|you|you|you|you|you|you|you|you|you|yu|yu|yu|yu|yu|" & _
        "yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|xu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yu|yuan|yuan|yuan|yuan|yuan|yuan|yuan|yuan|yuan|yuan|" & _
        "yuan|yuan|yuan|yuan|yuan|yuan|yuan|yuan|yuan|yuan|yue|yue|yue|yue|yao|yue|yue|yue|yue|yue|yun|yun|yun|yun|yun|yun|yun|yun|yun|yun|yun|yun|za|za|za|zai|zai|zai|zai|zai|zai|zai|zan|zan|zan|zan|zang|zang|zang|zao|" & _
        "zao|zao|zao|zao|zao|zao|zao|zao|zao|zao|zao|zao|zao|ze|ze|ze|ze|zei|zen|zeng|zeng|ceng|zeng|zha|zha|zha|zha|ya|zha|zha|zha|shan|zha|za|zha|zha|zha|zhai|zhai|zhai|zhai|zhai|zhai|zhan|zhan|zhan|nian|zhan|zhan|zhan|" & _
        "nian|zhan|zhan|zhan|zhan|zhan|zhan|zhan|zhan|zhan|zhang|zhang|zhang|zhang|zhang|zhang|zhang|zhang|zhang|zhang|zhang|zhang|zhang|zhang|zhang|zhao|zhao|zhao|zhao|zhao|zhao|zhao|zhao|zhao|zhao|zhe|zhe|zhe|zhe|zhe|zhe|zhe|zhe|zhe|zhe|zhen|zhen|zhen|zhen|zhen|" & _
        "zhen|zhen|zhen|zhen|zhen|zhen|zhen|zhen|zhen|zhen|zhen|zheng|zheng|zheng|zheng|zheng|zheng|zheng|zheng|zheng|zheng|zheng|zhen|zheng|zheng|zheng|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|" & _
        "zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhi|zhong|zhong|zhong|zhong|zhong|zhong|zhong|zhong|zhong|zhong|zhong|zhou|zhou|zhou|zhou|zhou|zhou|zhou|zhou|zhou|zhou|zhou|zhou|zhou|zhou|zhu|zhu|zhu|zhu|zhu|zhu|" & _
        "zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhu|zhua|zhua|zhuai|zhuan|zhuan|zhuan|zhuan|zhuan|zhuan|zhuang|zhuang|zhuang|zhuang|zhuang|zhuang|zhuang|zhui|zhui|zhui|zhui|zhui|zhui|zhun|zhun|zhuo|zhuo|zhuo|zhuo|zhuo|zhuo|" & _
        "zhuo|zhuo|zhe|zhuo|zhuo|zi|zi|zi|zi|zi|zi|zi|zi|zai|zi|zi|zi|zi|zi|zi|zong|zong|zong|zong|zong|zong|zong|zou|zou|zou|zou|zu|zu|zu|zu|zu|zu|zu|zu|zuan|zuan|zui|zui|zui|zui|zun|zun|zuo|zuo|zuo|" & _
        "zha|zuo|zuo|zuo|zuo"
    ' 实时识别：ps1 常驻循环 + 结果文件按 EOF 时间戳轮询；停止靠停止文件平滑退出，超时再按 PID 兜底终止
    Dim ocrWatchOn, ocrStopFile, ocrPidFile, ocrLastEof, ocrLastStatus
    Dim ocrLastLines, ocrLastMs, ocrLastTiku, ocrWatchMiss, ocrStopWait, ocrStopping
    Dim ocrMeta, ocrHits, ocrTextArr
    Dim ocrQuote
    Const OCR_WATCH_MS = 1500
    ocrQuote = Chr(34)
    ocrRootDir = ""
    ocrRelX = -1
    ocrRelY = -1
    ocrRelW = 0
    ocrRelH = 0
    ocrProcName = ""
    ocrBusy = False
    ocrPollCount = 0
    ocrTikuCount = 0
    ocrAnswerText = ""
    ocrSearchText = ""
    ocrTikuLines = Array()
    ocrSrLines = Array()
    ocrWatchOn = False
    ocrStopFile = ""
    ocrPidFile = ""
    ocrLastEof = ""
    ocrLastStatus = ""
    ocrLastLines = ""
    ocrLastMs = ""
    ocrLastTiku = 0
    ocrWatchMiss = 0
    ocrStopWait = 0
    ocrStopping = False
    Set ocrMeta = CreateObject("Scripting.Dictionary")
    Set ocrHits = CreateObject("Scripting.Dictionary")
    ocrTextArr = Array()
    ' ===== PowerShell 启动入口 =====
    ' 识别、捉鬼监控、环境自检、定时提醒全靠外部 ps1。安全软件（腾讯电脑管家、奇安信天擎等）
    ' 对“无路径的 powershell”和“隐藏窗口 + 绕过执行策略 + 内联 -Command”这类组合最敏感，
    ' 而这些调用以前散在七八处、参数各写一遍。统一收口后全路径固定（不走 PATH / App Paths）、
    ' 参数固定，以后要调只改这里，安全软件里也只认这一种命令行形态。
    Function PsExePath
        PsExePath = CreateObject("WScript.Shell").ExpandEnvironmentStrings("%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe")
    End Function
    ' 跑一个本地 ps1：不加载配置文件、不弹交互、窗口隐藏；需要 STA 的（截屏 / 窗口枚举）传 True
    Function PsCmdFile(strPs1, blnSta)
        Dim strCmd
        strCmd = ocrQuote & PsExePath() & ocrQuote & " -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden"
        If blnSta Then strCmd = strCmd & " -STA"
        PsCmdFile = strCmd & " -File " & ocrQuote & strPs1 & ocrQuote
    End Function
    ' 首次自检（环境检查）：后台跑一次 ocr\env_check.ps1，缺文件 / 缺语言包只在问题变化时说一次
    envOutFile = ""
    envTry = 0
    envBusy = False
    envDone = False
    ' 工具箱所在目录（还原 %20 兼容含空格路径，统一反斜杠）
    Function OcrRoot
        Dim fso, strPath
        If ocrRootDir <> "" Then
            OcrRoot = ocrRootDir
            Exit Function
        End If
        Set fso = CreateObject("Scripting.FileSystemObject")
        strPath = Replace(window.location.pathname, "%20", " ")
        ocrRootDir = Replace(fso.GetParentFolderName(strPath), "/", "\")
        OcrRoot = ocrRootDir
    End Function
    ' 运行时数据（锁定的角色、框选的识别区域、自检签名、宠环历史）统一放在工具箱目录下的 data 子目录：
    ' ocr\ 只留脚本与文案，备份、对比版本、分享时不会被本机状态混进来。
    Function OcrDataDir
        OcrDataDir = OcrRoot() & "\data"
    End Function
    Sub OcrEnsureData
        Dim fso
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        If Not fso.FolderExists(OcrDataDir()) Then fso.CreateFolder OcrDataDir()
        Err.Clear
        On Error GoTo 0
    End Sub
    Function OcrTikuFile
        OcrTikuFile = OcrRoot() & "\ocr_tiku.txt"
    End Function
    Function OcrConfigFile
        OcrConfigFile = OcrDataDir() & "\ocr_config.txt"
    End Function
    ' 按指定字符集读文本（ADODB.Stream 可读 UTF-8/GBK 等本地文本），并剔除 UTF-8 BOM
    Function OcrReadText(strPath, strCharset)
        Dim stm, strText
        strText = ""
        On Error Resume Next
        Set stm = CreateObject("ADODB.Stream")
        stm.Type = 2
        stm.Charset = strCharset
        stm.Open
        If Err.Number = 0 Then
            stm.LoadFromFile strPath
            If Err.Number = 0 Then strText = stm.ReadText
        End If
        Err.Clear
        If Not stm Is Nothing Then stm.Close
        On Error GoTo 0
        If Len(strText) > 0 Then
            If Left(strText, 1) = ChrW(&HFEFF) Then strText = Mid(strText, 2)
        End If
        OcrReadText = strText
    End Function
    ' 优先 UTF-8；出现替换字符（U+FFFD）说明是 GBK 存档，回退 gb2312 再读
    Function OcrReadFileSmart(strPath)
        Dim strUtf
        strUtf = OcrReadText(strPath, "utf-8")
        If InStr(strUtf, ChrW(-3)) > 0 Then
            OcrReadFileSmart = OcrReadText(strPath, "gb2312")
        Else
            OcrReadFileSmart = strUtf
        End If
    End Function
    ' 写 UTF-8 无 BOM（与项目其余文件编码一致）
    Sub OcrWriteText(strPath, strText)
        Dim stm, stmOut
        On Error Resume Next
        Set stm = CreateObject("ADODB.Stream")
        stm.Type = 2
        stm.Charset = "utf-8"
        stm.Open
        stm.WriteText strText
        stm.Position = 0
        stm.Type = 1
        If stm.Size >= 3 Then stm.Position = 3
        Set stmOut = CreateObject("ADODB.Stream")
        stmOut.Type = 1
        stmOut.Open
        stmOut.Write stm.Read
        stmOut.SaveToFile strPath, 2
        stmOut.Close
        stm.Close
        On Error GoTo 0
    End Sub
    ' ===== 首次自检（环境检查）=====
    ' 别人下载解压后最常见的三类故障：解压不全缺文件、系统没装中文 OCR 语言包、PowerShell 太旧。
    ' ocr\env_check.ps1 用 META 行回传结果，这里翻成中文；只在问题组合变化时弹一次提示，
    ' 点答题区状态行的“环境有问题”可随时重查（env_warn.txt 记上一次已提示过的组合）。
    Function EnvCheckPs1
        EnvCheckPs1 = OcrRoot() & "\ocr\env_check.ps1"
    End Function
    Function EnvWarnFile
        EnvWarnFile = OcrDataDir() & "\env_warn.txt"
    End Function
    ' 最近一次自检通过的日期（yyyyMMdd）。7 天内不重复跑 PowerShell：既省一次启动，
    ' 也少一次可能被安全软件当成“后台脚本”拦下的调用；环境真有变动时点状态行强制重查。
    Function EnvOkFile
        EnvOkFile = OcrDataDir() & "\env_ok.txt"
    End Function
    Function EnvOkFresh
        Dim fso, strText, dtLast
        EnvOkFresh = False
        Set fso = CreateObject("Scripting.FileSystemObject")
        If Not fso.FileExists(EnvOkFile()) Then Exit Function
        strText = Trim(OcrReadFileSmart(EnvOkFile()))
        If Len(strText) <> 8 Or Not IsNumeric(strText) Then Exit Function
        On Error Resume Next
        dtLast = DateSerial(CInt(Left(strText, 4)), CInt(Mid(strText, 5, 2)), CInt(Mid(strText, 7, 2)))
        If Err.Number <> 0 Then
            Err.Clear
            On Error GoTo 0
            Exit Function
        End If
        EnvOkFresh = (DateDiff("d", dtLast, Now) < 7)
        On Error GoTo 0
    End Function
    Sub EnvWriteOk
        OcrEnsureData
        On Error Resume Next
        OcrWriteText EnvOkFile(), CStr(Year(Now)) & Pad2(Month(Now)) & Pad2(Day(Now))
        On Error GoTo 0
    End Sub
    ' 点状态行重查：先作废缓存，保证这次真的跑一遍
    Sub EnvCheckForce
        On Error Resume Next
        CreateObject("Scripting.FileSystemObject").DeleteFile EnvOkFile(), True
        Err.Clear
        On Error GoTo 0
        EnvCheckRun
    End Sub
    Sub EnvSetStatus(strText, strColor)
        On Error Resume Next
        document.getElementById("envStatus").innerText = strText
        document.getElementById("envStatus").style.color = strColor
        On Error GoTo 0
    End Sub
    ' 上一轮已提示过的问题组合（换行压成一行存档），避免每次开工具箱都弹窗
    Function EnvReadSig
        Dim fso
        Set fso = CreateObject("Scripting.FileSystemObject")
        EnvReadSig = ""
        If fso.FileExists(EnvWarnFile()) Then EnvReadSig = Trim(OcrReadFileSmart(EnvWarnFile()))
    End Function
    Sub EnvWriteSig(strSig)
        OcrEnsureData
        On Error Resume Next
        OcrWriteText EnvWarnFile(), strSig
        On Error GoTo 0
    End Sub
    Sub EnvCheckRun
        Dim fso, strPs1, strOut, strCmd
        If envBusy Then Exit Sub
        ' 7 天内自检通过过就直接用缓存结果，不发新进程
        If EnvOkFresh() Then
            EnvSetStatus "环境检查通过", ""
            Exit Sub
        End If
        envBusy = True
        envDone = False
        envTry = 0
        EnvSetStatus "环境检查中…", ""
        Set fso = CreateObject("Scripting.FileSystemObject")
        strPs1 = EnvCheckPs1()
        If Not fso.FileExists(strPs1) Then
            envBusy = False
            envDone = True
            EnvSetStatus "环境有问题（点这里重查）", "#b33"
            EnvReport "缺少自检脚本 ocr\env_check.ps1：多半是压缩包没解压完整，或只把 .hta 拷了出来。请把整个文件夹一起解压后再用。"
            Exit Sub
        End If
        strOut = fso.GetSpecialFolder(2) & "\gadget_env.txt"
        envOutFile = strOut
        On Error Resume Next
        If fso.FileExists(strOut) Then fso.DeleteFile strOut, True
        strCmd = PsCmdFile(strPs1, False)
        strCmd = strCmd & " -OutFile " & ocrQuote & strOut & ocrQuote
        CreateObject("WScript.Shell").Run strCmd, 0, False
        Err.Clear
        On Error GoTo 0
        window.setTimeout "EnvCheckPoll", 300
    End Sub
    Sub EnvCheckPoll
        Dim fso, f, strLine, arr, dic
        envTry = envTry + 1
        Set fso = CreateObject("Scripting.FileSystemObject")
        If Not fso.FileExists(envOutFile) Then
            ' 10 秒还没写出结果就当超时（PowerShell 被策略拦住等），不弹窗，留状态行给用户重试
            If envTry * 300 >= 10000 Then
                envBusy = False
                envDone = True
                EnvSetStatus "环境检查超时（点这里重查；反复超时多为安全软件拦了 PowerShell，见 README）", "#b33"
            Else
                window.setTimeout "EnvCheckPoll", 300
            End If
            Exit Sub
        End If
        Set dic = CreateObject("Scripting.Dictionary")
        On Error Resume Next
        Set f = fso.OpenTextFile(envOutFile, 1)
        Do Until f.AtEndOfStream
            strLine = f.ReadLine
            arr = Split(strLine, vbTab)
            If UBound(arr) >= 2 Then
                If arr(0) = "META" Then dic(arr(1)) = arr(2)
            End If
        Loop
        f.Close
        Err.Clear
        On Error GoTo 0
        envBusy = False
        envDone = True
        EnvCheckApply dic
    End Sub
    ' 同一组问题只弹一次；问题修好（或换了别的问题）后才会再提示
    Sub EnvReport(strProblems)
        Dim strText, strSig
        strText = "工具箱自检发现问题（不影响计算类功能）：" & vbCrLf & vbCrLf & strProblems & vbCrLf & "修好后重新打开工具箱即可；也可以点答题区状态行的提示重新检查。"
        strSig = Replace(Replace(strProblems, vbCrLf, " / "), vbTab, " ")
        If EnvReadSig() <> strSig Then
            EnvWriteSig strSig
            MsgBox strText, vbExclamation, "环境自检"
        End If
    End Sub
    Sub EnvCheckApply(dic)
        Dim arrMiss, i, strMiss, strProblems, strPs, arrV, maj
        strProblems = ""
        ' 缺文件：自检脚本按清单比对过一遍，缺哪个列哪个
        If dic.Exists("files") Then
            If dic("files") <> "ok" Then
                strMiss = ""
                arrMiss = Split(dic("files"), "|")
                For i = 0 To UBound(arrMiss)
                    strMiss = strMiss & "    " & arrMiss(i) & vbCrLf
                Next
                strProblems = strProblems & "缺少文件（OCR 功能不可用，计算类不受影响）：" & vbCrLf & strMiss & vbCrLf
            End If
        End If
        ' 中文 OCR 语言包：没有它截图识别和捉鬼监控会直接报 OCR_NO_LANGUAGE_PACK
        If dic.Exists("ocr") Then
            If dic("ocr") <> "1" Then
                strProblems = strProblems & "系统缺少中文 OCR 语言包，识别会直接失败。安装：设置 → 时间和语言 → 语言和区域 → 中文(简体) → 语言选项 → 光学字符识别(OCR) → 安装" & vbCrLf & vbCrLf
            End If
        End If
        ' PowerShell 5 以下没有 WinRT OCR 需要的运行时
        If dic.Exists("psver") Then
            strPs = dic("psver")
            maj = 0
            arrV = Split(strPs, ".")
            On Error Resume Next
            maj = CLng(arrV(0))
            Err.Clear
            On Error GoTo 0
            If maj < 5 Then
                strProblems = strProblems & "Windows PowerShell 版本过低（当前 " & strPs & "，需要 5.1，Win10/11 自带）：识别功能不可用。" & vbCrLf & vbCrLf
            End If
        End If
        If strProblems = "" Then
            EnvSetStatus "环境检查通过", ""
            EnvWriteOk
            On Error Resume Next
            CreateObject("Scripting.FileSystemObject").DeleteFile EnvWarnFile(), True
            Err.Clear
            On Error GoTo 0
            Exit Sub
        End If
        EnvSetStatus "环境有问题（点这里重查）", "#b33"
        ' 一旦查出问题，旧的“通过”标记立刻作废，下次启动必查
        On Error Resume Next
        CreateObject("Scripting.FileSystemObject").DeleteFile EnvOkFile(), True
        Err.Clear
        On Error GoTo 0
        EnvReport strProblems
    End Sub
    ' ===== 在线更新 =====
    ' ocr\update_toolbox.ps1 先看百度网盘共享目录里的文件名：网盘一两秒就回，不用等 GitHub，
    ' 也不用翻墙；读到的新版本比本地新，就在 upd 弹窗里给出分享链接，另配一个“自动更新”按钮。
    ' 网盘只肯说“有哪个版本”、不给匿名客户端下载链接，所以弹窗里的自动更新改走 GitHub
    ' （-NoCloud）：读 GitHub 上的版本并整包下载替换；连不上或还没推上去，就留在弹窗里说明
    ' 只能手动下载。网盘读不到（网络不通、被墙、目录还没传）才回退去问 GitHub。
    ' 只有远程版本比本地 CHANGELOG.md 里的版本新才有动作，一致或更老什么都不做。
    ' 替换文件时保留 app\data：锁定的角色、框选区域、自检签名、宠环历史都还在。题库会被新包
    ' 的换掉（题库本可自己编辑/导入，否则新版题库永远到不了），换之前备份成 app\data\ocr_tiku.prev.txt。
    updBusy = False
    updOutFile = ""
    updTry = 0
    updTimeoutMs = 0
    updMode = ""
    updLocal = ""
    updRemote = ""
    ' updOffer = 弹窗里正在推荐的那个版本（网盘读到的），自动更新失败时用来报“哪个版本没下成”
    updOffer = ""
    updLink = ""
    updDlgShown = False
    updDlgScroll = 0
    ' 自动检测更新：勾选后每次打开工具箱都静默查一次版本（只比对、不下载），
    ' 有新版本才在“检查更新”按钮旁亮一行字，不弹窗、不写状态行。开关存在 app\data，默认关闭。
    updAutoOn = False
    Function UpdAutoFile
        UpdAutoFile = OcrDataDir() & "\update_auto.txt"
    End Function
    Sub UpdAutoLoad
        Dim fso
        updAutoOn = False
        Set fso = CreateObject("Scripting.FileSystemObject")
        If Not fso.FileExists(UpdAutoFile()) Then Exit Sub
        If Trim(OcrReadFileSmart(UpdAutoFile())) = "1" Then updAutoOn = True
    End Sub
    Sub UpdAutoSave
        OcrEnsureData
        On Error Resume Next
        If updAutoOn Then
            OcrWriteText UpdAutoFile(), "1"
        Else
            OcrWriteText UpdAutoFile(), "0"
        End If
        Err.Clear
        On Error GoTo 0
    End Sub
    ' 开关状态回写到勾选框：没存过（或存的是 0）就是默认不勾
    Sub UpdAutoPaint
        On Error Resume Next
        document.getElementById("chkUpdAuto").checked = updAutoOn
        Err.Clear
        On Error GoTo 0
    End Sub
    Sub UpdNewHint(strText)
        On Error Resume Next
        document.getElementById("updNewHint").innerText = strText
        Err.Clear
        On Error GoTo 0
    End Sub
    ' 勾选/取消：改动立刻落盘；勾上时顺手查一次，不然得重开工具箱才看得出效果
    Sub UpdAutoToggle
        On Error Resume Next
        updAutoOn = document.getElementById("chkUpdAuto").checked
        Err.Clear
        On Error GoTo 0
        UpdAutoSave
        UpdNewHint ""
        If updAutoOn And Not updBusy Then window.setTimeout "UpdSilentCheck", 300
    End Sub
    Sub UpdSilentCheck
        If updAutoOn Then UpdRun "silent"
    End Sub
    Function UpdPs1
        UpdPs1 = OcrRoot() & "\ocr\update_toolbox.ps1"
    End Function
    ' 工具箱根目录 = app 的上一级；exe 版就是它解包出来的 MengHuanToolbox 目录
    Function UpdRootDir
        Dim fso
        Set fso = CreateObject("Scripting.FileSystemObject")
        UpdRootDir = fso.GetParentFolderName(OcrRoot())
    End Function
    ' 版本号取 CHANGELOG.md 里第一条 "## 1.2.3"——版本号的唯一来源，打包脚本也按它命名
    Function UpdFirstVersion(strText)
        Dim arrLine, i, strLine, n
        UpdFirstVersion = ""
        arrLine = Split(Replace(Replace(strText, vbCrLf, vbLf), vbCr, vbLf), vbLf)
        For i = 0 To UBound(arrLine)
            strLine = Trim(arrLine(i))
            If Left(strLine, 2) = "##" And Mid(strLine, 3, 1) <> "#" Then
                strLine = Trim(Mid(strLine, 3))
                n = InStr(strLine, " ")
                If n > 0 Then strLine = Left(strLine, n - 1)
                If strLine <> "" Then
                    UpdFirstVersion = strLine
                    Exit Function
                End If
            End If
        Next
    End Function
    Sub UpdShowVersionText(strV)
        On Error Resume Next
        If strV = "" Then
            document.getElementById("updVer").innerText = "版本 未知"
        Else
            document.getElementById("updVer").innerText = "版本 v" & strV
        End If
        On Error GoTo 0
    End Sub
    ' 开窗只读本地版本，不联网：不点“检查更新”就不会有任何外部请求
    Sub UpdShowVersion
        Dim fso, strPath
        updLocal = ""
        Set fso = CreateObject("Scripting.FileSystemObject")
        strPath = UpdRootDir() & "\CHANGELOG.md"
        On Error Resume Next
        If fso.FileExists(strPath) Then updLocal = UpdFirstVersion(OcrReadFileSmart(strPath))
        Err.Clear
        On Error GoTo 0
        UpdShowVersionText updLocal
    End Sub
    Sub UpdSetStatus(strText, strColor)
        On Error Resume Next
        document.getElementById("updStatus").innerText = strText
        document.getElementById("updStatus").style.color = strColor
        On Error GoTo 0
    End Sub
    Sub UpdBusyUI(bBusy)
        On Error Resume Next
        ' 静默检测可能在后台跑很久（甚至超时），这段时间不锁“检查更新”：点了能接管，也不至于点不动
        If updMode = "silent" Then
            document.getElementById("btnUpdCheck").disabled = False
        Else
            document.getElementById("btnUpdCheck").disabled = bBusy
        End If
        document.getElementById("btnUpdAuto").disabled = bBusy
        On Error GoTo 0
    End Sub
    ' 自动下载走不通时（GitHub 连不上，或远端还没发布新包），只能让玩家自己去分享页拿：
    ' 脚本结果里的 link= 优先（它会跟着 update_source.txt 里的 share= / pwd= 变），拿不到才用这里的默认值
    Function UpdShareUrl
        UpdShareUrl = "https://pan.baidu.com/s/1jMjWXBqNIAm1qwaGaBkJ4w?pwd=8iif"
    End Function
    Sub UpdOpenLink(strUrl)
        Dim strGo
        strGo = Trim(strUrl)
        If strGo = "" Then strGo = UpdShareUrl()
        On Error Resume Next
        CreateObject("WScript.Shell").Run strGo
        Err.Clear
        On Error GoTo 0
    End Sub
    ' 点“检查更新”：先看网盘、只比对版本不下载；有新版本就弹窗，自动还是手动在窗里选
    Sub UpdCheck
        ' 静默检测还没回来：这次点击直接接管它，按手动检查展示结论（同一次查询，不再多发一个进程）
        If updBusy And updMode = "silent" Then
            updMode = "check"
            UpdNote "正在检查更新…", ""
            Exit Sub
        End If
        UpdRun "check"
    End Sub
    ' 进度只写一处：弹窗开着就写在窗里那行（状态行清空，免得两处重复、关窗后还留一行），
    ' 弹窗没开（检查中、没有新版本、检查失败）才写在状态行
    Sub UpdNote(strText, strColor)
        ' 静默检测不写底部状态行：脚本每改一次 status 都会走到这里，“正在检查更新…”会一直留在最右边
        If updMode = "silent" Then Exit Sub
        If updDlgShown Then
            On Error Resume Next
            document.getElementById("updNote").innerText = strText
            document.getElementById("updNote").style.color = strColor
            Err.Clear
            On Error GoTo 0
            UpdSetStatus "", ""
        Else
            UpdSetStatus strText, strColor
        End If
    End Sub
    ' 网盘上先看到新版本时用这个弹窗：链接可点（交给默认浏览器，不在 HTA 里跳走），
    ' 旁边一个“自动更新”按钮改走 GitHub 下载，下载不成就留在窗里说明只能手动下载
    Sub UpdDlgShow(strTitle, strBody)
        On Error Resume Next
        document.getElementById("updTitle").innerText = strTitle
        document.getElementById("updBody").innerHTML = strBody
        document.getElementById("updLink").innerText = updLink
        document.getElementById("updNote").innerText = ""
        Err.Clear
        On Error GoTo 0
        If Not updDlgShown Then
            updDlgShown = True
            OpenPetDialog "upd", updDlgScroll, False
        End If
    End Sub
    Sub UpdDlgClose
        If Not updDlgShown Then Exit Sub
        updDlgShown = False
        On Error Resume Next
        ClosePetDialog "upd", updDlgScroll
        Err.Clear
        On Error GoTo 0
    End Sub
    ' 链接和“打开下载页”按钮共用：<a> 的默认跳转要取消，否则整个工具箱会跳去分享页
    Sub UpdDlgOpen
        On Error Resume Next
        window.event.returnValue = False
        Err.Clear
        On Error GoTo 0
        UpdOpenLink updLink
    End Sub
    Sub UpdDlgAuto
        If updBusy Then Exit Sub
        UpdRun "auto"
    End Sub
    ' strMode：check 只查（网盘优先）、silent 开机静默只查（结论写按钮旁一行）、
    ' apply 确认后直接更新、auto 弹窗里的自动更新。后两种只走 GitHub：整包只有在 GitHub 上拿得到，网盘只肯报版本。
    Sub UpdRun(strMode)
        Dim fso, strPs1, strOut, strCmd
        If updBusy Then Exit Sub
        Set fso = CreateObject("Scripting.FileSystemObject")
        strPs1 = UpdPs1()
        If Not fso.FileExists(strPs1) Then
            ' 缺脚本是包没解压全，静默检测不该为这个弹红字，安静跳过
            If strMode = "silent" Then Exit Sub
            UpdSetStatus "缺少更新脚本 ocr\update_toolbox.ps1（多半是压缩包没解压完整）", "#b33"
            Exit Sub
        End If
        updBusy = True
        updMode = strMode
        updTry = 0
        updRemote = ""
        ' 手动检查的结论写在状态行，先把上次自动检测留下的提示清掉，免得同一条版本说两遍；
        ' 自动检测反过来：结论只落在按钮旁那一行，底部状态行全程清空
        If strMode <> "silent" Then
            UpdNewHint ""
        Else
            UpdSetStatus "", ""
        End If
        UpdBusyUI True
        If strMode = "check" Or strMode = "silent" Then
            ' 网盘一般一两秒就回，GitHub 只是兜底；15 秒读不到版本就算失败，两段串起来也够
            updTimeoutMs = 120000
            ' 静默检测不写状态行，结论只落在“检查更新”旁那一行
            If strMode = "check" Then UpdNote "正在检查更新…", ""
        Else
            ' 下载 + 解压 + 替换，留足 5 分钟
            updTimeoutMs = 300000
            UpdNote "正在连 GitHub 下载新版本，请不要关闭工具箱…", ""
            ' 识别/监控还开着的话先停掉：它们正占着 ocr 目录里的脚本，正在运行的脚本可能替换失败
            On Error Resume Next
            If ocrWatchOn Then OcrWatchStop
            GhostMonStopQuiet
            Err.Clear
            On Error GoTo 0
        End If
        strOut = fso.GetSpecialFolder(2) & "\gadget_update.txt"
        updOutFile = strOut
        On Error Resume Next
        If fso.FileExists(strOut) Then fso.DeleteFile strOut, True
        strCmd = PsCmdFile(strPs1, False)
        If strMode = "check" Or strMode = "silent" Then
            strCmd = strCmd & " -Mode check"
        Else
            ' 自动更新这条永远带 -NoCloud：包只有 GitHub 有，别再去网盘绕一圈
            strCmd = strCmd & " -Mode apply -NoCloud"
        End If
        strCmd = strCmd & " -Root " & ocrQuote & UpdRootDir() & ocrQuote & " -OutFile " & ocrQuote & strOut & ocrQuote
        CreateObject("WScript.Shell").Run strCmd, 0, False
        Err.Clear
        On Error GoTo 0
        window.setTimeout "UpdPoll", 500
    End Sub
    ' 结果文件每步整份重写：读到 downloading/extracting/applying 就只更新状态行，读到终态才结算
    Sub UpdPoll
        Dim fso, strStatus, dic
        updTry = updTry + 1
        Set fso = CreateObject("Scripting.FileSystemObject")
        If fso.FileExists(updOutFile) Then
            On Error Resume Next
            Set dic = UpdParse(OcrReadFileSmart(updOutFile))
            strStatus = dic("status")
            Err.Clear
            On Error GoTo 0
            If strStatus = "checking" Then
                UpdNote "正在检查更新…", ""
            ElseIf strStatus = "downloading" Then
                UpdNote "正在下载新版本…", ""
            ElseIf strStatus = "extracting" Then
                UpdNote "正在解压…", ""
            ElseIf strStatus = "applying" Then
                UpdNote "正在替换文件…", ""
            ElseIf strStatus <> "" Then
                updBusy = False
                UpdBusyUI False
                UpdApply dic
                Exit Sub
            End If
        End If
        If updTry * 500 >= updTimeoutMs Then
            updBusy = False
            UpdBusyUI False
            ' 静默检测失败不打扰：清掉按钮旁的旧提示，下次开工具箱再试，不写红字
            If updMode = "silent" Then
                UpdNewHint ""
                UpdSetStatus "", ""
                Exit Sub
            End If
            If updMode = "check" Then
                UpdNote "检查超时了：网络有点慢，或被安全软件拦了 PowerShell，隔一会儿再点一次", "#b33"
            Else
                UpdNote "更新还没完成：网络太慢，或被安全软件拦了 PowerShell，隔一会儿再点“检查更新”", "#b33"
            End If
            Exit Sub
        End If
        window.setTimeout "UpdPoll", 500
    End Sub
    Function UpdParse(strText)
        Dim dic, arrLine, i, strLine, n
        Set dic = CreateObject("Scripting.Dictionary")
        arrLine = Split(Replace(strText, vbCrLf, vbLf), vbLf)
        For i = 0 To UBound(arrLine)
            strLine = arrLine(i)
            n = InStr(strLine, "=")
            If n > 1 Then dic(Left(strLine, n - 1)) = Mid(strLine, n + 1)
        Next
        Set UpdParse = dic
    End Function
    Function UpdErrorText(strDetail)
        If strDetail = "" Then
            UpdErrorText = "未知错误"
        ElseIf Len(strDetail) > 400 Then
            UpdErrorText = Left(strDetail, 400) & "…"
        Else
            UpdErrorText = strDetail
        End If
    End Function
    ' 自动更新没成功（GitHub 上还没发布、连不上、或包不对）：弹窗不关，原因写在窗里，
    ' 链接还在，玩家可以再点一次或直接手动下载
    Sub UpdAutoFail(strWhy)
        Dim strBody
        strBody = strWhy & "。<br><br>" & _
            "可以隔一会儿再点一次「自动更新」，或者用下面的链接手动下载——" & _
            "zip 解压后覆盖原来的文件夹，exe 直接替换原来的 exe。"
        UpdDlgShow "自动更新失败", strBody
        ' 先摆好弹窗再写红字：UpdDlgShow 会清空窗内那行提示
        UpdNote "自动更新失败，请重新检查并手动下载更新", "#b33"
    End Sub
    ' 静默检测的结论只写按钮旁那一行：有新版本就亮出来，其余（已最新/本地更新/读不到）一律清空，
    ' 不弹窗、不写红字——开机自动跑的东西不该打断人
    Sub UpdApplySilent(strStatus, strLocal, strRemote)
        ' 检测跑的过程中把开关关掉了：结论不再展示（这条提示只属于开了自动检测的人）
        If Not updAutoOn Then
            UpdNewHint ""
            Exit Sub
        End If
        If strStatus = "available" Or strStatus = "manual" Then
            If strRemote = "" Then
                UpdNewHint ""
            Else
                UpdNewHint "有新版本 v" & strRemote & "（当前 v" & strLocal & "），点“检查更新”"
            End If
        Else
            UpdNewHint ""
        End If
    End Sub
    Sub UpdApply(dic)
        Dim strStatus, strLocal, strRemote, strDetail, strAsk, lngFiles, strMsg, strSource, strWhere, strLink, strBody
        strStatus = ""
        strLocal = ""
        strRemote = ""
        strDetail = ""
        strMsg = ""
        strSource = ""
        strWhere = ""
        strLink = ""
        lngFiles = 0
        On Error Resume Next
        strStatus = dic("status")
        strLocal = dic("local")
        strRemote = dic("remote")
        strDetail = dic("detail")
        strMsg = dic("msg")
        strSource = dic("source")
        If dic("files") <> "" Then lngFiles = CLng(dic("files"))
        If dic.Exists("link") Then strLink = dic("link")
        Err.Clear
        On Error GoTo 0
        If strLink = "" Then strLink = UpdShareUrl()
        If strSource = "cloud" Then
            strWhere = "百度网盘"
        ElseIf strSource = "github" Then
            strWhere = "GitHub"
        Else
            strWhere = "自定义源"
        End If
        If strLocal <> "" Then
            updLocal = strLocal
            UpdShowVersionText strLocal
        End If
        updRemote = strRemote
        ' 静默检测到此为止：不弹窗、不弹询问，也不替玩家下载
        If updMode = "silent" Then
            ' 底部状态行不留字：开机时不该出现“正在检查更新…”或上次手动检查的旧结论
            UpdSetStatus "", ""
            UpdApplySilent strStatus, updLocal, strRemote
            Exit Sub
        End If
        If strStatus = "available" Then
            If updMode = "check" Then
                ' 拼成变量再问：多行 If 条件（续行）在静态校验里数不准缩进层次
                strAsk = "发现新版本 v" & strRemote & "（当前 v" & strLocal & "，版本来自" & strWhere & "）。" & vbCrLf & vbCrLf & _
                    "现在下载并替换本地文件吗？" & vbCrLf & _
                    "· 约 1~2 分钟，期间请不要关闭工具箱" & vbCrLf & _
                    "· 锁定的角色、框选区域、宠环记录等本机数据都会保留" & vbCrLf & _
                    "· 题库会换成新版本的，旧题库先备份到 app\data\ocr_tiku.prev.txt"
                If MsgBox(strAsk, vbYesNo + vbQuestion, "检查更新") = vbYes Then
                    UpdRun "apply"
                Else
                    UpdSetStatus "有新版本 v" & strRemote & "，想更新时再点“检查更新”", ""
                End If
            Else
                UpdNote "正在更新…", ""
            End If
            Exit Sub
        End If
        If strStatus = "applied" Then
            ' 自动更新成功后先关弹窗，把位置让给“更新完成”的提示
            If updMode = "auto" Then UpdDlgClose
            If strDetail <> "" Then
                UpdSetStatus "已更新到 v" & strRemote & "，但有文件没能替换（重开工具箱后再点一次检查更新）", "#b33"
                MsgBox "更新完成，但下面这些文件被占用没能替换：" & vbCrLf & vbCrLf & strDetail & vbCrLf & vbCrLf & _
                    "关闭工具箱重新打开，再点一次“检查更新”就能补齐。", vbExclamation, "更新"
            Else
                UpdSetStatus "已更新到 v" & strRemote & "，关闭重开生效", "#2e8b57"
                MsgBox "工具箱已更新到 v" & strRemote & "（共替换 " & lngFiles & " 个文件）。" & vbCrLf & vbCrLf & _
                    "关闭工具箱再重新打开就生效了。" & vbCrLf & _
                    "本机数据（锁定角色、框选区域、宠环记录）都还在；题库已换成新版本的，旧题库备份在 app\data\ocr_tiku.prev.txt。", _
                    vbInformation, "更新完成"
            End If
            Exit Sub
        End If
        If strStatus = "latest" Then
            If updMode = "auto" Then
                ' 网盘说有新版本，GitHub 上却还是旧的（多半还没推上去）：自动这条路走不通
                UpdAutoFail "GitHub 上现在还是 v" & strRemote & "，新版本多半还没推上去"
                Exit Sub
            End If
            UpdNote "已是最新版本 v" & strLocal, "#2e8b57"
            If updMode = "apply" Then MsgBox "已经是最新版本 v" & strLocal & "，无需更新。", vbInformation, "检查更新"
            Exit Sub
        End If
        If strStatus = "local_newer" Then
            If updMode = "auto" Then
                UpdAutoFail "GitHub 上的版本 v" & strRemote & " 比本地的 v" & strLocal & " 还旧"
                Exit Sub
            End If
            UpdNote "本地 v" & strLocal & " 比远程 v" & strRemote & " 新，不更新", ""
            Exit Sub
        End If
        ' 网盘只肯报版本、不给匿名下载：弹窗里给分享链接，旁边的“自动更新”改走 GitHub
        If strStatus = "manual" Then
            updOffer = strRemote
            updLink = strLink
            strBody = "现在用的是 v" & strLocal & "，<b>" & strWhere & "</b>上已经有 <b>v" & strRemote & "</b>。" & "<br><br>" & _
                "· 点「自动更新」：去 GitHub 查一遍并自动下载替换，约 1~2 分钟；锁定的角色、框选区域、宠环记录都保留。" & "<br>" & _
                "· GitHub 连不上、或者还没推上去时会在这里说明，那就用下面的链接手动下载：" & _
                "zip 解压后覆盖原文件夹，exe 直接替换原来的 exe。"
            UpdDlgShow "发现新版本 v" & strRemote, strBody
            ' 窗里已经把版本和怎么更新都说全了，状态行不再重复一条
            UpdSetStatus "", ""
            Exit Sub
        End If
        ' 网盘目录还是空的、GitHub 也没读到版本：多半是发布那边没传完，不怪玩家网络
        If strMsg = "pan_empty" Then
            If updMode = "auto" Then
                UpdAutoFail "GitHub 上没读到 v" & updOffer & "，网盘里也还没看到新包"
                Exit Sub
            End If
            UpdSetStatus "网盘里还没看到新包，GitHub 也没读到新版本", "#b33"
            strAsk = "百度网盘里还没看到新版本，GitHub 那边也没读到，所以先没动你的文件。" & vbCrLf & vbCrLf & _
                "多半是刚发布、包还没传完，过十分钟再点一次“检查更新”就行。" & vbCrLf & _
                "你自己的网要是也断着，先连上网再点。" & vbCrLf & vbCrLf & _
                "想先去分享页扫一眼也可以：" & vbCrLf & strLink & vbCrLf & vbCrLf & _
                "要现在打开吗？"
            If MsgBox(strAsk, vbYesNo + vbQuestion, "检查更新") = vbYes Then UpdOpenLink strLink
            Exit Sub
        End If
        ' 网盘已发布、但自动下载源还没跟上：宁可不动文件，也不能把本地换成旧包
        If strMsg = "package_stale" Then
            If updMode = "auto" Then
                UpdAutoFail "能自动下载的包还是旧的，装了会把你本地换回旧版，所以没动文件"
                Exit Sub
            End If
            UpdSetStatus "百度网盘上已经是 v" & strRemote & "，但能自动下载的包还是旧的", "#b33"
            strAsk = "百度网盘分享里已经有 v" & strRemote & "，但自动下载的包还没跟上，所以这次没动你的文件，免得把本地换回旧版。" & vbCrLf & vbCrLf & _
                "想现在就用新版的话，可以打开分享页手动下载；也可以等发布那边同步好，再点一次“检查更新”。" & vbCrLf & vbCrLf & _
                "要现在打开分享页吗？"
            If MsgBox(strAsk, vbYesNo + vbQuestion, "检查更新") = vbYes Then UpdOpenLink strLink
            Exit Sub
        End If
        If updMode = "auto" Then
            UpdAutoFail "没连上 GitHub，或者被安全软件拦了 PowerShell（" & UpdErrorText(strDetail) & "）"
            Exit Sub
        End If
        UpdSetStatus "没能检查更新，稍后再点一次试试", "#b33"
        strAsk = "这次没检查成功，多半是这两种情况：" & vbCrLf & _
            "· 网络不通：浏览器也打不开 GitHub 或百度网盘" & vbCrLf & _
            "· 安全软件把工具箱偷偷调起的 PowerShell 拦了" & vbCrLf & vbCrLf & _
            "连着网再点一次“检查更新”通常就好了。" & vbCrLf & _
            "也可以直接去百度网盘分享页下载新版（zip 解压覆盖，或者换掉 exe）：" & vbCrLf & _
            strLink & vbCrLf & vbCrLf & _
            "技术细节（给排查用，看不懂没关系）：" & vbCrLf & UpdErrorText(strDetail) & vbCrLf & vbCrLf & _
            "要现在打开分享页吗？"
        If MsgBox(strAsk, vbYesNo + vbExclamation, "更新失败") = vbYes Then UpdOpenLink strLink
    End Sub
    Sub OcrLoadConfig
        Dim fso, f, strLine, arrPart, arrSeg
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        If fso.FileExists(OcrConfigFile()) Then
            Set f = fso.OpenTextFile(OcrConfigFile(), 1)
            Do Until f.AtEndOfStream
                strLine = f.ReadLine
                arrPart = Split(strLine, "=")
                If UBound(arrPart) = 1 Then
                    If arrPart(0) = "proc" Then ocrProcName = Trim(arrPart(1))
                    If arrPart(0) = "region" Then
                        arrSeg = Split(arrPart(1), ",")
                        If UBound(arrSeg) = 3 Then
                            ocrRelX = CLng(arrSeg(0))
                            ocrRelY = CLng(arrSeg(1))
                            ocrRelW = CLng(arrSeg(2))
                            ocrRelH = CLng(arrSeg(3))
                        End If
                    End If
                End If
            Loop
            f.Close
        End If
        On Error GoTo 0
    End Sub
    Sub OcrSaveConfig
        Dim fso, f
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        ' 配置进了 data 子目录，首次保存时目录可能还不存在
        OcrEnsureData
        Set f = fso.CreateTextFile(OcrConfigFile(), True)
        If Err.Number = 0 Then
            f.WriteLine "proc=" & ocrProcName
            f.WriteLine "region=" & ocrRelX & "," & ocrRelY & "," & ocrRelW & "," & ocrRelH
        End If
        Err.Clear
        If Not f Is Nothing Then f.Close
        On Error GoTo 0
    End Sub
    ' 统计题库有效条目（非空、非 # 注释、含分隔符）；同时缓存全部行供“搜索题库”使用
    Sub OcrRefreshTiku
        Dim strText, arrLines, strLine, n
        n = 0
        strText = ""
        ocrTikuLines = Array()
        ' 题库换了，拼音首字母 / 全拼缓存一并作废
        ocrTikuPy = Array()
        ocrTikuPyf = Array()
        ocrTikuPyReady = False
        On Error Resume Next
        If CreateObject("Scripting.FileSystemObject").FileExists(OcrTikuFile()) Then strText = OcrReadFileSmart(OcrTikuFile())
        Err.Clear
        On Error GoTo 0
        If strText <> "" Then
            arrLines = Split(Replace(Replace(strText, vbCrLf, vbLf), vbCr, vbLf), vbLf)
            ocrTikuLines = arrLines
            For Each strLine In arrLines
                strLine = Trim(strLine)
                If strLine <> "" And Left(strLine, 1) <> "#" Then
                    If InStr(strLine, "|") > 0 Or InStr(strLine, vbTab) > 0 Then n = n + 1
                End If
            Next
        End If
        ocrTikuCount = n
        OcrRefreshStatus
    End Sub
    Sub OcrRefreshStatus
        Dim strInfo
        strInfo = "题库 " & ocrTikuCount & " 条 · "
        If ocrRelW > 0 Then
            strInfo = strInfo & "区域 " & ocrRelW & "×" & ocrRelH
        Else
            ' 不框选时脚本只取窗口中间那块（题目对话框所在位置），不再整窗扫
            strInfo = strInfo & "中间区域识别（自动）"
        End If
        If ocrTikuCount = 0 Then strInfo = strInfo & " · 未命中时用网页搜索"
        On Error Resume Next
        document.getElementById("ocrStatus").innerText = strInfo
        On Error GoTo 0
    End Sub
    Sub ToggleOcrSection
        ToggleSection "ocrSection", "ocrToggleHint"
        If document.getElementById("ocrSection").style.display <> "none" Then OcrRefreshStatus
    End Sub
    Sub OcrSetBusy(bBusy)
        ocrBusy = bBusy
        document.getElementById("btnOcrRun").disabled = bBusy
        document.getElementById("btnOcrCal").disabled = bBusy
        OcrRefreshWatchBtn
    End Sub
    ' 实时按钮随状态换文案与配色（运行中变红“停止实时”，仍可点击）
    Sub OcrRefreshWatchBtn
        Dim btn
        On Error Resume Next
        Set btn = document.getElementById("btnOcrWatch")
        If btn Is Nothing Then Exit Sub
        If ocrWatchOn Then
            btn.innerText = "■ 停止实时"
            btn.className = "pet-hist-delete"
            btn.disabled = False
        Else
            btn.innerText = "▶ 实时识别"
            btn.className = ""
            btn.disabled = False
        End If
        On Error GoTo 0
    End Sub
    ' 组装调用识别脚本的命令行（单次与实时共用，实时模式在外层追加 -Watch/-StopFile/-PidFile）
    Function OcrPsCommand(strPs1, strOut)
        Dim fso, strCmd
        Set fso = CreateObject("Scripting.FileSystemObject")
        strCmd = PsCmdFile(strPs1, False)
        strCmd = strCmd & " -OutFile " & ocrQuote & strOut & ocrQuote
        If fso.FileExists(OcrTikuFile()) Then strCmd = strCmd & " -TikuFile " & ocrQuote & OcrTikuFile() & ocrQuote
        If ocrProcName <> "" Then strCmd = strCmd & " -ProcName " & ocrQuote & ocrProcName & ocrQuote
        If ocrRelW > 0 Then strCmd = strCmd & " -RelX " & ocrRelX & " -RelY " & ocrRelY & " -RelW " & ocrRelW & " -RelH " & ocrRelH
        OcrPsCommand = strCmd
    End Function
    Sub OcrRun
        Dim fso, objShell, strPs1, strCmd
        If ocrBusy Then Exit Sub
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set objShell = CreateObject("WScript.Shell")
        strPs1 = OcrRoot() & "\ocr\ocr_answer.ps1"
        If Not fso.FileExists(strPs1) Then
            MsgBox "找不到识别脚本：" & vbCrLf & strPs1 & vbCrLf & vbCrLf & "请确认工具箱目录下存在 ocr 文件夹（含 ocr_answer.ps1 与 ocr_region.ps1）。", vbExclamation, "缺少文件"
            Exit Sub
        End If
        ocrOutFile = fso.BuildPath(objShell.ExpandEnvironmentStrings("%TEMP%"), "gadget_ocr_result.txt")
        On Error Resume Next
        If fso.FileExists(ocrOutFile) Then fso.DeleteFile ocrOutFile, True
        On Error GoTo 0
        strCmd = OcrPsCommand(strPs1, ocrOutFile)
        objShell.Run strCmd, 0, False
        OcrSetBusy True
        ocrPollCount = 0
        document.getElementById("ocrAnswer").innerHTML = "<span class=""tip"">正在截取游戏画面并识别，请稍候…</span>"
        window.setTimeout "OcrPoll", 200
    End Sub
    ' 轮询识别结果文件（ps1 写完会落 EOF 行，避免读到半截内容）
    Sub OcrPoll
        Dim fso, strText
        Set fso = CreateObject("Scripting.FileSystemObject")
        ocrPollCount = ocrPollCount + 1
        If fso.FileExists(ocrOutFile) Then
            strText = OcrReadText(ocrOutFile, "utf-8")
            If InStr(strText, "EOF" & vbTab) > 0 Then
                OcrSetBusy False
                OcrApplyResult strText
                Exit Sub
            End If
        End If
        If ocrPollCount > 90 Then
            OcrSetBusy False
            document.getElementById("ocrAnswer").innerHTML = "<span class=""ocr-error"">识别超时：先确认游戏窗口处于打开状态；反复超时多半是安全软件拦截了 PowerShell 脚本，把工具箱目录加入信任后再试（见 README）。</span>"
            Exit Sub
        End If
        window.setTimeout "OcrPoll", 200
    End Sub
    ' 解析识别脚本回传的结果文本，放进 ocrMeta / ocrHits / ocrTextArr（单次与实时共用）
    Sub OcrParseResult(strRaw)
        Dim arrLines, strLine, arrPart
        Set ocrMeta = CreateObject("Scripting.Dictionary")
        Set ocrHits = CreateObject("Scripting.Dictionary")
        ocrTextArr = Array()
        arrLines = Split(Replace(strRaw, vbCr, ""), vbLf)
        For Each strLine In arrLines
            arrPart = Split(strLine, vbTab)
            If UBound(arrPart) >= 2 Then
                Select Case arrPart(0)
                    Case "META"
                        ocrMeta(arrPart(1)) = arrPart(2)
                    Case "LINE"
                        AppendValue ocrTextArr, arrPart(2)
                    Case "HIT"
                        If UBound(arrPart) >= 5 Then ocrHits(arrPart(1)) = Array(arrPart(2), arrPart(3), arrPart(4), arrPart(5))
                End Select
            End If
        Next
    End Sub
    ' 结果统一入口：ok 且画面有变化才重绘答案卡；等待类状态只改状态行，答案卡保持上一次内容
    Sub OcrApplyResult(strRaw)
        Dim strCode, strChanged, strErr
        OcrParseResult strRaw
        strCode = "error"
        If ocrMeta.Exists("status") Then strCode = ocrMeta("status")
        strChanged = "1"
        If ocrMeta.Exists("changed") Then strChanged = ocrMeta("changed")
        If strCode = "ok" Then
            If ocrMeta.Exists("tiku") Then ocrLastTiku = ocrMeta("tiku")
            If ocrMeta.Exists("lines") Then ocrLastLines = ocrMeta("lines")
            If ocrMeta.Exists("ms") Then ocrLastMs = ocrMeta("ms")
            ' changed=0：画面与上次识别时一致，答案卡内容不变，省掉一次重绘（避免肉眼可见的闪烁）
            If strChanged = "0" And ocrWatchOn And ocrLastStatus = "ok" Then
                OcrUpdateStatusLine ""
            Else
                OcrRenderResult
                OcrUpdateStatusLine ""
            End If
        ElseIf strCode = "no_window" Then
            OcrUpdateStatusLine "未找到游戏窗口（打开游戏后自动开始）"
        ElseIf strCode = "minimized" Then
            OcrUpdateStatusLine "游戏窗口已最小化"
        ElseIf strCode = "not_foreground" Then
            OcrUpdateStatusLine "切到游戏窗口后自动识别"
        Else
            strErr = ""
            If ocrMeta.Exists("error") Then strErr = ocrMeta("error")
            document.getElementById("ocrAnswer").innerHTML = "<span class=""ocr-error"">" & OcrErrorText(strErr) & "</span>"
            OcrUpdateStatusLine "识别失败"
        End If
        ocrLastStatus = strCode
    End Sub
    ' 状态行文案：实时模式带“实时识别中”，单次模式只报本次结果
    Sub OcrUpdateStatusLine(strState)
        Dim strInfo, n
        n = ocrLastTiku
        If n = 0 Then n = ocrTikuCount
        If ocrWatchOn Then
            strInfo = "实时识别中 · 题库 " & n & " 条"
        Else
            strInfo = "题库 " & n & " 条"
        End If
        If ocrLastLines <> "" Then strInfo = strInfo & " · 识别 " & ocrLastLines & " 行 · 耗时 " & ocrLastMs & " ms"
        If n = 0 Then strInfo = strInfo & " · 未命中时用网页搜索"
        If strState <> "" Then strInfo = strInfo & " · " & strState
        On Error Resume Next
        document.getElementById("ocrStatus").innerText = strInfo
        On Error GoTo 0
    End Sub
    ' 从结果文本里取 EOF 行的时间戳：实时模式靠它判断 ps1 是否又完成了一轮
    Function OcrEofTicks(strRaw)
        Dim arrLines, i
        OcrEofTicks = ""
        arrLines = Split(Replace(strRaw, vbCr, ""), vbLf)
        For i = 0 To UBound(arrLines)
            If Left(arrLines(i), 4) = "EOF" & vbTab Then OcrEofTicks = Mid(arrLines(i), 5)
        Next
    End Function
    ' ============ 实时识别：ps1 常驻循环（-Watch），本页按 EOF 时间戳轮询取结果 ============
    Sub OcrWatchToggle
        If ocrStopping Then Exit Sub
        If ocrWatchOn Then
            OcrWatchStop
        Else
            OcrWatchStart
        End If
    End Sub
    Sub OcrWatchStart
        Dim fso, objShell, strPs1, strCmd, strTmp
        If ocrBusy Or ocrStopping Then Exit Sub
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set objShell = CreateObject("WScript.Shell")
        strPs1 = OcrRoot() & "\ocr\ocr_answer.ps1"
        If Not fso.FileExists(strPs1) Then
            MsgBox "找不到识别脚本：" & vbCrLf & strPs1 & vbCrLf & vbCrLf & "请确认工具箱目录下存在 ocr 文件夹（含 ocr_answer.ps1 与 ocr_region.ps1）。", vbExclamation, "缺少文件"
            Exit Sub
        End If
        strTmp = objShell.ExpandEnvironmentStrings("%TEMP%")
        ocrOutFile = fso.BuildPath(strTmp, "gadget_ocr_watch.txt")
        ocrStopFile = fso.BuildPath(strTmp, "gadget_ocr_stop.txt")
        ocrPidFile = fso.BuildPath(strTmp, "gadget_ocr_pid.txt")
        ' 幂等收尾：上一轮若异常遗留进程（PID 文件还在），先按老 PID 终止再重新起
        OcrKillWatcher
        On Error Resume Next
        If fso.FileExists(ocrOutFile) Then fso.DeleteFile ocrOutFile, True
        If fso.FileExists(ocrStopFile) Then fso.DeleteFile ocrStopFile, True
        If fso.FileExists(ocrPidFile) Then fso.DeleteFile ocrPidFile, True
        On Error GoTo 0
        strCmd = OcrPsCommand(strPs1, ocrOutFile) & " -Watch " & OCR_WATCH_MS
        strCmd = strCmd & " -StopFile " & ocrQuote & ocrStopFile & ocrQuote & " -PidFile " & ocrQuote & ocrPidFile & ocrQuote
        objShell.Run strCmd, 0, False
        ocrWatchOn = True
        ocrLastEof = ""
        ocrLastStatus = ""
        ocrWatchMiss = 0
        OcrSetBusy True
        document.getElementById("ocrAnswer").innerHTML = "<span class=""tip"">实时识别已开启：切到游戏窗口，题目切换后会自动刷新答案（本窗口不会被抢焦点）。</span>"
        OcrUpdateStatusLine "正在启动…"
        window.setTimeout "OcrWatchPoll", 700
    End Sub
    ' 每 700ms 读一次结果文件；EOF 时间戳变了说明 ps1 又跑完一轮（没变就什么都不做，界面不闪）
    Sub OcrWatchPoll
        Dim fso, strText, strEof
        If Not ocrWatchOn Then Exit Sub
        Set fso = CreateObject("Scripting.FileSystemObject")
        If fso.FileExists(ocrOutFile) Then
            strText = OcrReadText(ocrOutFile, "utf-8")
            strEof = OcrEofTicks(strText)
        Else
            strText = ""
            strEof = ""
        End If
        If strEof <> "" And strEof <> ocrLastEof Then
            ocrLastEof = strEof
            ocrWatchMiss = 0
            OcrApplyResult strText
        Else
            ocrWatchMiss = ocrWatchMiss + 1
        End If
        ' 长时间没有新一轮：先提示，再判定后台进程异常退出（约 8s / 30s）
        If ocrWatchMiss = 12 Then
            OcrUpdateStatusLine "识别脚本无响应，稍候…"
        End If
        If ocrWatchMiss >= 42 Then
            ocrWatchOn = False
            OcrSetBusy False
            document.getElementById("ocrAnswer").innerHTML = "<span class=""ocr-error"">实时识别已中断（后台识别脚本无响应），请重新点“实时识别”；反复出现多为安全软件拦截了 PowerShell（见 README）。</span>"
            Exit Sub
        End If
        window.setTimeout "OcrWatchPoll", 700
    End Sub
    ' 停止：先落停止文件让 ps1 跑完当前一轮后自行退出，5s 内没退再按 PID 终止
    Sub OcrWatchStop
        Dim fso, f
        If Not ocrWatchOn Then Exit Sub
        ocrWatchOn = False
        ocrStopping = True
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        Set f = fso.CreateTextFile(ocrStopFile, True)
        If Err.Number = 0 Then f.Close
        Err.Clear
        On Error GoTo 0
        OcrSetBusy False
        OcrUpdateStatusLine "正在停止…"
        ocrStopWait = 0
        window.setTimeout "OcrWatchStopCheck", 500
    End Sub
    Sub OcrWatchStopCheck
        ocrStopWait = ocrStopWait + 1
        If OcrWatcherAlive() And ocrStopWait < 10 Then
            window.setTimeout "OcrWatchStopCheck", 500
            Exit Sub
        End If
        OcrKillWatcher
        OcrCleanFiles
        ocrStopping = False
        OcrRefreshStatus
        document.getElementById("ocrAnswer").innerHTML = "<span class=""tip"">实时识别已停止。</span>"
    End Sub
    Function OcrWatcherAlive()
        Dim fso, strPid
        OcrWatcherAlive = False
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        If fso.FileExists(ocrPidFile) Then
            strPid = Trim(fso.OpenTextFile(ocrPidFile, 1).ReadAll)
            If IsNumeric(strPid) Then OcrWatcherAlive = OcrProcessAlive(CLng(strPid))
        End If
        Err.Clear
        On Error GoTo 0
    End Function
    Function OcrProcessAlive(lngPid)
        Dim wmi, list, p
        OcrProcessAlive = False
        On Error Resume Next
        Set wmi = GetObject("winmgmts:\\.\root\cimv2")
        If Err.Number = 0 Then
            Set list = wmi.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE ProcessId=" & lngPid)
            If Err.Number = 0 Then
                For Each p In list
                    OcrProcessAlive = True
                Next
            End If
        End If
        Err.Clear
        On Error GoTo 0
    End Function
    ' 兜底终止：只在命令行确实指向本识别脚本时才结束进程（PID 可能已被系统复用）
    Sub OcrKillWatcher
        Dim fso, strPid, wmi, list, p
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        If fso.FileExists(ocrPidFile) Then
            strPid = Trim(fso.OpenTextFile(ocrPidFile, 1).ReadAll)
            If IsNumeric(strPid) Then
                Set wmi = GetObject("winmgmts:\\.\root\cimv2")
                If Err.Number = 0 Then
                    Set list = wmi.ExecQuery("SELECT ProcessId, CommandLine FROM Win32_Process WHERE ProcessId=" & CLng(strPid))
                    If Err.Number = 0 Then
                        For Each p In list
                            If InStr(LCase("" & p.CommandLine), "ocr_answer.ps1") > 0 Then p.Terminate
                        Next
                    End If
                End If
            End If
        End If
        Err.Clear
        On Error GoTo 0
    End Sub
    Sub OcrCleanFiles
        Dim fso
        Set fso = CreateObject("Scripting.FileSystemObject")
        On Error Resume Next
        If ocrStopFile <> "" Then
            If fso.FileExists(ocrStopFile) Then fso.DeleteFile ocrStopFile, True
        End If
        If ocrPidFile <> "" Then
            If fso.FileExists(ocrPidFile) Then fso.DeleteFile ocrPidFile, True
        End If
        Err.Clear
        On Error GoTo 0
    End Sub
    Sub OcrRenderResult
        Dim i, arrHit, strHtml, strTxtHtml, strQuestion, strAnswer, strScore, intHitLine
        Dim intRows, intPx
        intHitLine = -1
        strQuestion = ""
        strAnswer = ""
        strScore = ""
        If ocrHits.Exists("1") Then
            arrHit = ocrHits("1")
            strScore = arrHit(0)
            intHitLine = CLng(arrHit(1))
            strQuestion = arrHit(2)
            strAnswer = arrHit(3)
        End If
        ocrAnswerText = strAnswer
        ' 网页搜索用的题干：取识别结果中最长的一行（通常就是题目）
        ocrSearchText = ""
        For i = 0 To UBound(ocrTextArr)
            If Len(Replace(ocrTextArr(i), " ", "")) > Len(ocrSearchText) Then ocrSearchText = Replace(ocrTextArr(i), " ", "")
        Next
        strHtml = "<table class=""ocr-ans-table""><tr><th class=""x1"">识别结果</th></tr><tr><td class=""ocr-ans-cell"">"
        If strAnswer <> "" Then
            strHtml = strHtml & "<div class=""ocr-ans-main"">建议答案：<b>" & OcrHtml(strAnswer) & "</b></div>"
            strHtml = strHtml & "<div class=""ocr-ans-q"">匹配题目：" & OcrHtml(strQuestion) & "</div>"
            strHtml = strHtml & "<div class=""ocr-ans-meta"">匹配度 " & FormatNumber(CDbl(strScore) * 100, 0) & "%"
            If ocrHits.Count > 1 Then
                strHtml = strHtml & " ｜ 备选："
                For i = 2 To ocrHits.Count
                    If ocrHits.Exists(CStr(i)) Then
                        arrHit = ocrHits(CStr(i))
                        strHtml = strHtml & OcrHtml(arrHit(3)) & "（" & FormatNumber(CDbl(arrHit(0)) * 100, 0) & "%）　"
                    End If
                Next
            End If
            strHtml = strHtml & "</div>"
        Else
            strHtml = strHtml & "<div class=""ocr-ans-main"">未命中题库</div>"
            strHtml = strHtml & "<div class=""ocr-ans-meta"">可点“网页搜索”直接搜识别到的题目，或点“编辑题库”补充答案。</div>"
        End If
        strHtml = strHtml & "</td></tr></table>"
        strTxtHtml = ""
        For i = 0 To UBound(ocrTextArr)
            If i = intHitLine Then
                strTxtHtml = strTxtHtml & "<div class=""ocr-text-line ocr-line-hit"">" & OcrHtml(ocrTextArr(i)) & "</div>"
            Else
                strTxtHtml = strTxtHtml & "<div class=""ocr-text-line"">" & OcrHtml(ocrTextArr(i)) & "</div>"
            End If
        Next
        If strTxtHtml = "" Then strTxtHtml = "<span class=""tip"">（未识别到文字，可尝试重新框选识别区域）</span>"
        ' 原文区高度按行数算子（行高 13px×1.7≈22px + 上下内边距），最多 7 行，超出在框内滚动
        intRows = UBound(ocrTextArr) + 1
        intPx = intRows * 22 + 12
        If intPx > 154 Then intPx = 154
        If intPx < 40 Then intPx = 40
        strHtml = strHtml & "<div class=""ocr-text-head"">识别原文（" & intRows & " 行，超出可滚动查看）</div>"
        strHtml = strHtml & "<div class=""ocr-text"" style=""height: " & intPx & "px;"">" & strTxtHtml & "</div>"
        document.getElementById("ocrAnswer").innerHTML = strHtml
        OcrRevealAnswer
    End Sub
    ' 换题后把答案卡带回视野：答案卡在 ocrAnswer 顶部、原文区限高滚动；
    ' 只有答案卡顶部 120px 左右不可见时才滚动，避免用户正看着原文时被抽走；
    ' 落点让答案卡顶边距视口顶端 16px（与移动版 tikuRevealResult 同一取值），上方留一条原文区的边暗示可上滑
    Sub OcrRevealAnswer
        Dim el, top, vh, st
        On Error Resume Next
        Set el = document.getElementById("ocrAnswer")
        If el Is Nothing Then Exit Sub
        top = OcrAbsTop(el)
        vh = document.body.clientHeight
        st = document.body.scrollTop
        If top < st Or top + 120 > st + vh Then
            If top > 16 Then
                document.body.scrollTop = top - 16
            Else
                document.body.scrollTop = 0
            End If
            PinTopButtons
        End If
        On Error GoTo 0
    End Sub
    ' 元素在文档中的绝对纵坐标（offsetParent 链求和）
    Function OcrAbsTop(el)
        Dim t, p
        t = 0
        Set p = el
        On Error Resume Next
        Do While Not p Is Nothing
            t = t + p.offsetTop
            Set p = p.offsetParent
        Loop
        On Error GoTo 0
        OcrAbsTop = t
    End Function
    Function OcrHtml(strText)
        Dim s
        s = CStr(strText)
        s = Replace(s, "&", "&amp;")
        s = Replace(s, "<", "&lt;")
        s = Replace(s, ">", "&gt;")
        OcrHtml = s
    End Function
    Function OcrErrorText(strCode)
        Select Case strCode
            Case "GAME_WINDOW_NOT_FOUND"
                OcrErrorText = "未找到梦幻西游游戏窗口：请先打开游戏，窗口不能最小化（多开时自动取面积最大的那个）。"
            Case "OCR_NO_LANGUAGE_PACK"
                OcrErrorText = "系统缺少中文 OCR 语言包，请在系统设置的“时间和语言 → 语言”中为中文（简体）安装 OCR 可选功能。"
            Case "REGION_INVALID"
                OcrErrorText = "识别区域超出屏幕范围，请重新点“框选识别区域”。"
            Case ""
                OcrErrorText = "识别脚本执行失败，未返回具体原因。最常见的情况是安全软件拦下了 PowerShell 脚本：把工具箱目录加入信任后再试（见 README）。"
            Case Else
                OcrErrorText = "识别失败：" & strCode
        End Select
    End Function
    ' 框选识别区域：屏幕变暗后拖框，结果按“相对游戏窗口左上角”的偏移保存（窗口移动后仍可用）
    Sub OcrCalibrate
        Dim fso, objShell, strTmp, strPs1, strCmd
        If ocrBusy Then Exit Sub
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set objShell = CreateObject("WScript.Shell")
        strPs1 = OcrRoot() & "\ocr\ocr_region.ps1"
        If Not fso.FileExists(strPs1) Then
            MsgBox "找不到框选脚本：" & vbCrLf & strPs1, vbExclamation, "缺少文件"
            Exit Sub
        End If
        If MsgBox("框选操作说明：" & vbCrLf & "1. 先把游戏切到答题界面，让题目与选项都显示出来" & vbCrLf & "2. 点“确定”后整个屏幕会变暗，按住鼠标左键拖出一个框，把题目与选项框住" & vbCrLf & "3. 松开鼠标即完成；不想框选时按 Esc 取消" & vbCrLf & vbCrLf & "是否继续？", vbYesNo + vbQuestion, "框选识别区域") <> vbYes Then Exit Sub
        strTmp = objShell.ExpandEnvironmentStrings("%TEMP%")
        ocrRegionFile = fso.BuildPath(strTmp, "gadget_ocr_region.txt")
        On Error Resume Next
        If fso.FileExists(ocrRegionFile) Then fso.DeleteFile ocrRegionFile, True
        On Error GoTo 0
        strCmd = PsCmdFile(strPs1, True) & " -OutFile " & ocrQuote & ocrRegionFile & ocrQuote
        If ocrProcName <> "" Then strCmd = strCmd & " -ProcName " & ocrQuote & ocrProcName & ocrQuote
        objShell.Run strCmd, 0, False
        OcrSetBusy True
        ocrPollCount = 0
        document.getElementById("ocrAnswer").innerHTML = "<span class=""tip"">请在屏幕上拖框选择答题区域（按 Esc 取消）…</span>"
        window.setTimeout "OcrPollRegion", 300
    End Sub
    Sub OcrPollRegion
        Dim fso, strText, arrLines, strLine, arrPart
        Set fso = CreateObject("Scripting.FileSystemObject")
        ocrPollCount = ocrPollCount + 1
        If fso.FileExists(ocrRegionFile) Then
            strText = OcrReadText(ocrRegionFile, "utf-8")
            If Len(strText) > 0 Then
                arrLines = Split(Replace(strText, vbCr, ""), vbLf)
                For Each strLine In arrLines
                    arrPart = Split(strLine, vbTab)
                    If UBound(arrPart) = 4 Then
                        If arrPart(0) = "CANCEL" Then
                            OcrSetBusy False
                            document.getElementById("ocrAnswer").innerHTML = "<span class=""tip"">已取消框选，仍按当前区域识别。</span>"
                            Exit Sub
                        End If
                        If arrPart(0) = "REL" Then
                            OcrSetBusy False
                            If CLng(arrPart(1)) < 0 Then
                                document.getElementById("ocrAnswer").innerHTML = "<span class=""ocr-error"">未找到游戏窗口，无法换算相对区域。请打开游戏后重新框选。</span>"
                                Exit Sub
                            End If
                            ocrRelX = CLng(arrPart(1))
                            ocrRelY = CLng(arrPart(2))
                            ocrRelW = CLng(arrPart(3))
                            ocrRelH = CLng(arrPart(4))
                            OcrSaveConfig
                            OcrRefreshStatus
                            document.getElementById("ocrAnswer").innerHTML = "<span class=""tip"">区域已保存（" & ocrRelW & "×" & ocrRelH & "），点“识别游戏画面”开始答题。</span>"
                            Exit Sub
                        End If
                    End If
                Next
                OcrSetBusy False
                document.getElementById("ocrAnswer").innerHTML = "<span class=""ocr-error"">框选结果无效，请重试。</span>"
                Exit Sub
            End If
        End If
        If ocrPollCount > 500 Then
            OcrSetBusy False
            document.getElementById("ocrAnswer").innerHTML = "<span class=""tip"">框选已超时结束（若每次都这样，多半是安全软件拦了框选脚本，见 README）。</span>"
            Exit Sub
        End If
        window.setTimeout "OcrPollRegion", 300
    End Sub
    Sub OcrClearRegion
        ocrRelX = -1
        ocrRelY = -1
        ocrRelW = 0
        ocrRelH = 0
        OcrSaveConfig
        OcrRefreshStatus
        document.getElementById("ocrAnswer").innerHTML = "<span class=""tip"">已恢复自动模式：只识别游戏窗口中间那块（题目与选项所在区域）。</span>"
    End Sub
    Sub OcrEditTiku
        Dim fso, objShell, strPath
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set objShell = CreateObject("WScript.Shell")
        strPath = OcrTikuFile()
        If Not fso.FileExists(strPath) Then OcrCreateTemplate strPath
        objShell.Run "notepad.exe " & ocrQuote & strPath & ocrQuote, 1, False
    End Sub
    ' 没有题库文件时生成带格式说明的模板（UTF-8 无 BOM）
    Sub OcrCreateTemplate(strPath)
        Dim strText
        strText = "# 答题题库：每行一条，格式为 题目|答案 ；以 # 开头的行是注释" & vbCrLf & _
            "# 答案可写完整选项（如 C. 王安石），也可只写关键字（如 王安石）" & vbCrLf & _
            "# 识别按相似度模糊匹配，允许个别错别字；匹配不到时可点“网页搜索”" & vbCrLf & _
            "#" & vbCrLf & _
            "# 示例（换成自己的题目后删除示例）：" & vbCrLf & _
            "下列哪位不是唐朝的诗人？|C. 王安石" & vbCrLf
        OcrWriteText strPath, strText
    End Sub
    Sub OcrImportTiku
        document.getElementById("fileOcrTiku").click
    End Sub
    Sub OcrImportFile
        Dim fso, strPath, strText
        Set fso = CreateObject("Scripting.FileSystemObject")
        strPath = document.getElementById("fileOcrTiku").value
        If strPath = "" Then Exit Sub
        If InStr(strPath, ":") = 0 Then
            MsgBox "无法取得所选文件的完整路径，请改用“编辑题库”手动粘贴内容。", vbExclamation, "导入题库"
            Exit Sub
        End If
        strText = OcrReadFileSmart(strPath)
        If Trim(strText) = "" Then
            MsgBox "所选文件没有内容。", vbExclamation, "导入题库"
            Exit Sub
        End If
        OcrWriteText OcrTikuFile(), strText
        OcrRefreshTiku
        MsgBox "题库已导入，共 " & ocrTikuCount & " 条。", vbInformation, "导入题库"
    End Sub
    ' 本地题库即时搜索：只比题目（答案不参与匹配）。纯字母关键词走三个拼音通道，优先级：
    ' 首字母连续（was → 王安石）> 全拼连续（wanganshi）> 包含关键词 > 首字母松序容错（拼音模糊）；
    ' 结果按这个优先级排序，题目用蓝色、命中字用黄底标出，一条关键词命中多题时也能分辨；最多列 50 条，点某条直接复制答案
    Sub OcrSearchTiku
        Dim strKey, i, j, n, intTmp, strLine, strQ, strHtml, arrPart, arrRes, arrRank, arrKind, arrPos
        Dim blnFull, blnPy, strPyKey, strKind, dblRate, arrHit
        strKey = Trim(document.getElementById("txtOcrSearch").value)
        arrRes = Array()
        arrRank = Array()
        arrKind = Array()
        arrPos = Array()
        blnFull = False
        blnPy = OcrIsPyKey(strKey)
        strPyKey = LCase(strKey)
        ' 缓存为空（如题库文件刚新建）时先载入一次
        If UBound(ocrTikuLines) < 0 Then OcrRefreshTiku
        ' 首字母串 / 全拼串按题目缓存，构建一次后后续按键直接复用
        If blnPy Then OcrBuildTikuPy
        If strKey <> "" Then
            For i = 0 To UBound(ocrTikuLines)
                strLine = Trim(ocrTikuLines(i))
                If strLine <> "" And Left(strLine, 1) <> "#" Then
                    If InStr(strLine, "|") > 0 Or InStr(strLine, vbTab) > 0 Then
                        arrPart = OcrSplitPair(strLine)
                        strQ = arrPart(0)
                        strKind = ""
                        arrHit = Array()
                        ' 汉字包含（0.95）：中文关键词的主通道，也兜住中英混合关键词
                        If InStr(1, strQ, strKey, 1) > 0 Then strKind = "sub"
                        ' 拼音三通道：连续首字母 > 连续全拼 > 松序容错（跨度限 Len+2，避免命中过散）
                        If blnPy And i <= UBound(ocrTikuPy) Then
                            If InStr(1, ocrTikuPy(i), strPyKey, 1) > 0 Then
                                strKind = "py"
                            ElseIf i <= UBound(ocrTikuPyf) Then
                                If InStr(1, ocrTikuPyf(i), strPyKey, 1) > 0 Then
                                    strKind = "pyf"
                                ElseIf strKind = "" And Len(strPyKey) >= 3 Then
                                    If OcrPyFuzzy(strPyKey, ocrTikuPy(i)) Then strKind = "pyz"
                                End If
                            End If
                        End If
                        ' 汉字模糊通道（缺字 / 错别字 / 近音字容错）：搜“洛阳自马石”也能命中“洛阳白马寺”，
                        ' 得分排在“包含关键词”之下、“拼音模糊”之上；arrHit 记下字面命中的题面位置，用于逐字变色
                        If strKind = "" And Not blnPy And Len(strKey) >= 2 And Len(strKey) <= 16 Then
                            If InStr(strKey, " ") = 0 And InStr(strKey, vbTab) = 0 And InStr(strKey, vbLf) = 0 Then
                                dblRate = OcrHanFuzzy(strKey, strQ, arrHit)
                                If dblRate > 0 Then strKind = "hz"
                            End If
                        End If
                        If strKind <> "" Then
                            AppendValue arrRes, strLine
                            AppendValue arrRank, OcrKindRank(strKind)
                            AppendValue arrKind, strKind
                            AppendValue arrPos, arrHit
                            ' 先多收一些再排序：边扫边在第 50 条截断会把拼音命中挤到后面
                            If UBound(arrRes) >= 199 Then
                                blnFull = True
                                Exit For
                            End If
                        End If
                    End If
                End If
            Next
        End If
        ' 按匹配方式分档排序（同档保持题库原序）
        For i = 0 To UBound(arrRes) - 1
            n = i
            For j = i + 1 To UBound(arrRes)
                If arrRank(j) < arrRank(n) Then n = j
            Next
            If n <> i Then
                strLine = arrRes(i)
                arrRes(i) = arrRes(n)
                arrRes(n) = strLine
                intTmp = arrRank(i)
                arrRank(i) = arrRank(n)
                arrRank(n) = intTmp
                strKind = arrKind(i)
                arrKind(i) = arrKind(n)
                arrKind(n) = strKind
                arrHit = arrPos(i)
                arrPos(i) = arrPos(n)
                arrPos(n) = arrHit
            End If
        Next
        If UBound(arrRes) >= 50 Then
            ReDim Preserve arrRes(49)
            ReDim Preserve arrKind(49)
            ReDim Preserve arrPos(49)
            blnFull = True
        End If
        ocrSrLines = arrRes
        strHtml = ""
        For i = 0 To UBound(arrRes)
            arrPart = OcrSplitPair(arrRes(i))
            arrHit = arrPos(i)
            If IsArray(arrHit) Then
                If UBound(arrHit) >= 0 Then
                    strQ = OcrHtmlMarkAt(arrPart(0), arrHit)
                Else
                    strQ = OcrHtmlMark(arrPart(0), strKey)
                End If
            Else
                strQ = OcrHtmlMark(arrPart(0), strKey)
            End If
            strHtml = strHtml & "<div class=""ocr-sr-line"" onclick=""OcrPickSearch " & i & """>" _
                & "<span class=""ocr-sr-q"">" & strQ & "</span> → <b>" & OcrHtml(arrPart(1)) & "</b>" _
                & " <span class=""ocr-sr-kind"">" & OcrKindName(arrKind(i)) & "</span></div>"
        Next
        If strHtml = "" Then
            If strKey = "" Then
                strHtml = "<span class=""tip"">输入关键词即可搜索本地题库：片段、缺字、错别字都能模糊匹配，也支持拼音首字母或全拼（zxd 即“宰相肚里能撑船”）。</span>"
            Else
                strHtml = "<span class=""tip"">题库中没有匹配“" & OcrHtml(strKey) & "”的题目，可只打题干里的几个字试试。</span>"
            End If
        ElseIf blnFull Then
            strHtml = strHtml & "<div class=""tip"">已到 50 条上限，请补充更精确的关键词。</div>"
        Else
            strHtml = strHtml & "<div class=""tip"">共 " & (UBound(arrRes) + 1) & " 条" & OcrKindSummary(arrKind) & "。</div>"
        End If
        document.getElementById("ocrSearchResult").innerHTML = strHtml
        document.getElementById("ocrSearchResult").style.display = "block"
    End Sub
    ' 匹配方式的排序档位与短名：首字母 > 全拼 > 包含 > 汉字模糊 > 拼音模糊（与移动版得分 0.97 / 0.96 / 0.95 / 0.90+ / 0.90 同序）
    Function OcrKindRank(strKind)
        Select Case strKind
            Case "py" : OcrKindRank = 0
            Case "pyf" : OcrKindRank = 1
            Case "sub" : OcrKindRank = 2
            Case "hz" : OcrKindRank = 3
            Case "pyz" : OcrKindRank = 4
            Case Else : OcrKindRank = 9
        End Select
    End Function
    Function OcrKindName(strKind)
        Select Case strKind
            Case "py" : OcrKindName = "首字母"
            Case "pyf" : OcrKindName = "全拼"
            Case "pyz" : OcrKindName = "拼音模糊"
            Case "sub" : OcrKindName = "包含"
            Case "hz" : OcrKindName = "模糊"
            Case Else : OcrKindName = ""
        End Select
    End Function
    ' 结果行末尾的汇总：只有非“包含”命中时才说明，纯汉字包含不啰嗝
    Function OcrKindSummary(arrKind)
        Dim i, intPy, intHz, intSub, strOut
        intPy = 0
        intHz = 0
        intSub = 0
        For i = 0 To UBound(arrKind)
            If arrKind(i) = "sub" Then
                intSub = intSub + 1
            ElseIf arrKind(i) = "hz" Then
                intHz = intHz + 1
            Else
                intPy = intPy + 1
            End If
        Next
        strOut = ""
        If intPy > 0 Then strOut = strOut & "拼音 " & intPy & " 条"
        If intHz > 0 Then
            If strOut <> "" Then strOut = strOut & "、"
            strOut = strOut & "模糊 " & intHz & " 条"
        End If
        If intPy = 0 And intHz = 0 Then
            OcrKindSummary = ""
        ElseIf intPy = 0 And intSub = 0 Then
            OcrKindSummary = "，汉字模糊匹配"
        ElseIf intHz = 0 And intSub = 0 Then
            OcrKindSummary = "，均按拼音匹配"
        Else
            OcrKindSummary = "，其中" & strOut
        End If
    End Function
    ' 题库行拆成“题目/答案”：兼容 | 与 Tab 两种分隔符
    Function OcrSplitPair(strLine)
        Dim pos
        pos = InStr(strLine, "|")
        If pos = 0 Then pos = InStr(strLine, vbTab)
        If pos = 0 Then
            OcrSplitPair = Array(Trim(strLine), "")
        Else
            OcrSplitPair = Array(Trim(Left(strLine, pos - 1)), Trim(Mid(strLine, pos + 1)))
        End If
    End Function
    ' 拼音首字母通道：把汉字转成声母字母（王→w、安→a、石→s），表外字符丢弃；用于“was”这类首字母检索
    Sub OcrPyInit
        Dim i
        If ocrPyReady Then Exit Sub
        Set ocrPyDict = CreateObject("Scripting.Dictionary")
        For i = 1 To Len(ocrPyChars)
            ocrPyDict(Mid(ocrPyChars, i, 1)) = Mid(ocrPyLetters, i, 1)
        Next
        ocrPyReady = True
    End Sub
    Function OcrPyHead(strText)
        Dim i, strCh, strOut
        OcrPyInit
        strOut = ""
        For i = 1 To Len(strText)
            strCh = Mid(strText, i, 1)
            If ocrPyDict.Exists(strCh) Then
                strOut = strOut & ocrPyDict(strCh)
            ElseIf OcrIsAlnum(strCh) Then
                strOut = strOut & LCase(strCh)
            End If
        Next
        OcrPyHead = strOut
    End Function
    ' 全拼字典：ocrPyFull 按 "|" 拆开后与 ocrPyChars 逐字对应（王→wang、吕→lv），首次全拼检索时建一次
    Sub OcrPyFullInit
        Dim arrSyl, i, n
        If ocrPyFullReady Then Exit Sub
        Set ocrPyFullDict = CreateObject("Scripting.Dictionary")
        arrSyl = Split(ocrPyFull, "|")
        n = Len(ocrPyChars)
        If UBound(arrSyl) + 1 < n Then n = UBound(arrSyl) + 1
        For i = 1 To n
            If arrSyl(i - 1) <> "" Then ocrPyFullDict(Mid(ocrPyChars, i, 1)) = arrSyl(i - 1)
        Next
        ocrPyFullReady = True
    End Sub
    ' 整句全拼串（王安石是哪个朝代的 → wanganshi...）：数字字母原样保留，表外字与标点跳过
    Function OcrPyAll(strText)
        Dim i, strCh, strOut
        OcrPyFullInit
        strOut = ""
        For i = 1 To Len(strText)
            strCh = Mid(strText, i, 1)
            If ocrPyFullDict.Exists(strCh) Then
                strOut = strOut & ocrPyFullDict(strCh)
            ElseIf OcrIsAlnum(strCh) Then
                strOut = strOut & LCase(strCh)
            End If
        Next
        OcrPyAll = strOut
    End Function
    ' 首字母松序容错（拼音模糊）：字母按顺序出现即可、允许跳字母，但首末跳度不超过 Len(key)+2，避免命中过散
    ' 例：zxn / zxln 都能命中“宰相肚里能撑船…”（首字母串 zxdlncczdsnwzx，中间漏打字母也不影响）
    Function OcrPyFuzzy(strKey, strPy)
        Dim intLim, intNeed, strC0, i, j, n
        OcrPyFuzzy = False
        intNeed = Len(strKey)
        intLim = intNeed + 2
        If Len(strPy) < intNeed Then Exit Function
        strC0 = Left(strKey, 1)
        For i = 1 To Len(strPy)
            If Mid(strPy, i, 1) = strC0 Then
                n = 2
                j = i + 1
                Do While j <= Len(strPy) And (j - i + 1) <= intLim And n <= intNeed
                    If Mid(strPy, j, 1) = Mid(strKey, n, 1) Then n = n + 1
                    j = j + 1
                Loop
                If n > intNeed Then
                    OcrPyFuzzy = True
                    Exit Function
                End If
            End If
        Next
    End Function
    ' 把题目里与关键词字面相同的部分包成黄底 span（不区分大小写）；拼音通道没有字面可标，原样输出
    Function OcrHtmlMark(strText, strKey)
        Dim strOut, strLow, strKeyLow, intPos, intLen
        OcrHtmlMark = ""
        If Len(strKey) = 0 Then
            OcrHtmlMark = OcrHtml(strText)
            Exit Function
        End If
        strKeyLow = LCase(strKey)
        intLen = Len(strKeyLow)
        strLow = LCase(strText)
        Do While True
            intPos = InStr(1, strLow, strKeyLow, 1)
            If intPos = 0 Then Exit Do
            OcrHtmlMark = OcrHtmlMark & OcrHtml(Left(strText, intPos - 1)) & "<span class=""ocr-hl"">" & OcrHtml(Mid(strText, intPos, intLen)) & "</span>"
            strText = Mid(strText, intPos + intLen)
            strLow = Mid(strLow, intPos + intLen)
            If Len(strText) = 0 Then Exit Do
        Loop
        OcrHtmlMark = OcrHtmlMark & OcrHtml(strText)
    End Function
    ' 按题面下标逐字包黄底（汉字模糊通道用）：只有字面相同的字变色，错字与跳过的字不标；连续下标合并成一段
    ' 注意：VBScript 的 And 不短路，下标判断必须先比较 n 再取 arrPos(n)，不能写在一行里
    Function OcrHtmlMarkAt(strText, arrPos)
        Dim intLen, i, n, strOut, blnOpen, blnHit
        OcrHtmlMarkAt = ""
        If Not IsArray(arrPos) Then
            OcrHtmlMarkAt = OcrHtml(strText)
            Exit Function
        End If
        If UBound(arrPos) < 0 Then
            OcrHtmlMarkAt = OcrHtml(strText)
            Exit Function
        End If
        intLen = Len(strText)
        n = 0
        blnOpen = False
        strOut = ""
        For i = 0 To intLen - 1
            blnHit = False
            If n <= UBound(arrPos) Then
                If arrPos(n) = i Then blnHit = True
            End If
            If blnHit Then
                If Not blnOpen Then
                    strOut = strOut & "<span class=""ocr-hl"">"
                    blnOpen = True
                End If
                n = n + 1
            ElseIf blnOpen Then
                strOut = strOut & "</span>"
                blnOpen = False
            End If
            strOut = strOut & OcrHtml(Mid(strText, i + 1, 1))
        Next
        If blnOpen Then strOut = strOut & "</span>"
        OcrHtmlMarkAt = strOut
    End Function
    ' ASCII 字母数字判断（VBScript 的 Like 在本机引擎上有兼容问题，统一用 Asc 码位比较）
    Function OcrIsAlnum(strCh)
        Dim c
        c = Asc(strCh)
        OcrIsAlnum = (c >= 48 And c <= 57) Or (c >= 65 And c <= 90) Or (c >= 97 And c <= 122)
    End Function
    ' 汉字判断（Unicode 4E00-9FFF；AscW 是带符号的，负数先补回 65536）
    Function OcrIsHan(strCh)
        Dim w
        w = AscW(strCh)
        If w < 0 Then w = w + 65536
        OcrIsHan = (w >= 19968 And w <= 40959)
    End Function
    ' “算一个正文字”（汉字 / 字母 / 数字）：题面标点空白在对齐时直接跳过，不当作错字吃掉关键词
    Function OcrIsWordChar(strCh)
        OcrIsWordChar = OcrIsHan(strCh) Or OcrIsAlnum(strCh)
    End Function
    ' 单字拼音首字母（表外字返回空串）：近音字判断专用，不走 OcrPyHead 的整串循环
    Function OcrCharLetter(strCh)
        OcrPyInit
        If ocrPyDict.Exists(strCh) Then
            OcrCharLetter = ocrPyDict(strCh)
        Else
            OcrCharLetter = ""
        End If
    End Function
    ' 同拼音首字母（近音字）判断：自/字、石/寺这类 OCR 常见错字按部分命中计分，不要求字形相同
    Function OcrSameInitial(strA, strB)
        Dim a, b
        a = OcrCharLetter(strA)
        b = OcrCharLetter(strB)
        OcrSameInitial = (Len(a) = 1 And a = b)
    End Function
    ' 汉字模糊对齐（错别字 / OCR 误识容错）：从题目里与关键词首字相同处起对齐，允许题面多字（跳字 ≤2）、
    ' 少量错字（两边各消耗一字，记 0.4 分）、同首字母的近音字（记 0.85）；返回命中率 0~1，0 表示未命中；
    ' 命中要求：2 字逐字对、3 字容一个近音、4 字以上 0.75（洛阳自马石 → 洛阳白马寺 = 0.85）；
    ' arrPos 输出字面完全相同处的题面下标（0 基，用于逐字高亮）。与移动版 tikuHanFuzzy 同一算法
    Function OcrHanFuzzy(strKey, strQ, ByRef arrPos)
        Dim kl, tl, intLim, s, i, j, dblScore, arrTmp, strKch, strQch, intFound, intX, dblBest, dblMin
        OcrHanFuzzy = 0
        arrPos = Array()
        kl = Len(strKey)
        tl = Len(strQ)
        If kl < 2 Or kl > 16 Or tl < 2 Then Exit Function
        OcrPyInit
        ' 预筛：关键词里至少一半的字面能在题目里找到才做对齐（错字本就不在题面，阈值不能拉太高）
        intFound = 0
        For intX = 1 To kl
            If InStr(1, strQ, Mid(strKey, intX, 1), 1) > 0 Then intFound = intFound + 1
        Next
        If intFound * 2 < kl Then Exit Function
        intLim = kl + 2
        dblBest = 0
        For s = 1 To tl
            If LCase(Mid(strQ, s, 1)) = LCase(Left(strKey, 1)) Then
                i = 2
                j = s + 1
                dblScore = 1
                arrTmp = Array(s - 1)
                Do While i <= kl And j <= tl
                    If (j - s + 1) > intLim Then Exit Do
                    strKch = Mid(strKey, i, 1)
                    strQch = Mid(strQ, j, 1)
                    If LCase(strQch) = LCase(strKch) Then
                        dblScore = dblScore + 1
                        AppendValue arrTmp, j - 1
                        i = i + 1
                        j = j + 1
                    ElseIf Not OcrIsWordChar(strQch) Then
                        j = j + 1
                    ElseIf j + 1 <= tl Then
                        If LCase(Mid(strQ, j + 1, 1)) = LCase(strKch) Then
                            j = j + 1
                        ElseIf j + 2 <= tl And LCase(Mid(strQ, j + 2, 1)) = LCase(strKch) Then
                            j = j + 2
                        ElseIf OcrSameInitial(strKch, strQch) Then
                            dblScore = dblScore + 0.85
                            i = i + 1
                            j = j + 1
                        Else
                            dblScore = dblScore + 0.4
                            i = i + 1
                            j = j + 1
                        End If
                    ElseIf OcrSameInitial(strKch, strQch) Then
                        dblScore = dblScore + 0.85
                        i = i + 1
                        j = j + 1
                    Else
                        dblScore = dblScore + 0.4
                        i = i + 1
                        j = j + 1
                    End If
                Loop
                dblScore = dblScore / kl
                If dblScore > dblBest Then
                    dblBest = dblScore
                    arrPos = arrTmp
                End If
            End If
        Next
        ' 2 字必须逐字对上（短词靠近音命中噪音太大），3 字只容一个近音，4 字以上 0.75 即算命中
        If kl <= 2 Then
            dblMin = 1
        ElseIf kl = 3 Then
            dblMin = 0.85
        Else
            dblMin = 0.75
        End If
        If dblBest >= dblMin Then
            OcrHanFuzzy = dblBest
        Else
            OcrHanFuzzy = 0
            arrPos = Array()
        End If
    End Function
    ' 纯字母且长度 ≥2 的关键词才走拼音通道（单字母命中太多没有意义）
    Function OcrIsPyKey(strText)
        Dim i, c
        OcrIsPyKey = False
        If Len(strText) < 2 Then Exit Function
        For i = 1 To Len(strText)
            c = Asc(Mid(strText, i, 1))
            If Not ((c >= 65 And c <= 90) Or (c >= 97 And c <= 122)) Then Exit Function
        Next
        OcrIsPyKey = True
    End Function
    ' 题库每行题目的首字母串与全拼串，与 ocrTikuLines 下标一一对应；首次拼音搜索时构建一次
    ' 先 ReDim 到定长再逐项赋值（不用 AppendValue 反复扩容，2800 条题库下能省掉明显的一次性卡顿）
    Sub OcrBuildTikuPy
        Dim i, n, strLine, arrPair
        If ocrTikuPyReady Then Exit Sub
        n = UBound(ocrTikuLines)
        ReDim ocrTikuPy(n)
        ReDim ocrTikuPyf(n)
        For i = 0 To n
            strLine = Trim(ocrTikuLines(i))
            If strLine = "" Or Left(strLine, 1) = "#" Then
                ocrTikuPy(i) = ""
                ocrTikuPyf(i) = ""
            Else
                arrPair = OcrSplitPair(strLine)
                ocrTikuPy(i) = OcrPyHead(arrPair(0))
                ocrTikuPyf(i) = OcrPyAll(arrPair(0))
            End If
        Next
        ocrTikuPyReady = True
    End Sub
    ' 输入即搜的防抖：连续输入时只保留最后一次 300ms 后的搜索
    Sub OcrSearchKillTimer
        On Error Resume Next
        If ocrSearchTimer <> 0 Then window.clearTimeout ocrSearchTimer
        ocrSearchTimer = 0
        On Error GoTo 0
    End Sub
    ' 点击搜索结果：直接复制答案，并同步给“复制答案”按钮
    Sub OcrPickSearch(idx)
        Dim arrPair
        If idx < 0 Then Exit Sub
        If idx > UBound(ocrSrLines) Then Exit Sub
        arrPair = OcrSplitPair(ocrSrLines(idx))
        ocrAnswerText = arrPair(1)
        If arrPair(1) = "" Then Exit Sub
        On Error Resume Next
        window.clipboardData.setData "Text", arrPair(1)
        Err.Clear
        On Error GoTo 0
        document.getElementById("ocrSearchHint").innerText = "已复制：" & arrPair(1)
    End Sub
    Sub OcrCloseSearch
        OcrSearchKillTimer
        document.getElementById("txtOcrSearch").value = ""
        document.getElementById("ocrSearchResult").innerHTML = ""
        document.getElementById("ocrSearchResult").style.display = "none"
        document.getElementById("ocrSearchHint").innerText = ""
        ocrSrLines = Array()
    End Sub
    ' 输入即搜：普通按键 300ms 防抖后自动搜索，回车立即搜，Esc 清空
    ' 挂在 keyup 上才能读到刚敲进去的内容；修饰键与光标键不改变文本，直接忽略
    Sub OcrSearchKey
        Dim intCode
        intCode = window.event.keyCode
        If intCode = 27 Then
            OcrSearchKillTimer
            OcrCloseSearch
        ElseIf intCode = 13 Then
            OcrSearchKillTimer
            OcrSearchTiku
        ElseIf intCode = 16 Or intCode = 17 Or intCode = 18 Or intCode = 20 Then
            Exit Sub
        ElseIf intCode >= 33 And intCode <= 40 Then
            Exit Sub
        Else
            OcrSearchKillTimer
            ocrSearchTimer = window.setTimeout("OcrSearchTiku", 300)
        End If
    End Sub
    Sub OcrCopyAnswer
        If ocrAnswerText = "" Then
            MsgBox "还没有可复制的答案，请先识别一次。", vbInformation, "复制答案"
            Exit Sub
        End If
        On Error Resume Next
        window.clipboardData.setData "Text", ocrAnswerText
        If Err.Number <> 0 Then
            Err.Clear
            On Error GoTo 0
            MsgBox "复制失败，请手动选择答案文本。", vbExclamation, "复制答案"
            Exit Sub
        End If
        On Error GoTo 0
        MsgBox "已复制答案：" & ocrAnswerText, vbInformation, "复制答案"
    End Sub
    ' 未命中题库时的兜底：用识别到的题干直接搜网页
    Sub OcrOpenSearch
        Dim objShell, strQuery
        If ocrSearchText = "" Then
            MsgBox "还没有识别结果，请先识别一次。", vbInformation, "网页搜索"
            Exit Sub
        End If
        strQuery = ocrSearchText
        If Len(strQuery) > 60 Then strQuery = Left(strQuery, 60)
        Set objShell = CreateObject("WScript.Shell")
        ' 百分号编码交给 JScript 的 encodeURIComponent（VBScript 走 ADODB.Stream 转字节在部分字符上会失败）
        objShell.Run "explorer.exe " & ocrQuote & "https://www.baidu.com/s?wd=" & OcrUrlEncodeJs(strQuery) & ocrQuote, 1, False
    End Sub
    ' ===================== 主题切换 =====================
    Sub ToggleTheme
        Dim chk, track
        Set chk = document.getElementById("chkTheme")
        Set track = document.getElementById("toggleTrack")
        If document.body.className = "dark" Then
            document.body.className = ""
            chk.checked = False
            track.className = "theme-toggle-track"
            document.getElementById("themeTxt").innerText = "☀ 日间"
        Else
            document.body.className = "dark"
            chk.checked = True
            track.className = "theme-toggle-track on"
            document.getElementById("themeTxt").innerText = "🌙 夜间"
        End If
        ' 日/夜文本宽度不同，重钉主题开关位置
        PinTopButtons
    End Sub
    ' ===================== 初始化与窗口生命周期 =====================
    Sub Window_OnLoad
        Dim winW, maxH, winH, chromeH
        winW = 1100
        maxH = Int(screen.availHeight * 0.95)
        If winW > Int(screen.availWidth * 0.95) Then winW = Int(screen.availWidth * 0.95)
        ' 载入过程中要 resize 两次（先定宽度量标题栏补偿，再按内容高度贴合）。窗口可见时做这两步
        ' 会先小后大还闪一下，所以先挪到屏幕外算完尺寸，最后一次性移回居中（屏幕外不代表隐藏，
        ' 中途的 resize 仍在发生，只是看不见）。moveTo 失败时保持原样，不影响后续显示。
        On Error Resume Next
        window.moveTo -32000, -32000
        On Error GoTo 0
        ' 先按目标宽度调整窗口，待初始化完成后按实际内容高度贴合窗口，避免底部留白
        window.resizeTo winW, 600
        ' 主窗口尺寸变化时同步调整攻略弹窗并钉住右上角按钮条；窗口失去焦点时结束未完成的拖拽
        On Error Resume Next
        window.onresize = GetRef("Window_OnResize")
        window.onscroll = GetRef("Window_OnScroll")
        window.onblur = GetRef("Window_OnBlur")
        window.onfocus = GetRef("Window_OnFocus")
        On Error GoTo 0
        UpdatePetUndoButtons
        FillRemindMinutes
        FillGhostMaps
        RenderShenqiLinks
        OcrLoadConfig
        GhostMonLoadConfig
        GhostMonRefreshStatus
        OcrRefreshTiku
        ' 环境自检在后台跑（大约 1~2s），结果写进答题区状态行，缺东西才弹提示
        EnvCheckRun
        ' 版本号只读本地 CHANGELOG.md，不联网；点“检查更新”才会去比对远程版本
        UpdShowVersion
        ' 勾了“自动检测更新”就在窗口摆好之后静默查一次；延后 3 秒，避开启动时那次环境自检
        UpdAutoLoad
        UpdAutoPaint
        If updAutoOn Then window.setTimeout "UpdSilentCheck", 3000
        ' 标题栏/边框补偿 = 临时窗口高 - 客户区高（quirks 模式下 documentElement.clientHeight 恒为 0，须用 body.clientHeight 读取视口高）；窗口高 = 内容高 + 补偿 + 少量余量
        chromeH = 600 - document.body.clientHeight
        If chromeH < 0 Or chromeH > 200 Then chromeH = 72
        winH = document.body.scrollHeight + chromeH + 4
        If winH > maxH Then winH = maxH
        If winH < 400 Then winH = 400
        window.resizeTo winW, winH
        window.moveTo (screen.availWidth - winW) \ 2, (screen.availHeight - winH) \ 2
        PinTopButtons
        document.getElementById("txtPrice").focus
    End Sub
    Sub Window_OnUnload
        StopRemindTimers
        ' 工具箱关闭时必须清掉后台识别进程，否则它会一直在后台截屏
        If ocrWatchOn Then OcrKillWatcher
        GhostMonStopQuiet
    End Sub
    ' 右上角主题开关钉位：quirks 模式不支持 position:fixed（会随文档滚动漂移），改由脚本按视口重算 absolute 坐标
    ' （坐标系与攻略弹窗 PositionSqDialog 一致）；滚动/缩放/切主题时触发。
    ' themeScrX 记住上次重算时的横向滚动值：纯纵向滚动时左右位置没变，只要挪 top，
    ' 不必再读 offsetWidth（IE 下读它会强制重排，长页面滚动时是白花的开销）
    Dim themeScrX
    themeScrX = -1
    Sub PinTopButtons
        Dim objTheme, viewW, scrX, scrY
        viewW = document.body.clientWidth
        scrX = document.body.scrollLeft
        scrY = document.body.scrollTop
        Set objTheme = document.getElementById("themeToggle")
        ' 先清 CSS right 再量宽设 left：left/right 同时生效会把 absolute 元素宽度压成两者间距，
        ' 内容被挤换行（日/夜文字串行的根因）；清掉后宽度恢复内容自然宽
        objTheme.style.right = "auto"
        objTheme.style.pixelTop = scrY + 8
        objTheme.style.pixelLeft = viewW + scrX - objTheme.offsetWidth - 16
        themeScrX = scrX
    End Sub
    Sub Window_OnScroll
        Dim scrY, scrX
        scrY = document.body.scrollTop
        scrX = document.body.scrollLeft
        If scrX <> themeScrX Then
            ' 横向滚动会让开关脱离右缘，得整体重算
            PinTopButtons
        Else
            document.getElementById("themeToggle").style.pixelTop = scrY + 8
        End If
    End Sub
</script>
<script language="JScript">
// 供 VBScript 调用的纯工具函数：UTF-8 百分号编码（encodeURIComponent 对中文与保留字符均正确）
function OcrUrlEncodeJs(s) { return encodeURIComponent(String(s)); }
</script>
</head>
<body>
    <input type="checkbox" id="chkTheme" class="theme-toggle-chk" onclick="ToggleTheme"><label class="theme-toggle" id="themeToggle" for="chkTheme"><span class="theme-toggle-track" id="toggleTrack"><span class="theme-toggle-knob"></span></span><span class="theme-toggle-txt" id="themeTxt">☀ 日间</span></label>
    <div class="input-bar">
        <div><label>⏰ 定时提醒（小时）：</label><select id="selRemindHour"></select></div>
        <div><label>（第几分）：</label><select id="selRemindMinute"></select></div>
        <div><label>（第几秒）：</label><select id="selRemindSecond"></select></div>
        <div>
            <label>提醒内容：</label>
            <input type="text" id="txtRemindMsg" style="width: 220px;" value="该起来活动一下啦，喝口水休息休息！">
            <button id="btnRemindStart" onclick="StartRemind">运行</button>
            <button id="btnRemindStop" onclick="StopRemind" disabled>停止</button>
            <button id="btnRemindTest" onclick="ShowRemindNotify">测试</button>
        </div>
        <div id="remindStatus"></div>
    </div>
    <div class="input-bar">
        <div><label>👤 种族选择：</label><select id="selRace"><option value="human">人族</option><option value="immortal" selected>仙族</option><option value="demon">魔族</option></select></div>
        <div>
            <label>⚙️ 换算类型：</label>
            <select id="selCalcType" onchange="SwitchCalcType"><option value="weapon" selected>⚔️ 武器换算</option><option value="equip">🛡️ 装备换算</option></select>
            <button id="btnCalcAttr" onclick="CalcAttr">计算武器属性</button>
        </div>
        <div id="rowWeaponRequired">
            <label>武器伤害：</label><input type="text" id="txtWeaponDmg" onkeydown="CheckEnterAttr"><span class="tip">必填</span>
            <label style="width: auto; margin-left: 10px;">命中：</label><input type="text" id="txtWeaponHit" onkeydown="CheckEnterAttr"><span class="tip">必填</span>
        </div>
        <div id="rowEquipRequired" style="display: none;">
            <label>装备防御：</label><input type="text" id="txtEquipDef" onkeydown="CheckEnterAttr"><span class="tip">必填</span>
        </div>
        <div>
            <label>附加力量：</label><input type="text" id="txtStr" onkeydown="CheckEnterAttr"><span class="tip">选填</span>
            <label style="width: auto; margin-left: 10px;">魔力：</label><input type="text" id="txtMag" onkeydown="CheckEnterAttr"><span class="tip">选填</span>
        </div>
        <div>
            <label>附加体质：</label><input type="text" id="txtCon" onkeydown="CheckEnterAttr"><span class="tip">选填</span>
            <label style="width: auto; margin-left: 10px;">耐力：</label><input type="text" id="txtEnd" onkeydown="CheckEnterAttr"><span class="tip">选填</span>
        </div>
        <div><label>附加敏捷：</label><input type="text" id="txtAgi" onkeydown="CheckEnterAttr"><span class="tip">选填</span></div>
        <div id="divAttrTable" style="display: none; margin-top: 8px;">
            <table><tr><th class="a1">伤害</th><th class="a2">法伤</th><th class="a3">防御</th><th class="a4">气血</th><th class="a5">速度</th></tr><tr><td class="num" id="tdADmg">/</td><td class="num" id="tdAMag">/</td><td class="num" id="tdADef">/</td><td class="num" id="tdAHp">/</td><td class="num" id="tdASpd">/</td></tr></table>
        </div>
        <div id="divHistory" style="display: none;">
            <div class="history-header">计算结果对比<button id="btnClearHistory" class="btn-clear-hist" onclick="ClearHistory">清空历史</button><select id="selHistoryMax" style="margin-left:4px;" onchange="OnChangeHistoryLimit"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="5">5</option><option value="10" selected>10</option><option value="15">15</option><option value="20">20</option><option value="30">30</option></select><span style="font-weight:normal;font-size:12px;color:#888;margin-left:2px;">条</span></div>
            <div id="divHistoryTable"></div>
        </div>
    </div>
    <div class="input-bar">
        <div>
            <label>🏯 修炼类型：</label>
            <select id="selXiuType" onchange="OnXiuTypeChange"><option value="attack" selected>攻击修炼</option><option value="magic">法术修炼</option><option value="defend">防御修炼</option><option value="resist">抗法修炼</option><option value="hunt">猎术修炼</option><option value="pet">召唤兽修炼</option></select>
            <button id="btnCalcXiu" onclick="CalcXiulian">计算修炼消耗</button>
        </div>
        <div>
            <label>当前修炼等级：</label><input type="text" id="txtXiuCurLv" onkeydown="CheckEnterXiu"><span class="tip">必填 0-25</span>
            <label style="width: auto; margin-left: 10px;">当前经验：</label><input type="text" id="txtXiuCurExp" onkeydown="CheckEnterXiu"><span class="tip">选填 默认0</span>
        </div>
        <div>
            <label>目标修炼等级：</label><input type="text" id="txtXiuTgtLv" onkeydown="CheckEnterXiu"><span class="tip">必填 0-25</span>
            <label style="width: auto; margin-left: 10px;">目标经验：</label><input type="text" id="txtXiuTgtExp" onkeydown="CheckEnterXiu"><span class="tip">选填 默认0</span>
        </div>
        <div id="divXiuJiu">
            <label>💊 金丹每品质价格：</label><input type="text" id="txtJiuPrice" onkeydown="CheckEnterXiu"><span class="tip" style="display: inline-block; width: 66px;">选填 梦幻币</span>
            <label style="width: auto; margin-left: 2px;">金丹品质：</label><input type="text" id="txtJiuQuality" onkeydown="CheckEnterXiu"><span class="tip">选填 不填只算总品质</span>
        </div>
        <div id="divXiuGuo" style="display: none;">
            <label>🍎 修炼果价格（万）：</label><input type="text" id="txtGuoPrice" onkeydown="CheckEnterXiu"><span class="tip">选填 万/颗</span>
        </div>
        <div id="xiuResult"></div>
    </div>
    <div class="input-bar">
        <div style="cursor: pointer;" onclick="TogglePetSection"><label style="width: auto; text-align: left;">🐾 宠环任务（召唤兽修炼任务）：</label><span class="sq-toggle" id="petToggleHint">▼ 展开</span><span class="tip">积分规则与高级书铁奖励对照表</span></div>
        <div id="petSection" style="display: none;">
            <div class="pet-block-title">【召唤兽修炼任务积分规则】</div>
            <div style="margin-top: 6px;"><label style="width: auto;">是否计算成本：</label><select id="selPetCostMode"><option value="1" selected>是</option><option value="0">否</option></select><span class="tip">“是”：点 + 时填成本；“否”：只记次数</span></div>
            <div style="margin-top: 6px;"><label style="width: auto;">当前号：</label><button id="petCharBtn0" class="pet-char-btn-on" onclick="PetSwitchChar 0">1号</button><button id="petCharBtn1" class="pet-char-btn" onclick="PetSwitchChar 1">2号</button><button id="petCharBtn2" class="pet-char-btn" onclick="PetSwitchChar 2">3号</button><button id="petCharBtn3" class="pet-char-btn" onclick="PetSwitchChar 3">4号</button><button id="petCharBtn4" class="pet-char-btn" onclick="PetSwitchChar 4">5号</button><span class="tip">各号独立计数，全部号合计跨号累加</span></div>
            <table>
                <tr><th width="25%">任务内容</th><th width="10%">任务积分</th><th width="15%">次数</th><th width="25%">任务内容</th><th width="10%">任务积分</th><th width="15%">次数</th></tr>
                <tr><td class="lv">找人</td><td class="num">1</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 0">-</button> <span id="petCnt0">0</span> <button class="pet-cnt-btn" onclick="PetAdd 0">+</button></td><td class="lv">乐器</td><td class="num">4</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 1">-</button> <span id="petCnt1">0</span> <button class="pet-cnt-btn" onclick="PetAdd 1">+</button></td></tr>
                <tr class="alt"><td class="lv">60级装备</td><td class="num">2</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 2">-</button> <span id="petCnt2">0</span> <button class="pet-cnt-btn" onclick="PetAdd 2">+</button></td><td class="lv">花</td><td class="num">4</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 3">-</button> <span id="petCnt3">0</span> <button class="pet-cnt-btn" onclick="PetAdd 3">+</button></td></tr>
                <tr><td class="lv">1级家具</td><td class="num">2</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 4">-</button> <span id="petCnt4">0</span> <button class="pet-cnt-btn" onclick="PetAdd 4">+</button></td><td class="lv">80级装备</td><td class="num">5</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 5">-</button> <span id="petCnt5">0</span> <button class="pet-cnt-btn" onclick="PetAdd 5">+</button></td></tr>
                <tr class="alt"><td class="lv">三级药</td><td class="num">2</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 6">-</button> <span id="petCnt6">0</span> <button class="pet-cnt-btn" onclick="PetAdd 6">+</button></td><td class="lv">2级家具</td><td class="num">5</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 7">-</button> <span id="petCnt7">0</span> <button class="pet-cnt-btn" onclick="PetAdd 7">+</button></td></tr>
                <tr><td class="lv">烹饪</td><td class="num">2</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 8">-</button> <span id="petCnt8">0</span> <button class="pet-cnt-btn" onclick="PetAdd 8">+</button></td><td class="lv">非指定变异召唤兽</td><td class="num">5</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 9">-</button> <span id="petCnt9">0</span> <button class="pet-cnt-btn" onclick="PetAdd 9">+</button></td></tr>
                <tr class="alt"><td class="lv">70级装备</td><td class="num">3</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 10">-</button> <span id="petCnt10">0</span> <button class="pet-cnt-btn" onclick="PetAdd 10">+</button></td><td class="lv">指定变异召唤兽</td><td class="num">10</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 11">-</button> <span id="petCnt11">0</span> <button class="pet-cnt-btn" onclick="PetAdd 11">+</button></td></tr>
                <tr><td class="lv">上交非变异召唤兽</td><td class="num">-15</td><td class="pet-cnt"><button class="pet-cnt-btn pet-undo-btn" onclick="PetSub 12">-</button> <span id="petCnt12">0</span> <button class="pet-cnt-btn" onclick="PetAdd 12">+</button></td><td class="lv"></td><td class="num"></td><td class="pet-cnt"></td></tr>
            </table>
            <div class="pet-cost-summary"><span class="pet-cost-total">当前号成本：<b id="petTotalCost">0</b> 万梦幻币</span><span class="pet-cost-total">全部号合计：<b id="petAllCost">0</b> 万梦幻币</span></div>

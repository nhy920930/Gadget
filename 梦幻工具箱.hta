<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>梦幻工具箱</title>
<hta:application
    id="toolBox"
    applicationname="梦幻工具箱"
    border="thick"
    maximizebutton="yes"
    minimizebutton="yes"
    scroll="auto"
    singleinstance="yes"
    contextmenu="no" />
<style type="text/css">
    body { font-family: "Microsoft YaHei", SimSun; font-size: 14px; background-color: #ccd0d6; color: #2f353c; margin: 0; padding: 18px; }
    .input-bar {
        width: 100%; padding: 16px 14px; font-size: 14px; margin-bottom: 16px;
        background-color: #e8eaee;
        border: 2px solid; border-color: #f8fafc #a2a8b2 #a2a8b2 #f8fafc;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#F2FFFFFF', endColorstr='#D8D8DCE4');
    }
    .input-bar label { font-weight: bold; display: inline-block; width: 220px; text-align: right; color: #3d444d; vertical-align: middle; }
    .input-bar input, .input-bar select {
        width: 150px; height: 30px; padding: 0 8px; font-size: 14px;
        vertical-align: middle;
        background-color: #eef0f3; color: #2f353c;
        border: 2px solid; border-color: #9aa2ac #ffffff #ffffff #9aa2ac;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#E8FFFFFF', endColorstr='#D8E4E8EE');
    }
    .input-bar select { background-color: #f1f4f7; }
    .input-bar button {
        height: 34px; padding: 0 22px; margin-left: 10px; cursor: pointer;
        vertical-align: middle;
        font-size: 14px; font-weight: bold; color: #ffffff;
        background-color: #7b43f5;
        border: 2px solid; border-color: #7b43f5 #4895ef #4895ef #7b43f5;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF4895EF');
    }
    .input-bar button:active {
        border-color: #5f33d8 #377cd8 #377cd8 #5f33d8;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF5F33D8', endColorstr='#FF377CD8');
    }
    #btnCalcAttr, #btnCalcGold, #btnCalculate, #btnCalcXiu { width: 120px; padding: 0; }
    .tip { color: #70787f; margin-left: 10px; font-size: 13px; vertical-align: middle; }
    #goldResult { margin-top: 10px; font-size: 13px; color: #70787f; }
    #goldResult b { color: #c0392b; }
    .hist-del-btn {
        background-color: #7b43f5; color: #ffffff; font-weight: bold;
        border: 2px solid; border-color: #7b43f5 #4895ef #4895ef #7b43f5;
        padding: 1px 6px; cursor: pointer; font-size: 12px;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF4895EF');
    }
    body.dark .hist-del-btn {
        background-color: #7b43f5;
        border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    .input-bar button[disabled] {
        color: #9aa2ac; cursor: default;
        background-color: #d8dade;
        border-color: #e6e8eb #b6bac0 #b6bac0 #e6e8eb;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#D8DADE', endColorstr='#C0C4CA');
    }
    #remindStatus { margin-top: 10px; margin-left: 226px; font-size: 13px; color: #70787f; }
    #remindStatus b { color: #2e8b57; }
    #xiuResult { margin-top: 10px; font-size: 13px; color: #70787f; }
    #xiuResult b { color: #c0392b; }
    .xiu-table td.xiu-item { text-align: left; font-weight: bold; color: #3d444d; }
    .xiu-table td.xiu-val { text-align: left; }
    th.x1 { background-color: #7b43f5; border-left-color: #7b43f5; border-right-color: #616cf2; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF616CF2'); }
    th.x2 { background-color: #616cf2; border-left-color: #616cf2; border-right-color: #4895ef; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF616CF2', endColorstr='#FF4895EF'); }
    #resultArea {
        margin-top: 16px; height: 600px; overflow-y: auto;
        background-color: #eceef1;
        border: 2px solid; border-color: #9aa2ac #ffffff #ffffff #9aa2ac;
    }
    /* 宝石成本多选：选择模式下“单个成本”单元格可点击，选中高亮并可填写个数 */
    #resultArea.pick td.cost { cursor: pointer; }
    td.picked { background-color: #ffd76e; font-weight: bold; }
    body.dark td.picked { background-color: #6b5210; }
    td.cost input.gem-qty { width: 56px; height: 22px; padding: 0 4px; text-align: center; font-size: 13px; font-weight: normal; vertical-align: middle; }
    #gemSumResult { margin-top: 10px; font-size: 13px; color: #70787f; }
    #gemSumResult b { color: #c0392b; }
    body.dark #gemSumResult { color: #7c828a; }
    body.dark #gemSumResult b { color: #f0a050; }
    table { border-collapse: collapse; width: 100%; background-color: transparent; }
    th, td { border: 1px solid #c2c8d0; padding: 8px 10px; font-size: 14px; }
    th {
        text-align: center; color: #ffffff;
        background-color: #6764f3;
        border-left-color: #6764f3; border-right-color: #6764f3;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#FF6764F3', endColorstr='#FF5C5AE8');
    }
    th.a1 { background-color: #7b43f5; border-left-color: #7b43f5; border-right-color: #7153f4; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF7153F4'); }
    th.a2 { background-color: #7153f4; border-left-color: #7153f4; border-right-color: #6764f3; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7153F4', endColorstr='#FF6764F3'); }
    th.a3 { background-color: #6764f3; border-left-color: #6764f3; border-right-color: #5c74f1; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6764F3', endColorstr='#FF5C74F1'); }
    th.a4 { background-color: #5c74f1; border-left-color: #5c74f1; border-right-color: #5285f0; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF5C74F1', endColorstr='#FF5285F0'); }
    th.a5 { background-color: #5285f0; border-left-color: #5285f0; border-right-color: #4895ef; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF5285F0', endColorstr='#FF4895EF'); }
    th.g1 { background-color: #7b43f5; border-left-color: #7b43f5; border-right-color: #764bf4; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF764BF4'); }
    th.g2 { background-color: #764bf4; border-left-color: #764bf4; border-right-color: #6e58f4; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF764BF4', endColorstr='#FF6E58F4'); }
    th.g3 { background-color: #6e58f4; border-left-color: #6e58f4; border-right-color: #6764f3; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6E58F4', endColorstr='#FF6764F3'); }
    th.g4 { background-color: #6764f3; border-left-color: #6764f3; border-right-color: #577cf1; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6764F3', endColorstr='#FF577CF1'); }
    th.g5 { background-color: #577cf1; border-left-color: #577cf1; border-right-color: #4895ef; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF577CF1', endColorstr='#FF4895EF'); }
    th.h1 { background-color: #7b43f5; border-left-color: #7b43f5; border-right-color: #754cf4; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF754CF4'); }
    th.h2 { background-color: #754cf4; border-left-color: #754cf4; border-right-color: #7055f4; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF754CF4', endColorstr='#FF7055F4'); }
    th.h3 { background-color: #7055f4; border-left-color: #7055f4; border-right-color: #6a5ef3; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7055F4', endColorstr='#FF6A5EF3'); }
    th.h4 { background-color: #6a5ef3; border-left-color: #6a5ef3; border-right-color: #6467f2; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6A5EF3', endColorstr='#FF6467F2'); }
    th.h5 { background-color: #6467f2; border-left-color: #6467f2; border-right-color: #5f71f2; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6467F2', endColorstr='#FF5F71F2'); }
    th.h6 { background-color: #5f71f2; border-left-color: #5f71f2; border-right-color: #597af1; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF5F71F2', endColorstr='#FF597AF1'); }
    th.h7 { background-color: #597af1; border-left-color: #597af1; border-right-color: #5383f0; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF597AF1', endColorstr='#FF5383F0'); }
    th.h8 { background-color: #5383f0; border-left-color: #5383f0; border-right-color: #4e8cf0; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF5383F0', endColorstr='#FF4E8CF0'); }
    th.h9 { background-color: #4e8cf0; border-left-color: #4e8cf0; border-right-color: #4895ef; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF4E8CF0', endColorstr='#FF4895EF'); }
    td { text-align: right; color: #2f353c; }
    td.lv, td.num { text-align: center; }
    td.lv { font-weight: bold; }
    tr.alt { background-color: #e6e9ed; }
    .pet-block-title { margin-top: 12px; font-weight: bold; font-size: 14px; color: #3d444d; }
    .pet-note { margin-top: 6px; font-size: 12px; color: #70787f; line-height: 1.7; }
    .pet-score-table td { text-align: center; }
    .pet-cnt { text-align: center; white-space: nowrap; }
    .input-bar .pet-cnt-btn { width: 22px; height: 22px; padding: 0; font-size: 13px; font-weight: bold; line-height: 1; }
    .pet-cost-total { margin-left: 12px; font-size: 13px; color: #3d444d; }
    .pet-cost-total b { color: #c0392b; }
    .pet-empty { text-align: center; color: #70787f; }
    /* 多号切换页签：当前号高亮为主题渐变紫，其余为浅色小按钮。带 .input-bar 前缀提权，压过全局 .input-bar button 规则（同 .pet-cnt-btn 惯例） */
    .input-bar .pet-char-btn { width: 36px; height: 22px; padding: 0; font-size: 12px; font-weight: bold; line-height: 1; text-align: center; cursor: pointer; margin-left: 0; margin-right: 4px; background-color: #e8eaee; color: #3d444d; border: 2px solid; border-color: #f8fafc #a2a8b2 #a2a8b2 #f8fafc; }
    .input-bar .pet-char-btn-on { width: 36px; height: 22px; padding: 0; font-size: 12px; font-weight: bold; line-height: 1; text-align: center; cursor: pointer; margin-left: 0; margin-right: 4px; color: #ffffff; background-color: #7b43f5; border: 2px solid; border-color: #7b43f5 #4895ef #4895ef #7b43f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF4895EF'); }
    td.pet-char-cell { text-align: center; font-weight: bold; color: #7b43f5; background-color: #e6e0fb; }
    /* 汇总分层层级：号名行浅紫底 / 小计行浅黄底 / 全部号合计行紫底白字（与表头呼应） */
    td.pet-subtotal { text-align: center; font-weight: bold; background-color: #fff3d6; }
    td.pet-grand { text-align: center; font-weight: bold; color: #ffffff; background-color: #6764f3; }
    /* 明细表固定高度滚动区：超出约 5 条后内部滚动，避免掉长页面影响其他功能 */
    .pet-detail-scroll { max-height: 210px; overflow-y: auto; }
    /* 宠环成本录入弹窗：点击 + 时弹出，登记本次成本（万梦幻币，非必填），样式沿用攻略弹窗 */
    #petCostOverlay { position: absolute; left: 0; top: 0; z-index: 960; display: none; background-color: #000000; filter: progid:DXImageTransform.Microsoft.Alpha(opacity=40); }
    #petCostDialog {
        position: absolute; z-index: 961; display: none; width: 340px; padding: 12px 14px;
        background-color: #e8eaee;
        border: 2px solid; border-color: #f8fafc #a2a8b2 #a2a8b2 #f8fafc;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#F2FFFFFF', endColorstr='#D8D8DCE4');
    }
    #petCostTitle { font-weight: bold; font-size: 13px; color: #3d444d; margin-bottom: 8px; }
    #petCostDialog label { font-weight: bold; color: #3d444d; vertical-align: middle; }
    #petCostDialog input {
        width: 120px; height: 28px; padding: 0 8px; font-size: 14px; vertical-align: middle;
        background-color: #eef0f3; color: #2f353c;
        border: 2px solid; border-color: #9aa2ac #ffffff #ffffff #9aa2ac;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#E8FFFFFF', endColorstr='#D8E4E8EE');
    }
    .pet-cost-note { margin-top: 6px; font-size: 12px; color: #70787f; }
    .pet-cost-btns { margin-top: 10px; text-align: right; }
    .history-header { margin-top: 14px; font-weight: bold; font-size: 14px; color: #3d444d; padding-bottom: 6px; }
    .history-table td.hist-time { text-align: center; white-space: nowrap; font-size: 12px; color: #70787f; }
    .history-table td.hist-info { text-align: left; font-size: 13px; }
    .history-table td.hist-del { text-align: center; }
    .history-table tr.row-current { background-color: #fff3d6; }
    .history-table td.current-tag { text-align: center; font-weight: bold; color: #c0392b; font-size: 13px; }
    .history-table td.hist-tag { text-align: center; color: #70787f; font-size: 12px; }
    .history-header select {
        width: 50px; height: 24px; font-size: 12px;
        background-color: #eef0f3;
        border: 2px solid; border-color: #9aa2ac #ffffff #ffffff #9aa2ac;
    }
    .btn-clear-hist {
        background-color: #7b43f5; color: #ffffff; font-weight: bold;
        border: 2px solid; border-color: #7b43f5 #4895ef #4895ef #7b43f5;
        padding: 2px 12px; cursor: pointer; font-size: 12px; margin-left: 4px;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF4895EF');
    }
    .btn-clear-hist:active {
        border-color: #5f33d8 #377cd8 #377cd8 #5f33d8;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF5F33D8', endColorstr='#FF377CD8');
    }
    body.dark { background-color: #22262b; color: #c6cad0; }
    body.dark .input-bar {
        background-color: #2b2f35;
        border-color: #4a5058 #0e1013 #0e1013 #4a5058;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C8333740', endColorstr='#B0252930');
    }
    body.dark .input-bar label { color: #aeb4bc; }
    body.dark input, body.dark select {
        background-color: #292d33; color: #d2d6da;
        border-color: #0e1013 #4a5058 #4a5058 #0e1013;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C8292D33', endColorstr='#B022252B');
    }
    body.dark .input-bar select { background-color: #272b31; }
    body.dark .input-bar button {
        background-color: #7b43f5; color: #ffffff;
        border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    body.dark .input-bar button:active {
        border-color: #6a3de0 #4a90e8 #4a90e8 #6a3de0;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7042E0', endColorstr='#FF4690E8');
    }
    body.dark .input-bar button[disabled] {
        color: #767e86;
        background-color: #3c4046;
        border-color: #4c5158 #26292e #26292e #4c5158;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#3C4046', endColorstr='#2E3238');
    }
    body.dark .tip { color: #7c828a; }
    body.dark #goldResult { color: #7c828a; }
    body.dark #goldResult b { color: #f0a050; }
    body.dark table { background-color: transparent; }
    body.dark th {
        background-color: #787af6; color: #ffffff; border-color: #5a4a90;
        border-left-color: #787af6; border-right-color: #787af6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#FF787AF6', endColorstr='#FF6E70E8');
    }
    body.dark th.a1 { background-color: #8b5cf6; border-left-color: #8b5cf6; border-right-color: #816bf6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF816BF6'); }
    body.dark th.a2 { background-color: #816bf6; border-left-color: #816bf6; border-right-color: #787af6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF816BF6', endColorstr='#FF787AF6'); }
    body.dark th.a3 { background-color: #787af6; border-left-color: #787af6; border-right-color: #6e8af5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF787AF6', endColorstr='#FF6E8AF5'); }
    body.dark th.a4 { background-color: #6e8af5; border-left-color: #6e8af5; border-right-color: #6599f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6E8AF5', endColorstr='#FF6599F5'); }
    body.dark th.a5 { background-color: #6599f5; border-left-color: #6599f5; border-right-color: #5ba8f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6599F5', endColorstr='#FF5BA8F5'); }
    body.dark th.g1 { background-color: #8b5cf6; border-left-color: #8b5cf6; border-right-color: #8664f6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF8664F6'); }
    body.dark th.g2 { background-color: #8664f6; border-left-color: #8664f6; border-right-color: #7f6ff6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8664F6', endColorstr='#FF7F6FF6'); }
    body.dark th.g3 { background-color: #7f6ff6; border-left-color: #7f6ff6; border-right-color: #787af6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7F6FF6', endColorstr='#FF787AF6'); }
    body.dark th.g4 { background-color: #787af6; border-left-color: #787af6; border-right-color: #6991f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF787AF6', endColorstr='#FF6991F5'); }
    body.dark th.g5 { background-color: #6991f5; border-left-color: #6991f5; border-right-color: #5ba8f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6991F5', endColorstr='#FF5BA8F5'); }
    body.dark th.h1 { background-color: #8b5cf6; border-left-color: #8b5cf6; border-right-color: #8664f6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF8664F6'); }
    body.dark th.h2 { background-color: #8664f6; border-left-color: #8664f6; border-right-color: #806df6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8664F6', endColorstr='#FF806DF6'); }
    body.dark th.h3 { background-color: #806df6; border-left-color: #806df6; border-right-color: #7b75f6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF806DF6', endColorstr='#FF7B75F6'); }
    body.dark th.h4 { background-color: #7b75f6; border-left-color: #7b75f6; border-right-color: #767ef6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B75F6', endColorstr='#FF767EF6'); }
    body.dark th.h5 { background-color: #767ef6; border-left-color: #767ef6; border-right-color: #7086f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF767EF6', endColorstr='#FF7086F5'); }
    body.dark th.h6 { background-color: #7086f5; border-left-color: #7086f5; border-right-color: #6b8ff5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7086F5', endColorstr='#FF6B8FF5'); }
    body.dark th.h7 { background-color: #6b8ff5; border-left-color: #6b8ff5; border-right-color: #6697f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6B8FF5', endColorstr='#FF6697F5'); }
    body.dark th.h8 { background-color: #6697f5; border-left-color: #6697f5; border-right-color: #60a0f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF6697F5', endColorstr='#FF60A0F5'); }
    body.dark th.h9 { background-color: #60a0f5; border-left-color: #60a0f5; border-right-color: #5ba8f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF60A0F5', endColorstr='#FF5BA8F5'); }
    body.dark td { border-color: #3c424a; color: #b6bcc2; }
    body.dark tr.alt { background-color: #2c3038; }
    body.dark .pet-block-title { color: #aeb4bc; }
    body.dark .pet-note { color: #7c828a; }
    body.dark .pet-cost-total { color: #aeb4bc; }
    body.dark .pet-cost-total b { color: #f0a050; }
    body.dark .pet-empty { color: #7c828a; }
    body.dark .input-bar .pet-char-btn { background-color: #292d33; color: #d2d6da; border-color: #4a5058 #0e1013 #0e1013 #4a5058; }
    body.dark .input-bar .pet-char-btn-on { color: #ffffff; background-color: #7b43f5; border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5'); }
    body.dark td.pet-char-cell { color: #8b5cf6; background-color: #37324d; }
    body.dark td.pet-subtotal { background-color: #453a1e; }
    body.dark td.pet-grand { color: #ffffff; background-color: #787af6; }
    body.dark #petCostOverlay { filter: progid:DXImageTransform.Microsoft.Alpha(opacity=55); }
    body.dark #petCostDialog {
        background-color: #2b2f35;
        border-color: #4a5058 #0e1013 #0e1013 #4a5058;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C8333740', endColorstr='#B0252930');
    }
    body.dark #petCostTitle { color: #aeb4bc; }
    body.dark #petCostDialog label { color: #aeb4bc; }
    body.dark #petCostDialog input {
        background-color: #292d33; color: #d2d6da;
        border-color: #0e1013 #4a5058 #4a5058 #0e1013;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C8292D33', endColorstr='#B022252B');
    }
    body.dark .pet-cost-note { color: #7c828a; }
    body.dark .history-header { color: #aeb4bc; }
    body.dark .history-table td.hist-time { color: #7c828a; }
    body.dark .history-table td.hist-info { color: #a6adb4; }
    body.dark .history-table tr.row-current { background-color: #453a1e; }
    body.dark .history-table td.current-tag { color: #f0a050; }
    body.dark .history-table td.hist-tag { color: #7c828a; }
    body.dark #remindStatus { color: #7c828a; }
    body.dark #remindStatus b { color: #4ecca3; }
    body.dark #xiuResult { color: #7c828a; }
    body.dark #xiuResult b { color: #f0a050; }
    body.dark .xiu-table td.xiu-item { color: #aeb4bc; }
    body.dark th.x1 { background-color: #8b5cf6; border-left-color: #8b5cf6; border-right-color: #7382f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF7382F5'); }
    body.dark th.x2 { background-color: #7382f5; border-left-color: #7382f5; border-right-color: #5ba8f5; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7382F5', endColorstr='#FF5BA8F5'); }
    body.dark #resultArea {
        background-color: #262a30;
        border-color: #0e1013 #3c424a #3c424a #0e1013;
    }
    body.dark #resultArea table { background-color: transparent; }
    body.dark .btn-clear-hist {
        background-color: #7b43f5; color: #ffffff;
        border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    body.dark .btn-clear-hist:active {
        border-color: #6a3de0 #4a90e8 #4a90e8 #6a3de0;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7042E0', endColorstr='#FF4690E8');
    }
    body.dark .history-header select {
        background-color: #292d33;
        border-color: #0e1013 #3c424a #3c424a #0e1013;
    }
    .theme-toggle { position: fixed; top: 10px; right: 20px; z-index: 999; }
    .theme-toggle-chk { position: absolute; left: -9999px; }
    .theme-toggle-track {
        display: inline-block; width: 48px; height: 24px; position: relative; vertical-align: middle; cursor: pointer;
        background-color: #c8ccd2;
        border: 2px solid; border-color: #a0a6ae #eceef2 #eceef2 #a0a6ae;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#D8D4D8DE', endColorstr='#C0B4BAC4');
    }
    .theme-toggle-knob {
        display: block; width: 20px; height: 20px; position: absolute; top: 0; left: 0;
        background-color: #f2f4f6;
        border: 2px solid; border-color: #ffffff #98a0a8 #98a0a8 #ffffff;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#EAFFFFFF', endColorstr='#D8E2E6EC');
    }
    .theme-toggle-txt { font-size: 12px; color: #3d444d; margin-left: 6px; vertical-align: middle; font-weight: bold; }
    body.dark .theme-toggle-track {
        background-color: #7b43f5;
        border-color: #6a3de0 #5ba8f5 #5ba8f5 #6a3de0;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    body.dark .theme-toggle-track .theme-toggle-knob { left: 24px; }
    body.dark .theme-toggle-knob {
        background-color: #2e3238;
        border-color: #6a7078 #16181c #16181c #6a7078;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C82E3238', endColorstr='#B026292E');
    }
    body.dark .theme-toggle-txt { color: #aeb4bc; }
    /* 神器任务攻略 */
    #sqLinks { margin-top: 8px; }
    .sq-group {
        display: block; margin: 8px 0 2px 0; padding: 2px 10px; cursor: default;
        color: #ffffff; font-weight: bold; font-size: 13px;
        background-color: #4895ef;
        border: 2px solid; border-color: #7b43f5 #16181c #16181c #7b43f5;
    }
    body.dark .sq-group { background-color: #5ba8f5; }
    .sq-toggle {
        display: inline-block; margin-left: 10px; padding: 2px 12px; cursor: pointer;
        color: #ffffff; font-weight: bold; font-size: 12px;
        background-color: #4895ef;
        border: 2px solid; border-color: #7b43f5 #16181c #16181c #7b43f5;
    }
    body.dark .sq-toggle { background-color: #5ba8f5; }
    .sq-link {
        display: inline-block; margin: 3px 6px 3px 0; padding: 4px 12px; cursor: pointer;
        color: #ffffff; font-weight: bold; font-size: 13px;
        background-color: #7b43f5;
        border: 2px solid; border-color: #7b43f5 #4895ef #4895ef #7b43f5;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF4895EF');
    }
    body.dark .sq-link {
        background-color: #8b5cf6;
        border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    #sqOverlay {
        position: absolute; left: 0; top: 0; z-index: 900; display: none;
        background-color: #000000;
        filter: progid:DXImageTransform.Microsoft.Alpha(opacity=40);
    }
    body.dark #sqOverlay { filter: progid:DXImageTransform.Microsoft.Alpha(opacity=55); }
    #sqDialog {
        position: absolute; z-index: 901; display: none; padding: 10px;
        background-color: #e8eaee;
        border: 2px solid; border-color: #f8fafc #a2a8b2 #a2a8b2 #f8fafc;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#F2FFFFFF', endColorstr='#D8D8DCE4');
    }
    body.dark #sqDialog {
        background-color: #2b2f35;
        border-color: #4a5058 #0e1013 #0e1013 #4a5058;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C8333740', endColorstr='#B0252930');
    }
    .sq-dialog-head { margin-bottom: 8px; cursor: move; }
    #sqDialogTitle { font-weight: bold; font-size: 14px; color: #3d444d; margin-right: 8px; vertical-align: middle; }
    body.dark #sqDialogTitle { color: #aeb4bc; }
    .sq-dialog-btn {
        height: 28px; padding: 0 14px; margin-left: 8px; cursor: pointer; vertical-align: middle;
        font-size: 13px; font-weight: bold; color: #ffffff;
        background-color: #7b43f5;
        border: 2px solid; border-color: #7b43f5 #4895ef #4895ef #7b43f5;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF4895EF');
    }
    body.dark .sq-dialog-btn {
        background-color: #8b5cf6;
        border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    #sqFrame {
        background-color: #ffffff;
        border: 2px solid; border-color: #9aa2ac #ffffff #ffffff #9aa2ac;
    }
    /* 弹窗右下角拖拽手柄：鼠标拖动可自由调整弹窗大小 */
    .sq-resize-handle {
        position: absolute; right: 3px; bottom: 3px; width: 18px; height: 18px;
        cursor: se-resize; z-index: 940; overflow: hidden;
    }
    .sq-resize-handle span {
        position: absolute; right: 0; display: block; height: 3px;
        background-color: #7b43f5;
    }
    .sq-resize-handle .sq-rh-1 { bottom: 0; width: 16px; }
    .sq-resize-handle .sq-rh-2 { bottom: 6px; width: 10px; }
    .sq-resize-handle .sq-rh-3 { bottom: 12px; width: 4px; }
    body.dark .sq-resize-handle span { background-color: #8b5cf6; }
    /* 拖拽调整大小期间的透明遮罩：盖住 iframe，防止其吞掉鼠标移动事件 */
    #sqDragMask {
        position: absolute; left: 0; top: 0; width: 100%; height: 100%;
        z-index: 950; display: none; cursor: se-resize;
        background-color: #ffffff;
        filter: progid:DXImageTransform.Microsoft.Alpha(opacity=1);
    }
</style>
<script language="VBScript">
    Sub Window_OnLoad
        Dim winW, maxH, winH, chromeH
        winW = 1100
        maxH = Int(screen.availHeight * 0.95)
        If winW > Int(screen.availWidth * 0.95) Then winW = Int(screen.availWidth * 0.95)
        ' 先按目标宽度调整窗口，待初始化完成后按实际内容高度贴合窗口，避免底部留白
        window.resizeTo winW, 600
        ' 主窗口尺寸变化时同步调整攻略弹窗；窗口失去焦点时结束未完成的拖拽
        On Error Resume Next
        window.onresize = GetRef("Window_OnResize")
        window.onblur = GetRef("Window_OnBlur")
        On Error GoTo 0
        FillRemindMinutes
        RenderShenqiLinks
        ' 标题栏/边框补偿 = 临时窗口高 - 客户区高（quirks 模式下 documentElement.clientHeight 恒为 0，须用 body.clientHeight 读取视口高）；窗口高 = 内容高 + 补偿 + 少量余量
        chromeH = 600 - document.body.clientHeight
        If chromeH < 0 Or chromeH > 200 Then chromeH = 72
        winH = document.body.scrollHeight + chromeH + 4
        If winH > maxH Then winH = maxH
        If winH < 400 Then winH = 400
        window.resizeTo winW, winH
        window.moveTo (screen.availWidth - winW) \ 2, (screen.availHeight - winH) \ 2
        document.getElementById("txtPrice").focus
    End Sub
    Sub Window_OnUnload
        StopRemindTimers
    End Sub
    Sub CheckEnter
        If window.event.keyCode = 13 Then Calculate
    End Sub
    Sub CheckEnterGold
        If window.event.keyCode = 13 Then CalcGold
    End Sub
    Function GetGoldRatio()
        Dim strVal
        GetGoldRatio = 0
        strVal = document.getElementById("txtGold").value
        If Not IsNumeric(strVal) Then
            MsgBox "请先在金价比例中输入大于0的有效数字！", vbExclamation, "输入错误"
            document.getElementById("txtGold").focus
            Exit Function
        End If
        If CDbl(strVal) <= 0 Then
            MsgBox "请先在金价比例中输入大于0的有效数字！", vbExclamation, "输入错误"
            document.getElementById("txtGold").focus
            Exit Function
        End If
        GetGoldRatio = CDbl(strVal)
    End Function
    Sub CalcGold
        Dim dblGold, dblPerYuan, strVal, dblCoin, dblRmb, strHtml, strCls
        dblGold = GetGoldRatio()
        If dblGold = 0 Then Exit Sub
        ' 换算基准：金价比例 g 元 / 1000万梦幻币（1千万 = 1000万），万↔千万因子为 1000
        dblPerYuan = 1000 / dblGold
        dblCoin = -1
        dblRmb = -1
        strVal = document.getElementById("txtCoin").value
        If strVal <> "" Then
            If Not IsNumeric(strVal) Or CDbl(strVal) < 0 Then
                MsgBox "梦幻币必须为非负数字（不填默认不换算）！", vbExclamation, "输入错误"
                document.getElementById("txtCoin").focus
                Exit Sub
            End If
            dblCoin = CDbl(strVal)
        End If
        strVal = document.getElementById("txtRmb").value
        If strVal <> "" Then
            If Not IsNumeric(strVal) Or CDbl(strVal) < 0 Then
                MsgBox "人民币必须为非负数字（不填默认不换算）！", vbExclamation, "输入错误"
                document.getElementById("txtRmb").focus
                Exit Sub
            End If
            dblRmb = CDbl(strVal)
        End If
        strHtml = "<table class=""xiu-table""><tr><th class=""x1"" width=""30%"">项目</th><th class=""x2"">结果</th></tr>"
        strHtml = strHtml & "<tr><td class=""xiu-item"">金价比例</td><td class=""xiu-val"">" & FormatNumber(dblGold, 2) & " 元 / 1000万梦幻币</td></tr>"
        strHtml = strHtml & "<tr class=""alt""><td class=""xiu-item"">基准换算</td><td class=""xiu-val"">1 元 = " & FormatNumber(dblPerYuan, 2) & " 万梦幻币，1 万梦幻币 = " & FormatNumber(dblGold / 1000, 4) & " 元</td></tr>"
        If dblCoin >= 0 Then
            strHtml = strHtml & "<tr><td class=""xiu-item"">梦幻币 → 人民币</td><td class=""xiu-val"">" & FormatNumber(dblCoin, 2) & " 万梦幻币 ≈ <b>" & FormatNumber(dblCoin / 1000 * dblGold, 2) & "</b> 元</td></tr>"
        End If
        If dblRmb >= 0 Then
            If dblCoin >= 0 Then strCls = " class=""alt""" Else strCls = ""
            strHtml = strHtml & "<tr" & strCls & "><td class=""xiu-item"">人民币 → 梦幻币</td><td class=""xiu-val"">" & FormatNumber(dblRmb, 2) & " 元 ≈ <b>" & FormatNumber(dblRmb / dblGold * 1000, 2) & "</b> 万梦幻币</td></tr>"
        End If
        strHtml = strHtml & "</table>"
        document.getElementById("goldResult").innerHTML = strHtml
    End Sub
    ' 宝石成本多选合计：gemCosts(i) 为 i 级单个成本；gemPicked 记录选中等级；各等级个数填在 gemQty{等级} 输入框中（空=1个）
    ' gemResultOn：结果区展开状态（默认折叠，生成表格或点击切换时展开）
    Dim gemSelectOn, gemResultOn, gemPicked, gemCosts(15)
    Set gemPicked = CreateObject("Scripting.Dictionary")
    gemSelectOn = False
    gemResultOn = False
    Sub Calculate
        Dim strVal, dblPrice, i, lngNeed, lngCum, dblCost, dblCumCost, strHtml, strCls
        strVal = document.getElementById("txtPrice").value
        If Not IsNumeric(strVal) Then
            MsgBox "请输入大于0的有效数字！", vbExclamation, "输入错误"
            document.getElementById("txtPrice").focus
            Exit Sub
        End If
        dblPrice = CDbl(strVal)
        If dblPrice <= 0 Then
            MsgBox "请输入大于0的有效数字！", vbExclamation, "输入错误"
            document.getElementById("txtPrice").focus
            Exit Sub
        End If
        strHtml = "<table><tr><th class=""g1"" width=""10%"">等级</th><th class=""g2"" width=""15%"">需要1级宝石(个)</th><th class=""g3"" width=""15%"">累计1级宝石(个)</th><th class=""g4"" width=""30%"">单个成本(万)</th><th class=""g5"" width=""30%"">累计成本(万)</th></tr>"
        For i = 1 To 15
            lngNeed = 2 ^ (i - 1)
            lngCum = 2 ^ i - 1
            dblCost = lngNeed * dblPrice
            dblCumCost = lngCum * dblPrice
            gemCosts(i) = dblCost
            If i Mod 2 = 0 Then strCls = " class=""alt""" Else strCls = ""
            strHtml = strHtml & "<tr" & strCls & "><td class=""lv"">" & i & "级</td><td class=""num"">" & lngNeed & "</td><td class=""num"">" & lngCum & "</td><td class=""cost"" onclick=""ToggleGemPick " & i & """>" & FormatNumber(dblCost, 2) & "</td><td>" & FormatNumber(dblCumCost, 2) & "</td></tr>"
        Next
        document.getElementById("resultArea").innerHTML = strHtml & "</table>"
        ' 表格重新生成后重置多选与合计结果，并自动展开结果区
        gemPicked.RemoveAll
        document.getElementById("gemSumResult").innerHTML = ""
        SetGemResultVisible True
    End Sub
    ' 设置宝石结果区显示状态（同步切换提示文本与状态变量）
    Sub SetGemResultVisible(bOn)
        gemResultOn = bOn
        If bOn Then
            document.getElementById("resultArea").style.display = "block"
            document.getElementById("gemResultToggleHint").innerText = "▲ 收起"
        Else
            document.getElementById("resultArea").style.display = "none"
            document.getElementById("gemResultToggleHint").innerText = "▼ 展开"
        End If
    End Sub
    ' 结果区默认折叠，点击标题行展开/收起（与神器攻略一致）
    Sub ToggleGemResult
        If Not gemResultOn Then
            If document.getElementById("resultArea").innerHTML = "" Then
                MsgBox "请先输入宝石单价并点击“确认换算”生成表格！", vbExclamation, "提示"
                Exit Sub
            End If
            SetGemResultVisible True
        Else
            SetGemResultVisible False
        End If
    End Sub
    ' 进入/退出宝石成本多选模式
    Sub ToggleGemSelect
        If Not gemSelectOn Then
            If document.getElementById("resultArea").innerHTML = "" Then
                MsgBox "请先输入宝石单价并点击“确认换算”生成表格！", vbExclamation, "提示"
                Exit Sub
            End If
            gemSelectOn = True
            SetGemResultVisible True
            document.getElementById("btnGemSelect").innerText = "退出选择"
            document.getElementById("resultArea").className = "pick"
            document.getElementById("gemSumResult").innerHTML = "选择模式：点击表格中“单个成本(万)”列的金额选中该等级，在出现的输入框中填写宝石个数（不填默认1个），选好后点击“计算”按钮合计。"
        Else
            gemSelectOn = False
            document.getElementById("btnGemSelect").innerText = "选择"
            document.getElementById("resultArea").className = ""
            document.getElementById("gemSumResult").innerHTML = ""
        End If
    End Sub
    ' 点击“单个成本”单元格切换选中状态（仅选择模式下生效）；选中后单元格内出现个数输入框
    Sub ToggleGemPick(idx)
        Dim objSrc, objTd, objInputs
        If Not gemSelectOn Then Exit Sub
        If idx < 1 Or idx > 15 Then Exit Sub
        Set objSrc = window.event.srcElement
        ' 点击个数输入框内部时不改变选中状态
        If UCase(objSrc.tagName) = "INPUT" Then Exit Sub
        Set objTd = objSrc
        If gemPicked.Exists(idx) Then
            gemPicked.Remove idx
            objTd.className = "cost"
            objTd.innerHTML = FormatNumber(gemCosts(idx), 2)
        Else
            gemPicked(idx) = True
            objTd.className = "cost picked"
            objTd.innerHTML = FormatNumber(gemCosts(idx), 2) & " <input type=""text"" class=""gem-qty"" id=""gemQty" & idx & """ value="""" placeholder=""1"" title=""该等级宝石个数，不填默认1个"" />"
            Set objInputs = objTd.getElementsByTagName("INPUT")
            If objInputs.length > 0 Then objInputs(0).focus
        End If
    End Sub
    ' 合计已选成本（个数取自各等级输入框，不填默认1）
    Sub CalcGemSum
        Dim k, dblSum, dblQty, objInp, strVal, strDetail
        If gemPicked.Count = 0 Then
            MsgBox "尚未选择任何宝石成本！请先点击“选择”按钮进入选择模式，再点击表格中的金额多选。", vbExclamation, "提示"
            Exit Sub
        End If
        dblSum = 0
        strDetail = ""
        For Each k In gemPicked.Keys
            Set objInp = document.getElementById("gemQty" & k)
            strVal = ""
            If Not objInp Is Nothing Then strVal = Trim(objInp.value)
            If strVal = "" Then
                dblQty = 1
            Else
                If IsNumeric(strVal) Then
                    If CDbl(strVal) >= 1 And CDbl(strVal) = Fix(CDbl(strVal)) Then
                        dblQty = CDbl(strVal)
                    Else
                        dblQty = 0
                    End If
                Else
                    dblQty = 0
                End If
                If dblQty = 0 Then
                    MsgBox "“" & k & "级”宝石的个数须为大于等于1的整数（不填默认1）！", vbExclamation, "输入错误"
                    If Not objInp Is Nothing Then objInp.focus
                    Exit Sub
                End If
            End If
            dblSum = dblSum + gemCosts(k) * dblQty
            If strDetail <> "" Then strDetail = strDetail & "、"
            strDetail = strDetail & k & "级×" & dblQty
        Next
        document.getElementById("gemSumResult").innerHTML = "已选 <b>" & gemPicked.Count & "</b> 项（" & strDetail & "），合计：<b>" & FormatNumber(dblSum, 2) & "</b> 万梦幻币"
    End Sub
    Dim arrHistory, historyCount, lastDesc, lastResult
    ReDim arrHistory(0)
    historyCount = 0
    lastDesc = ""
    lastResult = ""
    Dim remindTimerId, remindUiTimerId, remindLastFired, remindHour, remindMinute, remindSecond
    remindTimerId = 0
    remindUiTimerId = 0
    remindHour = -1
    Function Pad2(n)
        Pad2 = Right("0" & n, 2)
    End Function
    Sub FillRemindMinutes
        FillHourOptions "selRemindHour"
        FillTimeOptions "selRemindMinute"
        FillTimeOptions "selRemindSecond"
    End Sub
    Sub FillTimeOptions(strId)
        Dim i, objSel, objOpt
        Set objSel = document.getElementById(strId)
        For i = 0 To 59
            Set objOpt = document.createElement("OPTION")
            objSel.options.Add objOpt
            objOpt.text = Pad2(i)
            objOpt.value = CStr(i)
        Next
    End Sub
    Sub FillHourOptions(strId)
        Dim i, objSel, objOpt
        Set objSel = document.getElementById(strId)
        Set objOpt = document.createElement("OPTION")
        objSel.options.Add objOpt
        objOpt.text = "不设置"
        objOpt.value = "-1"
        For i = 0 To 23
            Set objOpt = document.createElement("OPTION")
            objSel.options.Add objOpt
            objOpt.text = Pad2(i)
            objOpt.value = CStr(i)
        Next
    End Sub
    Sub StartRemind
        remindHour = CInt(document.getElementById("selRemindHour").value)
        remindMinute = CInt(document.getElementById("selRemindMinute").value)
        remindSecond = CInt(document.getElementById("selRemindSecond").value)
        remindLastFired = ""
        document.getElementById("btnRemindStart").disabled = True
        document.getElementById("btnRemindStop").disabled = False
        document.getElementById("btnRemindTest").disabled = True
        document.getElementById("selRemindHour").disabled = True
        document.getElementById("selRemindMinute").disabled = True
        document.getElementById("selRemindSecond").disabled = True
        StopRemindTimers
        remindTimerId = window.setInterval("CheckRemindTime", 1000, "VBScript")
        remindUiTimerId = window.setInterval("RefreshRemindStatus", 1000, "VBScript")
        CheckRemindTime
        RefreshRemindStatus
    End Sub
    Sub StopRemind
        StopRemindTimers
        document.getElementById("btnRemindStart").disabled = False
        document.getElementById("btnRemindStop").disabled = True
        document.getElementById("btnRemindTest").disabled = False
        document.getElementById("selRemindHour").disabled = False
        document.getElementById("selRemindMinute").disabled = False
        document.getElementById("selRemindSecond").disabled = False
        document.getElementById("remindStatus").innerHTML = "已停止"
    End Sub
    Sub StopRemindTimers
        If remindTimerId <> 0 Then window.clearInterval(remindTimerId) : remindTimerId = 0
        If remindUiTimerId <> 0 Then window.clearInterval(remindUiTimerId) : remindUiTimerId = 0
    End Sub
    Sub CheckRemindTime
        Dim dtNow, dtTarget, lngDelta, strKey
        dtNow = Now
        If remindHour >= 0 Then
            dtTarget = DateSerial(Year(dtNow), Month(dtNow), Day(dtNow)) + TimeSerial(remindHour, remindMinute, remindSecond)
            lngDelta = DateDiff("s", dtTarget, dtNow)
            If lngDelta >= 0 And lngDelta <= 10 Then
                strKey = Day(dtNow)
                If remindLastFired <> strKey Then
                    remindLastFired = strKey
                    ShowRemindNotify
                End If
            End If
        Else
            dtTarget = DateSerial(Year(dtNow), Month(dtNow), Day(dtNow)) + TimeSerial(Hour(dtNow), remindMinute, remindSecond)
            lngDelta = DateDiff("s", dtTarget, dtNow)
            If lngDelta >= 0 And lngDelta <= 10 Then
                strKey = Day(dtNow) & "-" & Hour(dtNow)
                If remindLastFired <> strKey Then
                    remindLastFired = strKey
                    ShowRemindNotify
                End If
            End If
        End If
    End Sub
    Sub RefreshRemindStatus
        Dim dtNow, dtNext, lngDiff, strMode
        dtNow = Now
        If remindHour >= 0 Then
            dtNext = DateSerial(Year(dtNow), Month(dtNow), Day(dtNow)) + TimeSerial(remindHour, remindMinute, remindSecond)
            If dtNext <= dtNow Then dtNext = DateAdd("d", 1, dtNext)
            strMode = "每天 " & Pad2(remindHour) & ":" & Pad2(remindMinute) & ":" & Pad2(remindSecond)
        Else
            dtNext = DateSerial(Year(dtNow), Month(dtNow), Day(dtNow)) + TimeSerial(Hour(dtNow), remindMinute, remindSecond)
            If dtNext <= dtNow Then dtNext = DateAdd("h", 1, dtNext)
            strMode = "每小时第 " & Pad2(remindMinute) & " 分 " & Pad2(remindSecond) & " 秒"
        End If
        lngDiff = DateDiff("s", dtNow, dtNext)
        document.getElementById("remindStatus").innerHTML = "<b>运行中</b>（" & strMode & "） 下次提醒 " & Pad2(Hour(dtNext)) & ":" & Pad2(Minute(dtNext)) & ":" & Pad2(Second(dtNext)) & "（还剩 " & (lngDiff \ 3600) & " 时 " & ((lngDiff Mod 3600) \ 60) & " 分 " & (lngDiff Mod 60) & " 秒）"
    End Sub
    Sub ShowRemindNotify
        Dim strMsg, strTitle, strPs, strCmd
        strMsg = document.getElementById("txtRemindMsg").value
        If strMsg = "" Then strMsg = "时间到啦！"
        strMsg = Replace(strMsg, """", "")
        strMsg = Replace(strMsg, "'", "''")
        strTitle = "定时提醒 " & Pad2(Hour(Now)) & ":" & Pad2(Minute(Now)) & ":" & Pad2(Second(Now))
        strPs = "Add-Type -AssemblyName System.Windows.Forms;Add-Type -AssemblyName System.Drawing;$n=New-Object System.Windows.Forms.NotifyIcon;$n.Icon=[System.Drawing.SystemIcons]::Information;$n.Visible=$true;$n.ShowBalloonTip(10000,'" & strTitle & "','" & strMsg & "',[System.Windows.Forms.ToolTipIcon]::Info);[System.Media.SystemSounds]::Exclamation.Play();Start-Sleep -Seconds 12;$n.Dispose()"
        strCmd = "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command """ & strPs & """"
        CreateObject("WScript.Shell").Run strCmd, 0, False
    End Sub
    Sub CheckEnterAttr
        If window.event.keyCode = 13 Then CalcAttr
    End Sub
    Sub CalcAttr
        If document.getElementById("selCalcType").value = "weapon" Then
            CalcWeapon
        Else
            CalcEquip
        End If
    End Sub
    Sub SwitchCalcType
        If document.getElementById("selCalcType").value = "weapon" Then
            document.getElementById("rowWeaponRequired").style.display = ""
            document.getElementById("rowEquipRequired").style.display = "none"
            document.getElementById("btnCalcAttr").innerText = "计算武器属性"
        Else
            document.getElementById("rowWeaponRequired").style.display = "none"
            document.getElementById("rowEquipRequired").style.display = ""
            document.getElementById("btnCalcAttr").innerText = "计算装备属性"
        End If
        document.getElementById("divAttrTable").style.display = "none"
    End Sub
    Sub CheckEnterXiu
        If window.event.keyCode = 13 Then CalcXiulian
    End Sub
    Function XiuExpForLv(lv)
        XiuExpForLv = (lv * lv + lv * 3 + 11) * 10
    End Function
    Sub CalcXiulian
        Dim strType, strName, strVal
        Dim curLv, tgtLv, curExp, tgtExp
        Dim i, needExp, times, perCoin, perCoinFree, coinN, coinF, strN, strF
        Dim needContrib, contribHtml, xiuHtml
        Dim jiuPrice, jiuQuality, jiuTotalQ, jiuCount, jiuCoin, jiuCoinStr, jiuHtml
        Dim guoPrice, baiHuan, guoCount, guoCoin, guoCoinStr, guoStr

        strType = document.getElementById("selXiuType").value
        strVal = document.getElementById("txtXiuCurLv").value
        If Not IsNumeric(strVal) Or strVal = "" Then
            MsgBox "请输入当前修炼等级（0-25的整数）！", vbExclamation, "输入错误"
            document.getElementById("txtXiuCurLv").focus
            Exit Sub
        End If
        If CDbl(strVal) <> Int(CDbl(strVal)) Or CDbl(strVal) < 0 Or CDbl(strVal) > 25 Then
            MsgBox "当前修炼等级必须为0-25的整数！", vbExclamation, "输入错误"
            document.getElementById("txtXiuCurLv").focus
            Exit Sub
        End If
        curLv = CInt(strVal)

        curExp = 0
        strVal = document.getElementById("txtXiuCurExp").value
        If strVal <> "" Then
            If Not IsNumeric(strVal) Then
                MsgBox "当前经验必须为非负整数（不填默认按0计算）！", vbExclamation, "输入错误"
                document.getElementById("txtXiuCurExp").focus
                Exit Sub
            End If
            If CDbl(strVal) < 0 Or CDbl(strVal) <> Int(CDbl(strVal)) Then
                MsgBox "当前经验必须为非负整数（不填默认按0计算）！", vbExclamation, "输入错误"
                document.getElementById("txtXiuCurExp").focus
                Exit Sub
            End If
            curExp = CLng(strVal)
        End If

        strVal = document.getElementById("txtXiuTgtLv").value
        If Not IsNumeric(strVal) Or strVal = "" Then
            MsgBox "请输入目标修炼等级（0-25的整数）！", vbExclamation, "输入错误"
            document.getElementById("txtXiuTgtLv").focus
            Exit Sub
        End If
        If CDbl(strVal) <> Int(CDbl(strVal)) Or CDbl(strVal) < 0 Or CDbl(strVal) > 25 Then
            MsgBox "目标修炼等级必须为0-25的整数！", vbExclamation, "输入错误"
            document.getElementById("txtXiuTgtLv").focus
            Exit Sub
        End If
        tgtLv = CInt(strVal)
        If tgtLv < curLv Then
            MsgBox "目标修炼等级不能低于当前修炼等级！", vbExclamation, "输入错误"
            document.getElementById("txtXiuTgtLv").focus
            Exit Sub
        End If

        tgtExp = 0
        strVal = document.getElementById("txtXiuTgtExp").value
        If strVal <> "" Then
            If Not IsNumeric(strVal) Then
                MsgBox "目标经验必须为非负整数（不填默认按0计算）！", vbExclamation, "输入错误"
                document.getElementById("txtXiuTgtExp").focus
                Exit Sub
            End If
            If CDbl(strVal) < 0 Or CDbl(strVal) <> Int(CDbl(strVal)) Then
                MsgBox "目标经验必须为非负整数（不填默认按0计算）！", vbExclamation, "输入错误"
                document.getElementById("txtXiuTgtExp").focus
                Exit Sub
            End If
            tgtExp = CLng(strVal)
        End If

        ' 九转金丹选填项（仅人物修炼）：每颗经验 = 品质×0.5，总品质 = 还需经验×2；填了品质时按颗数向上取整
        jiuPrice = 0
        jiuQuality = 0
        jiuHtml = ""
        guoPrice = 0
        If strType = "pet" Then
            ' 召唤兽修炼：修炼果价格（万/颗，选填），每颗固定 150 点经验
            strVal = Trim(document.getElementById("txtGuoPrice").value)
            If strVal <> "" Then
                If Not IsNumeric(strVal) Then
                    MsgBox "修炼果价格必须为大于0的数字（不填则不计算总成本）！", vbExclamation, "输入错误"
                    document.getElementById("txtGuoPrice").focus
                    Exit Sub
                End If
                If CDbl(strVal) <= 0 Then
                    MsgBox "修炼果价格必须为大于0的数字（不填则不计算总成本）！", vbExclamation, "输入错误"
                    document.getElementById("txtGuoPrice").focus
                    Exit Sub
                End If
                guoPrice = CDbl(strVal)
            End If
        Else
            strVal = Trim(document.getElementById("txtJiuPrice").value)
            If strVal <> "" Then
                If Not IsNumeric(strVal) Then
                    MsgBox "九转金丹每品质价格必须为大于0的数字（不填则不计算金丹）！", vbExclamation, "输入错误"
                    document.getElementById("txtJiuPrice").focus
                    Exit Sub
                End If
                If CDbl(strVal) <= 0 Then
                    MsgBox "九转金丹每品质价格必须为大于0的数字（不填则不计算金丹）！", vbExclamation, "输入错误"
                    document.getElementById("txtJiuPrice").focus
                    Exit Sub
                End If
                jiuPrice = CDbl(strVal)
            End If
            strVal = Trim(document.getElementById("txtJiuQuality").value)
            If strVal <> "" Then
                If Not IsNumeric(strVal) Then
                    MsgBox "九转金丹品质必须为大于0的数字（不填则不计算金丹）！", vbExclamation, "输入错误"
                    document.getElementById("txtJiuQuality").focus
                    Exit Sub
                End If
                If CDbl(strVal) <= 0 Then
                    MsgBox "九转金丹品质必须为大于0的数字（不填则不计算金丹）！", vbExclamation, "输入错误"
                    document.getElementById("txtJiuQuality").focus
                    Exit Sub
                End If
                jiuQuality = CDbl(strVal)
            End If
        End If

        If curLv < 25 And curExp >= XiuExpForLv(curLv + 1) Then
            MsgBox "当前经验已达到升" & (curLv + 1) & "级所需（" & XiuExpForLv(curLv + 1) & "点），请先调整当前等级！", vbExclamation, "输入错误"
            Exit Sub
        End If
        If tgtLv < 25 And tgtExp >= XiuExpForLv(tgtLv + 1) Then
            MsgBox "目标经验已达到升" & (tgtLv + 1) & "级所需（" & XiuExpForLv(tgtLv + 1) & "点），请调整目标等级！", vbExclamation, "输入错误"
            Exit Sub
        End If

        needExp = tgtExp - curExp
        For i = curLv + 1 To tgtLv
            needExp = needExp + XiuExpForLv(i)
        Next
        If needExp < 0 Then
            MsgBox "当前修炼进度已达到目标！", vbInformation, "提示"
            Exit Sub
        End If

        times = Int((needExp + 9) / 10)

        Select Case strType
            Case "attack" : strName = "攻击修炼" : perCoin = 3 : perCoinFree = 4.5
            Case "magic"  : strName = "法术修炼" : perCoin = 3 : perCoinFree = 4.5
            Case "hunt"   : strName = "猎术修炼" : perCoin = 3 : perCoinFree = 4.5
            Case "defend" : strName = "防御修炼" : perCoin = 2 : perCoinFree = 3.5
            Case "resist" : strName = "抗法修炼" : perCoin = 2 : perCoinFree = 3.5
            Case "pet"    : strName = "召唤兽修炼" : perCoin = 0 : perCoinFree = 0
        End Select

        needContrib = tgtLv * 150
        contribHtml = "≥ <b>" & needContrib & "</b> 点"
        xiuHtml = "<table class=""xiu-table""><tr><th class=""x1"" width=""30%"">项目</th><th class=""x2"">结果</th></tr>"
        xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">修炼类型</td><td class=""xiu-val"">" & strName & "</td></tr>"
        xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">修炼进度</td><td class=""xiu-val"">" & curLv & "级（" & curExp & "经验） → " & tgtLv & "级（" & tgtExp & "经验）</td></tr>"
        If times = 0 Then
            xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">还需修炼经验</td><td class=""xiu-val""><b>0</b> 点（已达到目标进度，无需修炼）</td></tr>"
            If strType <> "pet" Then
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">要求帮派总贡献</td><td class=""xiu-val"">" & contribHtml & "（目标等级 " & tgtLv & " × 150）</td></tr>"
            End If
        Else
            xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">还需修炼经验</td><td class=""xiu-val""><b>" & needExp & "</b> 点</td></tr>"
            If strType = "pet" Then
                ' 召唤兽修炼：每百环约 760 点经验、每颗修炼果固定 150 点经验，次数与个数均向上取整
                baiHuan = -Int(-needExp / 760)
                guoCount = -Int(-needExp / 150)
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">召唤兽修炼百环</td><td class=""xiu-val""><b>" & baiHuan & "</b> 次（每百环约 760 点经验）</td></tr>"
                guoStr = "<b>" & guoCount & "</b> 个（每颗 150 点经验）"
                If guoPrice > 0 Then
                    guoCoin = guoCount * guoPrice
                    If guoCoin = Int(guoCoin) Then guoCoinStr = FormatNumber(guoCoin, 0) Else guoCoinStr = FormatNumber(guoCoin, 1)
                    guoStr = guoStr & "，<b>" & guoCoinStr & "</b> 万梦幻币"
                End If
                xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">修炼果</td><td class=""xiu-val"">" & guoStr & "</td></tr>"
            Else
                coinN = times * perCoin
                coinF = times * perCoinFree
                If coinN = Int(coinN) Then strN = FormatNumber(coinN, 0) Else strN = FormatNumber(coinN, 1)
                If coinF = Int(coinF) Then strF = FormatNumber(coinF, 0) Else strF = FormatNumber(coinF, 1)
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">修炼次数</td><td class=""xiu-val""><b>" & times & "</b> 次（每次提升 10 点经验）</td></tr>"
                xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">正常模式消耗</td><td class=""xiu-val""><b>" & strN & "</b> 万梦幻币 + <b>" & times * 5 & "</b> 点资材</td></tr>"
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">免资材模式消耗</td><td class=""xiu-val""><b>" & strF & "</b> 万梦幻币（不消耗资材）</td></tr>"
                ' 九转金丹方案（填了价格或品质时显示；经验 = 品质×0.5，总品质 = 还需经验×2）
                If jiuPrice > 0 Or jiuQuality > 0 Then
                    jiuTotalQ = needExp * 2
                    If jiuQuality > 0 Then
                        jiuCount = -Int(-needExp / (jiuQuality * 0.5))
                        jiuTotalQ = jiuCount * jiuQuality
                    End If
                    If jiuPrice > 0 Then
                        jiuCoin = jiuTotalQ * jiuPrice / 10000
                        If jiuCoin = Int(jiuCoin) Then jiuCoinStr = FormatNumber(jiuCoin, 0) Else jiuCoinStr = FormatNumber(jiuCoin, 1)
                    End If
                    If jiuQuality > 0 Then
                        If jiuPrice > 0 Then
                            jiuHtml = "<tr><td class=""xiu-item"">九转金丹</td><td class=""xiu-val""><b>" & jiuTotalQ & "</b> 品质（<b>" & jiuCount & "</b> 颗 × " & jiuQuality & " 品），<b>" & jiuCoinStr & "</b> 万梦幻币</td></tr>"
                        Else
                            jiuHtml = "<tr><td class=""xiu-item"">九转金丹</td><td class=""xiu-val""><b>" & jiuTotalQ & "</b> 品质（<b>" & jiuCount & "</b> 颗 × " & jiuQuality & " 品）</td></tr>"
                        End If
                    Else
                        jiuHtml = "<tr><td class=""xiu-item"">九转金丹</td><td class=""xiu-val""><b>" & jiuTotalQ & "</b> 品质，<b>" & jiuCoinStr & "</b> 万梦幻币</td></tr>"
                    End If
                    xiuHtml = xiuHtml & jiuHtml
                End If
                xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">要求帮派总贡献</td><td class=""xiu-val"">" & contribHtml & "（目标等级 " & tgtLv & " × 150）</td></tr>"
            End If
        End If
        xiuHtml = xiuHtml & "</table>"
        document.getElementById("xiuResult").innerHTML = xiuHtml
    End Sub
    Sub OnXiuTypeChange
        Dim isPet
        isPet = (document.getElementById("selXiuType").value = "pet")
        If isPet Then
            document.getElementById("divXiuJiu").style.display = "none"
            document.getElementById("divXiuGuo").style.display = ""
        Else
            document.getElementById("divXiuJiu").style.display = ""
            document.getElementById("divXiuGuo").style.display = "none"
        End If
    End Sub
    Sub CalcWeapon
        Dim strRace, strDmg, strHit, dblDmg, dblHit
        Dim dblStr, dblMag, dblEnd, dblCon, dblAgi
        Dim dblStrDmgCoeff, dblEndDefCoeff, dblConHpCoeff
        Dim dblSpirit, dblTotalDmg, dblPhysInit, dblMagicInit, dblDefense, dblHp, dblSpeed
        strRace = document.getElementById("selRace").value
        strDmg = document.getElementById("txtWeaponDmg").value
        If Not IsNumeric(strDmg) Or strDmg = "" Then
            MsgBox "请输入武器伤害！", vbExclamation, "输入错误"
            document.getElementById("txtWeaponDmg").focus
            Exit Sub
        End If
        dblDmg = CDbl(strDmg)
        strHit = document.getElementById("txtWeaponHit").value
        If Not IsNumeric(strHit) Or strHit = "" Then
            MsgBox "请输入武器命中！", vbExclamation, "输入错误"
            document.getElementById("txtWeaponHit").focus
            Exit Sub
        End If
        dblHit = CDbl(strHit)
        dblStr = 0 : dblMag = 0 : dblEnd = 0 : dblCon = 0 : dblAgi = 0
        If document.getElementById("txtStr").value <> "" And IsNumeric(document.getElementById("txtStr").value) Then dblStr = CDbl(document.getElementById("txtStr").value)
        If document.getElementById("txtMag").value <> "" And IsNumeric(document.getElementById("txtMag").value) Then dblMag = CDbl(document.getElementById("txtMag").value)
        If document.getElementById("txtEnd").value <> "" And IsNumeric(document.getElementById("txtEnd").value) Then dblEnd = CDbl(document.getElementById("txtEnd").value)
        If document.getElementById("txtCon").value <> "" And IsNumeric(document.getElementById("txtCon").value) Then dblCon = CDbl(document.getElementById("txtCon").value)
        If document.getElementById("txtAgi").value <> "" And IsNumeric(document.getElementById("txtAgi").value) Then dblAgi = CDbl(document.getElementById("txtAgi").value)
        Select Case strRace
            Case "human" : dblStrDmgCoeff = 0.67 : dblEndDefCoeff = 1.5 : dblConHpCoeff = 5
            Case "immortal" : dblStrDmgCoeff = 0.57 : dblEndDefCoeff = 1.6 : dblConHpCoeff = 4.5
            Case "demon" : dblStrDmgCoeff = 0.77 : dblEndDefCoeff = 1.4 : dblConHpCoeff = 6
        End Select
        dblTotalDmg = dblDmg + dblStr * dblStrDmgCoeff
        dblSpirit = dblStr * 0.4 + dblMag * 0.7 + dblEnd * 0.2 + dblCon * 0.3
        dblPhysInit = dblHit / 3 + dblTotalDmg
        SaveToHistory
        dblMagicInit = dblDmg / 4 + dblSpirit
        dblDefense = dblEnd * dblEndDefCoeff
        dblHp = dblCon * dblConHpCoeff
        dblSpeed = dblCon * 0.1 + dblEnd * 0.1 + dblStr * 0.1 + dblAgi * 0.7
        document.getElementById("divAttrTable").style.display = ""
        document.getElementById("tdADmg").innerText = FormatNumber(dblPhysInit, 2)
        document.getElementById("tdAMag").innerText = FormatNumber(dblMagicInit, 2)
        document.getElementById("tdADef").innerText = FormatNumber(dblDefense, 2)
        document.getElementById("tdAHp").innerText = FormatNumber(dblHp, 2)
        document.getElementById("tdASpd").innerText = FormatNumber(dblSpeed, 2)
        Dim rn
        Select Case strRace : Case "human" : rn = "人族" : Case "immortal" : rn = "仙族" : Case "demon" : rn = "魔族" : Case Else : rn = strRace : End Select
        lastDesc = "武器 " & rn & " 伤害:" & dblDmg & " 命中:" & dblHit
        If dblStr <> 0 Then lastDesc = lastDesc & " 力:" & dblStr
        If dblMag <> 0 Then lastDesc = lastDesc & " 魔:" & dblMag
        If dblCon <> 0 Then lastDesc = lastDesc & " 体:" & dblCon
        If dblEnd <> 0 Then lastDesc = lastDesc & " 耐:" & dblEnd
        If dblAgi <> 0 Then lastDesc = lastDesc & " 敏:" & dblAgi
        lastResult = "伤害:" & FormatNumber(dblPhysInit, 2) & "  法伤:" & FormatNumber(dblMagicInit, 2) & "  防御:" & FormatNumber(dblDefense, 2) & "  气血:" & FormatNumber(dblHp, 2) & "  速度:" & FormatNumber(dblSpeed, 2)
        RenderHistory
    End Sub
    Sub CalcEquip
        Dim strRace, dblDef, dblCon, dblEnd, dblStr, dblMag, dblAgi, strVal
        Dim dblStrDmgCoeff, dblEndDefCoeff, dblConHpCoeff
        Dim dblDamage, dblSpirit, dblDefense, dblSpeed, dblHp
        strRace = document.getElementById("selRace").value
        strVal = document.getElementById("txtEquipDef").value
        If Not IsNumeric(strVal) Or strVal = "" Then
            MsgBox "请输入装备防御！", vbExclamation, "输入错误"
            document.getElementById("txtEquipDef").focus
            Exit Sub
        End If
        dblDef = CDbl(strVal)
        dblCon = 0 : dblEnd = 0 : dblStr = 0 : dblMag = 0 : dblAgi = 0
        If document.getElementById("txtCon").value <> "" And IsNumeric(document.getElementById("txtCon").value) Then dblCon = CDbl(document.getElementById("txtCon").value)
        If document.getElementById("txtEnd").value <> "" And IsNumeric(document.getElementById("txtEnd").value) Then dblEnd = CDbl(document.getElementById("txtEnd").value)
        If document.getElementById("txtStr").value <> "" And IsNumeric(document.getElementById("txtStr").value) Then dblStr = CDbl(document.getElementById("txtStr").value)
        If document.getElementById("txtMag").value <> "" And IsNumeric(document.getElementById("txtMag").value) Then dblMag = CDbl(document.getElementById("txtMag").value)
        If document.getElementById("txtAgi").value <> "" And IsNumeric(document.getElementById("txtAgi").value) Then dblAgi = CDbl(document.getElementById("txtAgi").value)
        Select Case strRace
            Case "human" : dblStrDmgCoeff = 0.67 : dblEndDefCoeff = 1.5 : dblConHpCoeff = 5
            Case "immortal" : dblStrDmgCoeff = 0.57 : dblEndDefCoeff = 1.6 : dblConHpCoeff = 4.5
            Case "demon" : dblStrDmgCoeff = 0.77 : dblEndDefCoeff = 1.4 : dblConHpCoeff = 6
        End Select
        dblDamage = dblStr * dblStrDmgCoeff
        dblSpirit = dblStr * 0.4 + dblMag * 0.7 + dblEnd * 0.2 + dblCon * 0.3
        SaveToHistory
        dblDefense = dblDef + dblEnd * dblEndDefCoeff
        dblHp = dblCon * dblConHpCoeff
        dblSpeed = dblCon * 0.1 + dblEnd * 0.1 + dblStr * 0.1 + dblAgi * 0.7
        document.getElementById("divAttrTable").style.display = ""
        document.getElementById("tdADmg").innerText = FormatNumber(dblDamage, 2)
        document.getElementById("tdAMag").innerText = FormatNumber(dblSpirit, 2)
        document.getElementById("tdADef").innerText = FormatNumber(dblDefense, 2)
        document.getElementById("tdAHp").innerText = FormatNumber(dblHp, 2)
        document.getElementById("tdASpd").innerText = FormatNumber(dblSpeed, 2)
        Dim rn2
        Select Case strRace : Case "human" : rn2 = "人族" : Case "immortal" : rn2 = "仙族" : Case "demon" : rn2 = "魔族" : Case Else : rn2 = strRace : End Select
        lastDesc = "装备 " & rn2 & " 防御:" & dblDef
        If dblStr <> 0 Then lastDesc = lastDesc & " 力:" & dblStr
        If dblMag <> 0 Then lastDesc = lastDesc & " 魔:" & dblMag
        If dblCon <> 0 Then lastDesc = lastDesc & " 体:" & dblCon
        If dblEnd <> 0 Then lastDesc = lastDesc & " 耐:" & dblEnd
        If dblAgi <> 0 Then lastDesc = lastDesc & " 敏:" & dblAgi
        lastResult = "伤害:" & FormatNumber(dblDamage, 2) & "  法伤:" & FormatNumber(dblSpirit, 2) & "  防御:" & FormatNumber(dblDefense, 2) & "  气血:" & FormatNumber(dblHp, 2) & "  速度:" & FormatNumber(dblSpeed, 2)
        RenderHistory
    End Sub

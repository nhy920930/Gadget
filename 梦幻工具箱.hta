        background-color: #292d33;
        border-color: #0e1013 #3c424a #3c424a #0e1013;
    }
    /* 退出按钮：钉在视口右上角最右（quirks 下 fixed 失效，改 absolute + PinTopButtons 脚本钉位；
       right 值为脚本执行前的兜底定位）；X/Alt+F4 无法拦截，可取消的退出统一走此按钮。
       nowrap 防文字换行（脚本设 left 后宽度由内容撑开） */
    .btn-exit {
        position: absolute; top: 9px; right: 20px; z-index: 999; white-space: nowrap;
        height: 26px; padding: 0 14px; cursor: pointer;
        font-size: 13px; font-weight: bold; color: #ffffff;
        background-color: #c0392b;
        border: 2px solid; border-color: #e05a4a #96281b #96281b #e05a4a;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FFE05A4A', endColorstr='#FFC0392B');
    }
    .btn-exit:active {
        border-color: #96281b #e05a4a #e05a4a #96281b;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FFC0392B', endColorstr='#FFE05A4A');
    }
    body.dark .btn-exit {
        background-color: #d2493a;
        border-color: #e8715f #a03325 #a03325 #e8715f;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FFE8715F', endColorstr='#FFD2493A');
    }
    /* 主题切换排在退出按钮左侧，同处右上角，同由 PinTopButtons 钉位；nowrap 防文字串行换行 */
    .theme-toggle { position: absolute; top: 10px; right: 235px; z-index: 999; white-space: nowrap; }
    .theme-toggle-chk { position: absolute; left: -9999px; }
    .theme-toggle-track {
        display: inline-block; width: 48px; height: 24px; position: relative; vertical-align: middle; cursor: pointer;
        background-color: #c8ccd2;
        border: 2px solid; border-color: #a0a6ae #eceef2 #eceef2 #a0a6ae;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#D8D4D8DE', endColorstr='#C0B4BAC4');
    }
    .theme-toggle-knob {
        display: block; width: 20px; height: 20px; position: absolute; top: 0; left: 0;
        background-color: #f2f4f6;
        border: 2px solid; border-color: #ffffff #98a0a8 #98a0a8 #ffffff;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#EAFFFFFF', endColorstr='#D8E2E6EC');
    }
    .theme-toggle-txt { font-size: 12px; color: #3d444d; margin-left: 6px; vertical-align: middle; font-weight: bold; }
    body.dark .theme-toggle-track {
        background-color: #7b43f5;
        border-color: #6a3de0 #5ba8f5 #5ba8f5 #6a3de0;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    body.dark .theme-toggle-track .theme-toggle-knob { left: 24px; }
    body.dark .theme-toggle-knob {
        background-color: #2e3238;
        border-color: #6a7078 #16181c #16181c #6a7078;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C82E3238', endColorstr='#B026292E');
    }
    body.dark .theme-toggle-txt { color: #aeb4bc; }
    /* 神器任务攻略 */
    #sqLinks { margin-top: 8px; }
    .sq-group {
        display: block; margin: 8px 0 2px 0; padding: 2px 10px; cursor: default;
        color: #ffffff; font-weight: bold; font-size: 13px;
        background-color: #4895ef;
        border: 2px solid; border-color: #7b43f5 #16181c #16181c #7b43f5;
    }
    body.dark .sq-group { background-color: #5ba8f5; }
    .sq-toggle {
        display: inline-block; margin-left: 10px; padding: 2px 12px; cursor: pointer;
        color: #ffffff; font-weight: bold; font-size: 12px;
        background-color: #4895ef;
        border: 2px solid; border-color: #7b43f5 #16181c #16181c #7b43f5;
    }
    body.dark .sq-toggle { background-color: #5ba8f5; }
    .sq-link {
        display: inline-block; margin: 3px 6px 3px 0; padding: 4px 12px; cursor: pointer;
        color: #ffffff; font-weight: bold; font-size: 13px;
        background-color: #7b43f5;
        border: 2px solid; border-color: #7b43f5 #4895ef #4895ef #7b43f5;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF4895EF');
    }
    body.dark .sq-link {
        background-color: #8b5cf6;
        border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    #sqOverlay {
        position: absolute; left: 0; top: 0; z-index: 900; display: none;
        background-color: #000000;
        filter: progid:DXImageTransform.Microsoft.Alpha(opacity=40);
    }
    body.dark #sqOverlay { filter: progid:DXImageTransform.Microsoft.Alpha(opacity=55); }
    #sqDialog {
        position: absolute; z-index: 901; display: none; padding: 10px;
        background-color: #e8eaee;
        border: 2px solid; border-color: #f8fafc #a2a8b2 #a2a8b2 #f8fafc;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#F2FFFFFF', endColorstr='#D8D8DCE4');
    }
    body.dark #sqDialog {
        background-color: #2b2f35;
        border-color: #4a5058 #0e1013 #0e1013 #4a5058;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0, startColorstr='#C8333740', endColorstr='#B0252930');
    }
    .sq-dialog-head { margin-bottom: 8px; cursor: move; }
    #sqDialogTitle { font-weight: bold; font-size: 14px; color: #3d444d; margin-right: 8px; vertical-align: middle; }
    body.dark #sqDialogTitle { color: #aeb4bc; }
    .sq-dialog-btn {
        height: 28px; padding: 0 14px; margin-left: 8px; cursor: pointer; vertical-align: middle;
        font-size: 13px; font-weight: bold; color: #ffffff;
        background-color: #7b43f5;
        border: 2px solid; border-color: #7b43f5 #4895ef #4895ef #7b43f5;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF7B43F5', endColorstr='#FF4895EF');
    }
    body.dark .sq-dialog-btn {
        background-color: #8b5cf6;
        border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6;
        filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5');
    }
    #sqFrame {
        background-color: #ffffff;
        border: 2px solid; border-color: #9aa2ac #ffffff #ffffff #9aa2ac;
    }
    /* 弹窗右下角拖拽手柄：鼠标拖动可自由调整弹窗大小 */
    .sq-resize-handle {
        position: absolute; right: 3px; bottom: 3px; width: 18px; height: 18px;
        cursor: se-resize; z-index: 940; overflow: hidden;
    }
    .sq-resize-handle span {
        position: absolute; right: 0; display: block; height: 3px;
        background-color: #7b43f5;
    }
    .sq-resize-handle .sq-rh-1 { bottom: 0; width: 16px; }
    .sq-resize-handle .sq-rh-2 { bottom: 6px; width: 10px; }
    .sq-resize-handle .sq-rh-3 { bottom: 12px; width: 4px; }
    body.dark .sq-resize-handle span { background-color: #8b5cf6; }
    /* 拖拽调整大小期间的透明遮罩：盖住 iframe，防止其吞掉鼠标移动事件 */
    #sqDragMask {
        position: absolute; left: 0; top: 0; width: 100%; height: 100%;
        z-index: 950; display: none; cursor: se-resize;
        background-color: #ffffff;
        filter: progid:DXImageTransform.Microsoft.Alpha(opacity=1);
    }
</style>
<script language="VBScript">
    ' ===================== 公共数值、单位与结构化数据 =====================
    Const GOLD_UNIT = 1000
    Const COIN_PER_WAN = 10000
    Const PET_CHAR_COUNT = 5
    Const PET_TASK_COUNT = 13
    Const XIU_FRUIT_EXP = 150
    Const XIU_HUNDRED_RING_EXP = 760
    Const XIU_PILL_EXP = 0.5
    Function Pad2(n)
        Pad2 = Right("0" & n, 2)
    End Function
    Function MakeRecord(keys, values)
        Dim record, i
        Set record = CreateObject("Scripting.Dictionary")
        For i = 0 To UBound(keys)
            record.Add keys(i), values(i)
        Next
        Set MakeRecord = record
    End Function
    Function TryNumber(value, ByRef number)
        TryNumber = False
        If IsNull(value) Or IsEmpty(value) Then Exit Function
        If Not IsNumeric(value) Then Exit Function
        On Error Resume Next
        Err.Clear
        number = CDbl(value)
        If Err.Number = 0 Then TryNumber = True
        Err.Clear
        On Error GoTo 0
    End Function
    Function ReadInputNumber(id, defaultValue, rule, maximum, message, ByRef number)
        Dim text, valid
        ReadInputNumber = False
        text = Trim(document.getElementById(id).value)
        If text = "" Then
            If Not IsNull(defaultValue) Then
                number = defaultValue
                ReadInputNumber = True
                Exit Function
            End If
        End If
        valid = TryNumber(text, number)
        If valid Then
            If rule = "positive" Then valid = (number > 0)
            If rule = "nonnegative" Or rule = "integer" Then valid = (number >= 0)
            If rule = "integer" Then valid = valid And (number = Fix(number))
            If maximum >= 0 Then valid = valid And (number <= maximum)
        End If
        If valid Then
            ReadInputNumber = True
        Else
            MsgBox message, vbExclamation, "输入错误"
            document.getElementById(id).focus
        End If
    End Function
    Function CoinToRmb(coin, gold)
        CoinToRmb = coin / GOLD_UNIT * gold
    End Function
    Function RmbToCoin(rmb, gold)
        RmbToCoin = rmb / gold * GOLD_UNIT
    End Function
    Function FmtAmount(value)
        If value = Fix(value) Then FmtAmount = FormatNumber(value, 0) Else FmtAmount = FormatNumber(value, 1)
    End Function
    ' 公共折叠：同步内容显示与提示文字，展开前的数据刷新由业务入口负责。
    Sub SetSectionVisible(sectionId, hintId, visible)
        If visible Then
            document.getElementById(sectionId).style.display = "block"
            document.getElementById(hintId).innerText = "▲ 收起"
        Else
            document.getElementById(sectionId).style.display = "none"
            document.getElementById(hintId).innerText = "▼ 展开"
        End If
    End Sub
    Sub ToggleSection(sectionId, hintId)
        SetSectionVisible sectionId, hintId, document.getElementById(sectionId).style.display = "none"
    End Sub
    ' ===================== 金价比例 =====================
    Sub CheckEnterGold
        If window.event.keyCode = 13 Then CalcGold
    End Sub
    Function GetGoldRatio()
        Dim value
        GetGoldRatio = 0
        If ReadInputNumber("txtGold", Null, "positive", -1, "请先在金价比例中输入大于0的有效数字！", value) Then GetGoldRatio = value
    End Function
    Sub CalcGold
        Dim dblGold, dblCoin, dblRmb
        dblGold = GetGoldRatio()
        If dblGold = 0 Then Exit Sub
        If Not ReadInputNumber("txtCoin", -1, "nonnegative", -1, "梦幻币必须为非负数字（不填默认不换算）！", dblCoin) Then Exit Sub
        If Not ReadInputNumber("txtRmb", -1, "nonnegative", -1, "人民币必须为非负数字（不填默认不换算）！", dblRmb) Then Exit Sub
        RenderGoldResult dblGold, dblCoin, dblRmb
    End Sub
    Sub RenderGoldResult(dblGold, dblCoin, dblRmb)
        Dim dblPerYuan, strHtml, strCls
        ' 换算基准：金价比例 g 元 / 1000万梦幻币（1千万 = 1000万），万↔千万因子为 1000
        dblPerYuan = RmbToCoin(1, dblGold)
        strHtml = "<table class=""xiu-table""><tr><th class=""x1"" width=""30%"">项目</th><th class=""x2"">结果</th></tr>"
        strHtml = strHtml & "<tr><td class=""xiu-item"">金价比例</td><td class=""xiu-val"">" & FormatNumber(dblGold, 2) & " 元 / 1000万梦幻币</td></tr>"
        strHtml = strHtml & "<tr class=""alt""><td class=""xiu-item"">基准换算</td><td class=""xiu-val"">1 元 = " & FormatNumber(dblPerYuan, 2) & " 万梦幻币，1 万梦幻币 = " & FormatNumber(CoinToRmb(1, dblGold), 4) & " 元</td></tr>"
        If dblCoin >= 0 Then
            strHtml = strHtml & "<tr><td class=""xiu-item"">梦幻币 → 人民币</td><td class=""xiu-val"">" & FormatNumber(dblCoin, 2) & " 万梦幻币 ≈ <b>" & FormatNumber(CoinToRmb(dblCoin, dblGold), 2) & "</b> 元</td></tr>"
        End If
        If dblRmb >= 0 Then
            If dblCoin >= 0 Then strCls = " class=""alt""" Else strCls = ""
            strHtml = strHtml & "<tr" & strCls & "><td class=""xiu-item"">人民币 → 梦幻币</td><td class=""xiu-val"">" & FormatNumber(dblRmb, 2) & " 元 ≈ <b>" & FormatNumber(RmbToCoin(dblRmb, dblGold), 2) & "</b> 万梦幻币</td></tr>"
        End If
        strHtml = strHtml & "</table>"
        document.getElementById("goldResult").innerHTML = strHtml
    End Sub
    ' ===================== 宝石成本 =====================
    ' 宝石成本多选合计：gemCosts(i) 为 i 级单个成本；gemPicked 记录选中等级；各等级个数填在 gemQty{等级} 输入框中（空=1个）
    ' gemResultOn：结果区展开状态（默认折叠，生成表格或点击切换时展开）
    Dim gemSelectOn, gemResultOn, gemPicked, gemCosts(15)
    Set gemPicked = CreateObject("Scripting.Dictionary")
    gemSelectOn = False
    gemResultOn = False
    Sub CheckEnter
        If window.event.keyCode = 13 Then Calculate
    End Sub
    Function CalculateGemCost(level, price)
        Dim required, cumulative
        required = 2 ^ (level - 1)
        cumulative = 2 ^ level - 1
        Set CalculateGemCost = MakeRecord(Array("required", "cumulative", "cost", "total"), Array(required, cumulative, required * price, cumulative * price))
    End Function
    Sub Calculate
        Dim dblPrice, level, rows(15)
        If Not ReadInputNumber("txtPrice", Null, "positive", -1, "请输入大于0的有效数字！", dblPrice) Then Exit Sub
        For level = 1 To 15
            Set rows(level) = CalculateGemCost(level, dblPrice)
        Next
        RenderGemCosts rows
    End Sub
    Sub RenderGemCosts(rows)
        Dim i, row, lngNeed, lngCum, dblCost, dblCumCost, strHtml, strCls
        strHtml = "<table><tr><th class=""g1"" width=""10%"">等级</th><th class=""g2"" width=""15%"">需要1级宝石(个)</th><th class=""g3"" width=""15%"">累计1级宝石(个)</th><th class=""g4"" width=""30%"">单个成本(万)</th><th class=""g5"" width=""30%"">累计成本(万)</th></tr>"
        For i = 1 To 15
            Set row = rows(i)
            lngNeed = row("required")
            lngCum = row("cumulative")
            dblCost = row("cost")
            dblCumCost = row("total")
            gemCosts(i) = dblCost
            If i Mod 2 = 0 Then strCls = " class=""alt""" Else strCls = ""
            strHtml = strHtml & "<tr" & strCls & "><td class=""lv"">" & i & "级</td><td class=""num"">" & lngNeed & "</td><td class=""num"">" & lngCum & "</td><td class=""cost"" onclick=""ToggleGemPick " & i & """>" & FormatNumber(dblCost, 2) & "</td><td>" & FormatNumber(dblCumCost, 2) & "</td></tr>"
        Next
        document.getElementById("resultArea").innerHTML = strHtml & "</table>"
        ' 表格重新生成后重置多选与合计结果，并自动展开结果区
        gemPicked.RemoveAll
        document.getElementById("gemSumResult").innerHTML = ""
        SetGemResultVisible True
    End Sub
    ' 设置宝石结果区显示状态（同步切换提示文本与状态变量）
    Sub SetGemResultVisible(bOn)
        gemResultOn = bOn
        SetSectionVisible "resultArea", "gemResultToggleHint", bOn
    End Sub
    ' 结果区默认折叠，点击标题行展开/收起（与神器攻略一致）
    Sub ToggleGemResult
        If Not gemResultOn Then
            If document.getElementById("resultArea").innerHTML = "" Then
                MsgBox "请先输入宝石单价并点击“确认换算”生成表格！", vbExclamation, "提示"
                Exit Sub
            End If
            SetGemResultVisible True
        Else
            SetGemResultVisible False
        End If
    End Sub
    ' 进入/退出宝石成本多选模式
    Sub ToggleGemSelect
        If Not gemSelectOn Then
            If document.getElementById("resultArea").innerHTML = "" Then
                MsgBox "请先输入宝石单价并点击“确认换算”生成表格！", vbExclamation, "提示"
                Exit Sub
            End If
            gemSelectOn = True
            SetGemResultVisible True
            document.getElementById("btnGemSelect").innerText = "退出选择"
            document.getElementById("resultArea").className = "pick"
            document.getElementById("gemSumResult").innerHTML = "选择模式：点击表格中“单个成本(万)”列的金额选中该等级，在出现的输入框中填写宝石个数（不填默认1个），选好后点击“计算”按钮合计。"
        Else
            gemSelectOn = False
            document.getElementById("btnGemSelect").innerText = "选择"
            document.getElementById("resultArea").className = ""
            document.getElementById("gemSumResult").innerHTML = ""
        End If
    End Sub
    ' 点击“单个成本”单元格切换选中状态（仅选择模式下生效）；选中后单元格内出现个数输入框
    Sub ToggleGemPick(idx)
        Dim objSrc, objTd, objInputs
        If Not gemSelectOn Then Exit Sub
        If idx < 1 Or idx > 15 Then Exit Sub
        Set objSrc = window.event.srcElement
        ' 点击个数输入框内部时不改变选中状态
        If UCase(objSrc.tagName) = "INPUT" Then Exit Sub
        Set objTd = objSrc
        If gemPicked.Exists(idx) Then
            gemPicked.Remove idx
            objTd.className = "cost"
            objTd.innerHTML = FormatNumber(gemCosts(idx), 2)
        Else
            gemPicked(idx) = True
            objTd.className = "cost picked"
            objTd.innerHTML = FormatNumber(gemCosts(idx), 2) & " <input type=""text"" class=""gem-qty"" id=""gemQty" & idx & """ value="""" placeholder=""1"" title=""该等级宝石个数，不填默认1个"" />"
            Set objInputs = objTd.getElementsByTagName("INPUT")
            If objInputs.length > 0 Then objInputs(0).focus
        End If
    End Sub
    ' 合计已选成本（个数取自各等级输入框，不填默认1）
    Sub CalcGemSum
        Dim k, dblSum, dblQty, objInp, strVal, strDetail
        If gemPicked.Count = 0 Then
            MsgBox "尚未选择任何宝石成本！请先点击“选择”按钮进入选择模式，再点击表格中的金额多选。", vbExclamation, "提示"
            Exit Sub
        End If
        dblSum = 0
        strDetail = ""
        For Each k In gemPicked.Keys
            Set objInp = document.getElementById("gemQty" & k)
            strVal = ""
            If Not objInp Is Nothing Then strVal = Trim(objInp.value)
            If strVal = "" Then
                dblQty = 1
            Else
                dblQty = 0
                If TryNumber(strVal, dblQty) Then
                    If dblQty < 1 Or dblQty <> Fix(dblQty) Then dblQty = 0
                End If
                If dblQty = 0 Then
                    MsgBox "“" & k & "级”宝石的个数须为大于等于1的整数（不填默认1）！", vbExclamation, "输入错误"
                    If Not objInp Is Nothing Then objInp.focus
                    Exit Sub
                End If
            End If
            dblSum = dblSum + gemCosts(k) * dblQty
            If strDetail <> "" Then strDetail = strDetail & "、"
            strDetail = strDetail & k & "级×" & dblQty
        Next
        document.getElementById("gemSumResult").innerHTML = "已选 <b>" & gemPicked.Count & "</b> 项（" & strDetail & "），合计：<b>" & FormatNumber(dblSum, 2) & "</b> 万梦幻币"
    End Sub
    ' ===================== 定时提醒 =====================
    Dim remindTimerId, remindUiTimerId, remindLastFired, remindHour, remindMinute, remindSecond
    remindTimerId = 0
    remindUiTimerId = 0
    remindHour = -1
    Sub FillRemindMinutes
        FillTimeOptions "selRemindHour", -1, 23
        FillTimeOptions "selRemindMinute", 0, 59
        FillTimeOptions "selRemindSecond", 0, 59
    End Sub
    Sub FillTimeOptions(strId, first, last)
        Dim i, objSel, objOpt
        Set objSel = document.getElementById(strId)
        For i = first To last
            Set objOpt = document.createElement("OPTION")
            objSel.options.Add objOpt
            If i = -1 Then objOpt.text = "不设置" Else objOpt.text = Pad2(i)
            objOpt.value = CStr(i)
        Next
    End Sub
    Sub SetRemindControls(running)
        Dim id
        For Each id In Array("btnRemindStart", "btnRemindTest", "selRemindHour", "selRemindMinute", "selRemindSecond")
            document.getElementById(id).disabled = running
        Next
        document.getElementById("btnRemindStop").disabled = Not running
    End Sub
    Sub StartRemind
        remindHour = CInt(document.getElementById("selRemindHour").value)
        remindMinute = CInt(document.getElementById("selRemindMinute").value)
        remindSecond = CInt(document.getElementById("selRemindSecond").value)
        remindLastFired = ""
        SetRemindControls True
        StopRemindTimers
        remindTimerId = window.setInterval("CheckRemindTime", 1000, "VBScript")
        remindUiTimerId = window.setInterval("RefreshRemindStatus", 1000, "VBScript")
        CheckRemindTime
        RefreshRemindStatus
    End Sub
    Sub StopRemind
        StopRemindTimers
        SetRemindControls False
        document.getElementById("remindStatus").innerHTML = "已停止"
    End Sub
    Sub StopRemindTimers
        If remindTimerId <> 0 Then
            window.clearInterval remindTimerId
            remindTimerId = 0
        End If
        If remindUiTimerId <> 0 Then
            window.clearInterval remindUiTimerId
            remindUiTimerId = 0
        End If
    End Sub
    Function RemindTarget(dtNow, targetHour, targetMinute, targetSecond)
        Dim hourValue
        hourValue = targetHour
        If hourValue < 0 Then hourValue = Hour(dtNow)
        RemindTarget = DateSerial(Year(dtNow), Month(dtNow), Day(dtNow)) + TimeSerial(hourValue, targetMinute, targetSecond)
    End Function
    Function RemindFireKey(dtNow, targetHour, targetMinute, targetSecond, lastFired)
        Dim delta, key
        RemindFireKey = ""
        delta = DateDiff("s", RemindTarget(dtNow, targetHour, targetMinute, targetSecond), dtNow)
        If delta < 0 Or delta > 10 Then Exit Function
        key = CStr(Day(dtNow))
        If targetHour < 0 Then key = key & "-" & Hour(dtNow)
        If key <> lastFired Then RemindFireKey = key
    End Function
    Sub CheckRemindTime
        Dim key
        key = RemindFireKey(Now, remindHour, remindMinute, remindSecond, remindLastFired)
        If key <> "" Then
            remindLastFired = key
            ShowRemindNotify
        End If
    End Sub
    Sub RefreshRemindStatus
        Dim dtNow, dtNext, lngDiff, strMode
        dtNow = Now
        dtNext = RemindTarget(dtNow, remindHour, remindMinute, remindSecond)
        If remindHour >= 0 Then
            If dtNext <= dtNow Then dtNext = DateAdd("d", 1, dtNext)
            strMode = "每天 " & Pad2(remindHour) & ":" & Pad2(remindMinute) & ":" & Pad2(remindSecond)
        Else
            If dtNext <= dtNow Then dtNext = DateAdd("h", 1, dtNext)
            strMode = "每小时第 " & Pad2(remindMinute) & " 分 " & Pad2(remindSecond) & " 秒"
        End If
        lngDiff = DateDiff("s", dtNow, dtNext)
        document.getElementById("remindStatus").innerHTML = "<b>运行中</b>（" & strMode & "） 下次提醒 " & Pad2(Hour(dtNext)) & ":" & Pad2(Minute(dtNext)) & ":" & Pad2(Second(dtNext)) & "（还剩 " & (lngDiff \ 3600) & " 时 " & ((lngDiff Mod 3600) \ 60) & " 分 " & (lngDiff Mod 60) & " 秒）"
    End Sub
    Sub ShowRemindNotify
        Dim strMsg, strTitle, strPs, strCmd
        strMsg = document.getElementById("txtRemindMsg").value
        If strMsg = "" Then strMsg = "时间到啦！"
        strMsg = Replace(strMsg, """", "")
        strMsg = Replace(strMsg, "'", "''")
        strTitle = "定时提醒 " & Pad2(Hour(Now)) & ":" & Pad2(Minute(Now)) & ":" & Pad2(Second(Now))
        strPs = "Add-Type -AssemblyName System.Windows.Forms;Add-Type -AssemblyName System.Drawing;$n=New-Object System.Windows.Forms.NotifyIcon;$n.Icon=[System.Drawing.SystemIcons]::Information;$n.Visible=$true;$n.ShowBalloonTip(10000,'" & strTitle & "','" & strMsg & "',[System.Windows.Forms.ToolTipIcon]::Info);[System.Media.SystemSounds]::Exclamation.Play();Start-Sleep -Seconds 12;$n.Dispose()"
        strCmd = "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command """ & strPs & """"
        CreateObject("WScript.Shell").Run strCmd, 0, False
    End Sub
    ' ===================== 修炼消耗 =====================
    Dim xiuTypes
    Set xiuTypes = MakeRecord(Array("attack", "magic", "hunt", "defend", "resist", "pet"), Array(Array("攻击修炼", 3, 4.5), Array("法术修炼", 3, 4.5), Array("猎术修炼", 3, 4.5), Array("防御修炼", 2, 3.5), Array("抗法修炼", 2, 3.5), Array("召唤兽修炼", 0, 0)))
    Sub CheckEnterXiu
        If window.event.keyCode = 13 Then CalcXiulian
    End Sub
    Function XiuExpForLv(lv)
        XiuExpForLv = (lv * lv + lv * 3 + 11) * 10
    End Function
    Sub CalcXiulian
        Dim strType, curLv, tgtLv, curExp, tgtExp, jiuPrice, jiuQuality, guoPrice, plan
        strType = document.getElementById("selXiuType").value
        If Not ReadInputNumber("txtXiuCurLv", Null, "integer", 25, "请输入当前修炼等级（0-25的整数）！", curLv) Then Exit Sub
        If Not ReadInputNumber("txtXiuCurExp", 0, "integer", 2147483647, "当前经验必须为非负整数（不填默认按0计算）！", curExp) Then Exit Sub
        If Not ReadInputNumber("txtXiuTgtLv", Null, "integer", 25, "请输入目标修炼等级（0-25的整数）！", tgtLv) Then Exit Sub
        If tgtLv < curLv Then
            MsgBox "目标修炼等级不能低于当前修炼等级！", vbExclamation, "输入错误"
            document.getElementById("txtXiuTgtLv").focus
            Exit Sub
        End If
        If Not ReadInputNumber("txtXiuTgtExp", 0, "integer", 2147483647, "目标经验必须为非负整数（不填默认按0计算）！", tgtExp) Then Exit Sub

        ' 九转金丹选填项（仅人物修炼）：每颗经验 = 品质×0.5，总品质 = 还需经验×2；填了品质时按颗数向上取整
        jiuPrice = 0
        jiuQuality = 0
        guoPrice = 0
        If strType = "pet" Then
            ' 召唤兽修炼：修炼果价格（万/颗，选填），每颗固定 150 点经验
            If Not ReadInputNumber("txtGuoPrice", 0, "positive", -1, "修炼果价格必须为大于0的数字（不填则不计算总成本）！", guoPrice) Then Exit Sub
        Else
            If Not ReadInputNumber("txtJiuPrice", 0, "positive", -1, "九转金丹每品质价格必须为大于0的数字（不填则不计算金丹）！", jiuPrice) Then Exit Sub
            If Not ReadInputNumber("txtJiuQuality", 0, "positive", -1, "九转金丹品质必须为大于0的数字（不填则不计算金丹）！", jiuQuality) Then Exit Sub
        End If

        If curLv < 25 And curExp >= XiuExpForLv(curLv + 1) Then
            MsgBox "当前经验已达到升" & (curLv + 1) & "级所需（" & XiuExpForLv(curLv + 1) & "点），请先调整当前等级！", vbExclamation, "输入错误"
            Exit Sub
        End If
        If tgtLv < 25 And tgtExp >= XiuExpForLv(tgtLv + 1) Then
            MsgBox "目标经验已达到升" & (tgtLv + 1) & "级所需（" & XiuExpForLv(tgtLv + 1) & "点），请调整目标等级！", vbExclamation, "输入错误"
            Exit Sub
        End If

        Set plan = CalculateXiuPlan(strType, curLv, tgtLv, curExp, tgtExp, jiuPrice, jiuQuality, guoPrice)
        If plan("needExp") < 0 Then
            MsgBox "当前修炼进度已达到目标！", vbInformation, "提示"
            Exit Sub
        End If
        RenderXiuResult strType, curLv, tgtLv, curExp, tgtExp, jiuPrice, jiuQuality, guoPrice, plan
    End Sub
    Function CalculateXiuPlan(kind, curLv, tgtLv, curExp, tgtExp, jiuPrice, jiuQuality, guoPrice)
        Dim needExp, level, times, info, jiuCount, jiuTotal, guoCount
        needExp = tgtExp - curExp
        For level = curLv + 1 To tgtLv
            needExp = needExp + XiuExpForLv(level)
        Next
        times = -Int(-needExp / 10)
        info = xiuTypes(kind)
        jiuCount = 0
        jiuTotal = needExp / XIU_PILL_EXP
        If jiuQuality > 0 Then
            jiuCount = -Int(-needExp / (jiuQuality * XIU_PILL_EXP))
            jiuTotal = jiuCount * jiuQuality
        End If
        guoCount = -Int(-needExp / XIU_FRUIT_EXP)
        Set CalculateXiuPlan = MakeRecord(Array("needExp", "times", "baiHuan", "guoCount", "guoCoin", "coinN", "coinF", "jiuCount", "jiuTotal", "jiuCoin"), Array(needExp, times, -Int(-needExp / XIU_HUNDRED_RING_EXP), guoCount, guoCount * guoPrice, times * info(1), times * info(2), jiuCount, jiuTotal, jiuTotal * jiuPrice / COIN_PER_WAN))
    End Function
    Sub RenderXiuResult(strType, curLv, tgtLv, curExp, tgtExp, jiuPrice, jiuQuality, guoPrice, plan)
        Dim info, strName, needExp, times, needContrib, contribHtml, xiuHtml
        Dim baiHuan, guoCount, guoCoin, guoStr, coinN, coinF, jiuTotalQ, jiuCount, jiuCoin, jiuHtml
        info = xiuTypes(strType)
        strName = info(0)
        needExp = plan("needExp")
        times = plan("times")

        needContrib = tgtLv * 150
        contribHtml = "≥ <b>" & needContrib & "</b> 点"
        xiuHtml = "<table class=""xiu-table""><tr><th class=""x1"" width=""30%"">项目</th><th class=""x2"">结果</th></tr>"
        xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">修炼类型</td><td class=""xiu-val"">" & strName & "</td></tr>"
        xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">修炼进度</td><td class=""xiu-val"">" & curLv & "级（" & curExp & "经验） → " & tgtLv & "级（" & tgtExp & "经验）</td></tr>"
        If times = 0 Then
            xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">还需修炼经验</td><td class=""xiu-val""><b>0</b> 点（已达到目标进度，无需修炼）</td></tr>"
            If strType <> "pet" Then
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">要求帮派总贡献</td><td class=""xiu-val"">" & contribHtml & "（目标等级 " & tgtLv & " × 150）</td></tr>"
            End If
        Else
            xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">还需修炼经验</td><td class=""xiu-val""><b>" & needExp & "</b> 点</td></tr>"
            If strType = "pet" Then
                ' 召唤兽修炼：每百环约 760 点经验、每颗修炼果固定 150 点经验，次数与个数均向上取整
                baiHuan = plan("baiHuan")
                guoCount = plan("guoCount")
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">召唤兽修炼百环</td><td class=""xiu-val""><b>" & baiHuan & "</b> 次（每百环约 760 点经验）</td></tr>"
                guoStr = "<b>" & guoCount & "</b> 个（每颗 150 点经验）"
                If guoPrice > 0 Then
                    guoCoin = plan("guoCoin")
                    guoStr = guoStr & "，<b>" & FmtAmount(guoCoin) & "</b> 万梦幻币"
                End If
                xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">修炼果</td><td class=""xiu-val"">" & guoStr & "</td></tr>"
            Else
                coinN = plan("coinN")
                coinF = plan("coinF")
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">修炼次数</td><td class=""xiu-val""><b>" & times & "</b> 次（每次提升 10 点经验）</td></tr>"
                xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">正常模式消耗</td><td class=""xiu-val""><b>" & FmtAmount(coinN) & "</b> 万梦幻币 + <b>" & times * 5 & "</b> 点资材</td></tr>"
                xiuHtml = xiuHtml & "<tr class=""alt""><td class=""xiu-item"">免资材模式消耗</td><td class=""xiu-val""><b>" & FmtAmount(coinF) & "</b> 万梦幻币（不消耗资材）</td></tr>"
                ' 九转金丹方案（填了价格或品质时显示；经验 = 品质×0.5，总品质 = 还需经验×2）
                If jiuPrice > 0 Or jiuQuality > 0 Then
                    jiuTotalQ = plan("jiuTotal")
                    jiuCount = plan("jiuCount")
                    jiuCoin = plan("jiuCoin")
                    jiuHtml = "<tr><td class=""xiu-item"">九转金丹</td><td class=""xiu-val""><b>" & jiuTotalQ & "</b> 品质"
                    If jiuQuality > 0 Then jiuHtml = jiuHtml & "（<b>" & jiuCount & "</b> 颗 × " & jiuQuality & " 品）"
                    If jiuPrice > 0 Then jiuHtml = jiuHtml & "，<b>" & FmtAmount(jiuCoin) & "</b> 万梦幻币"
                    xiuHtml = xiuHtml & jiuHtml & "</td></tr>"
                End If
                xiuHtml = xiuHtml & "<tr><td class=""xiu-item"">要求帮派总贡献</td><td class=""xiu-val"">" & contribHtml & "（目标等级 " & tgtLv & " × 150）</td></tr>"
            End If
        End If
        xiuHtml = xiuHtml & "</table>"
        document.getElementById("xiuResult").innerHTML = xiuHtml
    End Sub
    Sub OnXiuTypeChange
        Dim isPet
        isPet = (document.getElementById("selXiuType").value = "pet")
        If isPet Then
            document.getElementById("divXiuJiu").style.display = "none"
            document.getElementById("divXiuGuo").style.display = ""
        Else
            document.getElementById("divXiuJiu").style.display = ""
            document.getElementById("divXiuGuo").style.display = "none"
        End If
    End Sub
    ' ===================== 属性换算：输入、纯计算与展示 =====================
    Dim arrHistory, historyCount, lastDesc, lastResult
    ReDim arrHistory(0)
    historyCount = 0
    lastDesc = ""
    Set lastResult = Nothing
    Dim attrInputs, attrResults, raceCoeffs
    attrInputs = Array(Array("strength", "txtStr", "力"), Array("magic", "txtMag", "魔"), Array("constitution", "txtCon", "体"), Array("endurance", "txtEnd", "耐"), Array("agility", "txtAgi", "敏"))
    attrResults = Array(Array("damage", "tdADmg"), Array("magic", "tdAMag"), Array("defense", "tdADef"), Array("hp", "tdAHp"), Array("speed", "tdASpd"))
    Set raceCoeffs = MakeRecord(Array("human", "immortal", "demon"), Array(Array("人族", 0.67, 1.5, 5), Array("仙族", 0.57, 1.6, 4.5), Array("魔族", 0.77, 1.4, 6)))
    Sub CheckEnterAttr
        If window.event.keyCode = 13 Then CalcAttr
    End Sub
    Sub CalcAttr
        If document.getElementById("selCalcType").value = "weapon" Then
            CalcWeapon
        Else
            CalcEquip
        End If
    End Sub
    Sub SwitchCalcType
        If document.getElementById("selCalcType").value = "weapon" Then
            document.getElementById("rowWeaponRequired").style.display = ""
            document.getElementById("rowEquipRequired").style.display = "none"
            document.getElementById("btnCalcAttr").innerText = "计算武器属性"
        Else
            document.getElementById("rowWeaponRequired").style.display = "none"
            document.getElementById("rowEquipRequired").style.display = ""
            document.getElementById("btnCalcAttr").innerText = "计算装备属性"
        End If
        document.getElementById("divAttrTable").style.display = "none"
    End Sub
    Function ReadAttributes
        Dim attributes, field, value
        Set attributes = CreateObject("Scripting.Dictionary")
        For Each field In attrInputs
            value = 0
            If Not TryNumber(document.getElementById(field(1)).value, value) Then value = 0
            attributes.Add field(0), value
        Next
        Set ReadAttributes = attributes
    End Function
    Function CalculateAttributes(kind, race, attributes, base, hit)
        Dim coeffs, strength, magic, constitution, endurance, agility, damage, defense, spirit
        coeffs = raceCoeffs(race)
        strength = attributes("strength")
        magic = attributes("magic")
        constitution = attributes("constitution")
        endurance = attributes("endurance")
        agility = attributes("agility")
        damage = strength * coeffs(1)
        defense = endurance * coeffs(2)
        spirit = strength * 0.4 + magic * 0.7 + endurance * 0.2 + constitution * 0.3
        If kind = "weapon" Then
            damage = hit / 3 + (base + strength * coeffs(1))
            spirit = base / 4 + spirit
        Else
            defense = base + defense
        End If
        Set CalculateAttributes = MakeRecord(Array("damage", "magic", "defense", "hp", "speed"), Array(damage, spirit, defense, constitution * coeffs(3), constitution * 0.1 + endurance * 0.1 + strength * 0.1 + agility * 0.7))
    End Function
    Sub CalcWeapon
        CalculateAttrInput "weapon"
    End Sub
    Sub CalcEquip
        CalculateAttrInput "equip"
    End Sub
    Sub CalculateAttrInput(kind)
        Dim base, hit, race, attributes, result, field, coeffs, description
        hit = 0
        If kind = "weapon" Then
            If Not ReadInputNumber("txtWeaponDmg", Null, "number", -1, "请输入武器伤害！", base) Then Exit Sub
            If Not ReadInputNumber("txtWeaponHit", Null, "number", -1, "请输入武器命中！", hit) Then Exit Sub
        Else
            If Not ReadInputNumber("txtEquipDef", Null, "number", -1, "请输入装备防御！", base) Then Exit Sub
        End If
        race = document.getElementById("selRace").value
        coeffs = raceCoeffs(race)
        Set attributes = ReadAttributes
        Set result = CalculateAttributes(kind, race, attributes, base, hit)
        If kind = "weapon" Then
            description = "武器 " & coeffs(0) & " 伤害:" & base & " 命中:" & hit
        Else
            description = "装备 " & coeffs(0) & " 防御:" & base
        End If
        For Each field In attrInputs
            If attributes(field(0)) <> 0 Then description = description & " " & field(2) & ":" & attributes(field(0))
        Next
        SaveToHistory
        lastDesc = description
        Set lastResult = result
        document.getElementById("divAttrTable").style.display = ""
        For Each field In attrResults
            document.getElementById(field(1)).innerText = FormatNumber(result(field(0)), 2)
        Next
        RenderHistory
    End Sub
    Function AttrResultCells(result)
        Dim field, html
        html = ""
        For Each field In attrResults
            html = html & "<td class=""num"">" & FormatNumber(result(field(0)), 2) & "</td>"
        Next
        AttrResultCells = html
    End Function
    Sub SaveToHistory
        Dim idx
        If lastDesc = "" Then Exit Sub
        idx = historyCount
        historyCount = historyCount + 1
        ReDim Preserve arrHistory(historyCount - 1)
        arrHistory(idx) = Array(Pad2(Hour(Now)) & ":" & Pad2(Minute(Now)) & ":" & Pad2(Second(Now)), lastDesc, lastResult)
        lastDesc = ""
        Set lastResult = Nothing
        TrimHistory
    End Sub
    Sub TrimHistory
        Dim maxH, removeCount, i
        maxH = CInt(document.getElementById("selHistoryMax").value)
        If historyCount <= maxH Then Exit Sub
        removeCount = historyCount - maxH
        For i = 0 To historyCount - removeCount - 1
            arrHistory(i) = arrHistory(i + removeCount)
        Next
        historyCount = maxH
        ReDim Preserve arrHistory(historyCount - 1)
    End Sub
    Sub OnChangeHistoryLimit
        TrimHistory
        If lastDesc <> "" Or historyCount > 0 Then RenderHistory
    End Sub
    Sub RenderHistory
        Dim html, i, e
        html = "<table class=""history-table""><tr><th class=""h1"" width=""8%""></th><th class=""h2"" width=""9%"">时间</th><th class=""h3"" width=""28%"">输入参数</th><th class=""h4"">伤害</th><th class=""h5"">法伤</th><th class=""h6"">防御</th><th class=""h7"">气血</th><th class=""h8"">速度</th><th class=""h9"" width=""6%""></th></tr>"
        If lastDesc <> "" Then
            html = html & "<tr class=""row-current""><td class=""current-tag"">当前</td><td class=""hist-time"">" & Pad2(Hour(Now)) & ":" & Pad2(Minute(Now)) & ":" & Pad2(Second(Now)) & "</td><td class=""hist-info"">" & lastDesc & "</td>"
            html = html & AttrResultCells(lastResult)
            html = html & "<td></td></tr>"
        End If
        For i = historyCount - 1 To 0 Step -1
            e = arrHistory(i)
            html = html & "<tr><td class=""hist-tag"">历史</td><td class=""hist-time"">" & e(0) & "</td><td class=""hist-info"">" & e(1) & "</td>"
            html = html & AttrResultCells(e(2))
            html = html & "<td class=""hist-del""><button class=""hist-del-btn"" onclick=""DeleteHistory " & i & """>删</button></td></tr>"
        Next
        html = html & "</table>"
        document.getElementById("divHistoryTable").innerHTML = html
        document.getElementById("divHistory").style.display = ""
    End Sub
    Sub DeleteHistory(idx)
        Dim i
        If idx < 0 Or idx >= historyCount Then Exit Sub
        For i = idx To historyCount - 2
            arrHistory(i) = arrHistory(i + 1)
        Next
        historyCount = historyCount - 1
        If historyCount = 0 Then ReDim arrHistory(0) Else ReDim Preserve arrHistory(historyCount - 1)
        RenderHistory
    End Sub
    Sub ClearHistory
        ReDim arrHistory(0)
        historyCount = 0
        document.getElementById("divHistory").style.display = "none"
        document.getElementById("divHistoryTable").innerHTML = ""
    End Sub
    ' ===================== 宠环会话与明细 =====================
    ' 宠环任务区默认折叠，点击标题行展开/收起（规则同神器攻略）
    Sub TogglePetSection
        ToggleSection "petSection", "petToggleHint"
    End Sub
    ' 宠环跑环计数：+ 时弹录入框登记本次成本（万梦幻币，非必填按 0），- 撤销该任务最近一次记录（次数-1 并同步扣回其成本）
    ' “是否计算成本”选“否”时 + 不弹框，直接按 0 成本记账（仅计次数）；- 仍按撤销逻辑（无成本记录时仅减次数）
    ' 多号统计（1~5 号）：数据全部按号存两维——petCostHist(号,任务) 成本栈、petCounts(号,任务) 次数、petCostTotal(号) 累计成本、
    ' petDetailList(号) 录入顺序明细（格式 "任务序号:成本" 逗号分隔）；petCurChar 为当前号（0-4），DOM 只展示当前号视图，切号整体换装
    ' “是否计算成本”全局共享不分号；清零只清当前号；全部号合计为跨号只读汇总
    Dim petCostHist(4, 12), petCounts(4, 12), petCostTotal(4), petDetailList(4)
    Dim petCostIdx, petCostSavedScrollTop, petCurChar
    Dim pcI, petTaskNames
    petTaskNames = Array("找人", "乐器", "60级装备", "花", "1级家具", "80级装备", "三级药", "2级家具", "烹饪", "非指定变异召唤兽", "70级装备", "指定变异召唤兽", "上交非变异召唤兽")
    petCostIdx = -1
    petCurChar = 0
    ' 历史记录：petDirty 当天有未保存变更（清零/退出时提醒）；petExiting 退出按钮流程中（兜底提醒跳过，避免重复弹窗）；
    ' petHistData 文件加载的 日期→记录对象数组；petHistDateList 日期索引（日历点击传参用）；petHistYear/Month 当前显示月（-1 未初始化，展开时设为当月）；petIoSavedScrollTop 导入/导出弹窗打开前的滚动位置
    Dim petDirty, petExiting, petHistYear, petHistMonth, petHistSavedScrollTop, petIoSavedScrollTop
    Dim petHistDateList(), petHistData
    Dim petHistSelectedDate
    petHistSelectedDate = ""
    Set petHistData = CreateObject("Scripting.Dictionary")
    petDirty = False
    petExiting = False
    petHistYear = -1
    petHistMonth = -1
    ReDim petHistDateList(-1)
    For pcI = 0 To PET_CHAR_COUNT - 1
        PetResetChar pcI
    Next
    Sub PetResetChar(character)
        Dim task
        petCostTotal(character) = 0
        petDetailList(character) = ""
        For task = 0 To PET_TASK_COUNT - 1
            petCostHist(character, task) = ""
            petCounts(character, task) = 0
        Next
    End Sub
    Sub RefreshPetSession
        Dim task, count
        For task = 0 To PET_TASK_COUNT - 1
            Set count = document.getElementById("petCnt" & task)
            If Not count Is Nothing Then count.innerText = CStr(petCounts(petCurChar, task))
        Next
        RefreshPetCostTotal
        RefreshPetDetail
    End Sub
    Sub PetAdd(idx)
        Dim objSel, lngIdx
        Set objSel = document.getElementById("selPetCostMode")
        If Not (objSel Is Nothing) Then
            If objSel.value = "0" Then
                lngIdx = CLng(idx)
                PetRecordCost lngIdx, 0
                Exit Sub
            End If
        End If
        OpenPetCostDlg idx
    End Sub
    Sub PetSub(idx)
        PetUndoOne idx
    End Sub
    ' 号名（1~5 号）
    Function PetCharName(c)
        PetCharName = (CLng(c) + 1) & "号"
    End Function
    ' 只修改当前号次数；登记或撤销完成全部状态更新后统一刷新视图。
    Sub PetChange(idx, delta)
        Dim lngN
        lngN = petCounts(petCurChar, idx) + CLng(delta)
        If lngN < 0 Then lngN = 0
        petCounts(petCurChar, idx) = lngN
    End Sub
    ' 切换当前号：页签高亮、次数换装、累计成本与明细重绘（成本弹窗开着时有遮罩挡住页签，无需防护）
    Sub PetSwitchChar(c)
        Dim i, objBtn
        c = CLng(c)
        If c < 0 Or c >= PET_CHAR_COUNT Then Exit Sub
        If c = petCurChar Then Exit Sub
        petCurChar = c
        For i = 0 To PET_CHAR_COUNT - 1
            Set objBtn = document.getElementById("petCharBtn" & i)
            If Not objBtn Is Nothing Then
                If i = c Then
                    objBtn.className = "pet-char-btn-on"
                Else
                    objBtn.className = "pet-char-btn"
                End If
            End If
        Next
        RefreshPetSession
    End Sub
    ' 撤销最近一次记录（当前号）：次数-1；该任务有成本记录时同步扣回（成本>0 先弹确认框告知金额）
    Sub PetUndoOne(idx)
        Dim lngN, dblCost
        idx = CLng(idx)
        lngN = petCounts(petCurChar, idx)
        If lngN <= 0 Then Exit Sub
        If petCostHist(petCurChar, idx) <> "" Then
            dblCost = PetCostPeek(idx)
            If dblCost > 0 Then
                If MsgBox("将撤销「" & PetCharName(petCurChar) & " · " & PetTaskName(idx) & "」最近一次记录：次数 -1，并从累计成本中扣回 " & PetFmtCost(dblCost) & " 万梦幻币。是否继续？", vbYesNo + vbQuestion, "撤销确认") <> vbYes Then Exit Sub
            End If
            petCostTotal(petCurChar) = petCostTotal(petCurChar) - PetCostPop(idx)
            If petCostTotal(petCurChar) < 0 Then petCostTotal(petCurChar) = 0
            PetDetailRemoveLast idx
        End If
        PetChange idx, -1
        petDirty = True
        RefreshPetSession
    End Sub
    ' 读取当前号该任务最近一次录入的成本（不出栈）
    Function PetCostPeek(idx)
        Dim strS, lngP
        PetCostPeek = 0
        strS = petCostHist(petCurChar, idx)
        If strS = "" Then Exit Function
        lngP = InStrRev(strS, ",")
        If lngP = 0 Then
            PetCostPeek = CDbl(strS)
        Else
            PetCostPeek = CDbl(Mid(strS, lngP + 1))
        End If
    End Function
    ' 弹出并返回当前号该任务最近一次录入的成本（从历史中移除）
    Function PetCostPop(idx)
        Dim strS, lngP
        PetCostPop = PetCostPeek(idx)
        strS = petCostHist(petCurChar, idx)
        If strS = "" Then Exit Function
        lngP = InStrRev(strS, ",")
        If lngP = 0 Then
            petCostHist(petCurChar, idx) = ""
        Else
            petCostHist(petCurChar, idx) = Left(strS, lngP - 1)
        End If
    End Function
    ' 成本格式化：最多保留2位小数，去掉末尾无意义的 0 与小数点
    Function PetFmtCost(v)
        PetFmtCost = TrimNumberZeros(FormatNumber(v, 2))
    End Function
    ' 成本格式化（无千分位版，专用于历史文件与跨端交换文本）：最多保留2位小数，去掉末尾无意义的 0 与小数点；
    ' PetFmtCost（FormatNumber 默认带千分位）仅供界面显示，写文件/交换用本函数免得移动版 parseFloat 在逗号截断
    Function PetFmtCostPlain(v)
        PetFmtCostPlain = TrimNumberZeros(FormatNumber(v, 2, -1, 0, 0))
    End Function
    Function TrimNumberZeros(ByVal strS)
        If InStr(strS, ".") > 0 Then
            Do While Right(strS, 1) = "0"
                strS = Left(strS, Len(strS) - 1)
            Loop
            If Right(strS, 1) = "." Then strS = Left(strS, Len(strS) - 1)
        End If
        TrimNumberZeros = strS
    End Function
    ' 任务名称统一从配置读取，未知任务回退为序号。
    Function PetTaskName(idx)
        PetTaskName = "第" & (idx + 1) & "项"
        If idx >= 0 And idx < PET_TASK_COUNT Then PetTaskName = petTaskNames(idx)
    End Function
    ' 三类宠环弹窗共用遮罩、视口定位及滚动恢复；内容和焦点由各入口处理。
    Sub OpenPetDialog(prefix, ByRef savedScrollTop, alignTall)
        Dim dialog, overlay, viewHeight
        savedScrollTop = document.body.scrollTop
        document.body.style.overflow = "hidden"
        document.body.scrollTop = savedScrollTop
        Set dialog = document.getElementById(prefix & "Dialog")
        Set overlay = document.getElementById(prefix & "Overlay")
        dialog.style.display = "block"
        overlay.style.display = "block"
        overlay.style.pixelWidth = document.body.scrollWidth
        overlay.style.pixelHeight = document.body.scrollHeight
        viewHeight = document.body.clientHeight
        dialog.style.pixelLeft = Int((document.body.clientWidth - dialog.offsetWidth) / 2) + document.body.scrollLeft
        If alignTall And dialog.offsetHeight > viewHeight Then
            dialog.style.pixelTop = 8 + document.body.scrollTop
        Else
            dialog.style.pixelTop = Int((viewHeight - dialog.offsetHeight) / 2) + document.body.scrollTop
        End If
    End Sub
    Sub ClosePetDialog(prefix, savedScrollTop)
        document.getElementById(prefix & "Dialog").style.display = "none"
        document.getElementById(prefix & "Overlay").style.display = "none"
        document.body.style.overflow = ""
        document.body.scrollTop = savedScrollTop
    End Sub
    Sub OpenPetCostDlg(idx)
        Dim objInp
        petCostIdx = CLng(idx)
        document.getElementById("petCostTitle").innerText = "录入「" & PetCharName(petCurChar) & " · " & PetTaskName(petCostIdx) & "」本次成本"
        Set objInp = document.getElementById("petCostInput")
        objInp.value = ""
        OpenPetDialog "petCost", petCostSavedScrollTop, False
        objInp.focus
    End Sub
    Sub PetCostKeyDown
        If window.event.keyCode = 13 Then PetCostOk
    End Sub
    ' 确定：留空按 0 计入；非法输入保持弹窗待修正；成功则次数+1 并累计成本
    Sub PetCostOk
        Dim strVal, dblCost, message
        If petCostIdx < 0 Then Exit Sub
        strVal = Trim(document.getElementById("petCostInput").value)
        dblCost = 0
        If strVal <> "" Then
            If Not TryNumber(strVal, dblCost) Then
                MsgBox "成本必须为数字（单位：万梦幻币），不填按 0 计入！", vbExclamation, "输入错误"
                document.getElementById("petCostInput").focus
                Exit Sub
            End If
            If dblCost < 0 Then
                MsgBox "成本不能为负数（单位：万梦幻币），不填按 0 计入！", vbExclamation, "输入错误"
                document.getElementById("petCostInput").focus
                Exit Sub
            End If
            On Error Resume Next
            Err.Clear
            dblCost = Int(dblCost * 100 + 0.5) / 100
            message = Err.Description
            Err.Clear
            On Error GoTo 0
            If message <> "" Then
                MsgBox "成本超出可保存范围，请减小金额！", vbExclamation, "输入错误"
                Exit Sub
            End If
        End If
        PetRecordCost petCostIdx, dblCost
        ClosePetCostDlg
    End Sub
    ' 登记一笔成本（可为 0）并计数 +1（当前号）：成本入栈、明细追加、累计与表格同步刷新
    Sub PetRecordCost(ByVal idx, ByVal dblCost)
        idx = CLng(idx)
        dblCost = CDbl(dblCost)
        If petCostHist(petCurChar, idx) = "" Then
            petCostHist(petCurChar, idx) = CStr(dblCost)
        Else
            petCostHist(petCurChar, idx) = petCostHist(petCurChar, idx) & "," & CStr(dblCost)
        End If
        If petDetailList(petCurChar) = "" Then
            petDetailList(petCurChar) = idx & ":" & CStr(dblCost)
        Else
            petDetailList(petCurChar) = petDetailList(petCurChar) & "," & idx & ":" & CStr(dblCost)
        End If
        petCostTotal(petCurChar) = petCostTotal(petCurChar) + dblCost
        PetChange idx, 1
        petDirty = True
        RefreshPetSession
    End Sub
    Sub PetCostCancel
        ClosePetCostDlg
    End Sub
    Sub ClosePetCostDlg
        ClosePetDialog "petCost", petCostSavedScrollTop
        petCostIdx = -1
    End Sub
    ' 刷新累计成本：当前号 + 全部号合计两个数字
    Sub RefreshPetCostTotal
        Dim n, dblAll
        dblAll = 0
        For n = 0 To PET_CHAR_COUNT - 1
            dblAll = dblAll + petCostTotal(n)
        Next
        document.getElementById("petTotalCost").innerText = PetFmtCost(petCostTotal(petCurChar))
        document.getElementById("petAllCost").innerText = PetFmtCost(dblAll)
    End Sub
    ' 展示/收起累计成本明细（展开时先刷新内容）
    Sub TogglePetDetail
        If document.getElementById("petDetailSection").style.display = "none" Then RefreshPetDetail
        ToggleSection "petDetailSection", "petDetailToggleHint"
    End Sub
    ' 积分奖励矩阵表与最终得分表默认折叠，点击标题行展开/收起（纯静态表，无内容刷新）
    Sub TogglePetReward
        ToggleSection "petRewardSection", "petRewardToggleHint"
    End Sub
    Sub TogglePetScore
        ToggleSection "petScoreSection", "petScoreToggleHint"
    End Sub
    ' 构建只读展示数据，供会话与历史共用汇总和逐笔明细表。
    Function PetViewRecord(record)
        Dim sums, item, details
        Set sums = CreateObject("Scripting.Dictionary")
        details = record("details")
        For Each item In details
            If Not sums.Exists(item(0)) Then sums.Add item(0), 0
            sums(item(0)) = sums(item(0)) + item(1)
        Next
        Set PetViewRecord = MakeRecord(Array("c", "counts", "details", "sums"), Array(record("c"), record("counts"), details, sums))
    End Function
    Function PetSessionViews
        Dim records, counts, character, task, record
        records = Array()
        For character = 0 To PET_CHAR_COUNT - 1
            ReDim counts(12)
            For task = 0 To PET_TASK_COUNT - 1
                counts(task) = petCounts(character, task)
            Next
            Set record = MakeRecord(Array("c", "counts", "details"), Array(character, counts, PetParseDetails(petDetailList(character))))
            AppendValue records, PetViewRecord(record)
        Next
        PetSessionViews = records
    End Function
    ' 从当前号全局明细中移除指定任务最近一笔（与该号成本栈弹出保持同步）
    Sub PetDetailRemoveLast(idx)
        Dim arrAll, arrItem, n, lngFound, strOut
        If petDetailList(petCurChar) = "" Then Exit Sub
        arrAll = Split(petDetailList(petCurChar), ",")
        lngFound = -1
        For n = UBound(arrAll) To 0 Step -1
            arrItem = Split(arrAll(n), ":")
            If CLng(arrItem(0)) = CLng(idx) Then
                lngFound = n
                Exit For
            End If
        Next
        If lngFound < 0 Then Exit Sub
        strOut = ""
        For n = 0 To UBound(arrAll)
            If n <> lngFound Then
                If strOut = "" Then
                    strOut = arrAll(n)
                Else
                    strOut = strOut & "," & arrAll(n)
                End If
            End If
        Next
        petDetailList(petCurChar) = strOut
    End Sub
    ' 重绘成本汇总与明细表：汇总按号分组（每号小节+小计，末行全部号合计）；明细只显示当前号（最新在上，序号为录入顺序）
    Sub RefreshPetDetail
        Dim objWrap
        Set objWrap = document.getElementById("petDetailSection")
        If objWrap Is Nothing Then Exit Sub
        objWrap.innerHTML = PetRenderTables(PetSessionViews, petCurChar)
    End Sub
    ' 清零当前号的次数与累计成本（有未保存变更先提醒保存；有记录时再确认；其他号不受影响）
    Sub PetCountReset
        Dim i, blnHasData, r
        ' 清零前保存提醒：当天有未保存变更时先问（是=先保存再清零 / 否=不保存直接清零 / 取消=不清零）
        If petDirty Then
            r = MsgBox("当天宠环成本记录有未保存的变更，清零前先保存吗？" & vbCrLf & vbCrLf & "【是】先保存再清零    【否】不保存直接清零    【取消】不清零", vbYesNoCancel + vbQuestion, "保存提醒")
            If r = vbCancel Then Exit Sub
            If r = vbYes Then
                ' 保存失败（已弹提示）且当天确有数据：不清零；当天无可保存数据：继续清零
                If Not PetSaveBeforeAction Then Exit Sub
            End If
        End If
        blnHasData = False
        For i = 0 To PET_TASK_COUNT - 1
            If petCounts(petCurChar, i) > 0 Then blnHasData = True
        Next
        If blnHasData Or petCostTotal(petCurChar) > 0 Then
            If MsgBox("将清空 " & PetCharName(petCurChar) & " 的全部次数与累计成本（当前 " & PetFmtCost(petCostTotal(petCurChar)) & " 万梦幻币），其他号不受影响。是否继续？", vbYesNo + vbQuestion, "清零确认") <> vbYes Then Exit Sub
        End If
        PetResetChar petCurChar
        petDirty = True
        RefreshPetSession
    End Sub
    ' ===================== 宠环成本历史记录（文件按行存储：日期|号|次数CSV|明细CSV|累计成本，同一天多次保存覆盖当天） =====================
    ' 行格式即双端交换格式：与移动版“历史记录导入/导出”通用；total 一律无千分位（见 PetFmtCostPlain），跨端解析不被逗号截断
    ' 当天日期字符串（yyyy-mm-dd）
    Function PetTodayStr
        PetTodayStr = Year(Date) & "-" & Right("0" & Month(Date), 2) & "-" & Right("0" & Day(Date), 2)
    End Function
    ' 历史记录文件路径（与工具箱同目录，内容纯 ASCII）
    Function PetHistFile
        Dim fso
        Set fso = CreateObject("Scripting.FileSystemObject")
        PetHistFile = fso.BuildPath(fso.GetParentFolderName(window.location.pathname), "pet_cost_history.txt")
    End Function
    ' 读取历史文件全部行（文件不存在返回空数组，调用方过滤空行）
    Function PetReadHistLines
        Dim fso, f, strAll, message
        strAll = ""
        Set f = Nothing
        On Error Resume Next
        Err.Clear
        Set fso = CreateObject("Scripting.FileSystemObject")
        If fso.FileExists(PetHistFile) Then
            Set f = fso.OpenTextFile(PetHistFile, 1)
            ' 清空或删除最后一天后文件为零字节，直接 ReadAll 会触发错误 62（输入超出了文件尾）。
            If Err.Number = 0 Then
                If Not f.AtEndOfStream Then strAll = f.ReadAll
            End If
        End If
        message = Err.Description
        Err.Clear
        If Not f Is Nothing Then f.Close
        If message = "" Then message = Err.Description
        Err.Clear
        On Error GoTo 0
        If message <> "" Then Err.Raise 5, "PetReadHistLines", message
        If strAll = "" Then
            PetReadHistLines = Array()
        Else
            PetReadHistLines = Split(strAll, vbCrLf)
        End If
    End Function
    ' 存储结果显式区分成功、无数据、错误及并发变更；提示仅由事件入口负责。
    Function PetResult(status, data, raw, message)
        Set PetResult = MakeRecord(Array("status", "data", "raw", "error"), Array(status, data, raw, message))
    End Function
    Function TextMatches(text, pattern)
        Dim regex
        Set regex = New RegExp
        regex.Pattern = pattern
        regex.IgnoreCase = True
        TextMatches = regex.Test(CStr(text))
    End Function
    Function PetInteger(text, maximum)
        Dim number
        PetInteger = False
        If Not TextMatches(text, "^\d+$") Then Exit Function
        If Not TryNumber(text, number) Then Exit Function
        PetInteger = (number <= maximum)
    End Function
    Function PetNumber(text, ByRef number)
        PetNumber = False
        If Not TextMatches(Trim(text), "^[+-]?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$") Then Exit Function
        PetNumber = TryNumber(text, number)
    End Function
    Sub AppendValue(ByRef values, value)
        ReDim Preserve values(UBound(values) + 1)
        If IsObject(value) Then
            Set values(UBound(values)) = value
        Else
            values(UBound(values)) = value
        End If
    End Sub
    ' 交换行日期字段校验：先检查结构和范围，再验证日历日期，拒绝 DateSerial 自动归一化。
    Function PetValidDate(s)
        Dim yearValue, monthValue, dayValue, dt
        PetValidDate = False
        If Not TextMatches(s, "^\d{4}-\d{2}-\d{2}$") Then Exit Function
        yearValue = CInt(Left(s, 4))
        monthValue = CInt(Mid(s, 6, 2))
        dayValue = CInt(Right(s, 2))
        If yearValue < 100 Or monthValue < 1 Or monthValue > 12 Or dayValue < 1 Or dayValue > 31 Then Exit Function
        On Error Resume Next
        Err.Clear
        dt = DateSerial(yearValue, monthValue, dayValue)
        If Err.Number = 0 Then PetValidDate = (Year(dt) = yearValue And Month(dt) = monthValue And Day(dt) = dayValue)
        Err.Clear
        On Error GoTo 0
    End Function
    Function PetParseDetails(text)
        Dim items, fields, item, amount, details
        details = Array()
        If text <> "" Then
            items = Split(text, ",")
            For Each item In items
                fields = Split(item, ":")
                If UBound(fields) <> 1 Then Err.Raise 5, , "明细须为“任务序号:成本”格式。"
                If Not PetInteger(fields(0), PET_TASK_COUNT - 1) Then Err.Raise 5, , "明细任务序号须为 0~12。"
                If Not PetNumber(fields(1), amount) Then Err.Raise 5, , "明细成本须为完整数字。"
                AppendValue details, Array(CLng(fields(0)), amount)
            Next
        End If
        PetParseDetails = details
    End Function
    Function PetParseLine(line, normalizeTotal)
        Dim fields, counts, i, details, total
        fields = Split(line, "|")
        If UBound(fields) <> 4 Then Err.Raise 5, , "须有 5 个竖线分隔的字段。"
        If Not PetValidDate(fields(0)) Then Err.Raise 5, , "日期须为真实的 yyyy-mm-dd 日期。"
        If Not PetInteger(fields(1), PET_CHAR_COUNT - 1) Then Err.Raise 5, , "号字段须为 0~4。"
        counts = Split(fields(2), ",")
        If UBound(counts) <> PET_TASK_COUNT - 1 Then Err.Raise 5, , "次数字段须为 13 项。"
        For i = 0 To UBound(counts)
            If Not PetInteger(counts(i), 2147483647) Then Err.Raise 5, , "次数须为 0~2147483647 的整数。"
            counts(i) = CDbl(counts(i))
        Next
        details = PetParseDetails(fields(3))
        If Not PetNumber(Replace(fields(4), ",", ""), total) Then Err.Raise 5, , "累计成本须为完整数字。"
        If normalizeTotal Then line = fields(0) & "|" & fields(1) & "|" & fields(2) & "|" & fields(3) & "|" & PetFmtCostPlain(total)
        Set PetParseLine = MakeRecord(Array("date", "c", "counts", "detail", "details", "total", "line"), Array(fields(0), CLng(fields(1)), counts, fields(3), details, total, line))
    End Function
    Function PetParseHistText(text, normalizeTotal)
        Dim lines, line, history, records, record, count, message, result
        Set history = CreateObject("Scripting.Dictionary")
        lines = Split(Replace(Replace(text, vbCrLf, vbLf), vbCr, vbLf), vbLf)
        count = 0
        For Each line In lines
            line = Trim(line)
            If line <> "" Then
                count = count + 1
                On Error Resume Next
                Err.Clear
                Set record = PetParseLine(line, normalizeTotal)
                message = Err.Description
                Err.Clear
                On Error GoTo 0
                If message <> "" Then
                    Set PetParseHistText = PetResult("error", Nothing, text, "第 " & count & " 行：" & message)
                    Exit Function
                End If
                records = Array()
                If history.Exists(record("date")) Then records = history(record("date"))
                AppendValue records, record
                history(record("date")) = records
            End If
        Next
        Set result = PetResult("ok", history, text, "")
        If count = 0 Then result("status") = "empty"
        result.Add "count", count
        result.Add "days", history.Count
        Set PetParseHistText = result
    End Function
    Function PetReadHistory
        Dim lines, message
        On Error Resume Next
        Err.Clear
        lines = PetReadHistLines
        message = Err.Description
        Err.Clear
        On Error GoTo 0
        If message <> "" Then
            Set PetReadHistory = PetResult("error", Nothing, "", message)
        Else
            Set PetReadHistory = PetParseHistText(Join(lines, vbCrLf), False)
        End If
    End Function
    Function PetMergeHistory(history, incoming)
        Dim merged, day
        Set merged = CreateObject("Scripting.Dictionary")
        For Each day In history.Keys
            If Not incoming.Exists(day) Then merged.Add day, history(day)
        Next
        For Each day In incoming.Keys
            merged.Add day, incoming(day)
        Next
        Set PetMergeHistory = merged
    End Function
    Function PetHistoryText(history)
        Dim day, record, records, text
        text = ""
        For Each day In history.Keys
            records = history(day)
            For Each record In records
                text = text & record("line") & vbCrLf
            Next
        Next
        PetHistoryText = text
    End Function
    Function PetWriteHistory(history, expectedRaw)
        Dim check, fso, stream, message, text
        Set check = PetReadHistory
        If check("status") = "error" Then
            Set PetWriteHistory = check
            Exit Function
        End If
        If check("raw") <> expectedRaw Then
            Set PetWriteHistory = PetResult("changed", Nothing, expectedRaw, "确认期间历史记录发生变化，已取消操作，请重新查看。")
            Exit Function
        End If
        text = PetHistoryText(history)
        Set stream = Nothing
        On Error Resume Next
        Err.Clear
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set stream = fso.CreateTextFile(PetHistFile, True)
        If Err.Number = 0 Then stream.Write text
        message = Err.Description
        Err.Clear
        If Not stream Is Nothing Then stream.Close
        If message = "" Then message = Err.Description
        Err.Clear
        On Error GoTo 0
        If message = "" Then
            Set PetWriteHistory = PetResult("ok", history, text, "")
        Else
            Set PetWriteHistory = PetResult("error", Nothing, expectedRaw, message)
        End If
    End Function
    ' 组装当天全部有数据号的记录行（无数据返回空数组）
    Function PetBuildTodayLines
        Dim d, i, n, strCounts, blnHas, arrLines
        d = PetTodayStr
        ReDim arrLines(-1)
        For i = 0 To PET_CHAR_COUNT - 1
            blnHas = False
            strCounts = ""
            For n = 0 To PET_TASK_COUNT - 1
                If n > 0 Then strCounts = strCounts & ","
                strCounts = strCounts & CStr(petCounts(i, n))
                If petCounts(i, n) > 0 Or petCostHist(i, n) <> "" Then blnHas = True
            Next
            If blnHas Then
                ReDim Preserve arrLines(UBound(arrLines) + 1)
                arrLines(UBound(arrLines)) = d & "|" & i & "|" & strCounts & "|" & petDetailList(i) & "|" & PetFmtCostPlain(petCostTotal(i))
            End If
        Next
        PetBuildTodayLines = arrLines
    End Function
    ' 保存当天快照，返回 status/data/raw/error；当天无数据不写文件，仅成功写入才清除 petDirty。
    Function PetSaveHistoryCore
        Dim incoming, loaded, merged, result
        Set incoming = PetParseHistText(Join(PetBuildTodayLines, vbCrLf), True)
        If incoming("status") <> "ok" Then
            Set PetSaveHistoryCore = incoming
            Exit Function
        End If
        Set loaded = PetReadHistory
        If loaded("status") = "error" Then
            Set PetSaveHistoryCore = loaded
            Exit Function
        End If
        Set merged = PetMergeHistory(loaded("data"), incoming("data"))
        Set result = PetWriteHistory(merged, loaded("raw"))
        If result("status") = "ok" Then petDirty = False
        Set PetSaveHistoryCore = result
    End Function
    Function PetSaveBeforeAction
        Dim result
        Set result = PetSaveHistoryCore
        PetSaveBeforeAction = (result("status") = "ok" Or result("status") = "empty")
        If Not PetSaveBeforeAction Then MsgBox "保存失败：" & result("error"), vbExclamation, "保存失败"
    End Function
    ' “保存当天记录”按钮：保存并提示（历史区展开时同步刷新日历）
    Sub PetSaveHistory
        Dim result
        Set result = PetSaveHistoryCore
        If result("status") = "empty" Then
            MsgBox "当天暂无可保存的宠环成本记录。", vbInformation, "保存当天记录"
            Exit Sub
        End If
        If result("status") <> "ok" Then
            MsgBox "保存失败：" & result("error"), vbExclamation, "保存失败"
            Exit Sub
        End If
        MsgBox "已保存 " & PetTodayStr & " 的宠环成本记录（可在“历史记录查询”中查看）。", vbInformation, "保存成功"
        If document.getElementById("petHistSection").style.display <> "none" Then RefreshPetHist
    End Sub
    ' 加载历史文件到 petHistData（日期 → 该日记录对象数组），失败明确返回 False。
    Function PetLoadHist
        Dim result
        Set result = PetReadHistory
        PetLoadHist = False
        If result("status") = "error" Then
            MsgBox "读取历史记录失败：" & result("error"), vbExclamation, "历史记录"
            Exit Function
        End If
        Set petHistData = result("data")
        PetLoadHist = True
    End Function
    ' 日期数组升序（插入排序，量小）
    Sub PetSortDates(arr)
        Dim i, j, t
        For i = 1 To UBound(arr)
            t = arr(i)
            j = i - 1
            Do While j >= 0
                If arr(j) > t Then
                    arr(j + 1) = arr(j)
                    j = j - 1
                Else
                    Exit Do
                End If
            Loop
            arr(j + 1) = t
        Next
    End Sub
    ' 展开/收起历史记录查询（展开时重读文件渲染日历）
    Sub TogglePetHist
        If document.getElementById("petHistSection").style.display = "none" Then RefreshPetHist
        ToggleSection "petHistSection", "petHistToggleHint"
    End Sub
    ' 渲染日历：周日起头；有记录日期紫底白字可点（传日期索引规避字符串引号问题）；今天紫字
    Sub RefreshPetHist
        Dim objSec, n, strH, wd, days, d, cIdx, strDate, arrKeys, strToday
        Set objSec = document.getElementById("petHistSection")
        If objSec Is Nothing Then Exit Sub
        If Not PetLoadHist Then
            objSec.innerText = "历史记录读取失败，请检查文件后重试。"
            Exit Sub
        End If
        If petHistYear < 0 Then
            petHistYear = Year(Date)
            petHistMonth = Month(Date)
        End If
        arrKeys = petHistData.Keys
        PetSortDates arrKeys
        ReDim petHistDateList(UBound(arrKeys))
        For n = 0 To UBound(arrKeys)
            petHistDateList(n) = arrKeys(n)
        Next
        strToday = PetTodayStr
        strH = "<div style=""margin-top: 6px;""><button class=""pet-char-btn"" style=""width: 26px;"" onclick=""PetHistPrevMonth"">&lt;</button><b style=""margin: 0 10px; font-size: 14px;"">" & petHistYear & "年" & petHistMonth & "月</b><button class=""pet-char-btn"" style=""width: 26px;"" onclick=""PetHistNextMonth"">&gt;</button><span class=""tip"" style=""margin-left: 8px;"">高亮日期有记录，点击查看</span></div>"
        strH = strH & "<table class=""pet-hist-cal""><tr><th width=""14%"">日</th><th width=""14%"">一</th><th width=""14%"">二</th><th width=""14%"">三</th><th width=""15%"">四</th><th width=""14%"">五</th><th width=""15%"">六</th></tr>"
        wd = Weekday(DateSerial(petHistYear, petHistMonth, 1))
        days = Day(DateSerial(petHistYear, petHistMonth + 1, 0))
        d = 1 - (wd - 1)
        Do While d <= days
            strH = strH & "<tr>"
            For cIdx = 0 To 6
                If d >= 1 And d <= days Then
                    strDate = petHistYear & "-" & Right("0" & petHistMonth, 2) & "-" & Right("0" & d, 2)
                    If petHistData.Exists(strDate) Then
                        strH = strH & "<td class=""pet-hist-day pet-hist-has"" onclick=""PetShowHist " & PetDateIndex(strDate) & """>" & d & "</td>"
                    ElseIf strDate = strToday Then
                        strH = strH & "<td class=""pet-hist-day pet-hist-today"">" & d & "</td>"
                    Else
                        strH = strH & "<td class=""pet-hist-day"">" & d & "</td>"
                    End If
                Else
                    strH = strH & "<td class=""pet-hist-day""></td>"
                End If
                d = d + 1
            Next
            strH = strH & "</tr>"
        Loop
        strH = strH & "</table>"
        objSec.innerHTML = strH
    End Sub
    ' 日期在 petHistDateList 中的下标（-1 未找到）
    Function PetDateIndex(strDate)
        Dim n
        PetDateIndex = -1
        For n = 0 To UBound(petHistDateList)
            If petHistDateList(n) = strDate Then
                PetDateIndex = n
                Exit Function
            End If
        Next
    End Function
    Sub PetHistPrevMonth
        petHistMonth = petHistMonth - 1
        If petHistMonth = 0 Then
            petHistMonth = 12
            petHistYear = petHistYear - 1
        End If
        RefreshPetHist
    End Sub
    Sub PetHistNextMonth
        petHistMonth = petHistMonth + 1
        If petHistMonth = 13 Then
            petHistMonth = 1
            petHistYear = petHistYear + 1
        End If
        RefreshPetHist
    End Sub
    ' 点击日历日期：弹窗展示该日保存的成本汇总（按号分组）与逐笔明细（最新在上）
    Sub PetShowHist(idx)
        Dim strDate, records, views, record
        idx = CLng(idx)
        If idx < 0 Or idx > UBound(petHistDateList) Then Exit Sub
        strDate = petHistDateList(idx)
        If Not PetLoadHist Then Exit Sub
        If Not petHistData.Exists(strDate) Then Exit Sub
        records = petHistData(strDate)
        views = Array()
        For Each record In records
            AppendValue views, PetViewRecord(record)
        Next
        OpenPetHistDlg strDate, PetRenderTables(views, -1)
    End Sub
    Function PetRenderTables(records, detailCharacter)
        Dim n, m, record, arrCnt, arrDet, arrItem, strH, strCls, c, detailTitle
        Dim lngRows, lngCnt, dblSum, lngAllCnt, dblAllSum, blnAny, blnAnyDet, rn, taskSum, t
        strH = "<div class=""pet-block-title"""
        If detailCharacter = -1 Then strH = strH & " style=""margin-top: 0;"""
        strH = strH & ">【成本汇总】</div>"
        strH = strH & "<table><tr><th width=""55%"">任务内容</th><th width=""20%"">次数</th><th width=""25%"">合计成本（万）</th></tr>"
        lngAllCnt = 0
        dblAllSum = 0
        blnAny = False
        For n = 0 To UBound(records)
            Set record = records(n)
            c = record("c")
            arrCnt = record("counts")
            Set taskSum = record("sums")
            lngRows = 0
            lngCnt = 0
            dblSum = 0
            For t = 0 To PET_TASK_COUNT - 1
                If taskSum.Exists(t) Then
                    If lngRows = 0 Then
                        strH = strH & "<tr><td class=""pet-char-cell"" colspan=""3"">" & PetCharName(c) & "</td></tr>"
                        blnAny = True
                    End If
                    lngRows = lngRows + 1
                    lngCnt = lngCnt + arrCnt(t)
                    dblSum = dblSum + taskSum(t)
                    strCls = ""
                    If lngRows Mod 2 = 0 Then strCls = " class=""alt"""
                    strH = strH & "<tr" & strCls & "><td class=""lv"">" & PetTaskName(t) & "</td><td class=""num"">" & arrCnt(t) & "</td><td class=""num"">" & PetFmtCost(taskSum(t)) & "</td></tr>"
                End If
            Next
            If lngRows > 0 Then
                strH = strH & "<tr><td class=""pet-subtotal"">" & PetCharName(c) & " 小计</td><td class=""pet-subtotal""><b>" & lngCnt & "</b></td><td class=""pet-subtotal""><b>" & PetFmtCost(dblSum) & "</b></td></tr>"
                lngAllCnt = lngAllCnt + lngCnt
                dblAllSum = dblAllSum + dblSum
            End If
        Next
        If Not blnAny Then
            strH = strH & "<tr><td class=""pet-empty"" colspan=""3"">暂无成本记录</td></tr>"
        Else
            strH = strH & "<tr><td class=""pet-grand"">全部号合计</td><td class=""pet-grand""><b>" & lngAllCnt & "</b></td><td class=""pet-grand""><b>" & PetFmtCost(dblAllSum) & "</b></td></tr>"
        End If
        strH = strH & "</table>"
        detailTitle = "成本明细"
        If detailCharacter >= 0 Then detailTitle = detailTitle & " · " & PetCharName(detailCharacter) & "（最新在上）"
        strH = strH & "<div class=""pet-block-title"">【" & detailTitle & "】</div>"
        strH = strH & "<div class=""pet-detail-scroll""><table><tr><th width=""15%"">序号</th><th width=""55%"">任务内容</th><th width=""30%"">成本（万）</th></tr>"
        blnAnyDet = False
        For n = 0 To UBound(records)
            Set record = records(n)
            c = record("c")
            arrDet = record("details")
            If UBound(arrDet) >= 0 And (detailCharacter = -1 Or detailCharacter = c) Then
                If detailCharacter = -1 Then strH = strH & "<tr><td class=""pet-char-cell"" colspan=""3"">" & PetCharName(c) & "</td></tr>"
                blnAnyDet = True
                rn = 0
                For m = UBound(arrDet) To 0 Step -1
                    arrItem = arrDet(m)
                    rn = rn + 1
                    strCls = ""
                    If rn Mod 2 = 0 Then strCls = " class=""alt"""
                    strH = strH & "<tr" & strCls & "><td class=""num"">" & (m + 1) & "</td><td class=""lv"">" & PetTaskName(CLng(arrItem(0))) & "</td><td class=""num"">" & PetFmtCost(CDbl(arrItem(1))) & "</td></tr>"
                Next
            End If
        Next
        If Not blnAnyDet Then strH = strH & "<tr><td class=""pet-empty"" colspan=""3"">暂无成本记录</td></tr>"
        strH = strH & "</table></div>"
        PetRenderTables = strH
    End Function
    ' 打开历史弹窗：遮罩 + 视口居中 + 锁背景滚动（内容超高时顶部对齐）
    Sub OpenPetHistDlg(strDate, strHtml)
        petHistSelectedDate = strDate
        document.getElementById("petHistTitle").innerText = "📅 " & strDate & " 宠环成本记录"
        document.getElementById("petHistBody").innerHTML = strHtml
        OpenPetDialog "petHist", petHistSavedScrollTop, True
    End Sub
    Sub ClosePetHist
        petHistSelectedDate = ""
        ClosePetDialog "petHist", petHistSavedScrollTop
    End Sub
    ' 删除仅处理已保存快照，不改当前计数、成本和 petDirty；空日期仅由全部清空入口传入。
    Sub PetDeleteHistDay
        If petHistSelectedDate <> "" Then PetRemoveHistory petHistSelectedDate
    End Sub
    Sub PetClearHistory
        window.event.cancelBubble = True
        PetRemoveHistory ""
    End Sub
    Sub PetRemoveHistory(ByVal strDate)
        Dim loaded, history, result, hasRecords, strScope, strToken, strAnswer, strNote
        Set loaded = PetReadHistory
        If loaded("status") = "error" Then
            MsgBox "读取历史记录失败，未执行删除：" & loaded("error"), vbExclamation, "删除历史记录"
            Exit Sub
        End If
        Set history = loaded("data")
        hasRecords = (history.Count > 0)
        If strDate <> "" Then hasRecords = history.Exists(strDate)
        If Not hasRecords Then
            If strDate = "" Then
                MsgBox "暂无可清空的历史记录。", vbInformation, "清空历史记录"
            Else
                MsgBox strDate & " 已无历史记录。", vbInformation, "删除该日记录"
            End If
            If petHistSelectedDate <> "" Then ClosePetHist
            RefreshPetHist
            Exit Sub
        End If
        strNote = ""
        If strDate = "" Then
            strScope = "全部 " & history.Count & " 个日期、全部号的历史记录"
            strToken = "清空全部历史记录"
        Else
            strScope = strDate & " 的全部号历史记录"
            strToken = strDate
            strNote = vbCrLf & "其他日期记录保留。"
        End If
        If MsgBox("即将永久删除" & strScope & "。" & strNote & vbCrLf & vbCrLf & "此操作不可撤销，建议先取消并导出备份。" & vbCrLf & "当前计数和成本不受影响；再次保存当天记录会重新生成当天历史。" & vbCrLf & vbCrLf & "是否继续？", vbYesNo + vbExclamation + vbDefaultButton2, "删除历史记录 · 确认范围") <> vbYes Then Exit Sub
        If strDate = "" Then
            If MsgBox("再次确认：将清空所有日期的宠环历史记录，不只是当前月份或当前号！" & vbCrLf & "没有导出备份的记录将无法恢复。" & vbCrLf & vbCrLf & "确定继续清空吗？", vbYesNo + vbExclamation + vbDefaultButton2, "清空全部历史记录 · 二次确认") <> vbYes Then Exit Sub
        End If
        strAnswer = InputBox("最后确认：请输入“" & strToken & "”以删除" & strScope & "。" & vbCrLf & "输入不一致或取消均不会删除。", "删除历史记录 · 输入确认", "")
        If strAnswer = "" Then Exit Sub
        If strAnswer <> strToken Then
            MsgBox "输入不一致，已取消删除，历史记录未改动。", vbInformation, "已取消删除"
            Exit Sub
        End If
        ' 确认期间若其他窗口保存或导入了记录，拒绝用旧快照覆盖。
        If strDate = "" Then
            history.RemoveAll
        Else
            history.Remove strDate
        End If
        Set result = PetWriteHistory(history, loaded("raw"))
        If result("status") <> "ok" Then
            MsgBox "删除失败：" & result("error"), vbExclamation, "删除失败"
            Exit Sub
        End If
        If petHistSelectedDate <> "" Then ClosePetHist
        RefreshPetHist
        If strDate = "" Then
            MsgBox "已清空全部宠环历史记录。", vbInformation, "清空完成"
        Else
            MsgBox "已删除 " & strDate & " 的全部号历史记录，其他日期保留。", vbInformation, "删除完成"
        End If
    End Sub
    ' ===================== 历史记录跨端导入/导出（交换格式即文件行格式，与移动版通用） =====================
    ' 导出：全部已保存历史行填入文本框，全选待复制（到移动版“导入”粘贴）
    Sub PetHistExport
        Dim loaded, strAll, lngCnt
        window.event.cancelBubble = True
        Set loaded = PetReadHistory
        If loaded("status") = "error" Then
            MsgBox "读取历史记录失败：" & loaded("error"), vbExclamation, "导出历史记录"
            Exit Sub
        End If
        strAll = PetHistoryText(loaded("data"))
        lngCnt = loaded("count")
        If strAll = "" Then
            MsgBox "暂无已保存的历史记录（先点“保存当天记录”或从移动版导入）。", vbInformation, "导出历史记录"
            Exit Sub
        End If
        document.getElementById("petIoTitle").innerText = "导出历史记录（与移动版通用）"
        document.getElementById("petIoNote").innerText = "共 " & lngCnt & " 行。点“全选复制”复制全部文本，再到移动版“历史记录查询”的“导入”粘贴。"
        document.getElementById("petIoText").value = strAll
        document.getElementById("petIoOkBtn").style.display = "none"
        document.getElementById("petIoCopyBtn").style.display = ""
        OpenPetIoDlg
        document.getElementById("petIoText").select
    End Sub
    ' 导入：粘贴移动版导出的行文本，确认后与本机文件合并（同日期覆盖、其他保留）
    Sub PetHistImport
        window.event.cancelBubble = True
        document.getElementById("petIoTitle").innerText = "导入历史记录（与移动版通用）"
        document.getElementById("petIoNote").innerText = "粘贴移动版导出的记录文本后点“导入”。导入日期将覆盖本机同日期记录，其他日期保留；不影响当前计数。"
        document.getElementById("petIoText").value = ""
        document.getElementById("petIoOkBtn").style.display = ""
        document.getElementById("petIoCopyBtn").style.display = "none"
        OpenPetIoDlg
    End Sub
    ' 导入确认：逐行校验（5 段/日期/号 0-4/13 项整数次数/明细 t:c 且任务号 0-12/数字成本），
    ' 全过才合并写入：导入文本中的日期整日覆盖本地同日期行，本地其他日期保留；
    ' 计数器与 petDirty 不受影响（导入的是已落盘快照，不是会话数据）；写入时 total 顺手规范化去千分位
    Sub PetIoOk
        Dim incoming, loaded, merged, result
        ' 统一换行为 vbLf 再分行（兼容 CRLF / LF / CR 及末尾多余换行）
        ' total 容忍千分位（HTA 旧版文件可能写过），写入时规范化
        Set incoming = PetParseHistText(document.getElementById("petIoText").value, True)
        If incoming("status") = "error" Then
            MsgBox "导入失败：" & incoming("error"), vbExclamation, "导入失败"
            Exit Sub
        End If
        If incoming("status") = "empty" Then
            MsgBox "请先粘贴历史记录文本！", vbExclamation, "导入历史记录"
            Exit Sub
        End If
        Set loaded = PetReadHistory
        If loaded("status") = "error" Then
            MsgBox "读取历史记录失败，未执行导入：" & loaded("error"), vbExclamation, "导入失败"
            Exit Sub
        End If
        ' 本地保留日期不在导入集合的行，再追加导入行（total 重写为无千分位）
        Set merged = PetMergeHistory(loaded("data"), incoming("data"))
        Set result = PetWriteHistory(merged, loaded("raw"))
        If result("status") <> "ok" Then
            MsgBox "导入失败：" & result("error"), vbExclamation, "导入失败"
            Exit Sub
        End If
        PetIoClose
        MsgBox "导入成功：共 " & incoming("count") & " 行（" & incoming("days") & " 天），导入日期已覆盖本机同日期记录，其他日期保留。", vbInformation, "导入历史记录"
        If document.getElementById("petHistSection").style.display <> "none" Then RefreshPetHist
    End Sub
    ' 全选并尝试复制文本框内容（剪贴板被安全设置拦截时退化为全选待手动 Ctrl+C）
    Sub PetIoCopyAll
        Dim objT
        Set objT = document.getElementById("petIoText")
        objT.focus
        objT.select
        On Error Resume Next
        window.clipboardData.setData "Text", objT.value
        If Err.Number = 0 Then
            MsgBox "已复制到剪贴板，到移动版“导入”粘贴即可。", vbInformation, "导出历史记录"
        Else
            Err.Clear
            MsgBox "已全选文本（剪贴板直接写入被拦截），请按 Ctrl+C 复制。", vbInformation, "导出历史记录"
        End If
        On Error GoTo 0
    End Sub
    ' 打开导入/导出弹窗：遮罩 + 视口居中 + 锁背景滚动（同历史查看弹窗）
    Sub OpenPetIoDlg
        OpenPetDialog "petIo", petIoSavedScrollTop, True
    End Sub
    Sub PetIoClose
        ClosePetDialog "petIo", petIoSavedScrollTop
    End Sub

    Dim arrSqGroups
    arrSqGroups = Array( _
        Array("序章", 0), _
        Array("神器任务·起", 1), _
        Array("神器任务·转", 20), _
        Array("神器任务·合", 35) _
    )
    sqCurrentIdx = -1
    Dim sqHttp, sqFetchIdx, sqCache
    Set sqCache = CreateObject("Scripting.Dictionary")
    sqFetchIdx = -1
    ' 弹窗尺寸状态：sqUserW/H 为用户拖拽调整后的尺寸（0 表示未调整，始终跟随主窗口自适应）
    Dim sqUserW, sqUserH, sqResizeOn, sqDragStartX, sqDragStartY, sqDragStartW, sqDragStartH
    sqUserW = 0
    sqUserH = 0
    sqResizeOn = False
    ' 弹窗位置状态：sqUserLeft/Top 为用户拖动后的位置（-1 表示未拖动过，打开时居中）
    Dim sqUserLeft, sqUserTop, sqMoveOn, sqMoveStartX, sqMoveStartY, sqMoveStartL, sqMoveStartT
    sqUserLeft = -1
    sqUserTop = -1
    sqMoveOn = False
    ' 弹窗打开期间禁用主界面滚动条时保存的滚动位置（关闭弹窗时恢复）
    Dim sqSavedScrollTop
    sqSavedScrollTop = 0
    Sub RenderShenqiLinks
        Dim i, g, strHtml
        strHtml = ""
        g = 0
        For i = 0 To UBound(arrShenqi)
            If g <= UBound(arrSqGroups) Then
                If arrSqGroups(g)(1) = i Then
                    strHtml = strHtml & "<span class=""sq-group"">" & arrSqGroups(g)(0) & "</span>"
                    g = g + 1
                End If
            End If
            strHtml = strHtml & "<a class=""sq-link"" onclick=""ShowShenqi " & i & """>" & arrShenqi(i)(0) & "</a>"
        Next
        document.getElementById("sqLinks").innerHTML = strHtml
    End Sub
    Sub ToggleSqSection
        ToggleSection "sqLinks", "sqToggleHint"
    End Sub
    Sub ShowShenqi(idx)
        sqCurrentIdx = CInt(idx)
        sqFetchIdx = sqCurrentIdx
        document.getElementById("sqDialogTitle").innerText = arrShenqi(sqCurrentIdx)(0)
        ' 弹窗打开期间禁用主界面滚动条（防止背景滚动带动视野），关闭弹窗时恢复
        sqSavedScrollTop = document.body.scrollTop
        document.body.style.overflow = "hidden"
        document.body.scrollTop = sqSavedScrollTop
        PositionSqDialog
        document.getElementById("sqOverlay").style.display = "block"
        document.getElementById("sqDialog").style.display = "block"
        If sqCache.Exists(sqCurrentIdx) Then
            WriteSqFrame sqCache(sqCurrentIdx)
            Exit Sub
        End If
        WriteSqFrame SqNoticePage("攻略加载中，请稍候……")
        On Error Resume Next
        If IsObject(sqHttp) Then sqHttp.abort
        Set sqHttp = CreateObject("MSXML2.XMLHTTP.6.0")
        If Err.Number = 0 Then
            sqHttp.onreadystatechange = GetRef("SqGuideStateChanged")
            sqHttp.open "GET", arrShenqi(sqCurrentIdx)(1), True
            sqHttp.setRequestHeader "User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
            sqHttp.send
        End If
        If Err.Number <> 0 Then
            Err.Clear
            WriteSqFrame SqNoticePage("攻略页面获取失败（网络异常），请点击上方“在浏览器中打开”按钮查看。")
        End If
        On Error GoTo 0
    End Sub
    Sub SqGuideStateChanged
        Dim strHtml, strBody, strCharset
        On Error Resume Next
        If Not IsObject(sqHttp) Then Exit Sub
        If sqHttp.readyState <> 4 Then Exit Sub
        If sqFetchIdx < 0 Then Exit Sub
        If sqHttp.status = 200 Then
            If InStr(1, arrShenqi(sqFetchIdx)(1), "xyq.163.com", vbTextCompare) > 0 Then
                strCharset = "gb2312"
            Else
                strCharset = "utf-8"
            End If
            strHtml = SqDecodeBody(sqHttp.responseBody, strCharset)
            ' 优先提取纯正文（丢弃导航/推荐位/评论区，加快加载与滚动），失败则回退整页清洗
            strBody = SqExtractBody(strHtml, arrShenqi(sqFetchIdx)(1))
            If Len(strBody) > 300 Then
                strHtml = strBody
            Else
                strHtml = SqTransformHtml(strHtml, arrShenqi(sqFetchIdx)(1))
            End If
            If Len(strHtml) > 500 Then
                sqCache(sqFetchIdx) = strHtml
                If sqCurrentIdx = sqFetchIdx Then WriteSqFrame strHtml
            Else
                If sqCurrentIdx = sqFetchIdx Then WriteSqFrame SqNoticePage("攻略内容获取失败，请点击上方“在浏览器中打开”按钮查看。")
            End If
        Else
            If sqCurrentIdx = sqFetchIdx Then WriteSqFrame SqNoticePage("攻略页面获取失败（网络异常），请点击上方“在浏览器中打开”按钮查看。")
        End If
    End Sub
    Function SqNoticePage(strMsg)
        SqNoticePage = "<html><head></head>" & _
            "<body style=""font-family:'Microsoft YaHei';font-size:14px;color:#555;padding:24px;line-height:1.8;"">" & strMsg & "</body></html>"
    End Function
    Function SqDecodeBody(varBody, strCharset)
        Dim stm
        Set stm = CreateObject("ADODB.Stream")
        stm.Type = 1
        stm.Open
        stm.Write varBody
        stm.Position = 0
        stm.Type = 2
        stm.Charset = strCharset
        SqDecodeBody = stm.ReadText
        stm.Close
    End Function
    ' 提取攻略正文：仅保留正文容器内容并按锚点截尾（截止到神器小结/结束语），
    ' 丢弃导航、推荐位、侧边栏、评论区等全部非正文区域；DOM 最小化，加快加载并让滚动更流畅
    ' 游侠站正文容器为 .c-detail；3DM 站桌面版为 warp_center、移动版为 detaile_cont，截尾锚点按站点区分
    Function SqExtractBody(strHtml, strUrl)
        Dim re, m, posStart, posEnd, posTry, posJ, posP, strBody, blnIs3dm, posLt, posGt, intCh, anchors, anchor
        SqExtractBody = ""
        blnIs3dm = False
        Set re = New RegExp
        re.IgnoreCase = True
        re.Global = False
        re.Pattern = "<div\b[^>]*c-detail[^>]*>"
        Set m = re.Execute(strHtml)
        If m.Count = 0 Then
            ' 3DM 站：抓取走桌面 UA 得到 warp_center 桌面版，移动 UA 才得到 detaile_cont，两个容器都按 3DM 处理
            re.Pattern = "<div\b[^>]*detaile_cont[^>]*>"
            Set m = re.Execute(strHtml)
            If m.Count = 0 Then
                re.Pattern = "<div\b[^>]*warp_center[^>]*>"
                Set m = re.Execute(strHtml)
                If m.Count = 0 Then Exit Function
            End If
            blnIs3dm = True
        End If
        posStart = m(0).FirstIndex + m(0).Length + 1
        posEnd = Len(strHtml)
        ' 逐个截尾锚点：保留到最早出现者之前
        If blnIs3dm Then
            anchors = Array("floating-button-container", "warp_b", "warp_c", "related_cont", "comm-title", "sy-tuijian")
        Else
            anchors = Array("share-container", "hidden-table", "newsbbs", "gl_r", ChrW(&H63A8) & ChrW(&H8350) & ChrW(&H9605) & ChrW(&H8BFB))  ' 推荐阅读
        End If
        For Each anchor In anchors
            posTry = InStr(posStart, strHtml, anchor, vbTextCompare)
            If posTry > 0 And posTry - 1 < posEnd Then posEnd = posTry - 1
        Next
        ' 结束语“以上就是……”：保留到其段落结束（含神器小结自然收尾）
        posJ = InStr(posStart, strHtml, ChrW(&H4EE5) & ChrW(&H4E0A) & ChrW(&H5C31) & ChrW(&H662F))
        If posJ > 0 Then
            posP = InStr(posJ, strHtml, "</p>", vbTextCompare)
            If posP > 0 And posP + 3 < posEnd Then posEnd = posP + 3
        End If
        ' 截尾点可能落在容器起始标签内部（锚点命中的是类名/ID 子串，如 <div class="warp_b 中的 warp_b），
        ' 残留的半截标签会显示为 <div class="——回退到该标签的 '<' 之前（'<' 后须为字母/斜杠/感叹号才算标签，防正文裸 '<' 误伤）
        Do
            posLt = InStrRev(strHtml, "<", posEnd)
            If posLt = 0 Then Exit Do
            posGt = InStr(posLt, strHtml, ">")
            If posGt > 0 And posGt <= posEnd Then Exit Do
            intCh = Asc(Mid(strHtml, posLt + 1, 1))
            If (intCh >= 97 And intCh <= 122) Or (intCh >= 65 And intCh <= 90) Or intCh = 47 Or intCh = 33 Then
                posEnd = posLt - 1
            Else
                Exit Do
            End If
        Loop
        If posEnd <= posStart Then Exit Function
        strBody = Mid(strHtml, posStart, posEnd - posStart + 1)
        ' 正文中偶发的脚本与事件属性同样剥离，旧 IE 引擎执行会报脚本错误
        strBody = SqCleanContent(strBody, False)
        SqExtractBody = "<html><head>" & _
            "<base href=""" & strUrl & """>" & _
            "<style>" & _
            "html{overflow-y:scroll;}" & _
            "body{margin:0;padding:14px 18px;font-family:'Microsoft YaHei';font-size:15px;line-height:1.8;color:#333333;background-color:#ffffff;}" & _
            "img{max-width:100%;height:auto;}" & _
            "p{margin:10px 0;}" & _
            "</style></head><body>" & strBody & "</body></html>"
    End Function
    Function SqCleanContent(ByVal html, stripFrames)
        Dim regex, pattern
        Set regex = New RegExp
        regex.Global = True
        regex.IgnoreCase = True
        For Each pattern In Array("<script\b[\s\S]*?</script\s*>", "<script\b[^>]*>")
            regex.Pattern = pattern
            html = regex.Replace(html, "")
        Next
        If stripFrames Then
            For Each pattern In Array("<iframe\b[\s\S]*?</iframe\s*>", "<iframe\b[^>]*>")
                regex.Pattern = pattern
                html = regex.Replace(html, "")
            Next
        End If
        For Each pattern In Array(" on[a-zA-Z]+\s*=\s*""[^""]*""", " on[a-zA-Z]+\s*=\s*'[^']*'")
            regex.Pattern = pattern
            html = regex.Replace(html, "")
        Next
        SqCleanContent = html
    End Function
    Function SqTransformHtml(strHtml, strUrl)
        Dim re, strBase
        Set re = New RegExp
        re.Global = True
        re.IgnoreCase = True
        ' 移除脚本与嵌套框架：旧 IE 引擎无法执行现代 JS，保留会触发“脚本错误”弹窗
        ' 移除事件属性，防止调用已剥离的脚本
        strHtml = SqCleanContent(strHtml, True)
        ' javascript: 链接改为空锚
        re.Pattern = "(href\s*=\s*[""'])\s*javascript:[^""']*"
        strHtml = re.Replace(strHtml, "$1#")
        ' 移除 charset/refresh 声明（内容已解码为 Unicode 注入，refresh 会导致整页跳转）
        re.Pattern = "<meta\b[^>]*(http-equiv\s*=\s*[""']?refresh|charset)[^>]*>"
        strHtml = re.Replace(strHtml, "")
        ' 图片直链重写：http://f.xyq.netease.com 302 到 https://xyq-f.netease.com/forum/，改走 https 直连
        strHtml = Replace(strHtml, "https://f.xyq.netease.com/", "https://xyq-f.netease.com/forum/", 1, -1, vbTextCompare)
        strHtml = Replace(strHtml, "http://f.xyq.netease.com/", "https://xyq-f.netease.com/forum/", 1, -1, vbTextCompare)
        strHtml = Replace(strHtml, "//f.xyq.netease.com/", "//xyq-f.netease.com/forum/", 1, -1, vbTextCompare)
        ' 注入 base 使相对资源按原页面地址解析；隐藏侧边栏/评论区，正文自适应弹窗宽度；固定滚动条防抖
        strBase = "<base href=""" & strUrl & """>" & _
            "<style>" & _
            "html{overflow-y:scroll;}" & _
            "img{max-width:100%;height:auto;}" & _
            ".gl_r,.right_box,.pl{display:none !important;}" & _
            "footer{display:none !important;}" & _
            ".gl_l{float:none !important;width:auto !important;max-width:100% !important;}" & _
            ".content,.base{width:auto !important;max-width:100% !important;}" & _
            "</style>"
        re.Global = False
        re.Pattern = "(<head\b[^>]*>)"
        If re.Test(strHtml) Then
            strHtml = re.Replace(strHtml, "$1" & strBase)
        Else
            strHtml = strBase & strHtml
        End If
        SqTransformHtml = strHtml
    End Function
    Sub WriteSqFrame(strHtml)
        Dim objDoc, objLink
        Set objDoc = Nothing
        On Error Resume Next
        Set objDoc = document.getElementById("sqFrame").contentWindow.document
        On Error GoTo 0
        If objDoc Is Nothing Then Exit Sub
        On Error Resume Next
        objDoc.open
        objDoc.write strHtml
        objDoc.close
        ' 禁用页内链接：点击跳转会加载带脚本的完整页面
        For Each objLink In objDoc.links
            objLink.removeAttribute "href"
        Next
        On Error GoTo 0
    End Sub
    ' 弹窗定位：未手动调整过时按主窗口 90% x 85% 自适应；调整过则保持用户尺寸
    '（超出当前视口时压缩到视口内）。位置未拖动过时居中，拖动过则保持（限制在视口内）
    Sub PositionSqDialog
        Dim vw, vh, dw, dh, dlgL, dlgT, maxL, maxT
        vw = document.body.clientWidth
        vh = document.body.clientHeight
        If sqUserW > 0 And sqUserH > 0 Then
            dw = sqUserW
            dh = sqUserH
            If dw > vw Then dw = vw
            If dh > vh Then dh = vh
            If dw < 400 Then dw = 400
            If dh < 300 Then dh = 300
        Else
            dw = Int(vw * 0.9)
            If dw > 1020 Then dw = 1020
            dh = Int(vh * 0.85)
        End If
        document.getElementById("sqOverlay").style.pixelWidth = document.body.scrollWidth
        document.getElementById("sqOverlay").style.pixelHeight = document.body.scrollHeight
        document.getElementById("sqDialog").style.pixelWidth = dw
        document.getElementById("sqDialog").style.pixelHeight = dh
        If sqUserLeft >= 0 And sqUserTop >= 0 Then
            dlgL = sqUserLeft
            dlgT = sqUserTop
            maxL = document.body.scrollLeft + vw - dw
            maxT = document.body.scrollTop + vh - dh
            If dlgL < document.body.scrollLeft Then dlgL = document.body.scrollLeft
            If dlgL > maxL Then dlgL = maxL
            If dlgT < document.body.scrollTop Then dlgT = document.body.scrollTop
            If dlgT > maxT Then dlgT = maxT
        Else
            dlgL = Int((vw - dw) / 2) + document.body.scrollLeft
            dlgT = Int((vh - dh) / 2) + document.body.scrollTop
        End If
        document.getElementById("sqDialog").style.pixelLeft = dlgL
        document.getElementById("sqDialog").style.pixelTop = dlgT
        document.getElementById("sqFrame").style.pixelWidth = dw - 28
        document.getElementById("sqFrame").style.pixelHeight = dh - 72
    End Sub
    Sub Window_OnResize
        PinTopButtons
        If sqCurrentIdx >= 0 Then PositionSqDialog
    End Sub
    Sub Window_OnBlur
        If sqResizeOn Then StopSqResize
        If sqMoveOn Then StopSqMove
    End Sub
    ' 按住标题栏拖动弹窗（标题栏按钮除外）：位置限制在工具箱窗口可视范围内
    Sub StartSqMove
        Dim objDialog
        If UCase(window.event.srcElement.tagName) = "BUTTON" Then Exit Sub
        Set objDialog = document.getElementById("sqDialog")
        sqMoveStartX = window.event.clientX
        sqMoveStartY = window.event.clientY
        sqMoveStartL = objDialog.offsetLeft
        sqMoveStartT = objDialog.offsetTop
        sqMoveOn = True
        document.getElementById("sqDragMask").style.pixelWidth = objDialog.offsetWidth
        document.getElementById("sqDragMask").style.pixelHeight = objDialog.offsetHeight
        document.getElementById("sqDragMask").style.cursor = "move"
        document.getElementById("sqDragMask").style.display = "block"
        document.onmousemove = GetRef("DoSqMove")
        document.onmouseup = GetRef("StopSqMove")
        document.body.style.cursor = "move"
        On Error Resume Next
        document.getElementById("sqDragMask").setCapture
        On Error GoTo 0
        window.event.returnValue = False
    End Sub
    Sub DoSqMove
        Dim objDialog, vw, vh, minL, minT, maxL, maxT, nleft, ntop
        If Not sqMoveOn Then Exit Sub
        Set objDialog = document.getElementById("sqDialog")
        vw = document.body.clientWidth
        vh = document.body.clientHeight
        minL = document.body.scrollLeft
        minT = document.body.scrollTop
        maxL = minL + vw - objDialog.offsetWidth
        maxT = minT + vh - objDialog.offsetHeight
        If maxL < minL Then maxL = minL
        If maxT < minT Then maxT = minT
        nleft = sqMoveStartL + window.event.clientX - sqMoveStartX
        ntop = sqMoveStartT + window.event.clientY - sqMoveStartY
        If nleft < minL Then nleft = minL
        If nleft > maxL Then nleft = maxL
        If ntop < minT Then ntop = minT
        If ntop > maxT Then ntop = maxT
        objDialog.style.pixelLeft = nleft
        objDialog.style.pixelTop = ntop
    End Sub
    Sub StopSqMove
        If Not sqMoveOn Then Exit Sub
        sqMoveOn = False
        sqUserLeft = document.getElementById("sqDialog").style.pixelLeft
        sqUserTop = document.getElementById("sqDialog").style.pixelTop
        FinishSqDrag
    End Sub
    ' 开始拖拽右下角手柄：显示覆盖遮罩并捕获鼠标，拖动中实时调整弹窗尺寸（400x300 ~ 当前视口）
    Sub StartSqResize
        sqDragStartX = window.event.clientX
        sqDragStartY = window.event.clientY
        sqDragStartW = document.getElementById("sqDialog").offsetWidth
        sqDragStartH = document.getElementById("sqDialog").offsetHeight
        sqResizeOn = True
        document.getElementById("sqDragMask").style.pixelWidth = sqDragStartW
        document.getElementById("sqDragMask").style.pixelHeight = sqDragStartH
        document.getElementById("sqDragMask").style.cursor = "se-resize"
        document.getElementById("sqDragMask").style.display = "block"
        document.onmousemove = GetRef("DoSqResize")
        document.onmouseup = GetRef("StopSqResize")
        document.body.style.cursor = "se-resize"
        On Error Resume Next
        document.getElementById("sqDragMask").setCapture
        On Error GoTo 0
        window.event.returnValue = False
    End Sub
    Sub DoSqResize
        Dim vw, vh, nw, nh
        If Not sqResizeOn Then Exit Sub
        vw = document.body.clientWidth
        vh = document.body.clientHeight
        nw = sqDragStartW + window.event.clientX - sqDragStartX
        nh = sqDragStartH + window.event.clientY - sqDragStartY
        If nw < 400 Then nw = 400
        If nh < 300 Then nh = 300
        If nw > vw Then nw = vw
        If nh > vh Then nh = vh
        sqUserW = nw
        sqUserH = nh
        document.getElementById("sqDialog").style.pixelWidth = nw
        document.getElementById("sqDialog").style.pixelHeight = nh
        document.getElementById("sqFrame").style.pixelWidth = nw - 28
        document.getElementById("sqFrame").style.pixelHeight = nh - 72
        document.getElementById("sqDragMask").style.pixelWidth = nw
        document.getElementById("sqDragMask").style.pixelHeight = nh
    End Sub
    Sub StopSqResize
        If Not sqResizeOn Then Exit Sub
        sqResizeOn = False
        FinishSqDrag
    End Sub
    Sub FinishSqDrag
        document.getElementById("sqDragMask").style.display = "none"
        Set document.onmousemove = Nothing
        Set document.onmouseup = Nothing
        document.body.style.cursor = ""
        On Error Resume Next
        document.getElementById("sqDragMask").releaseCapture
        On Error GoTo 0
    End Sub
    ' 双击手柄恢复默认自适应大小并重新居中
    Sub ResetSqDialogSize
        sqUserW = 0
        sqUserH = 0
        sqUserLeft = -1
        sqUserTop = -1
        If Not sqResizeOn Then PositionSqDialog
    End Sub
    Sub CloseSq
        document.getElementById("sqDialog").style.display = "none"
        document.getElementById("sqOverlay").style.display = "none"
        ' 恢复主界面滚动条与滚动位置
        document.body.style.overflow = ""
        document.body.scrollTop = sqSavedScrollTop
        sqCurrentIdx = -1
    End Sub
    Sub OpenSqBrowser
        Dim objShell
        If sqCurrentIdx < 0 Then Exit Sub
        Set objShell = CreateObject("WScript.Shell")
        objShell.Run "explorer.exe " & arrShenqi(sqCurrentIdx)(1), 1, False
    End Sub
    ' ===================== 主题切换 =====================
    Sub ToggleTheme
        Dim chk, track
        Set chk = document.getElementById("chkTheme")
        Set track = document.getElementById("toggleTrack")
        If document.body.className = "dark" Then
            document.body.className = ""
            chk.checked = False
            track.className = "theme-toggle-track"
            document.getElementById("themeTxt").innerText = "☀ 日间"
        Else
            document.body.className = "dark"
            chk.checked = True
            track.className = "theme-toggle-track on"
            document.getElementById("themeTxt").innerText = "🌙 夜间"
        End If
        ' 日/夜文本宽度不同，重钉右上角按钮条位置
        PinTopButtons
    End Sub
    ' ===================== 初始化与窗口生命周期 =====================
    Sub Window_OnLoad
        Dim winW, maxH, winH, chromeH
        winW = 1100
        maxH = Int(screen.availHeight * 0.95)
        If winW > Int(screen.availWidth * 0.95) Then winW = Int(screen.availWidth * 0.95)
        ' 先按目标宽度调整窗口，待初始化完成后按实际内容高度贴合窗口，避免底部留白
        window.resizeTo winW, 600
        ' 主窗口尺寸变化时同步调整攻略弹窗并钉住右上角按钮条；窗口失去焦点时结束未完成的拖拽
        On Error Resume Next
        window.onresize = GetRef("Window_OnResize")
        window.onscroll = GetRef("Window_OnScroll")
        window.onblur = GetRef("Window_OnBlur")
        window.onbeforeunload = GetRef("Window_OnBeforeUnload")
        On Error GoTo 0
        FillRemindMinutes
        RenderShenqiLinks
        ' 标题栏/边框补偿 = 临时窗口高 - 客户区高（quirks 模式下 documentElement.clientHeight 恒为 0，须用 body.clientHeight 读取视口高）；窗口高 = 内容高 + 补偿 + 少量余量
        chromeH = 600 - document.body.clientHeight
        If chromeH < 0 Or chromeH > 200 Then chromeH = 72
        winH = document.body.scrollHeight + chromeH + 4
        If winH > maxH Then winH = maxH
        If winH < 400 Then winH = 400
        window.resizeTo winW, winH
        window.moveTo (screen.availWidth - winW) \ 2, (screen.availHeight - winH) \ 2
        PinTopButtons
        document.getElementById("txtPrice").focus
    End Sub
    Sub Window_OnUnload
        StopRemindTimers
    End Sub
    ' 右上角按钮条（退出工具箱/主题切换）钉位：quirks 模式不支持 position:fixed（会随文档滚动漂移），
    ' 改由脚本按视口重算 absolute 坐标（坐标系与攻略弹窗 PositionSqDialog 一致）；滚动/缩放/切主题时触发
    Sub PinTopButtons
        Dim objExit, objTheme, viewW, scrX, scrY
        viewW = document.body.clientWidth
        scrX = document.body.scrollLeft
        scrY = document.body.scrollTop
        Set objExit = document.getElementById("btnExitApp")
        Set objTheme = document.getElementById("themeToggle")
        ' 先清 CSS right 再量宽设 left：left/right 同时生效会把 absolute 元素宽度压成两者间距，
        ' 内容被挤换行（日/夜文字串行的根因）；清掉后宽度恢复内容自然宽
        objExit.style.right = "auto"
        objTheme.style.right = "auto"
        ' 退出按钮钉视口右上角（右缘内缩 20px，视觉上接替标题栏 X 的位置），主题切换排其左侧（间隔 12px）
        objExit.style.pixelTop = scrY + 9
        objExit.style.pixelLeft = viewW + scrX - objExit.offsetWidth - 20
        objTheme.style.pixelTop = scrY + 10
        objTheme.style.pixelLeft = viewW + scrX - objExit.offsetWidth - objTheme.offsetWidth - 32
    End Sub
    Sub Window_OnScroll
        PinTopButtons
    End Sub
    ' “退出工具箱”按钮（X/Alt+F4 无法拦截，可取消的退出统一走此按钮）：有未保存变更时三选（保存后退出 / 不保存退出 / 留在工具箱），无变更直接退出
    Sub PetExitApp
        Dim r
        If petDirty Then
            r = MsgBox("宠环成本记录当天有未保存的变更，退出前是否保存？" & vbCrLf & vbCrLf & "【是】保存后退出    【否】不保存直接退出    【取消】留在工具箱", vbYesNoCancel + vbQuestion, "退出确认")
            If r = vbCancel Then Exit Sub
            If r = vbYes Then
                ' 保存失败（已弹提示）且当天确有数据：留在工具箱待处理；当天无可保存数据：直接退出
                If Not PetSaveBeforeAction Then Exit Sub
            End If
        End If
        petExiting = True
        window.close
    End Sub
    ' 兜底提醒：X/Alt+F4 等系统级关闭（HTA 受 IE 引擎限制无法取消，returnValue/取消键均拦不住）只能二选是否保存后退出；
    ' 需要“留在工具箱”的可取消退出流程走右上角“退出工具箱”按钮
    Sub Window_OnBeforeUnload
        If petExiting Then Exit Sub
        If Not petDirty Then Exit Sub
        If MsgBox("宠环成本记录当天有未保存的变更，退出前是否保存？" & vbCrLf & vbCrLf & "【是】保存后退出    【否】不保存直接退出", vbYesNo + vbQuestion, "保存提醒") = vbYes Then PetSaveBeforeAction
    End Sub
</script>
</head>
<body>
    <button class="btn-exit" id="btnExitApp" onclick="PetExitApp">退出工具箱</button>
    <input type="checkbox" id="chkTheme" class="theme-toggle-chk" onclick="ToggleTheme"><label class="theme-toggle" id="themeToggle" for="chkTheme"><span class="theme-toggle-track" id="toggleTrack"><span class="theme-toggle-knob"></span></span><span class="theme-toggle-txt" id="themeTxt">☀ 日间</span></label>
    <div class="input-bar">
        <div><label>⏰ 定时提醒（小时）：</label><select id="selRemindHour"></select></div>
        <div><label>（第几分）：</label><select id="selRemindMinute"></select></div>
        <div><label>（第几秒）：</label><select id="selRemindSecond"></select></div>
        <div>
            <label>提醒内容：</label>
            <input type="text" id="txtRemindMsg" style="width: 220px;" value="该起来活动一下啦，喝口水休息休息！">
            <button id="btnRemindStart" onclick="StartRemind">运行</button>
            <button id="btnRemindStop" onclick="StopRemind" disabled>停止</button>
            <button id="btnRemindTest" onclick="ShowRemindNotify">测试</button>
        </div>
        <div id="remindStatus"></div>
    </div>
    <div class="input-bar">
        <div><label>👤 种族选择：</label><select id="selRace"><option value="human">人族</option><option value="immortal" selected>仙族</option><option value="demon">魔族</option></select></div>
        <div>
            <label>⚙️ 换算类型：</label>
            <select id="selCalcType" onchange="SwitchCalcType"><option value="weapon" selected>⚔️ 武器换算</option><option value="equip">🛡️ 装备换算</option></select>
            <button id="btnCalcAttr" onclick="CalcAttr">计算武器属性</button>
        </div>
        <div id="rowWeaponRequired">
            <label>武器伤害：</label><input type="text" id="txtWeaponDmg" onkeydown="CheckEnterAttr"><span class="tip">必填</span>
            <label style="width: auto; margin-left: 10px;">命中：</label><input type="text" id="txtWeaponHit" onkeydown="CheckEnterAttr"><span class="tip">必填</span>
        </div>
        <div id="rowEquipRequired" style="display: none;">
            <label>装备防御：</label><input type="text" id="txtEquipDef" onkeydown="CheckEnterAttr"><span class="tip">必填</span>
        </div>
        <div>
            <label>附加力量：</label><input type="text" id="txtStr" onkeydown="CheckEnterAttr"><span class="tip">选填</span>
            <label style="width: auto; margin-left: 10px;">魔力：</label><input type="text" id="txtMag" onkeydown="CheckEnterAttr"><span class="tip">选填</span>
        </div>
        <div>
            <label>附加体质：</label><input type="text" id="txtCon" onkeydown="CheckEnterAttr"><span class="tip">选填</span>
            <label style="width: auto; margin-left: 10px;">耐力：</label><input type="text" id="txtEnd" onkeydown="CheckEnterAttr"><span class="tip">选填</span>
        </div>
        <div><label>附加敏捷：</label><input type="text" id="txtAgi" onkeydown="CheckEnterAttr"><span class="tip">选填</span></div>
        <div id="divAttrTable" style="display: none; margin-top: 8px;">
            <table><tr><th class="a1">伤害</th><th class="a2">法伤</th><th class="a3">防御</th><th class="a4">气血</th><th class="a5">速度</th></tr><tr><td class="num" id="tdADmg">/</td><td class="num" id="tdAMag">/</td><td class="num" id="tdADef">/</td><td class="num" id="tdAHp">/</td><td class="num" id="tdASpd">/</td></tr></table>
        </div>
        <div id="divHistory" style="display: none;">
            <div class="history-header">计算结果对比<button id="btnClearHistory" class="btn-clear-hist" onclick="ClearHistory">清空历史</button><select id="selHistoryMax" style="margin-left:4px;" onchange="OnChangeHistoryLimit"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="5">5</option><option value="10" selected>10</option><option value="15">15</option><option value="20">20</option><option value="30">30</option></select><span style="font-weight:normal;font-size:12px;color:#888;margin-left:2px;">条</span></div>
            <div id="divHistoryTable"></div>
        </div>
    </div>
    <div class="input-bar">
        <div>
            <label>🏯 修炼类型：</label>
            <select id="selXiuType" onchange="OnXiuTypeChange"><option value="attack" selected>攻击修炼</option><option value="magic">法术修炼</option><option value="defend">防御修炼</option><option value="resist">抗法修炼</option><option value="hunt">猎术修炼</option><option value="pet">召唤兽修炼</option></select>
            <button id="btnCalcXiu" onclick="CalcXiulian">计算修炼消耗</button>
        </div>
        <div>
            <label>当前修炼等级：</label><input type="text" id="txtXiuCurLv" onkeydown="CheckEnterXiu"><span class="tip">必填 0-25</span>
            <label style="width: auto; margin-left: 10px;">当前经验：</label><input type="text" id="txtXiuCurExp" onkeydown="CheckEnterXiu"><span class="tip">选填 默认0</span>
        </div>
        <div>
            <label>目标修炼等级：</label><input type="text" id="txtXiuTgtLv" onkeydown="CheckEnterXiu"><span class="tip">必填 0-25</span>
            <label style="width: auto; margin-left: 10px;">目标经验：</label><input type="text" id="txtXiuTgtExp" onkeydown="CheckEnterXiu"><span class="tip">选填 默认0</span>
        </div>
        <div id="divXiuJiu">
            <label>💊 金丹每品质价格：</label><input type="text" id="txtJiuPrice" onkeydown="CheckEnterXiu"><span class="tip" style="display: inline-block; width: 66px;">选填 梦幻币</span>
            <label style="width: auto; margin-left: 2px;">金丹品质：</label><input type="text" id="txtJiuQuality" onkeydown="CheckEnterXiu"><span class="tip">选填 不填只算总品质</span>
        </div>
        <div id="divXiuGuo" style="display: none;">
            <label>🍎 修炼果价格（万）：</label><input type="text" id="txtGuoPrice" onkeydown="CheckEnterXiu"><span class="tip">选填 万/颗</span>
        </div>
        <div id="xiuResult"></div>
    </div>
    <div class="input-bar">
        <div style="cursor: pointer;" onclick="TogglePetSection"><label style="width: auto; text-align: left;">🐾 宠环任务（召唤兽修炼任务）：</label><span class="sq-toggle" id="petToggleHint">▼ 展开</span><span class="tip">积分规则与高级书铁奖励对照表</span></div>
        <div id="petSection" style="display: none;">
            <div class="pet-block-title">【召唤兽修炼任务积分规则】</div>
            <div style="margin-top: 6px;"><label style="width: auto;">是否计算成本：</label><select id="selPetCostMode"><option value="1" selected>是</option><option value="0">否</option></select><span class="tip">“是”：点 + 时填成本；“否”：只记次数</span></div>
            <div style="margin-top: 6px;"><label style="width: auto;">当前号：</label><button id="petCharBtn0" class="pet-char-btn-on" onclick="PetSwitchChar 0">1号</button><button id="petCharBtn1" class="pet-char-btn" onclick="PetSwitchChar 1">2号</button><button id="petCharBtn2" class="pet-char-btn" onclick="PetSwitchChar 2">3号</button><button id="petCharBtn3" class="pet-char-btn" onclick="PetSwitchChar 3">4号</button><button id="petCharBtn4" class="pet-char-btn" onclick="PetSwitchChar 4">5号</button><span class="tip">各号独立计数，全部号合计跨号累加</span></div>
            <table>
                <tr><th width="25%">任务内容</th><th width="10%">任务积分</th><th width="15%">次数</th><th width="25%">任务内容</th><th width="10%">任务积分</th><th width="15%">次数</th></tr>
                <tr><td class="lv">找人</td><td class="num">1</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 0">-</button> <span id="petCnt0">0</span> <button class="pet-cnt-btn" onclick="PetAdd 0">+</button></td><td class="lv">乐器</td><td class="num">4</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 1">-</button> <span id="petCnt1">0</span> <button class="pet-cnt-btn" onclick="PetAdd 1">+</button></td></tr>
                <tr class="alt"><td class="lv">60级装备</td><td class="num">2</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 2">-</button> <span id="petCnt2">0</span> <button class="pet-cnt-btn" onclick="PetAdd 2">+</button></td><td class="lv">花</td><td class="num">4</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 3">-</button> <span id="petCnt3">0</span> <button class="pet-cnt-btn" onclick="PetAdd 3">+</button></td></tr>
                <tr><td class="lv">1级家具</td><td class="num">2</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 4">-</button> <span id="petCnt4">0</span> <button class="pet-cnt-btn" onclick="PetAdd 4">+</button></td><td class="lv">80级装备</td><td class="num">5</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 5">-</button> <span id="petCnt5">0</span> <button class="pet-cnt-btn" onclick="PetAdd 5">+</button></td></tr>
                <tr class="alt"><td class="lv">三级药</td><td class="num">2</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 6">-</button> <span id="petCnt6">0</span> <button class="pet-cnt-btn" onclick="PetAdd 6">+</button></td><td class="lv">2级家具</td><td class="num">5</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 7">-</button> <span id="petCnt7">0</span> <button class="pet-cnt-btn" onclick="PetAdd 7">+</button></td></tr>
                <tr><td class="lv">烹饪</td><td class="num">2</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 8">-</button> <span id="petCnt8">0</span> <button class="pet-cnt-btn" onclick="PetAdd 8">+</button></td><td class="lv">非指定变异召唤兽</td><td class="num">5</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 9">-</button> <span id="petCnt9">0</span> <button class="pet-cnt-btn" onclick="PetAdd 9">+</button></td></tr>
                <tr class="alt"><td class="lv">70级装备</td><td class="num">3</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 10">-</button> <span id="petCnt10">0</span> <button class="pet-cnt-btn" onclick="PetAdd 10">+</button></td><td class="lv">指定变异召唤兽</td><td class="num">10</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 11">-</button> <span id="petCnt11">0</span> <button class="pet-cnt-btn" onclick="PetAdd 11">+</button></td></tr>
                <tr><td class="lv">上交非变异召唤兽</td><td class="num">-15</td><td class="pet-cnt"><button class="pet-cnt-btn" onclick="PetSub 12">-</button> <span id="petCnt12">0</span> <button class="pet-cnt-btn" onclick="PetAdd 12">+</button></td><td class="lv"></td><td class="num"></td><td class="pet-cnt"></td></tr>
            </table>
            <div style="margin-top: 8px;"><button onclick="PetCountReset">清零计数</button><button onclick="PetSaveHistory">保存当天记录</button><span class="pet-cost-total">累计成本：<b id="petTotalCost">0</b> 万梦幻币</span><span class="pet-cost-total">全部号合计：<b id="petAllCost">0</b> 万梦幻币</span></div>
            <div style="cursor: pointer; margin-top: 8px;" onclick="TogglePetDetail"><label style="width: auto; text-align: left;">📋 累计成本明细：</label><span class="sq-toggle" id="petDetailToggleHint">▼ 展开</span></div>
            <div id="petDetailSection" style="display: none;"></div>
            <div style="cursor: pointer; margin-top: 8px;" onclick="TogglePetHist"><label style="width: auto; text-align: left;">📅 历史记录查询：</label><span class="sq-toggle" id="petHistToggleHint">▼ 展开</span><button class="btn-hist-io" onclick="PetHistExport">导出</button><button class="btn-hist-io" onclick="PetHistImport">导入</button><button class="pet-hist-delete" onclick="PetClearHistory">清空历史记录</button><span class="tip">按日历查看每天保存的成本记录，导入/导出与移动版通用</span></div>
            <div id="petHistSection" style="display: none;"></div>
            <div class="pet-note">★点击 “+” 记录一次任务，可登记本次成本（万梦幻币，非必填，不填按 0 计入；取消则不计数）；点击 “-” 撤销最近一次记录，并同步从累计成本中扣回该次成本<br>★切换“当前号”页签可分别为 1~5 号计数，各号次数、成本互相独立；“清零计数”只清当前号，其他号不受影响</div>
            <div class="pet-note">★上交烹饪、三药品质不满足要求，会扣除一定任务积分，修炼经验/修炼点不受影响<br>★烹饪三药扣分规则：（应交品质-实际品质）/2，积分向下取整<br>★实际积分：（应交品质-实际品质）/2+2，积分向下取整<br>例如需上交63品质的珍露酒，实际上交58品质的，相差5品，扣除2分加上本身应得2分（上交三级药/烹饪获得2分），实际不扣分（即-2分+2分）</div>
            <div class="pet-block-title" style="cursor: pointer;" onclick="TogglePetReward">【召唤兽修炼任务积分奖励】<span class="sq-toggle" id="petRewardToggleHint">▼ 展开</span></div>
            <div id="petRewardSection" style="display: none;">
            <div class="pet-note">奖励说明：高级书铁奖励与宠环总积分和人物等级相关。各个奖励所需宠环总积分如下：</div>
            <table>
                <tr><th>书铁等级＼角色等级</th><th>69</th><th>89</th><th>109</th><th>129</th><th>145</th><th>155</th></tr>
                <tr><td class="lv">70</td><td class="num">147</td><td class="num">141</td><td class="num">134</td><td class="num">127</td><td class="num">122</td><td class="num">119</td></tr>
                <tr class="alt"><td class="lv">2个70</td><td class="num">157</td><td class="num">151</td><td class="num">144</td><td class="num">137</td><td class="num">132</td><td class="num">129</td></tr>
                <tr><td class="lv">80</td><td class="num">167</td><td class="num">161</td><td class="num">154</td><td class="num">147</td><td class="num">142</td><td class="num">139</td></tr>
                <tr class="alt"><td class="lv">2个80</td><td class="num">177</td><td class="num">171</td><td class="num">164</td><td class="num">157</td><td class="num">152</td><td class="num">149</td></tr>
                <tr><td class="lv">3个80</td><td class="num">187</td><td class="num">181</td><td class="num">174</td><td class="num">167</td><td class="num">162</td><td class="num">159</td></tr>
                <tr class="alt"><td class="lv">90</td><td class="num">197</td><td class="num">191</td><td class="num">184</td><td class="num">177</td><td class="num">172</td><td class="num">169</td></tr>
                <tr><td class="lv">100</td><td class="num">207</td><td class="num">201</td><td class="num">194</td><td class="num">187</td><td class="num">182</td><td class="num">179</td></tr>
                <tr class="alt"><td class="lv">110</td><td class="num">217</td><td class="num">211</td><td class="num">204</td><td class="num">197</td><td class="num">192</td><td class="num">189</td></tr>
                <tr><td class="lv">120</td><td class="num">227</td><td class="num">221</td><td class="num">214</td><td class="num">207</td><td class="num">202</td><td class="num">199</td></tr>
                <tr class="alt"><td class="lv">130</td><td class="num">237</td><td class="num">231</td><td class="num">224</td><td class="num">217</td><td class="num">212</td><td class="num">209</td></tr>
                <tr><td class="lv">140</td><td class="num">247</td><td class="num">241</td><td class="num">234</td><td class="num">227</td><td class="num">222</td><td class="num">219</td></tr>
            </table>
            </div>
            <div class="pet-block-title" style="cursor: pointer;" onclick="TogglePetScore">【召唤兽修炼任务积分奖励·最终得分】<span class="sq-toggle" id="petScoreToggleHint">▼ 展开</span></div>
            <div id="petScoreSection" style="display: none;">
            <div class="pet-note">奖励说明：高级书铁奖励根据最终得分获得，最终得分=宠环总积分+人物等级/3（向下取整）</div>
            <table class="pet-score-table">
                <tr><th width="30%">最终得分</th><th width="70%">奖励</th></tr>
                <tr><td class="num">170</td><td>70级制造指南书/百炼精铁</td></tr>
                <tr class="alt"><td class="num">180</td><td>2个70级制造指南书/百炼精铁</td></tr>
                <tr><td class="num">190</td><td>80级制造指南书/百炼精铁</td></tr>
                <tr class="alt"><td class="num">200</td><td>2个80级制造指南书/百炼精铁</td></tr>
                <tr><td class="num">210</td><td>3个80级制造指南书/百炼精铁</td></tr>
                <tr class="alt"><td class="num">220</td><td>90级制造指南书/百炼精铁</td></tr>
                <tr><td class="num">230</td><td>100级制造指南书/百炼精铁</td></tr>
                <tr class="alt"><td class="num">240</td><td>110级制造指南书/百炼精铁</td></tr>
                <tr><td class="num">250</td><td>120级制造指南书/百炼精铁</td></tr>
                <tr class="alt"><td class="num">260</td><td>130级制造指南书/百炼精铁</td></tr>
                <tr><td class="num">270</td><td>140级制造指南书/百炼精铁</td></tr>
                <tr class="alt"><td class="num">280</td><td>140级制造指南书/百炼精铁</td></tr>
            </table>
            </div>
        </div>
    </div>
    <div class="input-bar">
        <div style="cursor: pointer;" onclick="ToggleSqSection"><label style="width: auto; text-align: left;">⚔️ 神器任务攻略（序章/起/转/合）：</label><span class="sq-toggle" id="sqToggleHint">▼ 展开</span><span class="tip">点击任务名弹窗查看攻略（内容加载自网络）</span></div>
        <div id="sqLinks" style="display: none;"></div>
    </div>
    <div class="input-bar">
        <div>
            <label>💰 金价比例（元/1000万梦幻币）：</label><input type="text" id="txtGold" onkeydown="CheckEnterGold"><button id="btnCalcGold" onclick="CalcGold">汇率换算</button>
        </div>
        <div>
            <label>梦幻币（万）：</label><input type="text" id="txtCoin" onkeydown="CheckEnterGold"><span class="tip">选填</span>
            <label style="width: auto; margin-left: 10px;">人民币（元）：</label><input type="text" id="txtRmb" onkeydown="CheckEnterGold"><span class="tip">选填</span>
        </div>
        <div id="goldResult"></div>
    </div>
    <div class="input-bar">
        <label>1级宝石单价（万）：</label><input type="text" id="txtPrice" onkeydown="CheckEnter"><button id="btnCalculate" onclick="Calculate">确认换算</button><button id="btnGemSelect" onclick="ToggleGemSelect">选择</button><button id="btnGemSum" onclick="CalcGemSum">计算</button><span class="tip">合成规则：2个N级宝石 = 1个(N+1)级宝石</span>
        <div id="gemSumResult"></div>
        <div style="cursor: pointer;" onclick="ToggleGemResult"><label style="width: auto; text-align: left;">💎 成本计算结果：</label><span class="sq-toggle" id="gemResultToggleHint">▼ 展开</span></div>
    </div>
    <div id="resultArea" style="display: none;"></div>
    <div id="petCostOverlay" onclick="PetCostCancel"></div>
    <div id="petCostDialog">
        <div id="petCostTitle"></div>
        <div><label>本次成本（万梦幻币）：</label><input type="text" id="petCostInput" onkeydown="PetCostKeyDown"></div>
        <div class="pet-cost-note">非必填，不填按 0 计入；金额可带小数</div>
        <div class="pet-cost-btns"><button class="sq-dialog-btn" onclick="PetCostOk">确定</button><button class="sq-dialog-btn" onclick="PetCostCancel">取消</button></div>
    </div>
    <div id="petHistOverlay" onclick="ClosePetHist"></div>
    <div id="petHistDialog">
        <div id="petHistTitle"></div>
        <div id="petHistBody"></div>
        <div class="pet-cost-btns"><button class="pet-hist-delete" onclick="PetDeleteHistDay">删除该日记录</button><button class="sq-dialog-btn" onclick="ClosePetHist">✕ 关闭</button></div>
    </div>
    <div id="petIoOverlay" onclick="PetIoClose"></div>
    <div id="petIoDialog">
        <div id="petIoTitle"></div>
        <div class="pet-cost-note" id="petIoNote"></div>
        <textarea id="petIoText" wrap="off"></textarea>
        <div class="pet-cost-btns"><button class="sq-dialog-btn" id="petIoOkBtn" onclick="PetIoOk">导入</button><button class="sq-dialog-btn" id="petIoCopyBtn" onclick="PetIoCopyAll">全选复制</button><button class="sq-dialog-btn" onclick="PetIoClose">✕ 关闭</button></div>
    </div>
    <div id="sqOverlay" onclick="CloseSq"></div>
    <div id="sqDialog">
        <div class="sq-dialog-head" onmousedown="StartSqMove" title="按住可拖动弹窗">
            <span id="sqDialogTitle"></span>
            <button class="sq-dialog-btn" onclick="OpenSqBrowser">在浏览器中打开</button>
            <button class="sq-dialog-btn" onclick="CloseSq">✕ 关闭</button>
        </div>
        <iframe id="sqFrame" application="yes"></iframe>
        <div id="sqDragMask"></div>
        <div class="sq-resize-handle" onmousedown="StartSqResize" ondblclick="ResetSqDialogSize" title="拖动可自由调整弹窗大小（双击恢复默认）"><span class="sq-rh-1"></span><span class="sq-rh-2"></span><span class="sq-rh-3"></span></div>
    </div>
</body>
</html>

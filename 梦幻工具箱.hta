    body.dark .input-bar .pet-char-btn { background-color: #292d33; color: #d2d6da; border-color: #4a5058 #0e1013 #0e1013 #4a5058; }
    body.dark .input-bar .pet-char-btn-on { color: #ffffff; background-color: #7b43f5; border-color: #8b5cf6 #5ba8f5 #5ba8f5 #8b5cf6; filter: progid:DXImageTransform.Microsoft.gradient(GradientType=1, startColorstr='#FF8B5CF6', endColorstr='#FF5BA8F5'); }
    body.dark td.pet-char-cell { color: #8b5cf6; background-color: #37324d; }
